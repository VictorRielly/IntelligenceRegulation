 /// count of looked pairs that are not a row of the table (ruling CS-3;
 /// a miss is filed in entry 0, exactly as before). Shared by `prove_core`
 /// and [`check_lookup_misses`].
+/// **[ZK60-METAL M16] the A and H matrices, reused across blocks.** A fresh
+/// `vec![0; len]` of a block's 330 MB matrix pays a page fault per page at its
+/// first write (on this Mac the first touch of fresh memory costs about 0.08
+/// ms per MB and does not parallelize well; M4f). A matrix of the same length
+/// returned by an earlier block (after its opening) is zeroed in parallel
+/// instead: the same words, `len` zeros. At most [`MATRIX_POOL_MAX`] are kept;
+/// `HL_MATRIX_POOL=0` allocates fresh every time.
+static MATRIX_POOL: std::sync::Mutex<Vec<Vec<Fp>>> = std::sync::Mutex::new(Vec::new());
+const MATRIX_POOL_MAX: usize = 4;
+
+fn matrix_pool_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("HL_MATRIX_POOL").map(|v| v != "0").unwrap_or(true))
+}
+
+fn matrix_take(len: usize) -> Vec<Fp> {
+    if matrix_pool_on() {
+        let reused = MATRIX_POOL.lock().ok().and_then(|mut pool| pool.iter().position(|v| v.len() == len).map(|i| pool.swap_remove(i)));
+        if let Some(mut v) = reused {
+            use rayon::prelude::*;
+            v.par_chunks_mut(1 << 16).for_each(|c| c.fill(Fp::ZERO));
+            return v;
+        }
+    }
+    vec![Fp::ZERO; len]
+}
+
+fn matrix_put(v: Vec<Fp>) {
+    if matrix_pool_on() && !v.is_empty() {
+        if let Ok(mut pool) = MATRIX_POOL.lock() {
+            if pool.len() < MATRIX_POOL_MAX {
+                pool.push(v);
+            }
+        }
+    }
+}
