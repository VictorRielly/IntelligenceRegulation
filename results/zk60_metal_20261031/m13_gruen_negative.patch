+/// **[ZK60-METAL M13] the Gruen split of a slot polynomial.** `P = eqtau *
+/// A_inner + B`: `t_eq` is the ONE table that is a zero-check's `eq(tau, .)`
+/// over the leading variables (`TableKind::Eq { start: 0 }`) and enters the
+/// polynomial ONLY as a wrapper factor, at most once per term. `a_terms` are
+/// the terms it wraps; every other term is `B`. `b_nodes[n]`: node `n` is
+/// reached from a `B` term (it must be computed at every point); the rest is
+/// needed only where `A` is evaluated. `None`: no such table, so no split.
+pub(super) struct GruenSplit {
+    pub t_eq: usize,
+    pub a_terms: Vec<bool>,
+    pub b_nodes: Vec<bool>,
+}
+
+pub(super) fn gruen_split(ir: &SlotIr) -> Option<GruenSplit> {
+    let in_nodes = |t: usize| {
+        ir.nodes.iter().any(|n| match &n.body {
+            NodeBody::Affine { terms, .. } => terms.iter().any(|(_, x)| *x as usize == t),
+            NodeBody::Sum { subterms } => subterms.iter().any(|st| st.factors.iter().any(|f| matches!(f, Factor::Table(x) if *x as usize == t))),
+        })
+    };
+    for (t, tr) in ir.tables.iter().enumerate() {
+        if !matches!(tr.kind, TableKind::Eq { start: 0, .. }) || in_nodes(t) {
+            continue;
+        }
+        if ir.terms.iter().any(|term| term.inner.iter().any(|f| matches!(f, Factor::Table(x) if *x as usize == t)) || term.wrapper.iter().filter(|w| **w as usize == t).count() > 1) {
+            continue;
+        }
+        let a_terms: Vec<bool> = ir.terms.iter().map(|term| term.wrapper.iter().any(|w| *w as usize == t)).collect();
+        if !a_terms.iter().any(|a| *a) {
+            continue;
+        }
+        let mut b_nodes = vec![false; ir.nodes.len()];
+        for (term, a) in ir.terms.iter().zip(a_terms.iter()) {
+            if !*a {
+                for f in &term.inner {
+                    if let Factor::Node(nid) = f {
+                        b_nodes[*nid as usize] = true;
+                    }
+                }
+            }
+        }
+        for i in (0..ir.nodes.len()).rev() {
+            if !b_nodes[i] {
+                continue;
+            }
+            if let NodeBody::Sum { subterms } = &ir.nodes[i].body {
+                for st in subterms {
+                    for f in &st.factors {
+                        if let Factor::Node(nid) = f {
+                            b_nodes[*nid as usize] = true;
+                        }
+                    }
+                }
+            }
+        }
+        return Some(GruenSplit { t_eq: t, a_terms, b_nodes });
+    }
+    None
+}
+
+/// **[ZK60-METAL M13] the Gruen round kernels** for a split slot (`gruen_split`):
+/// (round-0 kernel typed as `msl_round_kernels`' round 0, later-round kernel)
+/// and their coefficient buffer. One thread per (pair stride, point d), every
+/// point `0..=D` launched; partial `(gid, d)` is the pair `(A_d, B_d)`:
+/// * `B_d = sum B-terms` at point d, always;
+/// * `A_d = sum (lo_eq + hi_eq) * (A-terms without their eq factor)` at point
+///   d, only where `needA`: `d < D`, and `d != 1` when the claim gives s(1).
+///
+/// Along a round's line the eq table is `(lo + hi) * eq_j(X)` exactly, so the
+/// round's sums are `s(d) = eq_j(d) A(d) + B(d)`; the transcript step
+/// (`k_sc_fs_step`, gruen mode) recovers `A(1)` from the claim and extrapolates
+/// `A(D)` (degree <= D-1). The nodes and tables only the A-terms reach are
+/// evaluated only at the `needA` points: one evaluation point fewer of the
+/// heavy part per round.
+pub(super) fn msl_round_kernels_gruen(ir: &SlotIr, g: &GruenSplit, base0: &[bool]) -> (String, String, Vec<Fp2>) {
+    let (k0, cf0) = gen_kernel_gruen(ir, g, base0, "k_sc_round0_g");
+    let (k1, cf1) = gen_kernel_gruen(ir, g, &vec![false; base0.len()], "k_sc_round_g");
+    assert_eq!(cf0.len(), cf1.len(), "both Gruen kernels read the same coefficient buffer");
+    (k0, k1, cf0)
+}
+
+fn gen_kernel_gruen(ir: &SlotIr, g: &GruenSplit, base: &[bool], name: &str) -> (String, Vec<Fp2>) {
+    let mut cf: Vec<Fp2> = Vec::new();
+    let k = ir.tables.len();
+    let tab = |t: usize| Ex { code: format!("v{t}"), base: base[t] };
+    let fac = |f: &Factor, nodes: &[Ex]| -> Ex {
+        match f {
+            Factor::Table(t) => tab(*t as usize),
+            Factor::Node(n) => nodes[*n as usize].clone(),
+        }
+    };
+    // which tables B reaches (its nodes' tables, its terms' wrappers and inner tables)
+    let mut b_tab = vec![false; k];
+    for (n, nb) in ir.nodes.iter().zip(g.b_nodes.iter()) {
+        if !*nb {
+            continue;
+        }
+        match &n.body {
+            NodeBody::Affine { terms, .. } => terms.iter().for_each(|(_, t)| b_tab[*t as usize] = true),
+            NodeBody::Sum { subterms } => subterms.iter().flat_map(|st| st.factors.iter()).for_each(|f| {
+                if let Factor::Table(t) = f {
+                    b_tab[*t as usize] = true;
+                }
+            }),
+        }
+    }
+    for (term, a) in ir.terms.iter().zip(g.a_terms.iter()) {
+        if *a {
+            continue;
+        }
+        term.wrapper.iter().for_each(|w| b_tab[*w as usize] = true);
+        term.inner.iter().for_each(|f| {
+            if let Factor::Table(t) = f {
+                b_tab[*t as usize] = true;
+            }
+        });
+    }
+    assert!(!b_tab[g.t_eq], "the split's eq table is not read by B");
+    let line = |t: usize| -> String {
+        let f = if base[t] { ("ulong", "ln_base") } else { ("fp2", "ln_ext") };
+        format!("            {} v{t} = {}(tabs, ({t}UL * a.cap + i) * 2UL, ({t}UL * a.cap + i + a.nhalf) * 2UL, d, dd);\n", f.0, f.1)
+    };
+    let emit_node = |n: &super::slot_ir::Node, nodes: &[Ex], cf: &mut Vec<Fp2>, indent: &str| -> (String, Ex) {
+        let val = match &n.body {
+            NodeBody::Affine { konst, terms } => {
+                let mut e = coef_ex(konst, cf).unwrap_or_else(one);
+                for (c, t) in terms {
+                    let p = product(c, &[tab(*t as usize)], cf);
+                    e = add(&e, &p);
+                }
+                e
+            }
+            NodeBody::Sum { subterms } => {
+                let mut e: Option<Ex> = None;
+                for st in subterms {
+                    let fs: Vec<Ex> = st.factors.iter().map(|f| fac(f, nodes)).collect();
+                    let p = product(&st.coef, &fs, cf);
+                    e = Some(match e {
+                        None => p,
+                        Some(a) => add(&a, &p),
+                    });
+                }
+                e.unwrap_or(Ex { code: "0UL".to_string(), base: true })
+            }
+        };
+        let ty = if val.base { "ulong" } else { "fp2" };
+        (format!("{indent}{ty} n{} = {};\n", n.id, val.code), Ex { code: format!("n{}", n.id), base: val.base })
+    };
+    // B: its tables, its nodes, its terms (every point)
+    let mut body = String::new();
+    for t in (0..k).filter(|t| b_tab[*t]) {
+        body.push_str(&line(t));
+    }
+    let mut nodes: Vec<Ex> = vec![Ex { code: String::new(), base: true }; ir.nodes.len()];
+    for (i, n) in ir.nodes.iter().enumerate() {
+        if g.b_nodes[i] {
+            let (code, ex) = emit_node(n, &nodes, &mut cf, "            ");
+            body.push_str(&code);
+            nodes[i] = ex;
+        }
+    }
+    body.push_str("            fp2 outB = f2(0UL, 0UL);\n");
+    for (term, a) in ir.terms.iter().zip(g.a_terms.iter()) {
+        if *a {
+            continue;
+        }
+        let mut fs: Vec<Ex> = term.wrapper.iter().map(|w| tab(*w as usize)).collect();
+        fs.extend(term.inner.iter().map(|f| fac(f, &nodes)));
+        let p = product(&term.coef, &fs, &mut cf);
+        body.push_str(&format!("            outB = f2_add(outB, {});\n", ext_of(&p)));
+    }
+    body.push_str("            accB = f2_add(accB, outB);\n");
+    // A: only where needed
+    body.push_str("            if (needA) {\n");
+    body.push_str(&format!(
+        "                fp2 eqE = f2_add(f2(tabs[({t}UL * a.cap + i) * 2UL], tabs[({t}UL * a.cap + i) * 2UL + 1UL]), f2(tabs[({t}UL * a.cap + i + a.nhalf) * 2UL], tabs[({t}UL * a.cap + i + a.nhalf) * 2UL + 1UL]));\n",
+        t = g.t_eq
+    ));
+    for t in (0..k).filter(|t| !b_tab[*t] && *t != g.t_eq) {
+        body.push_str(&format!("    {}", line(t)));
+    }
+    for (i, n) in ir.nodes.iter().enumerate() {
+        if !g.b_nodes[i] {
+            let (code, ex) = emit_node(n, &nodes, &mut cf, "                ");
+            body.push_str(&code);
+            nodes[i] = ex;
+        }
+    }
+    body.push_str("                fp2 outA = f2(0UL, 0UL);\n");
+    for (term, a) in ir.terms.iter().zip(g.a_terms.iter()) {
+        if !*a {
+            continue;
+        }
+        let mut fs: Vec<Ex> = term.wrapper.iter().filter(|w| **w as usize != g.t_eq).map(|w| tab(*w as usize)).collect();
+        fs.extend(term.inner.iter().map(|f| fac(f, &nodes)));
+        let p = product(&term.coef, &fs, &mut cf);
+        body.push_str(&format!("                outA = f2_add(outA, {});\n", ext_of(&p)));
+    }
+    body.push_str("                accA = f2_add(accA, f2_mul(eqE, outA));\n");
+    body.push_str("            }\n");
+    let mut s = String::new();
+    s.push_str(&format!("// slot {} ({}) at {}: Gruen split on table {} ({} tables)\n", ir.slot, ir.name, ir.profile, g.t_eq, k));
+    if name == "k_sc_round0_g" {
+        s.push_str("struct RoundArgs { ulong nhalf; ulong cap; uint eval_one; uint nthreads; };\n");
+    }
+    s.push_str(&format!("kernel void {name}(device const ulong *tabs [[buffer(0)]],\n"));
+    s.push_str(concat!(
+        "                       device ulong *part [[buffer(1)]],\n",
+        "                       constant ulong *cf [[buffer(2)]],\n",
+        "                       constant RoundArgs &a [[buffer(3)]],\n",
+        "                       uint tid [[thread_position_in_grid]]) {\n",
+        "    uint np = SC_D + 1u;\n",
+        "    uint grp = tid >> 5;\n",
+        "    uint d = grp % np;\n",
+        "    uint gid = (grp / np) * 32u + (tid & 31u);\n",
+        "    if (gid >= a.nthreads) { return; }\n",
+        "    ulong dd = ulong(d);\n",
+        "    bool needA = d < SC_D && (d != 1u || a.eval_one != 0u);\n",
+        "    fp2 accA = f2(0UL, 0UL);\n",
+        "    fp2 accB = f2(0UL, 0UL);\n",
+        "    for (ulong i = ulong(gid); i < a.nhalf; i += ulong(a.nthreads)) {\n",
+    ));
+    s.push_str(&body);
+    s.push_str(concat!(
+        "    }\n",
+        "    ulong o = ((ulong(gid) * (SC_D + 1) + ulong(d)) * 2UL) * 2UL;\n",
+        "    part[o] = accA.c0;\n",
+        "    part[o + 1] = accA.c1;\n",
+        "    part[o + 2] = accB.c0;\n",
+        "    part[o + 3] = accB.c1;\n",
+        "}\n",
+    ));
+    (s, cf)
+}
+
+/// [M13, diagnostics] multiplications in each node (coefficient products and
+/// factor products, as `gen_kernel` emits them)
+pub(super) fn node_mul_counts(ir: &SlotIr) -> Vec<usize> {
+    ir.nodes
+        .iter()
+        .map(|n| match &n.body {
+            NodeBody::Affine { terms, .. } => terms.iter().filter(|(c, _)| !matches!(c.prov, CoefProv::One)).count(),
+            NodeBody::Sum { subterms } => subterms.iter().map(|st| st.factors.len().saturating_sub(1) + !matches!(st.coef.prov, CoefProv::One) as usize).sum(),
+        })
+        .collect()
+}
