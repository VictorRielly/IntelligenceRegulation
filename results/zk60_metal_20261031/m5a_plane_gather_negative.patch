+impl MetalTables {
+    /// **[M5a]** Gather every job whose data is resident on the device, in ONE
+    /// command buffer. Returns, per job, whether it was written; a job without
+    /// a resident buffer, or whose largest index leaves its data, is left for
+    /// the CPU builder. The words are copied from the committed rows, so a
+    /// gathered table is word for word the CPU's (`m5a_` tests).
+    pub fn gather(&mut self, jobs: &[GatherJob<'_>]) -> Result<Vec<bool>, String> {
+        let mut done = vec![false; jobs.len()];
+        if !gather_on() || jobs.is_empty() {
+            return Ok(done);
+        }
+        let c = ctx()?;
+        let reg: Vec<(usize, usize, Buffer)> = RESIDENT.lock().map_err(|_| "metal resident registry poisoned".to_string())?.clone();
+        let mut picks: Vec<(usize, Buffer, PBuf, PBuf, PlaneGatherArgs)> = Vec::new();
+        for (j, job) in jobs.iter().enumerate() {
+            let Some((_, _, src)) = reg.iter().find(|e| e.0 == job.data.as_ptr() as usize && e.1 == job.data.len()) else { continue };
+            let max_idx = job.inv_hi.iter().max().copied().unwrap_or(0) as usize | job.inv_lo.iter().max().copied().unwrap_or(0) as usize;
+            let reach = job.off[0].max(if job.two { job.off[1] } else { 0 }) + max_idx;
+            let out_base = job.table * self.cap;
+            if job.table >= self.k || reach >= job.data.len() || reach > u32::MAX as usize || 2 * (out_base + self.cap) > u32::MAX as usize
+                || job.inv_lo.len() != 1usize << job.xlo || job.used >= self.cap {
+                continue;
+            }
+            let args = PlaneGatherArgs {
+                n: self.cap as u32,
+                used: job.used as u32,
+                xlo: job.xlo as u32,
+                lo_mask: ((1usize << job.xlo) - 1) as u32,
+                off0: job.off[0] as u32,
+                off1: if job.two { job.off[1] as u32 } else { 0 },
+                two: job.two as u32,
+                out_base: out_base as u32,
+            };
+            picks.push((j, src.clone(), upload_u32(c, &job.inv_lo)?, upload_u32(c, &job.inv_hi)?, args));
+        }
+        if picks.is_empty() {
+            return Ok(done);
+        }
+        let out: &Buffer = &self.buf;
+        objc::rc::autoreleasepool(|| {
+            run(c, |enc| {
+                for (_, src, lo, hi, args) in &picks {
+                    enc.set_buffer(0, Some(src), 0);
+                    enc.set_buffer(1, Some(out), 0);
+                    enc.set_buffer(2, Some(lo), 0);
+                    enc.set_buffer(3, Some(hi), 0);
+                    set_args(enc, 4, args);
+                    dispatch_2d(c, enc, "k_gather_plane", self.cap as u64, 1);
+                }
+                Ok(())
+            })
+        })?;
+        for (j, ..) in &picks {
+            done[*j] = true;
+        }
+        Ok(done)
+    }
+}
