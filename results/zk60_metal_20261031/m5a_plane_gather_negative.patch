+// ------------------------------------------- M5a: plane tables gathered on the device
+// One plain-store plane table: `argument.rs`'s `priv_table_fill`, parallel
+// branch. out[x] = (data[off0 + idx], two ? data[off1 + idx] : 0), with
+// idx = inv_hi[xu >> xlo] | inv_lo[xu & lo_mask] and xu = x & used.
+// The words are COPIED, never computed: a plane's coefficients are 1 (an A
+// plane) or (1, u) (an H plane's real and imaginary rows), so its Fp2 entry is
+// the pair of committed words itself, exactly what the CPU stores.
+struct PlaneGatherArgs { uint n; uint used; uint xlo; uint lo_mask; uint off0; uint off1; uint two; uint out_base; };
+kernel void k_gather_plane(device const ulong *src [[buffer(0)]],
+                           device ulong *out [[buffer(1)]],
+                           device const uint *inv_lo [[buffer(2)]],
+                           device const uint *inv_hi [[buffer(3)]],
+                           constant PlaneGatherArgs &a [[buffer(4)]],
+                           uint2 gid [[thread_position_in_grid]]) {
+    uint x = gid.x;
+    if (x >= a.n) { return; }
+    uint xu = x & a.used;
+    uint idx = inv_hi[xu >> a.xlo] | inv_lo[xu & a.lo_mask];
+    ulong re = src[a.off0 + idx];
+    ulong im = a.two != 0u ? src[a.off1 + idx] : 0UL;
+    out[2u * (a.out_base + x)] = re;
+    out[2u * (a.out_base + x) + 1u] = im;
+}
