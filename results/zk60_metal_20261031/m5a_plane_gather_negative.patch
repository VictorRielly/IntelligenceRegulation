+/// **[M5a] The device gather of a PLAIN-STORE plane table**, or `None` where
+/// the CPU must build it. It is `priv_table_fill`'s parallel branch, stated
+/// again for the device: plain store (no fixed coordinate, no challenge index
+/// used twice), and a plane whose coefficients are exactly `1` (an `A` plane)
+/// or `(1, u)` (an `H` plane's real and imaginary rows), so each entry is the
+/// committed word pair itself, `(data[off0 + idx], data[off1 + idx] or 0)`.
+/// The inverse bit tables are the branch's `inverse_half`, as `u32`.
+#[cfg(feature = "gpu-metal")]
+pub(super) fn plane_gather<'a>(table: usize, p: &Priv, n_vars: usize, data: &'a [Fp]) -> Option<crate::gpu::GatherJob<'a>> {
+    if p.coords.iter().any(|c| matches!(c, Coord::Fixed(_))) {
+        return None;
+    }
+    let (off, two) = match p.slices.as_slice() {
+        [(o, c)] if *c == Fp2::ONE => ([*o, 0], false),
+        [(re, c0), (im, c1)] if *c0 == Fp2::ONE && *c1 == Fp2::U => ([*re, *im], true),
+        _ => return None,
+    };
+    let mut used = 0usize;
+    let mut bit_of: Vec<Option<(usize, usize)>> = vec![None; n_vars];
+    for (j, c) in p.coords.iter().enumerate() {
+        let (k, flip) = match c {
+            Coord::Rho(k) => (*k, 0),
+            Coord::Flip(k) => (*k, 1),
+            Coord::Fixed(_) => return None,
+        };
+        if k >= n_vars || bit_of[n_vars - 1 - k].is_some() {
+            return None; // an index used twice accumulates: not a plain store
+        }
+        used |= 1usize << (n_vars - 1 - k);
+        bit_of[n_vars - 1 - k] = Some((p.log - 1 - j, flip));
+    }
+    let (xlo, xhi) = (n_vars / 2, n_vars - n_vars / 2);
+    let inverse_half = |shift: usize, bits: usize| -> Vec<u32> {
+        (0..1usize << bits)
+            .map(|v| {
+                let mut idx = 0usize;
+                for b in 0..bits {
+                    if let Some((ib, flip)) = bit_of[shift + b] {
+                        idx |= (((v >> b) & 1) ^ flip) << ib;
+                    }
+                }
+                idx as u32
+            })
+            .collect()
+    };
+    Some(crate::gpu::GatherJob { table, data, off, two, used, xlo, inv_lo: inverse_half(0, xlo), inv_hi: inverse_half(xlo, xhi) })
+}
