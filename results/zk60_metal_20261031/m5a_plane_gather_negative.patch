+/// a u32 vector in a pooled shared buffer
+fn upload_u32(c: &Ctx, vals: &[u32]) -> Result<PBuf, String> {
+    let buf = shared_buffer(c, (vals.len().max(1) * 4) as u64)?;
+    // SAFETY: `vals.len() * 4` bytes of shared, CPU-visible memory owned here
+    let dst = unsafe { std::slice::from_raw_parts_mut(buf.contents() as *mut u32, vals.len()) };
+    dst.copy_from_slice(vals);
+    Ok(buf)
+}
