+// ------------------------------------------- M5a: resident committed data
+
+/// **[M5a] The hiding commitments' device data rows, by the HOST slice they
+/// were uploaded from** `(host ptr, host len, the same buffer)`. A slot's
+/// plain-store plane tables are then gathered on the device
+/// (`MetalTables::gather`) instead of copied word by word on the CPU (0.14 s of
+/// a W16 block's tables, `results/zk60_limb16_20261031/DESIGN.md`).
+///
+/// **Why a key can never name the wrong words.** An entry is added when its
+/// `MetalCommit` is made and removed in that commitment's `drop`, before its
+/// buffer can go back to the pool; and the host slice is the commitment's own
+/// data (`CommittedZk::data` is the `Vec` the upload read, moved, not copied),
+/// immutable for the commitment's life. `HL_METAL_GATHER=0` turns it off.
+static RESIDENT: Mutex<Vec<(usize, usize, Buffer)>> = Mutex::new(Vec::new());
+
+fn gather_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("HL_METAL_GATHER").map(|v| v != "0").unwrap_or(true))
+}
+
+fn resident_add(data: &[Fp], d: &PBuf) {
+    if !gather_on() || data.is_empty() {
+        return;
+    }
+    if let Ok(mut g) = RESIDENT.lock() {
+        let key = data.as_ptr() as usize;
+        g.retain(|e| e.0 != key);
+        g.push((key, data.len(), (**d).clone()));
+    }
+}
+
+impl Drop for MetalCommit {
+    fn drop(&mut self) {
+        if let Some(d) = &self.data {
+            let p = d.contents() as usize;
+            if let Ok(mut g) = RESIDENT.lock() {
+                g.retain(|e| e.2.contents() as usize != p);
+            }
+        }
+    }
+}
