+@dataclass(frozen=True)
+class Deployment:
+    binary: Path
+    binary_sha256: str
+    prover_export: Path
+    verifier_export: Path
+    tables: Path
+    statement_identity: str
+    policy: str
+    chunk_size: int
+    overlap: int
+    min_bits: int=95
+    development: bool=False
+    statement_schema: str=R_C1_SCHEMA
