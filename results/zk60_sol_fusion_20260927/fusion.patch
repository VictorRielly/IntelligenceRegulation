+fn fused_parts<F: Fn(usize, &[Fp2]) -> Fp2 + Sync>(
+    quarters: Quarters<'_>, offset: usize, r: Fp2, groups: &[EqualityGroup],
+    metadata: &[RoundGroup], bracket: &F, max_degree: usize, chunk: usize,
+) -> Vec<Vec<Fp2>> {
+    let len = quarters[0][0].len();
+    if len <= chunk {
+        return fused_tile(quarters, offset, r, groups, metadata, bracket, max_degree);
+    }
+    let mid = len / 2;
+    let mut left = Vec::with_capacity(quarters.len());
+    let mut right = Vec::with_capacity(quarters.len());
+    for qs in quarters {
+        let [q0, q1, q2, q3] = qs;
+        let (a0, b0) = q0.split_at_mut(mid);
+        let (a1, b1) = q1.split_at_mut(mid);
+        let (a2, b2) = q2.split_at_mut(mid);
+        let (a3, b3) = q3.split_at_mut(mid);
+        left.push([a0, a1, a2, a3]);
+        right.push([b0, b1, b2, b3]);
+    }
+    let (a, b) = rayon::join(
+        || fused_parts(left, offset, r, groups, metadata, bracket, max_degree, chunk),
+        || fused_parts(right, offset + mid, r, groups, metadata, bracket, max_degree, chunk),
+    );
+    add_sums(a, b)
+}
