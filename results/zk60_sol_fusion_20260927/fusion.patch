+#[test]
+fn middle_offsets_empty_support_and_two_row_transition_match_scalar() {
+    for n in [2usize, 5] {
+        let mut seed = 20260927 + n as u64;
+        let specs: &[(usize, usize, usize)] = if n == 2 {
+            &[(0, 2, 2), (1, 1, 1), (2, 0, 1)]
+        } else {
+            &[(2, 2, 2), (3, 1, 1), (4, 0, 1)]
+        };
+        let groups: Vec<_> = specs.iter().map(|&(start, len, bracket_degree)| EqualityGroup {
+            point: (0..len).map(|_| value(&mut seed)).collect(), start, bracket_degree,
+        }).collect();
+        let mut tables: Vec<Vec<Fp2>> = groups.iter().map(|desc| {
+            (0..1usize << n).map(|i| {
+                let x: Vec<_> = (desc.start..desc.start + desc.point.len()).map(|j|
+                    Fp2::from_u64(((i >> (n - 1 - j)) & 1) as u64)).collect();
+                eq_point(&desc.point, &x)
+            }).collect()
+        }).collect();
+        tables.extend((0..2).map(|_| (0..1usize << n).map(|_| value(&mut seed)).collect()));
+        let bracket = |g: usize, v: &[Fp2]| match g {
+            0 => v[3].mul(v[4]),
+            1 => v[4],
+            2 => v[3].add(v[4]),
+            _ => unreachable!(),
+        };
+        let poly = |v: &[Fp2]| (0..3).fold(Fp2::ZERO,
+            |a, g| a.add(v[g].mul(bracket(g, v))));
+        let challenges = [Fp2::U, Fp2::from_u64(7), Fp2::ZERO,
+            Fp2::ONE, Fp2::from_u64(11)];
+        for fused in [false, true] {
+            let mut reference = tables.clone();
+            let mut candidate = tables.clone();
+            let mut scalar = ClosureRounds::new(&mut reference, 3, poly).recover_one(None);
+            let mut grouped = GroupedEqRounds::new(&mut candidate, 3, groups.clone(), bracket)
+                .with_fusion(fused);
+            for (j, r) in challenges[..n].iter().enumerate() {
+                assert_eq!(grouped.round(j), scalar.round(j), "n={n} j={j} fused={fused}");
+                scalar.fold(*r);
+                grouped.fold(*r);
+            }
+            assert_eq!(grouped.finals(), scalar.finals());
+        }
+    }
 }
 
