+// Each tile owns four nonoverlapping quarter slices of every table. Splitting
+// every quarter before Rayon joins makes the parallel write ownership explicit.
+type Quarters<'a> = Vec<[&'a mut [Fp2]; 4]>;
+
+fn add_sums(mut a: Vec<Vec<Fp2>>, b: Vec<Vec<Fp2>>) -> Vec<Vec<Fp2>> {
+    for (x, y) in a.iter_mut().zip(b) {
+        for (v, w) in x.iter_mut().zip(y) { *v = v.add(w); }
+    }
+    a
+}
