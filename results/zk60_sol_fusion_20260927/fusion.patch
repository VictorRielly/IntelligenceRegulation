+fn fused_tile<F: Fn(usize, &[Fp2]) -> Fp2 + Sync>(
+    mut quarters: Quarters<'_>, offset: usize, r: Fp2, groups: &[EqualityGroup],
+    metadata: &[RoundGroup], bracket: &F, max_degree: usize,
+) -> Vec<Vec<Fp2>> {
+    let mut sums: Vec<_> = groups.iter().map(|g| vec![Fp2::ZERO; g.bracket_degree + 1]).collect();
+    let mut cur = vec![Fp2::ZERO; quarters.len()];
+    let mut dif = vec![Fp2::ZERO; quarters.len()];
+    let mut weights = vec![Fp2::ZERO; groups.len()];
+    for i in 0..quarters[0][0].len() {
+        for (t, qs) in quarters.iter().enumerate() {
+            let lo = qs[0][i].add(r.mul(qs[2][i].sub(qs[0][i])));
+            let hi = qs[1][i].add(r.mul(qs[3][i].sub(qs[1][i])));
+            cur[t] = lo;
+            dif[t] = hi.sub(lo);
+        }
+        for (t, qs) in quarters.iter_mut().enumerate() {
+            qs[0][i] = cur[t];
+            qs[1][i] = cur[t].add(dif[t]);
+        }
+        let row = offset + i;
+        for (g, rg) in metadata.iter().enumerate() {
+            let pos = (row >> rg.trailing) & ((1usize << rg.suffix_len) - 1);
+            weights[g] = rg.left[pos / rg.right.len()].mul(rg.right[pos % rg.right.len()]);
+        }
+        for degree in 0..=max_degree {
+            for (g, desc) in groups.iter().enumerate() {
+                if degree <= desc.bracket_degree &&
+                    (degree != 1 || metadata[g].inverse_one.is_none() || cfg!(debug_assertions)) {
+                    sums[g][degree] = sums[g][degree].add(weights[g].mul(bracket(g, &cur)));
+                }
+            }
+            if degree < max_degree {
+                for (v, d) in cur.iter_mut().zip(&dif) { *v = v.add(*d); }
+            }
+        }
+    }
+    sums
+}
