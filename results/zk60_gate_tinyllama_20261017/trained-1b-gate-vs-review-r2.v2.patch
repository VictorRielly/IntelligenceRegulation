+/// What the trained capture did, for the note and the log (public facts).
+struct TrainedCaptureFacts {
+    variant: String,
+    layers: Vec<u32>,
+    statement_identity: String,
+    silu: Vec<(i32, i32)>,
+    exp_e_s: Vec<i32>,
+    calibration: String,
+    parity_words: usize,
+}
+
+/// Prove an honest trained run over `layers` (dense: the export's hidden
+/// input on `seq`, with the native output checked bit for bit against the
+/// export's `x_out` at every layer; zero: the all-zero hidden plane on the
+/// SAME trained public blocks), then VERIFY it with the recorder attached.
+fn prove_and_capture_trained(export: &Path, seq: &str, layers: &[u32], dense: bool, opts: run_capture::CaptureOpts) -> (Vec<Vec<u8>>, Bundle, Digest, TrainedCaptureFacts) {
+    use super::trained_block::TrainedExport;
+    let ex = TrainedExport::load(export).unwrap_or_else(|e| panic!("the export {}: {e}", export.display()));
+    let c = ex.run_constants(layers).expect("the run-level constants");
+    let sh = ex.shape_for(&c).expect("the trained shape (through the door)");
+    assert!(sh.trained_calibration, "the export did not build a trained-calibration shape");
+    let mut blocks = Vec::with_capacity(layers.len());
+    let mut records = Vec::with_capacity(layers.len());
+    for &l in layers {
+        let t = ex.load_layer(&sh, &c, l, false).unwrap_or_else(|e| panic!("layer {l}: {e}"));
+        records.push(t.record);
+        blocks.push(t.blk);
+    }
+    let silu: Vec<(i32, i32)> = records.iter().map(|r| r.silu_member).collect();
+    let exp_e_s: Vec<i32> = records.iter().map(|r| r.exp_e_s).collect();
+    let st_model = ex.statement_of_records(&sh, &c, records).expect("the trained-model statement");
+    let x0 = if dense { ex.load_seq(&sh, seq, layers[0]).expect("the export's hidden input").0 } else { vec![0i16; sh.tokens * sh.width] };
+    let mut chain = TrainedChain::build(&sh, &blocks, x0);
+    // PARITY (dense only): the native chain IS the export's reference chain
+    let mut parity_words = 0usize;
+    if dense {
+        for (k, &l) in layers.iter().enumerate() {
+            let (_, want) = ex.load_seq(&sh, seq, l).expect("the export's reference output");
+            let got = chain.output_words(k);
+            let differ = got.iter().zip(want.iter()).filter(|(a, b)| a != b).count();
+            assert_eq!(differ, 0, "parity: layer {l}'s native output differs from the export's x_out in {differ} words (no value printed)");
+            parity_words += got.len();
+        }
+    }
+    let l = layers.len();
+    let ctx = trained_capture_context(&ex.variant, layers);
+    let spec = IoSpec::new_shaped(&sh, ctx, 0, 0).expect("the run's endpoint spec");
+    let (expected, owners) = prepare_endpoints(spec, &chain.planes[0], &chain.planes[l]).expect("the run's external endpoint owners");
+    let rs = ex.geometry.run_shape(&sh, l).expect("the trained run shape");
+    let st = RunStatement::new_bound(rs, ctx, expected, &blocks, &vec![(0, 0); l], &st_model).expect("the bound run statement");
+    let segs = prove_to_vec(&st, &blocks, &mut chain, owners);
+    drop(chain);
+    let binding = st.binding().expect("the run binding");
+    let guard = run_capture::Recorder::attach();
+    run_capture::begin_run_with(st.capture_header().expect("the capture header"), binding, opts);
+    run::verify_run(&st, &blocks, &segs).expect("the honest trained run verifies");
+    let bundle = run_capture::take().expect("a bundle for an accepted run");
+    drop(guard);
+    let id: String = st_model.identity().iter().map(|b| format!("{b:02x}")).collect();
+    let facts = TrainedCaptureFacts { variant: ex.variant.clone(), layers: layers.to_vec(), statement_identity: id, silu, exp_e_s, calibration: sh.norm_calibration().describe(), parity_words };
+    (segs, bundle, binding, facts)
+}
