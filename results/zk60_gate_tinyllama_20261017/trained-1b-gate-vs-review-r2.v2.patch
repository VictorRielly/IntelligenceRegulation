+// -------------------------------------------------- PRIVACY GATE LANE (2026-10-17): the trained TinyLlama T32 capture
+//
+// ADDITIVE AND TEST-ONLY. Nothing below changes a prover or verifier relation:
+// it builds a run through the same production constructors the trained stack
+// CLI uses (`TrainedExport::load` / `run_constants` / `shape_for` /
+// `load_layer` / `statement_of_records`, `IoSpec::new_shaped`,
+// `prepare_endpoints`, `RunStatement::new_bound`, `run::prove_run`), and
+// VERIFIES it with the production run verifier while the capture's recorder
+// is attached, exactly as `capture_a_run_into` does at the development
+// shapes and at 125M. The bundle is written only after the run verified.
+
+/// One honest trained chain: the export's own public block per layer (each
+/// with ITS tables), the hidden inputs and the `l + 1` padded planes the
+/// run's IO commitments carry. Prover side only; none of it reaches a bundle.
+struct TrainedChain<'a> {
+    sh: Shape,
+    // BORROWED, never cloned: 22 padded TinyLlama blocks are about 1.3 GB,
+    // and the stack holds them once (the stack CLI's own rule)
+    blocks: &'a [BlockPublic],
+    inputs: Vec<Vec<i16>>,
+    planes: Vec<Vec<i16>>,
+}
+
+impl<'a> TrainedChain<'a> {
+    fn build(sh: &Shape, blocks: &'a [BlockPublic], x0: Vec<i16>) -> TrainedChain<'a> {
+        let ids = Ids::new(sh).expect("the trained shape has a plane map");
+        let mut inputs = Vec::with_capacity(blocks.len());
+        let mut planes = Vec::with_capacity(blocks.len() + 1);
+        let mut x = x0;
+        for (k, b) in blocks.iter().enumerate() {
+            let w = witness::build_shaped(sh, b.attention(), b.feed_forward(), &x).unwrap_or_else(|e| panic!("block {k}: the honest trained witness: {e}"));
+            if k == 0 {
+                planes.push(padded(&w, ids.at(A_X)));
+            }
+            planes.push(padded(&w, ids.at(A_X2)));
+            inputs.push(x);
+            x = true_input(sh, &padded(&w, ids.at(A_X2)));
+        }
+        TrainedChain { sh: sh.clone(), blocks, inputs, planes }
+    }
+    /// the true `[T, d]` output words of block `k` (for the parity check)
+    fn output_words(&self, k: usize) -> Vec<i16> {
+        true_input(&self.sh, &self.planes[k + 1])
+    }
+}
+
+impl RunWitnessSource for TrainedChain<'_> {
+    fn witness(&mut self, k: usize) -> Result<Witness, String> {
+        witness::build_shaped(&self.sh, self.blocks[k].attention(), self.blocks[k].feed_forward(), &self.inputs[k])
+    }
+    fn boundary_plane(&mut self, k: usize) -> Result<Vec<i16>, String> {
+        Ok(self.planes[k + 1].clone())
+    }
+}
+
+/// The capture's public context word: the same length-prefixed recipe as the
+/// stack CLI's `stack_context`, under this lane's own label, so a capture run
+/// is never mistaken for a stack-CLI artifact. Public.
+fn trained_capture_context(variant: &str, layers: &[u32]) -> Digest {
+    let mut b = Vec::new();
+    for s in ["hashline/zk60-trained-stack-context/1", variant, "zk60-privacy-gate-capture"] {
+        b.extend_from_slice(&(s.len() as u64).to_le_bytes());
+        b.extend_from_slice(s.as_bytes());
+    }
+    for l in layers {
+        b.extend_from_slice(&u64::from(*l).to_le_bytes());
+    }
+    *blake3::hash(&b).as_bytes()
+}
