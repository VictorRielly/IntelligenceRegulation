+/// **PRIVACY GATE LANE: CAPTURE ONE BOUND PRIVATE RUN OF TRAINED TinyLlama
+/// BLOCKS AT T = 32**, for the joint-view / run gate at the trained profile.
+///
+/// | variable | what | default |
+/// |---|---|---|
+/// | `HL_PB_CAPTURE_DIR` | where the bundle goes | **required**, absolute, refused inside the repository |
+/// | `HL_PB_INPUT` | `dense` (the export's real hidden input, parity-checked) or `zero` (the all-zero hidden plane on the same trained blocks) | `dense` |
+/// | `HL_PB_CAPTURE_BLOCKS` | `L` | 2 |
+/// | `HL_PB_FIRST_LAYER` | the first export layer of the run | 7 |
+/// | `HL_PB_EXPORT` | the calibration export (variant directory) | the repository's `pg_rot1_export_T32` |
+/// | `HL_PB_SEQ` | the held-out sequence id | `ho00` |
+/// | `HL_RUN_CAPTURE_PUBLIC_TABLES` | `1` carries the public tables' values | **required** |
+/// | `HL_TEST_SOURCE_COMMIT` | the label the bundle records | `uncommitted-test` |
+///
+/// Why layer 7 by default: across the 7 | 8 boundary BOTH per-block table
+/// keys of `pg_rot1` change (exp `e_s` 1 -> 2, SiLU member (-1,-10) ->
+/// (-4,-13)), so a two-block bundle there is the most demanding window for a
+/// gate that must carry every stage's own public tables.
+#[test]
+#[ignore = "captures a trained TinyLlama run; set HL_PB_CAPTURE_DIR (outside the repo) and HL_RUN_CAPTURE_PUBLIC_TABLES"]
+fn capture_a_tinyllama_trained_run() {
+    let dense = capture_dense_from_env();
+    let dir = capture_dir_from_env();
+    let l = capture_blocks_from_env(2);
+    let first: u32 = match std::env::var("HL_PB_FIRST_LAYER") {
+        Ok(v) => v.parse().unwrap_or_else(|_| panic!("HL_PB_FIRST_LAYER={v:?} is not a number")),
+        Err(_) => 7,
+    };
+    let export = match std::env::var("HL_PB_EXPORT") {
+        Ok(v) => PathBuf::from(v),
+        Err(_) => Path::new(env!("CARGO_MANIFEST_DIR")).join("../../../../results/zk60_1b_calibration_20260929/export/pg_rot1_export_T32"),
+    };
+    let seq = std::env::var("HL_PB_SEQ").unwrap_or_else(|_| "ho00".into());
+    let public_tables = match std::env::var("HL_RUN_CAPTURE_PUBLIC_TABLES").as_deref() {
+        Ok("1") => true,
+        Ok("0") => false,
+        _ => panic!("HL_RUN_CAPTURE_PUBLIC_TABLES is not set to 1 or 0; this test will not pick for you"),
+    };
+    let layers: Vec<u32> = (first..first + l as u32).collect();
+    let opts = run_capture::CaptureOpts { arrays: true, public_tables };
+    let t0 = std::time::Instant::now();
+    let (segs, bundle, binding, facts) = prove_and_capture_trained(&export, &seq, &layers, dense, opts);
+    let capture_s = t0.elapsed().as_secs_f64();
+    let tag = format!("TinyLlama-trained L={l} layers {}..{} {}", layers[0], layers[l - 1] + 1, if dense { "dense" } else { "zero" });
+    eprintln!(
+        "CAPTURE {tag}: witness={}, public tables={}, parity words {}, prove+verify+record {capture_s:.2} s, high-water mark {:.2} GiB",
+        if dense { "the export's hidden input (generic, parity bit-exact)" } else { "all-zero (degenerate)" },
+        if public_tables { "values" } else { "length + digest only" },
+        facts.parity_words,
+        run::peak_rss_mib() / 1024.0
+    );
+    let (distinct, stored, deduped, inline, blob) = bundle.arrays.stats();
+    eprintln!("CAPTURE {tag}: run.json {} B, stage files {:?} B; arrays.bin {blob} B over {distinct} distinct arrays, {stored} references ({deduped} deduplicated), {inline} inline", bundle.run_json.len(), bundle.stages.iter().map(|s| s.len()).collect::<Vec<_>>());
+    eprintln!("CAPTURE {tag}: segments {} B (pinned by digest)", segs.iter().map(|s| s.len()).sum::<usize>());
+    let note = format!(
+        "Bundle: one honest {l}-block private run of TRAINED TinyLlama-1.1B-Chat blocks at T = 32,\nbound to its trained-model statement (run profile\n`hashline-zk-mr1/private-run-tinyllama-1.1b-t32-trained-statement/1`, block profile\nthe trained TinyLlama T32 profile), under the D19 separating hash tag.\n\nExport: variant `{}` (calibration `{}`), layers {:?}, per-block table keys\nexp e_s {:?} and SiLU members {:?}; trained-model statement identity\n{}.\n\nHidden input: {}.\n\nWritten by the PRIVACY GATE lane (2026-10-17) from `ops/zkp-mvp/trained-1b-gate/`\n(the frozen review copy `trained-1b-review-r2` plus test-only capture code).\nA capture is the INPUT to the run privacy gate and is NOT a privacy result.",
+        facts.variant,
+        facts.calibration,
+        facts.layers,
+        facts.exp_e_s,
+        facts.silu,
+        facts.statement_identity,
+        if dense {
+            format!("the export's own held-out sequence `{seq}` entering layer {} (the real integer hidden state), and the native output was checked bit for bit against the export's reference output at every layer ({} words). THE GENERIC WITNESS", layers[0], facts.parity_words)
+        } else {
+            "the ALL-ZERO hidden plane on the same trained public blocks - the fixed input the privacy case is stated at, and the named DEGENERATE partner of the dense run".to_string()
+        }
+    );
+    let command = "HL_PB_CAPTURE_DIR=<dir> HL_PB_INPUT=<dense|zero> HL_PB_CAPTURE_BLOCKS=<L> HL_PB_FIRST_LAYER=<k> HL_PB_SEQ=<id> HL_RUN_CAPTURE_PUBLIC_TABLES=1 HL_TEST_SOURCE_COMMIT=<label> cargo test --release --lib private_block::run_capture_tests::capture_a_tinyllama_trained_run -- --ignored --nocapture";
+    run_capture::write_bundle(&dir, &bundle, &segs, &note, command).unwrap_or_else(|e| panic!("{tag}: {e}"));
+    let total = check_bundle_on_disk(&dir, l, binding, &segs, true);
+    assert!(total < 2_000_000_000, "the trained bundle is {total} B, past the 2 GB runaway ceiling");
