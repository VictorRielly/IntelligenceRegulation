+def coverage(ranges, size):
+    """the gaps and overruns of a set of byte ranges against [0, size)"""
+    gaps, end = [], 0
+    for off, n in sorted(ranges):
+        if off > end:
+            gaps.append([end, off])
+        end = max(end, off + n)
+    if end < size:
+        gaps.append([end, size])
+    return gaps, max(0, end - size)
+
