+// the CLI's own verification function, `run::verify_run_from_dir_hashed_with`,
+// the gate's recorder attached, after rebuilding the run statement exactly as
+// the CLI's `stack_verify_inner` does (R7 `trained_block.rs:2707-2768`). The
+// pieces of that function that are private to `trained_block` (a sibling
+// module) are re-stated here from its `pub(crate)` constructors, each next to
+// the CLI line it mirrors; R7's bodies of `stack_records`, `stack_context`,
+// `BlockCache` / `CacheBlocks`, `parse_layers`, `refuse_prover_private_entries`
+// and `label_of` are byte-identical to R6's. Nothing here changes a prover or
+// verifier relation, and nothing here is a privacy result.
+
+/// **A mirror of the stack CLI's private `CacheBlocks` / `BlockCache`** (R7
+/// `trained_block.rs:1763-1858`): ONE block resident, reloaded from the
+/// export with `reload_block` (no RoPE from the export: the CLI default) and
+/// refused unless its digest is the statement's; the shape compared on the
+/// block GEOMETRY only (`fit_the_shape`); CS-6 on the digest list
+/// (`are_the_statements`). Public data only.
+struct CliBlocks<'a> {
+    ex: &'a super::trained_block::TrainedExport,
+    sh: &'a Shape,
+    c: &'a super::trained_block::Constants,
+    layers: Vec<u32>,
+    digests: Vec<Digest>,
+    cur: Option<(usize, std::sync::Arc<BlockPublic>)>,
+    loads: usize,
+}
+
+impl run::BlockSource for CliBlocks<'_> {
+    // = `BlockCache::get` + `CacheBlocks::block`
+    fn block(&mut self, k: usize) -> Result<run::BlockRef<'_>, String> {
+        if let Some((j, a)) = &self.cur {
+            if *j == k {
+                return Ok(run::BlockRef::Shared(a.clone()));
+            }
+        }
+        if k >= self.layers.len() {
+            return Err(format!("trained stack: no block {k} in a {}-block run", self.layers.len()));
+        }
+        // drop the previous block BEFORE the next one is read
+        self.cur = None;
+        let blk = self.ex.reload_block(self.sh, self.c, self.layers[k], false)?;
+        if blk.digest() != self.digests[k] {
+            return Err(format!("trained stack: layer {}'s reloaded public statement is not the one the run statement binds", self.layers[k]));
+        }
+        let a = std::sync::Arc::new(blk);
+        self.cur = Some((k, a.clone()));
+        self.loads += 1;
+        Ok(run::BlockRef::Shared(a))
+    }
+    fn count(&self) -> usize {
+        self.layers.len()
+    }
+    // = `CacheBlocks::fit_the_shape` (the block GEOMETRY, not the whole shape)
+    fn fit_the_shape(&mut self, sh: &Shape) -> Result<(), String> {
+        let geometry = |s: &Shape| (s.profile, s.tokens, s.width, s.hidden, s.q_heads, s.head_dim, s.kv_heads, s.t_pad, s.d_pad, s.h_pad, s.f_pad);
+        if geometry(self.sh) != geometry(sh) {
+            return Err(format!("private run: the block cache was built for the block geometry of {:?}, the run's shape is {:?}", self.sh.name, sh.name));
+        }
+        Ok(())
+    }
+    // = `CacheBlocks::are_the_statements` (ruling CS-6)
+    fn are_the_statements(&mut self, st: &RunStatement) -> Result<(), String> {
+        let want = st.block_digests();
+        if self.digests.len() != want.len() {
+            return Err(format!("private run: ruling CS-6 — the run statement holds {} block digests and {} blocks were handed", want.len(), self.digests.len()));
+        }
+        for (k, (got, w)) in self.digests.iter().zip(want).enumerate() {
+            run::digest_is_the_statements(k, got, w)?;
+        }
+        Ok(())
+    }
+}
+
+/// = the CLI's private `stack_context` (R7 `trained_block.rs:1944`), C-R1's
+/// 40-byte refusal included. Public.
+fn cli_stack_context(variant: &str, layers: &[u32], label: &str) -> Digest {
+    let mut b = Vec::new();
+    for s in ["hashline/zk60-trained-stack-context/1", variant, label] {
+        b.extend_from_slice(&(s.len() as u64).to_le_bytes());
+        b.extend_from_slice(s.as_bytes());
+    }
+    for l in layers {
+        b.extend_from_slice(&u64::from(*l).to_le_bytes());
+    }
+    assert_ne!(b.len(), 40, "context: condition C-R1 — a 40-byte input to the unkeyed hash is refused");
+    *blake3::hash(&b).as_bytes()
+}
