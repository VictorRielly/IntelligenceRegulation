+/// a small regular file read whole, refused above `max` or when it is not a
+/// regular file (a link is not followed). Public files of the run directory.
+fn read_small_regular(p: &Path, max: u64) -> Vec<u8> {
+    let m = std::fs::symlink_metadata(p).unwrap_or_else(|e| panic!("{}: {e}", p.display()));
+    assert!(m.file_type().is_file(), "{} is not a regular file", p.display());
+    assert!(m.len() <= max, "{} is {} B, above {max} B", p.display(), m.len());
+    std::fs::read(p).unwrap_or_else(|e| panic!("{}: {e}", p.display()))
+}
