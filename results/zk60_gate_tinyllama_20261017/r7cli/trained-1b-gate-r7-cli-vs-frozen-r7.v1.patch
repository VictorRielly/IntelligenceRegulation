+/// the `statement_written_by` text of the CLI's FRESH-PROCESS verifier
+/// (R7 `trained_block.rs:2163`, `StatementWriter::FreshVerify`, private)
+const CLI_FRESH_VERIFY_WRITER: &str = "stack-verify, after its fresh-process verification of the run directory, from its own data and the hashes of the bytes it verified";
+
+/// **PRIVACY GATE LANE, P-18: CAPTURE THE PRODUCTION CLI'S RUN DIRECTORY.**
+///
+/// | variable | what |
+/// |---|---|
+/// | `HL_PB_EXPORT` | the VERIFIER's copy of the export (no `seq_*`; refused otherwise, as the CLI's P-5) |
+/// | `HL_PB_ARTIFACT` | the CLI's run directory, after `stack-verify` published `statement/` |
+/// | `HL_PB_LAYERS` | `A..B`, B exclusive, as the CLI's `--layers` |
+/// | `HL_PB_LABEL` | the context label (C-R4 allow-list: `zk60-trained-stack`) |
+/// | `HL_PB_CAPTURE_DIR` | where the bundle goes: absolute, outside the repository |
+/// | `HL_PB_SEQ` | for the note only: the held-out sequence the prover was given (the verifier never reads it) |
+/// | `HL_PB_CLI_SHA256` | for the note only: the sha256 of the CLI binary that proved and verified |
+/// | `HL_RUN_CAPTURE_PUBLIC_TABLES` | `1` carries the public tables' values (**required**) |
+/// | `HL_TEST_SOURCE_COMMIT` | the label the bundle records |
+#[test]
+#[ignore = "captures a production-CLI run directory; set HL_PB_EXPORT, HL_PB_ARTIFACT, HL_PB_LAYERS, HL_PB_LABEL, HL_PB_CAPTURE_DIR, HL_PB_SEQ, HL_PB_CLI_SHA256, HL_RUN_CAPTURE_PUBLIC_TABLES"]
+fn capture_a_cli_run_directory() {
+    use super::trained_block::{hex, parse_json, TrainedExport, J, STACK_LABELS};
+    let var = |k: &str| std::env::var(k).unwrap_or_else(|_| panic!("{k} is not set; this test will not choose it for you"));
+    let dir = capture_dir_from_env();
+    let export = PathBuf::from(var("HL_PB_EXPORT"));
+    let art = PathBuf::from(var("HL_PB_ARTIFACT"));
+    let spec = var("HL_PB_LAYERS");
+    let label = var("HL_PB_LABEL");
+    let seq_note = var("HL_PB_SEQ");
+    let cli_sha = var("HL_PB_CLI_SHA256");
+    let public_tables = match std::env::var("HL_RUN_CAPTURE_PUBLIC_TABLES").as_deref() {
+        Ok("1") => true,
+        Ok("0") => false,
+        _ => panic!("HL_RUN_CAPTURE_PUBLIC_TABLES is not set to 1 or 0; this test will not pick for you"),
+    };
+    let t0 = std::time::Instant::now();
+    // = `label_of(f, &STACK_LABELS)` (C-R4)
+    assert!(STACK_LABELS.contains(&label.as_str()), "--label: ruling C-R4 — this build admits {STACK_LABELS:?}, not {label:?}");
+    // = `refuse_prover_private_entries(&export)` (P-5)
+    for e in std::fs::read_dir(&export).unwrap_or_else(|e| panic!("{}: {e}", export.display())) {
+        let name = e.unwrap_or_else(|e| panic!("{}: {e}", export.display())).file_name().to_string_lossy().to_string();
+        assert!(!name.starts_with("seq_"), "privacy review P-5: the export directory {} holds the prover-private entry {name:?}; a verifier's copy holds the public files only", export.display());
+    }
+    // = `TrainedExport::load` + `parse_layers`
+    let ex = TrainedExport::load(&export).unwrap_or_else(|e| panic!("the export {}: {e}", export.display()));
+    let (a, b) = spec.split_once("..").expect("HL_PB_LAYERS is A..B (B exclusive)");
+    let (a, b): (u32, u32) = (a.parse().expect("HL_PB_LAYERS: A is not an integer"), b.parse().expect("HL_PB_LAYERS: B is not an integer"));
+    assert!(a < b, "HL_PB_LAYERS: an empty range");
+    let layers: Vec<u32> = (a..b).collect();
+    for m in &layers {
+        assert!(ex.layers.contains(m), "HL_PB_LAYERS: layer {m} is not in the export");
+    }
+    let l = layers.len();
+    // = `stack_records(&ex, &layers, false)`: the same loads and checks, in
+    //   layer order (the CLI loads two at a time in parallel; same results)
+    let c = ex.run_constants(&layers).expect("the run-level constants");
+    let sh = ex.shape_for(&c).expect("the trained shape (through the door)");
+    assert!(sh.trained_calibration, "the export did not build a trained-calibration shape");
+    let (mut digests, mut records, mut silu, mut exp_e_s) = (Vec::with_capacity(l), Vec::with_capacity(l), Vec::new(), Vec::new());
+    for &m in &layers {
+        let t = ex.load_layer(&sh, &c, m, false).unwrap_or_else(|e| panic!("layer {m}: {e}"));
+        digests.push(t.record.block_digest);
+        silu.push(t.record.silu_member);
+        exp_e_s.push(t.record.exp_e_s);
+        records.push(t.record);
+        // the block itself is dropped here: one resident at a time
+    }
+    let st = ex.statement_of_records(&sh, &c, records).expect("the trained-model statement");
+    let identity = hex(&st.identity());
+    // = `stack_context(&ex.variant, &layers, label)`
+    let ctx = cli_stack_context(&ex.variant, &layers, &label);
+    // = R7's `clear_stale_writing_dirs(&art)` (N-r6-b), as a refusal that
+    //   mutates nothing: this test never removes anything from the run
+    for e in std::fs::read_dir(&art).unwrap_or_else(|e| panic!("{}: {e}", art.display())) {
+        let name = e.unwrap_or_else(|e| panic!("{}: {e}", art.display())).file_name().to_string_lossy().to_string();
+        assert!(!name.starts_with(&format!("{}.writing-", super::run_sink::STATEMENT_DIR)), "{}: a half-written statement directory {name:?} is in the run; this test does not clear it", art.display());
+    }
+    // the statement directory: the one the CLI's FRESH-PROCESS verifier wrote
+    // (the prover's unverified directory must be gone: `stack-verify` promoted it)
+    let sdir = art.join(super::run_sink::STATEMENT_DIR);
+    let unverified = art.with_file_name(format!("{}.unverified-statement", art.file_name().expect("the run directory has a name").to_string_lossy()));
+    assert!(std::fs::symlink_metadata(&unverified).is_err(), "{} still exists: `stack-verify` has not published this run", unverified.display());
+    let sm = std::fs::symlink_metadata(&sdir).unwrap_or_else(|e| panic!("{}: {e} (run the CLI's stack-verify first)", sdir.display()));
+    assert!(sm.is_dir() && !sm.file_type().is_symlink(), "{} is not a real directory", sdir.display());
+    let mut names: Vec<String> = std::fs::read_dir(&sdir).expect("the statement directory").map(|e| e.expect("an entry").file_name().to_string_lossy().to_string()).collect();
+    names.sort();
+    assert_eq!(names, ["expected.bin", "segments.json", "statement.json"], "{} does not hold exactly the verifier's three files", sdir.display());
+    let stmt = parse_json(&read_small_regular(&sdir.join("statement.json"), 4 << 20)).expect("statement.json parses (the CLI's strict parser)");
+    let field = |k: &str| -> String { stmt.get(k).and_then(J::str).unwrap_or_else(|e| panic!("statement.json: {k}: {e}")).to_string() };
+    assert_eq!(field("schema"), "zk60-trained-stack-run/2", "statement.json schema");
+    assert_eq!(field("statement_written_by"), CLI_FRESH_VERIFY_WRITER, "statement.json was not written by the CLI's fresh-process verifier");
+    assert_eq!(field("trained_statement_identity"), identity, "the CLI's published statement identity is not the one rebuilt here from the verifier's export");
+    assert_eq!(field("context_label"), label, "statement.json context label");
+    assert_eq!(field("context"), hex(&ctx), "statement.json context");
+    // = the CLI's policy read: canonical, carrying this run's context
+    let expected_bytes = read_small_regular(&sdir.join("expected.bin"), 4096);
+    assert_eq!(field("expected_io"), hex(&expected_bytes), "statement.json expected_io is not expected.bin");
+    let expected = super::ExpectedIo::from_bytes_at(&sh, &expected_bytes).expect("expected.bin decodes at the run's shape");
+    assert_eq!(expected.to_bytes(), expected_bytes, "expected.bin is not the canonical encoding of its policy");
+    assert_eq!(&expected_bytes[8..40], &ctx[..], "the artifact's endpoint policy carries another context");
+    // = `RunStatement::new_bound_from_digests(...)`, the CLI's own call
+    let rs = ex.geometry.run_shape(&sh, l).expect("the trained run shape");
+    let rst = RunStatement::new_bound_from_digests(rs, ctx, expected.clone(), digests.clone(), &vec![(0, 0); l], &st).expect("the bound run statement");
+    let header = rst.capture_header().expect("the capture header");
+    assert_eq!(header.calibration, st.identity(), "the run header's calibration word is not the trained statement identity");
+    let binding = rst.binding().expect("the run binding");
+    let load_s = t0.elapsed().as_secs_f64();
+    // THE CLI'S VERIFICATION FUNCTION on THE CLI'S RUN DIRECTORY, recorder attached
+    let opts = run_capture::CaptureOpts { arrays: true, public_tables };
+    let t1 = std::time::Instant::now();
+    let guard = run_capture::Recorder::attach();
+    run_capture::begin_run_with(header, binding, opts);
+    let mut blocks = CliBlocks { ex: &ex, sh: &sh, c: &c, layers: layers.clone(), digests: digests.clone(), cur: None, loads: 0 };
+    let seen = run::verify_run_from_dir_hashed_with(&rst, &mut blocks, &art).unwrap_or_else(|e| panic!("the CLI's run directory did not verify: {e}"));
+    let bundle = run_capture::take().expect("a bundle for an accepted run");
+    drop(guard);
+    let verify_s = t1.elapsed().as_secs_f64();
+    let loads = blocks.loads;
+    drop(blocks);
+    // the bytes verified here are the bytes the CLI's fresh-process verifier
+    // verified: `segments.json` (its hashes of EXACTLY those bytes), entry for entry
+    let sj = parse_json(&read_small_regular(&sdir.join("segments.json"), 4 << 20)).expect("segments.json parses");
+    let entries = sj.arr().expect("segments.json is a list");
+    assert_eq!(entries.len(), l, "segments.json does not list {l} segments");
+    for (k, (e, (n, h))) in entries.iter().zip(&seen).enumerate() {
+        assert_eq!(e.get("file").and_then(J::str).expect("file"), super::run_sink::segment_file_name(k), "segments.json entry {k}: file");
+        assert_eq!(e.get("bytes").and_then(J::i64).expect("bytes"), *n as i64, "segments.json entry {k}: the CLI's verifier verified another length");
+        assert_eq!(e.get("sha256").and_then(J::str).expect("sha256"), h.as_str(), "segments.json entry {k}: the CLI's verifier verified other bytes");
+    }
+    // re-read through the run verifier's bounded reader; they must be the verified bytes
+    let paths = super::run_sink::segment_paths(&art, l).expect("the run directory holds exactly the run's segments");
+    let segs: Vec<Vec<u8>> = paths.iter().enumerate().map(|(k, p)| run::read_segment_bounded(&rst, k, p).unwrap_or_else(|e| panic!("segment {k}: {e}"))).collect();
+    for (k, (s, (n, h))) in segs.iter().zip(&seen).enumerate() {
+        assert_eq!(s.len() as u64, *n, "segment {k} changed length after its verification");
+        assert_eq!(&super::run_sink::digest_hex(s), h, "segment {k} changed after its verification");
+    }
+    let tag = format!("TinyLlama-trained CLI run L={l} layers {}..{}", layers[0], layers[l - 1] + 1);
+    eprintln!("CAPTURE {tag}: trained statement identity {identity} (public; = the CLI's published statement.json)");
+    eprintln!(
+        "CAPTURE {tag}: rebuilt the statement in {load_s:.2} s; verify_run_from_dir_hashed_with + record {verify_s:.2} s over {loads} block loads; segments {} B, = statement/segments.json entry for entry; high-water mark {:.2} GiB",
+        seen.iter().map(|(n, _)| *n).sum::<u64>(),
+        run::peak_rss_mib() / 1024.0
+    );
+    let (distinct, stored, deduped, inline, blob) = bundle.arrays.stats();
+    eprintln!("CAPTURE {tag}: run.json {} B, stage files {:?} B; arrays.bin {blob} B over {distinct} distinct arrays, {stored} references ({deduped} deduplicated), {inline} inline", bundle.run_json.len(), bundle.stages.iter().map(|s| s.len()).collect::<Vec<_>>());
+    let note = format!(
+        "Bundle: one honest {l}-block private run of TRAINED TinyLlama-1.1B-Chat blocks at T = 32,\nbound to its trained-model statement, under the D19 separating hash tag, whose\nRECEIPT BYTES WERE WRITTEN BY THE PRODUCTION CLI (`zk60_trained_block stack-prove`,\nthe native R7 release binary, sha256 {cli_sha}), not by the test harness\n(privacy review P-18).\n\nVerification: the CLI's own fresh-process `stack-verify` (same binary) verified the run\ndirectory and published its `statement/` (writer: the fresh-process verifier); this\ncapture then verified THE SAME DIRECTORY with the CLI's verification function\n`run::verify_run_from_dir_hashed_with`, the statement rebuilt as the CLI's\n`stack_verify_inner` does (block source: a test-local mirror of the CLI's private\n`CacheBlocks`), with the gate's recorder attached. The bytes it verified equal the\nCLI verifier's `statement/segments.json` entry for entry.\n\nExport: variant `{}` (calibration `{}`), layers {:?}, context label `{label}`,\nper-block table keys exp e_s {:?} and SiLU members {:?}; trained-model statement\nidentity {identity}.\n\nHidden input: the export's held-out sequence `{seq_note}` entering layer {}, handed to the\nprover through `--seq-dir` (P-5); the CLI's sealing pass checked the native output\nbit for bit against the export's reference output at every layer before the run\nheader (ruling H-1). THE GENERIC WITNESS. The verifier never read it.\n\nWritten by the PRIVACY GATE lane (P-18 sub-lane, 2026-10-19) from\n`ops/zkp-mvp/trained-1b-gate-r7-cli/` (the frozen native R7 tree plus test-only capture\ncode). A capture is the INPUT to the run privacy gate and is NOT a privacy result.",
+        ex.variant,
+        sh.norm_calibration().describe(),
+        layers,
+        exp_e_s,
+        silu,
+        layers[0]
+    );
+    let command = "zk60_trained_block stack-prove --export <export> --seq-dir <prover-private seq dir> --out <run> --layers A..B --label zk60-trained-stack; zk60_trained_block stack-verify --export <verifier copy> --artifact <run> --expect-statement <identity> --layers A..B --label zk60-trained-stack; HL_PB_EXPORT=<verifier copy> HL_PB_ARTIFACT=<run> HL_PB_LAYERS=A..B HL_PB_LABEL=zk60-trained-stack HL_PB_CAPTURE_DIR=<dir> HL_PB_SEQ=<id> HL_PB_CLI_SHA256=<sha> HL_RUN_CAPTURE_PUBLIC_TABLES=1 HL_TEST_SOURCE_COMMIT=<label> cargo test --release --lib private_block::run_capture_tests::capture_a_cli_run_directory -- --ignored --nocapture";
+    run_capture::write_bundle(&dir, &bundle, &segs, &note, command).unwrap_or_else(|e| panic!("{tag}: {e}"));
+    let total = check_bundle_on_disk(&dir, l, binding, &segs, true);
+    assert!(total < 2_000_000_000, "the CLI-run bundle is {total} B, past the 2 GB runaway ceiling");
+    eprintln!("CAPTURE {tag} RESULT: {total} B ({:.1} MB) at {}, self-consistent, every key on the allow-list — a CAPTURE of the production CLI's receipt, not a privacy result", total as f64 / 1e6, dir.display());
+}
