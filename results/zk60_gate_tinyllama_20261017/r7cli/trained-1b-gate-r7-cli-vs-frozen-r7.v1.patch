+/// The capture's public context word: the same length-prefixed recipe as the
+/// stack CLI's `stack_context`, under this lane's own label, so a capture run
+/// is never mistaken for a stack-CLI artifact. Public.
+fn trained_capture_context(variant: &str, layers: &[u32]) -> Digest {
+    let mut b = Vec::new();
+    for s in ["hashline/zk60-trained-stack-context/1", variant, "zk60-privacy-gate-capture"] {
+        b.extend_from_slice(&(s.len() as u64).to_le_bytes());
+        b.extend_from_slice(s.as_bytes());
+    }
+    for l in layers {
+        b.extend_from_slice(&u64::from(*l).to_le_bytes());
+    }
+    *blake3::hash(&b).as_bytes()
+}
