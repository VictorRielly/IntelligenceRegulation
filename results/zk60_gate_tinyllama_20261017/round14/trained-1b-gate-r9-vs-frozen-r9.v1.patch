+/// Prove a bound DD run over `blocks` with the model statement `model`, then
+/// VERIFY it with the recorder attached; returns the segments, the bundle and
+/// the binding.
+fn prove_and_capture_bound(sh: &Shape, blocks: &[BlockPublic], x0: Vec<i16>, model: &super::trained_statement::TrainedModelStatement, rs: RunShape, ctx: Digest, opts: run_capture::CaptureOpts) -> (Vec<Vec<u8>>, Bundle, Digest, Vec<Vec<i16>>) {
+    let l = blocks.len();
+    let mut chain = DdChain::build(sh, blocks, x0);
+    let outputs: Vec<Vec<i16>> = (0..l).map(|k| chain.output_words(k)).collect();
+    let spec = IoSpec::new_shaped(sh, ctx, 0, 0).expect("the run's endpoint spec");
+    let (expected, owners) = prepare_endpoints(spec, &chain.planes[0], &chain.planes[l]).expect("the run's external endpoint owners");
+    let st = RunStatement::new_bound(rs, ctx, expected, blocks, &vec![(0, 0); l], model).expect("the bound DD run statement");
+    let segs = prove_to_vec(&st, blocks, &mut chain, owners);
+    drop(chain);
+    let binding = st.binding().expect("the run binding");
+    let guard = run_capture::Recorder::attach();
+    run_capture::begin_run_with(st.capture_header().expect("the capture header"), binding, opts);
+    run::verify_run(&st, blocks, &segs).expect("the honest DD run verifies");
+    let bundle = run_capture::take().expect("a bundle for an accepted run");
+    drop(guard);
+    (segs, bundle, binding, outputs)
+}
