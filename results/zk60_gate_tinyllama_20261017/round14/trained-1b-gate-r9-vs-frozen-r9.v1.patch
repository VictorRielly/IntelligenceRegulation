+/// `run.json`'s declared `n_slots`
+fn declared_n_slots(run: &[u8]) -> usize {
+    let key = b"\"n_slots\":";
+    let i = run.windows(key.len()).position(|w| w == key).expect("run.json declares n_slots") + key.len();
+    let digits: Vec<u8> = run[i..].iter().take_while(|b| b.is_ascii_digit()).copied().collect();
+    String::from_utf8(digits).expect("ascii").parse().expect("a number")
+}
