+/// One honest chain over DISTINCT public blocks (each with ITS tables): the
+/// hidden inputs and the `l + 1` padded planes the run's IO commitments carry.
+/// Prover side only; none of it reaches a bundle.
+struct DdChain<'a> {
+    sh: Shape,
+    blocks: &'a [BlockPublic],
+    inputs: Vec<Vec<i16>>,
+    planes: Vec<Vec<i16>>,
+}
+
+impl<'a> DdChain<'a> {
+    fn build(sh: &Shape, blocks: &'a [BlockPublic], x0: Vec<i16>) -> DdChain<'a> {
+        let ids = Ids::new(sh).expect("the DD shape has a plane map");
+        let mut inputs = Vec::with_capacity(blocks.len());
+        let mut planes = Vec::with_capacity(blocks.len() + 1);
+        let mut x = x0;
+        for (k, b) in blocks.iter().enumerate() {
+            let w = witness::build_shaped(sh, b.attention(), b.feed_forward(), &x).unwrap_or_else(|e| panic!("block {k}: the honest DD witness: {e}"));
+            if k == 0 {
+                planes.push(padded(&w, ids.at(A_X)));
+            }
+            planes.push(padded(&w, ids.at(A_X2)));
+            inputs.push(x);
+            x = true_input(sh, &padded(&w, ids.at(A_X2)));
+        }
+        DdChain { sh: sh.clone(), blocks, inputs, planes }
+    }
+    fn output_words(&self, k: usize) -> Vec<i16> {
+        true_input(&self.sh, &self.planes[k + 1])
+    }
+}
+
+impl RunWitnessSource for DdChain<'_> {
+    fn witness(&mut self, k: usize) -> Result<Witness, String> {
+        witness::build_shaped(&self.sh, self.blocks[k].attention(), self.blocks[k].feed_forward(), &self.inputs[k])
+    }
+    fn boundary_plane(&mut self, k: usize) -> Result<Vec<i16>, String> {
+        Ok(self.planes[k + 1].clone())
+    }
+}
