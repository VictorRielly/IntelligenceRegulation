+        assert_eq!(idx.slots[SC_DD], want23, "{}: slot 23's push order", sh.name);
+        assert_eq!(ids.mdd() - ids.pdict() + 1, 2 + sh.limbs_p() + 2 * sh.limbs_sigma_s(), "{}: the dictionary's A block", sh.name);
+        let mut want_s: Vec<Ref> = (ids.at(A_S8)..=ids.at(A_P)).map(Ref::A).collect();
+        want_s.extend([Ref::A(ids.at(A_MX)), Ref::A(ids.at(A_SUM))]);
+        want_s.extend((0..sh.helpers(Dom::S)).map(|j| Ref::H(hids.helper(Dom::S, j))));
+        want_s.extend([Ref::H(hids.sexp()), Ref::H(hids.stuple())]);
+        assert_eq!(idx.slots[SC_SZC], want_s, "{}: the DD softmax zero-check's push order", sh.name);
+        assert!(idx.a.iter().all(|p| (p.dom == Dom::Dd) == (p.id >= ids.pdict() && p.id <= ids.mdd())), "{}: the Dom::Dd A planes are exactly the dictionary block", sh.name);
+    }
+    for sh in [Shape::rung_g(), Shape::tinyllama_trained(32, &tl, 9).expect("the TinyLlama T32 trained shape")] {
+        let lay = Layout::for_shape(&sh).expect("a non-DD layout");
+        let idx = plane_index::build(&lay).expect("the non-DD plane index");
+        assert_eq!(idx.slots.len(), N_SLOTS, "{}: a non-DD layout keeps 23 push orders", sh.name);
+        assert!(idx.a.iter().all(|p| p.dom != Dom::Dd) && idx.h.iter().all(|p| p.dom != Dom::Dd), "{}: no Dom::Dd plane", sh.name);
+    }
+}
