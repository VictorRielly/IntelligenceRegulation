+def chain(file: str, digest: str) -> list:
+    """the digests from `digest` back along `base` links through this module's readings"""
+    allr = _all_readings()
+    out, cur = [digest], digest
+    for _ in range(10):
+        r = allr.get(file, {}).get(cur)
+        if r is None:
+            break
+        cur = r["base"]
+        out.append(cur)
+        if cur is None:
+            break
+    return out
+
