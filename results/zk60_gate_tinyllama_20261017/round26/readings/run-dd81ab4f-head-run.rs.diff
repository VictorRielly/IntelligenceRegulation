+pub(crate) fn open_nofollow_nonblock(p: &std::path::Path) -> std::io::Result<std::fs::File> {
+    #[cfg(test)]
+    if let Some(f) = BEFORE_OPEN_HOOK.with(|h| h.borrow_mut().take()) {
+        f(p);
+    }
