+/// [ZK60-METAL M8] `HL_FSP_COL_FOLD=0` keeps the per-element field arithmetic
+/// of `fold_cols_i8`, for a same-binary differential measurement.
+fn deferred_cols() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("HL_FSP_COL_FOLD").map(|v| v != "0").unwrap_or(true))
+}
