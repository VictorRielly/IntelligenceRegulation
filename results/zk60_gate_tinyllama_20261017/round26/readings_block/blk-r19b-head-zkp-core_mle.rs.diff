+/// [ZK60-METAL M8] `fold_rows_deferred` for the other axis: each output row's
+/// dot product with `c` is the exact signed integer sum of the u64
+/// coefficients times the signed matrix values, reduced once per output. A
+/// field sum is that integer sum reduced mod p, so the values are unchanged.
+/// The same public bound (`cols` x u64::MAX x max_abs fits an i128) and the
+/// same zero skip as the row fold.
+fn fold_cols_deferred<T, F>(m: &[T], rows: usize, cols: usize, c: &[Fp2], max_abs: i64, value: F) -> Option<Vec<Fp2>>
+where
+    T: Copy + Sync,
+    F: Fn(T) -> i64 + Sync,
+{
+    if cols as u128 > i128::MAX as u128 / (u64::MAX as u128 * max_abs as u128) {
+        return None;
+    }
+    let reduce = |s: i128| {
+        if s == 0 { return Fp::ZERO; }
+        let magnitude = Fp::from_u128(s.unsigned_abs());
+        if s < 0 { Fp::ZERO.sub(magnitude) } else { magnitude }
+    };
+    Some((0..rows).into_par_iter().map(|i| {
+        let row = &m[i * cols..(i + 1) * cols];
+        let (mut s0, mut s1) = (0i128, 0i128);
+        for (&v, cw) in row.iter().zip(c.iter()) {
+            let v = value(v) as i128;
+            if v == 0 { continue; }
+            s0 += cw.c0.0 as i128 * v;
+            s1 += cw.c1.0 as i128 * v;
+        }
+        Fp2::new(reduce(s0), reduce(s1))
+    }).collect())
+}
