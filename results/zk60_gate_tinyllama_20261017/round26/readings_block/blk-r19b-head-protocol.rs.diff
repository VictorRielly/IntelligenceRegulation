+fn tagged_column<'c>(vals: &'c [i64], tag: LkTag, g_u8: Fp2, u8_inv: &'c [Option<Fp2>], tabs: &'c [(u32, Fp2, Vec<Option<Fp2>>)]) -> Result<TaggedColumn<'c>, String> {
