+        ThreadHooks {
+            cheating_prover: CHEATING_PROVER.with(|c| c.get()),
+            dd_moved_multiplicity: DD_MOVED_MULTIPLICITY.with(|c| c.get()),
+            moved_multiplicity: MOVED_MULTIPLICITY.with(|c| c.get()),
