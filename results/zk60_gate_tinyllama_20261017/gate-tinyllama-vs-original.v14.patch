+# ------------------------------------------------------------------ driver
+def gate(directory: str, controls=True, full_preimage=True, export_dir=None) -> dict:
+    """[v14] `export_dir` overrides the export the block-stage terminal check
+    takes from the capture's README (a capture whose README names no export
+    directory, e.g. the CLI path's, whose export is a prover-side VIEW)"""
+    import time
+    t0 = time.time()
+    rec = {"what": "the privacy gate's token items (DESIGN 4.2 G-1..G-7) on ONE token-I/O run capture; "
+                   "NOT a privacy result", "privacy_acceptance": False,
+           "privacy_property_established": False, "timings": {}}
+
+    def tick(name, t):
+        rec["timings"][name] = round(time.time() - t, 1)
+    t = time.time()
+    b = load(directory)
+    rec["bundle"], rec["bundle_dir"], rec["profile"] = b.name, b.dir, b.profile
+    rec["blocks"], rec["stages"] = b.l, len(b.stages)
+    rec["integrity"] = token_integrity(b)
+    tick("load_and_integrity", t)
+    t = time.time()
+    rp = TokenRunReplay(b).run()
+    rec["replay"] = rp.summary()
+    tick("replay", t)
+    t = time.time()
+    from zk60_native_rg_hashlayer import check_hash_layer
+    h = check_hash_layer(b)
+    rec["hash_layer"] = {k: h[k] for k in ("ok", "columns_checked", "columns_authenticated", "bytes_hashed", "findings") if k in h}
+    rec["hash_layer"]["wrong_rules_that_reached_the_root"] = h.get("cross_rule_probe", {}).get("wrong_rules_that_reached_the_root")
+    tick("hash_layer", t)
+    t = time.time()
+    s3, views = token_stage3(b, rp, pad_rank=True)
+    rec["G1_per_commitment"] = s3
+    tick("per_commitment", t)
+    t = time.time()
+    from zk60_native_rg_joint import boundary_reserved_figure
+    rec["G1_G2_boundaries_reserved"] = {nm: boundary_reserved_figure(b, views[f"B{k}"], k)
+                                        for nm, k in (("B_in", 0), ("B_out", b.l))}
+    rec["G2_claim_points"] = g2_claim_points(b)
+    tick("boundaries_and_G2", t)
+    t = time.time()
+    rec["G3_mask_cfs"] = token_mask_cfs(b, rp)
+    tick("G3", t)
+    rec["G4_support_tables"] = g4_support_tables(b)
+    rec["G4_static"] = b.geom.g4()
+    rec["G5_tab_width"] = g5_tab_width(b)
+    t = time.time()
+    rec["G6_endpoints"] = g6_endpoints(s3["per_commitment"], views)
+    tick("G6", t)
+    rec["G7"] = {"in_scope": False, "why": "the D26 two-site input endpoint and its SHIFT / IO-s claims are not built "
+                 "(token_io/run.rs variant_is_built refuses every variant but the public row)"}
+    # [v10] the joint figure over the new shared planes, COMPUTED at word level
+    t = time.time()
+    rec["G1_joint"] = token_joint_figure(b, views)
+    tick("G1_joint", t)
+    # [v10] the terminal identity: the new slots (and NL-1 on them), and the
+    # block stages inside the token run
+    t = time.time()
+    from zk60_native_rg_tokenterminals import check_token_terminals, nl1_token_slots
+    rec["terminals_new_slots"] = check_token_terminals(b, rp)
+    rec["NL1_new_slots"] = nl1_token_slots(b)
+    tick("terminals_new_slots_and_NL1", t)
+    t = time.time()
+    from zk60_native_rg_tokenblocks import token_block_terminals
+    rec["terminals_block_stages"] = token_block_terminals(b, rp, export_dir=export_dir)
+    rec["export_override"] = export_dir
+    tick("terminals_block_stages", t)
+    # [v10] the per-commitment full preimage (zero data) on EVERY commitment,
+    # and one joint assignment for the whole run
+    if full_preimage:
+        t = time.time()
+        from zk60_native_rg_ahpreimage import full_preimages
+        s11 = full_preimages(b, views, names=list(views))
+        rec["full_preimage"] = {k: s11[k] for k in ("ok", "view_entries_compared", "view_entries_differing",
+                                                    "salted_leaves_authenticated", "commitments") if k in s11}
+        tick("full_preimage", t)
+        rec["joint_preimage"] = token_joint_preimage(
+            b, views, s11, rec["G3_mask_cfs"], rec["G1_joint"],
+            {"new_slots": rec["terminals_new_slots"], "block_stages": rec["terminals_block_stages"],
+             "ok": rec["terminals_new_slots"].get("ok") is True and rec["terminals_block_stages"].get("ok") is True})
+    else:
+        rec["full_preimage"] = {"skipped": "not requested", "ok": None}
+        rec["joint_preimage"] = {"skipped": "needs the full preimage", "ok": None}
+    if controls:
+        t = time.time()
+        rec["controls"] = token_controls(b, rp, views)
+        jc = token_joint_controls(b, views)
+        for k, v in jc["controls"].items():
+            rec["controls"]["controls"][k] = v
+        if full_preimage:
+            # [v10] round 7's P-1..P-6 (the preimage arm's own controls) on the
+            # new stages' A and H
+            from zk60_native_rg_ahcontrols import ah_controls
+            for nm, a_k, h_k in (("TC-11_preimage_controls_on_stage_IN", "A-in@0", "H-in@0"),
+                                 ("TC-12_preimage_controls_on_stage_OUT", f"A-out@{b.l + 1}", f"H-out@{b.l + 1}")):
+                ac = ah_controls(b, views, a_name=a_k, h_name=h_k)
+                rec["controls"]["controls"][nm] = {
+                    "fires": ac["ok"], "applicable": ac["controls_applicable"],
+                    "fired": ac["controls_that_fire"], "not_applicable": ac["not_applicable"]}
+        live = {k: v for k, v in rec["controls"]["controls"].items() if v.get("fires") is not None}
+        rec["controls"]["not_fired"] = [k for k, v in live.items() if not v["fires"]]
+        rec["controls"]["all_fire"] = not rec["controls"]["not_fired"]
+        rec["controls"]["ok"] = bool(live) and not rec["controls"]["not_fired"]
+        tick("controls", t)
+    else:
+        rec["controls"] = {"skipped": "controls not requested", "ok": None}
+    parts = ["integrity", "replay", "hash_layer", "G1_per_commitment", "G2_claim_points", "G3_mask_cfs",
+             "G4_support_tables", "G5_tab_width", "G6_endpoints", "G1_joint",
+             "terminals_new_slots", "NL1_new_slots", "terminals_block_stages"]
+    if full_preimage:
+        parts += ["full_preimage", "joint_preimage"]
+    bres = rec["G1_G2_boundaries_reserved"]
+    rec["boundaries_ok"] = all(v["disclosed_on_the_reserved_block_fp"] == 0 and v["full_row_rank"]
+                               and v["determinant_nonzero"] and v["row_rule"] == "data + 2*sites + 2"
+                               for v in bres.values())
+    rec["false_parts"] = [p for p in parts if rec[p].get("ok") is not True] + ([] if rec["boundaries_ok"] else ["boundaries"])
+    rec["ok"] = not rec["false_parts"] and (rec["controls"].get("ok") is True if controls else True)
+    rec["status"] = "PASS" if rec["ok"] and controls else ("PASS-NO-CONTROLS" if rec["ok"] else "NOT-OK")
+    rec["total_seconds"] = round(time.time() - t0, 1)
+    try:
+        import resource
+        rec["peak_rss_mb"] = round(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024)
+    except Exception:  # noqa: BLE001
+        pass
+    import zk60_native_run_gate as G
+    rec["tool_sha256"] = G.tool_hashes()
+    return rec
+
+
+def main(argv=None):
+    import argparse
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--bundle", required=True)
+    ap.add_argument("--evidence", required=True)
+    ap.add_argument("--name", required=True)
+    ap.add_argument("--no-controls", action="store_true")
+    ap.add_argument("--no-full-preimage", action="store_true")
+    ap.add_argument("--export", default=None, help="[v14] override the export the block-stage terminals read")
+    a = ap.parse_args(argv)
+    rec = gate(a.bundle, controls=not a.no_controls, full_preimage=not a.no_full_preimage, export_dir=a.export)
+    os.makedirs(a.evidence, exist_ok=True)
+    path = os.path.join(a.evidence, f"{a.name}.json")
+    with open(path, "w") as fh:
+        json.dump(rec, fh, indent=1, sort_keys=True, default=str)
+    print(f"{a.name}: status {rec['status']}; false parts {rec['false_parts']}; "
+          f"controls not fired {rec['controls'].get('not_fired')}; {rec['total_seconds']} s; record {path}")
+    return 0 if rec["status"] == "PASS" else 1
