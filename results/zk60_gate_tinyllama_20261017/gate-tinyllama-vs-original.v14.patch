+                for i in diff:
+                    d2 = dict(blocks[k].doc)
+                    d2["arguments"] = list(d2["arguments"])
+                    a19 = dict(d2["arguments"][TAB_SLOT])
+                    a19["tables"] = list(a19["tables"])
+                    a19["tables"][i] = blocks[j].doc["arguments"][TAB_SLOT]["tables"][i]
