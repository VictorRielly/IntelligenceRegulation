+        return b.finish(poly, [], ["supp_V e (c1 + c2 iota + c3 delta)", "- u0 (c1 + c2 tok)"], dr)
+    if slot == SO_TAB:                                         # :509-526
+        tau, _ = dr.take(ltab, "tau")
+        _, mu = dr.take(2, "mu", nonzero=True)
+        _, zz = dr.take(1, "zeta", nonzero=True)
+        zeta = zz[0]
