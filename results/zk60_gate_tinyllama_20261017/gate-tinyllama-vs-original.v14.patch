+def _keys(o, out):
+    if isinstance(o, dict):
+        for k, v in o.items():
+            out.append(k)
+            _keys(v, out)
+    elif isinstance(o, list):
+        for v in o:
+            _keys(v, out)
+    return out
+
+
+def _refs(o, out):
+    if isinstance(o, dict):
+        if set(o) == REF_KEYS:
+            out.append((int(o["offset"]), int(o["bytes"])))
+            return out
+        for v in o.values():
+            _refs(v, out)
+    elif isinstance(o, list):
+        for v in o:
+            _refs(v, out)
+    return out
+
