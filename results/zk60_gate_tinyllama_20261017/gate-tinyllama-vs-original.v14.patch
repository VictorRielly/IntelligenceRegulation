+    if slot == SO_IO:                                          # :355-365
+        tau, _ = dr.take(d_bits, "tau")
+        i_eq = b.eq(tau, 0)
+        i_x = b.a_at(A_X, fixed_c([ZERO] * lift) + rho_c(range(d_bits)))
