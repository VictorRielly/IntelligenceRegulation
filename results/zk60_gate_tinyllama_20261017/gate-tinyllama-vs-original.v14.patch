+++ frozen_v14/scripts/zk60_native_rg_tlcontrols.py	2026-10-19 12:28:13.931948725 -0700
@@ -0,0 +1,269 @@
+#!/usr/bin/env python3
+"""[TINYLLAMA PORT, 2026-10-17] Controls on the port's OWN adaptation: the
+per-bundle calibration the terminal identity now reads from
+`run.json["shape"]`.
+
+    python3 zk60_native_rg_tlcontrols.py --bundle <trained bundle> \
+        --evidence <dir> --name tl-controls
+
+A port that READS constants from the bundle could be vacuous -- an identity
+that holds whatever the constants are says nothing about them.  These
+controls show it is not, on the real trained bytes and at the run's real
+challenges:
+
+* **TL-1** the FROZEN calibration on a trained bundle (the trained keys
+  removed from a copy of the shape): exactly the slots whose relations read
+  a constant that DIFFERS between the frozen and the trained calibration must
+  fail -- predicted from the two calibrations alone, never read off the
+  result -- and every other slot must still hold.
+* **TL-2** each of the eleven trained constants moved by one step inside its
+  declared class: exactly the slots that read THAT constant fail.
+* **TL-3** a shape that names trained keys without `trained_calibration:
+  true`, one with the flag but a key missing, and one with the flag false
+  and keys present are each REFUSED by `Calibration` (no silent mixture of a
+  frozen and a trained reading).
+
+Nothing is written to the bundle: each perturbation is a shallow copy of the
+loaded bundle with a modified `run["shape"]`.  NOTHING HERE IS A PRIVACY
+STATEMENT.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+from zk60_native_rg_block import load_bundle  # noqa: E402
+from zk60_native_rg_planes import plane_index_of  # noqa: E402
+from zk60_native_rg_replay import RunReplay  # noqa: E402
+from zk60_native_rg_terminals import (  # noqa: E402
+    FROZEN_CALIBRATION,
+    TRAINED_KEYS,
+    Calibration,
+    check_terminals,
+)
+
+# Which slot's relation (or lookup list) reads which calibration constant,
+# from `argument.rs` / `layout.rs` at the trained digests (the readings in
+# `zk60_native_rg_tinyllama_pins`).  The lookups of a domain enter its host
+# zero-check's helper sum, so a top-limb coefficient is that slot's too.
+READS = {
+    "norm_ceps": {2},            # SC_TZC: dsq + a1 - Ceps (both norms)
+    "norm_tn": {14},             # SC_DZC: 2^tn, 2^(tn+1)
+    "norm_cn_a": {14},           # SC_DZC c0
+    "norm_cn_m": {14},           # SC_DZC c6
+    "sh_ao": {14},               # SC_DZC host_wo; Dom::D lookup RAL 2^(8-sh_ao)
+    "sh_z": {14},                # SC_DZC host_dmm; Dom::D lookup RDL
+    "sh_qkv": {15, 16},          # SC_QZC host1, SC_KVZC host1/2; RQL, RKL, RVL
+    "sh_o": {15},                # SC_QZC host2; Dom::Q lookup RO1 2^(16-sh_o)
+    "sh_s": {17},                # SC_SZC host_s; Dom::S lookup RSL
+    "sh_g": {18},                # SC_FZC host_g; Dom::F lookup RGL
+    "sh_h": {18},                # SC_FZC f0; Dom::F lookup RH1 2^(16-sh_h)
+}
+# a step inside each constant's declared class (`shape.rs`)
+WINDOWS = {
+    "norm_tn": (1, 16), "norm_cn_a": (1, 1 << 20), "norm_cn_m": (1, 1 << 20),
+    "norm_ceps": (1, 1 << 40), "sh_ao": (0, 8), "sh_qkv": (1, 8),
+    "sh_s": (1, 8), "sh_o": (9, 16), "sh_g": (1, 8), "sh_h": (9, 16),
+    "sh_z": (1, 8),
+}
+
+
+def _step(name: str, v: int) -> int:
+    lo, hi = WINDOWS[name]
+    return v + 1 if v + 1 <= hi else v - 1
+
+
+def _with_shape(bundle, shape):
+    b = copy.copy(bundle)
+    b.run = dict(bundle.run)
+    b.run["shape"] = shape
+    return b
+
+
+def _failing_slots(rec) -> set:
+    bad = set()
+    for row in rec["per_stage"]:
+        bad |= set(row["checked"]) - set(row["equal"])
+        bad |= {e["slot"] for e in row["not_checked"]}
+    return bad
+
+
+def _failing_pairs(rec) -> set:
+    """(stage, slot) of every slot that stopped matching"""
+    bad = set()
+    for k, row in enumerate(rec["per_stage"]):
+        bad |= {(k, s) for s in set(row["checked"]) - set(row["equal"])}
+        bad |= {(k, e["slot"]) for e in row["not_checked"]}
+    return bad
+
+
+TAB_SLOT = 19   # SC_TAB: the slot whose arguments carry the captured lookup rows
+
+
+def tl4_table_swaps(bundle, index, replay) -> list:
+    """[v5, review P-20] **TL-4: one layer reads ANOTHER layer's table.**  For
+    the first adjacent stage pair (j, k = j + 1) whose captured lookup tables
+    differ (pg_rot1: layers 7 | 8, where both the exp key and the SiLU member
+    change), stage k's carried table entry (values AND its digest, so the
+    capture's own digest check passes) is replaced by stage j's, one table at
+    a time.  Predicted: stage k's SC_TAB slot, and no slot of any other stage,
+    stops matching.  The entry is restored before the next run."""
+    def caps(st):
+        return {i: t for i, t in enumerate(st.doc["arguments"][TAB_SLOT]["tables"])
+                if "values" in t}
+    pair = None
+    for j in range(bundle.blocks - 1):
+        a, b = caps(bundle.stages[j]), caps(bundle.stages[j + 1])
+        diff = [i for i in a if i in b and a[i].get("sha256") != b[i].get("sha256")]
+        if diff:
+            pair = (j, j + 1, diff)
+            break
+    if pair is None:
+        return [{"control": "TL-4", "skipped": "no adjacent stage pair carries "
+                 "different lookup tables (a one-block run, or equal tables)",
+                 "ok": True, "fires": None}]
+    j, k, diff = pair
+    out = []
+    for i in diff:
+        tabs = bundle.stages[k].doc["arguments"][TAB_SLOT]["tables"]
+        saved = tabs[i]
+        tabs[i] = bundle.stages[j].doc["arguments"][TAB_SLOT]["tables"][i]
+        try:
+            rec = check_terminals(bundle, index, replay=replay)
+        finally:
+            tabs[i] = saved
+        got = _failing_pairs(rec)
+        want = {(k, TAB_SLOT)}
+        c = {"control": f"TL-4/table-{i}", "perturbation": f"stage {k}'s SC_TAB "
+             f"table {i} replaced by stage {j}'s (values and digest)",
+             "predicted_failing": sorted(list(x) for x in want),
+             "failing": sorted(list(x) for x in got), "fires": not rec["ok"],
+             "exactly_as_predicted": got == want}
+        c["ok"] = c["fires"] and c["exactly_as_predicted"]
+        out.append(c)
+    return out
+
+
+def tl_controls(bundle, index=None, replay=None, only=None) -> dict:
+    """`only`: a set of families to run ({"TL-1", "TL-2", "TL-3", "TL-4"}); all
+    by default"""
+    fam = set(only) if only else {"TL-1", "TL-2", "TL-3", "TL-4"}
+    shape = bundle.run["shape"]
+    cal = Calibration(shape)
+    if not cal.trained:
+        return {"skipped": "not a trained-calibration bundle", "ok": False}
+    if index is None:
+        index, why = plane_index_of(bundle)
+        if index is None:
+            return {"skipped": f"no plane index: {why}", "ok": False}
+    if replay is None:
+        replay = RunReplay(bundle).run()
+    out = {"what": __doc__.strip().splitlines()[0], "controls": [], "ok": True}
+
+    honest = check_terminals(bundle, index, replay=replay)
+    out["honest"] = {"ok": honest["ok"], "slot_checks_equal":
+                     honest["slot_checks_equal"],
+                     "slot_checks_expected": honest["slot_checks_expected"]}
+    if not honest["ok"]:
+        out["ok"] = False
+        out["why"] = "the honest identity does not hold; no control is meaningful"
+        return out
+
+    # TL-1: the frozen calibration
+    if "TL-1" in fam:
+        frozen_shape = {k: v for k, v in shape.items()
+                        if k not in TRAINED_KEYS + ("trained_calibration", "d_max")}
+        differs = [k for k in TRAINED_KEYS if FROZEN_CALIBRATION[k] != cal.values[k]]
+        want = set().union(*(READS[k] for k in differs)) if differs else set()
+        rec = check_terminals(_with_shape(bundle, frozen_shape), index, replay=replay)
+        got = _failing_slots(rec)
+        c = {"control": "TL-1", "perturbation": "the frozen calibration "
+             "(trained keys removed)", "constants_that_differ": differs,
+             "predicted_failing_slots": sorted(want), "failing_slots": sorted(got),
+             "fires": not rec["ok"], "exactly_as_predicted": got == want}
+        c["ok"] = c["fires"] and c["exactly_as_predicted"]
+        out["controls"].append(c)
+
+    # TL-2: each constant moved by one step inside its class
+    if "TL-2" in fam:
+        for name in TRAINED_KEYS:
+            moved = dict(shape)
+            moved[name] = _step(name, int(shape[name]))
+            rec = check_terminals(_with_shape(bundle, moved), index, replay=replay)
+            got = _failing_slots(rec)
+            c = {"control": f"TL-2/{name}", "perturbation":
+                 f"{name} {shape[name]} -> {moved[name]}",
+                 "predicted_failing_slots": sorted(READS[name]),
+                 "failing_slots": sorted(got), "fires": not rec["ok"],
+                 "exactly_as_predicted": got == READS[name]}
+            c["ok"] = c["fires"] and c["exactly_as_predicted"]
+            out["controls"].append(c)
+
+    # TL-3: the loader's refusals
+    if "TL-3" in fam:
+        bad_shapes = {
+            "TL-3/keys-without-flag": {k: v for k, v in shape.items()
+                                       if k != "trained_calibration"},
+            "TL-3/flag-without-a-key": {k: v for k, v in shape.items()
+                                        if k != "norm_ceps"},
+            "TL-3/flag-false-with-keys": {**shape, "trained_calibration": False},
+        }
+        for name, sh in bad_shapes.items():
+            try:
+                Calibration(sh)
+                refused, why = False, None
+            except ValueError as exc:
+                refused, why = True, str(exc)
+            out["controls"].append({"control": name, "refused": refused,
+                                    "why": why, "ok": refused})
+    # TL-4 (v5, review P-20): one layer reads another layer's table
+    if "TL-4" in fam:
+        out["controls"] += tl4_table_swaps(bundle, index, replay)
+    live = [c for c in out["controls"] if not c.get("skipped")]
+    out["fired"] = sum(1 for c in live if c["ok"])
+    out["of"] = len(live)
+    out["skipped_by_name"] = [c["control"] for c in out["controls"] if c.get("skipped")]
+    # [v5] over the controls that ran, never over none
+    out["ok"] = bool(live) and all(c["ok"] for c in live)
+    out["privacy_property_established"] = False
+    return out
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--bundle", required=True)
+    ap.add_argument("--evidence", required=True)
+    ap.add_argument("--name", default="tl-controls")
+    ap.add_argument("--only", default="", help="[v5] comma list of families "
+                    "(TL-1,TL-2,TL-3,TL-4); all by default")
+    a = ap.parse_args(argv)
+    b = load_bundle(a.bundle)
+    only = {x.strip() for x in a.only.split(",") if x.strip()} or None
+    rec = tl_controls(b, only=only)
+    rec["families_run"] = sorted(only) if only else ["TL-1", "TL-2", "TL-3", "TL-4"]
+    rec["bundle"] = b.name
+    os.makedirs(a.evidence, exist_ok=True)
+    path = os.path.join(a.evidence, a.name + ".json")
+    with open(path, "w") as fh:
+        json.dump(rec, fh, indent=1, sort_keys=True)
+        fh.write("\n")
+    for c in rec["controls"]:
+        print(f"{c['control']:28s} ok={c['ok']}  "
+              + (f"failing={c.get('failing_slots')} predicted="
+                 f"{c.get('predicted_failing_slots')}" if 'failing_slots' in c
+                 else f"failing={c.get('failing')} predicted={c.get('predicted_failing')}"
+                 if 'failing' in c else f"refused={c.get('refused')} {c.get('skipped') or ''}"))
+    print(f"record: {path}  {rec.get('fired')} of {rec.get('of')} fire  ok={rec['ok']}")
+    return 0 if rec["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff -ruN -x __pycache__ original/zk60_native_rg_tokenblocks.py frozen_v14/scripts/zk60_native_rg_tokenblocks.py
--- original/zk60_native_rg_tokenblocks.py	1969-12-31 16:00:00.000000000 -0800
+++ frozen_v14/scripts/zk60_native_rg_tokenblocks.py	2026-10-19 12:29:13.783282839 -0700
@@ -0,0 +1,1026 @@
+#!/usr/bin/env python3
+"""[GATE, token block terminals adapter, 2026-10-19] The gate's frozen
+BLOCK-STAGE TERMINAL IDENTITY (stage 8, `zk60_native_rg_terminals.
+check_terminals`) run on the L block stages INSIDE a token-I/O run capture
+(schema `hashline-native-capture/6-token-run`), through a shim.  The port is
+not changed; this module only presents each block stage in the form the port
+reads, with the calibration that stage was proved at, and records how.
+
+    python3 zk60_native_rg_tokenblocks.py --bundle <token capture dir> \
+        --evidence <dir> --name <name> [--export <dir>] [--no-controls] \
+        [--control-constant sh_z]
+
+The export is taken from the bundle's README (`export `<dir>` (variant V)`);
+`--export` only overrides it, and a disagreement is a finding.
+
+WHAT THE PORT DEPENDS ON, AND WHAT THE SHIM MAPS  ([MINE], by reading
+`zk60_native_rg_terminals.check_terminals`, `TerminalGate`,
+`zk60_native_rg_planes.PlaneIndex` and `zk60_native_rg_gqa.GroupFactors`):
+
+* the STAGE INDEX only as a key: `docs[st.index]`, `replay.stages[st.index]`
+  and `GroupFactors.point(st.index, slot)`; and `bundle.blocks` as the stage
+  count (`slot_checks_expected = 23 * blocks`).  A token run's block k is
+  token stage k + 1 (READ, `token_io/run.rs:725-808`).  The port is run ONCE
+  PER BLOCK STAGE on a one-stage shim (block k as stage 0, `blocks = 1`, a
+  replay view whose `stages[0]` is the token replay's `stages[k + 1]`),
+  because a block stage's calibration may be its LAYER'S OWN (below) and the
+  port reads one calibration per bundle.  Nothing in `check_terminals` is
+  cross-stage, so this is the same check.  Every record is translated back to
+  TOKEN stage numbers.
+* EXTERNAL ENDPOINTS and BOUNDARY NUMBERING: nothing.  None of the three
+  modules reads `bundle.boundary(...)`, `internal_boundaries` or a
+  `commitment_kind`.  Slots 21 / 22 (`SC_IO_IN` / `SC_IO_OUT`) are
+  `eq * (A_X - IO)`, the same polynomial whether the IO table is an external
+  endpoint or an internal boundary (the port's own `_io` docstring), and
+  `PlaneIndex` only requires the IO private tables' roles to be `Input` /
+  `Output`, which a token block stage's are.  The shim still maps
+  `boundary(j)` to token boundary j + 1 and the IO wiring is checked in token
+  numbering (block k opens boundary k, commits k + 1); the port reads neither.
+* the TRAINED CALIBRATION: `Calibration(run.json["shape"])`.  A token bundle's
+  shape carries NO trained-calibration key (the token tree's `run_capture.rs`
+  lacks the gate's capture patch: READ, `zk60_native_rg_tokenio_r7c_pins`),
+  and `Calibration` then FALLS BACK TO THE FROZEN CONSTANTS without complaint.
+  On a trained run that is the wrong polynomial (control NC-2).  Each stage's
+  shim shape therefore carries `trained_calibration: true`, the eleven
+  constants of THAT stage, and the `norm_wrho` they derive.
+* the SOURCE PINS: `check_source_pins` accepts the token bundle's
+  `argument.rs`, `layout.rs`, `protocol.rs`, `plane_index.rs` and `pad.rs`
+  but NOT its `shape.rs` `8c62519c` (native R8's bytes).  The gate HAS a
+  written reading of exactly that digest (`zk60_native_rg_tokenio_r7c_pins.
+  TOKEN_R7C_READINGS`, read against `7b0c9742`, which the port accepts;
+  `moves_a_block_stage_byte: False`).  The adapter adds that one digest to
+  the port's `PINNED_IF_PRESENT` IN MEMORY, only during its own calls, only
+  when the bundle pins it and the reading's base is accepted, and removes it
+  afterwards.  NC-0 shows the port refuses every slot without it.
+
+THE CALIBRATION OF EACH BLOCK STAGE (READ, token tree `trained_block.rs`
+`run_constants` / `load_layer_mode`, `trained_statement.rs` `OWN_FIELDS`,
+`apply_own`; `token_io/run.rs` `TokenRunStatement::new`, `stage_shape`):
+a stage is proved at its layer's manifest constants.  Keys the export lists
+in `per_layer_constants_differ` (null in `profile_constants`) may differ per
+layer; every other key equals the profile's.  The RUN's calibration (the
+shape the layout description prints) is the profile's, with each per-layer
+field set to the value tuple most of the run's layers carry (ties: the
+smallest, fields in `OWN_FIELDS` order); a layer that differs is proved at
+`with_layer_calibration` of its own values and its stage line says so.
+
+  source  the export (from the README): profile.json `profile_constants`, and
+          the stage's layer `manifest.json` `constants` for the per-layer keys.
+  X0  which trained keys the bundle's own shape carries (none: the known gap).
+  X1  the bundle's `layout_description` calibration and feed-forward lines
+      (block `Layout::describe()`, hashed into the schedule digest) against
+      the RUN calibration, its derived `wrho` / `D_max`, and the port's frozen
+      literals (`F_P`, `SH_ROPE`, `MASK_SCORE`, residual 0, up 0).
+  X2  the token schedule digest RECOMPUTED from run.json's own lines (blake3
+      "hashline/token-io-run-schedule/v1" over the parameter line, the block
+      layout description, stage IN / OUT layouts and the stage lines, each
+      length-framed; READ, `token_io/run.rs` `schedule_digest`) equals
+      `run.json["schedule_digest"]`, which the token replay absorbs to
+      reproduce `run_binding`: the X1 and X6 lines are transcript-bound.
+  X3  the absorbed parameter line's `sh-g{g}-u{u}-h{h}-z{z}`.
+  X4  the shape's `f_e`, `tokens`, `norm_wrho`, `wrho_s` against the RUN
+      calibration's derivation (`D_max = isqrt(ceps + width * 32768^2)`,
+      `wrho = tn + 1 + bits(D_max)`, `wrho_s = clog2(T) + f_e`; READ, token
+      tree `shape.rs:238-278`, :644-646) and their window rules.
+  X5  every stage's and the run's constants inside their classes
+      (`zk60_native_rg_tlcontrols.WINDOWS`).
+  X6  each block stage line's "(the layer's own; the run's is b)" clauses
+      equal exactly the fields where that stage's layer differs from the run
+      calibration (none, when no field is per layer).
+  X7  the export constants the port hard-codes: `f_p`, `sh_rope`, `f_ro`,
+      `sh_u`, `sh_r2`.
+  X8  every export layer's `manifest.json` hashes to profile.json's
+      `manifest_sha256`, its arrays to the manifest's digests, and its
+      constants equal the profile's on every non-per-layer key.
+  X9  (after the identity) the exp and SiLU tables the port RECOVERED from
+      each stage's slot 19 equal its layer's `exp.bin` / `act.bin`
+      (`zk60_native_rg_exportcheck` E4's rule), `exp[0] = 2^f_e`,
+      `act[128] = 0`.
+  X10 (BEFORE the identity, it chooses the layer) each block stage's captured
+      norm gains (slot 14's `gamma_a`, `gamma_m`) equal exactly one export
+      layer's `gamma_a.bin` / `gamma_m.bin`: the stage-to-layer map, from the
+      capture, compared with the README's declared layer range.
+
+NOT reproduced: the absorbed `calibration` word, the only place a token
+bundle binds the export's profile digest (blake3 over the trained-model
+statement identity -- `trained_statement.rs:665-755`, whose encoding includes
+`export-profile-sha256` among some forty fields, per-layer word / table /
+source-tensor digests among them -- and the token profile digest).  No bundle
+or export file carries that statement in a form this module can recompute.
+
+CONTROLS (each perturbs an in-memory copy; no captured byte is touched):
+
+  NC-0  the shape.rs reading NOT added: the port refuses before any slot.
+  NC-1  one calibration constant moved by one inside its class (TL-2's rule,
+        `_step`), in every stage: exactly the slots `READS[name]` names stop
+        matching, in every stage -- predicted from `READS`.
+  NC-2  the port's own fallback (the shape as written -> FROZEN): exactly the
+        union of `READS` over the constants where frozen and the stage's
+        calibration differ, in every stage.
+  NC-3  the X-checks on a run calibration with one constant moved: X1 fires.
+  NC-4  (L >= 2) TL-4's rule: the first adjacent stage pair whose captured
+        lookup tables differ; stage k's carried table (values and digest)
+        replaced by stage j's, one table at a time: exactly stage k's slot 19
+        stops matching.
+
+NOTHING HERE IS A PRIVACY STATEMENT.
+"""
+
+from __future__ import annotations
