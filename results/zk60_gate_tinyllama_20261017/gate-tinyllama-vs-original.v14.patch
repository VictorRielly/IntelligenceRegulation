+def helper_sum(v, lks, h0, alpha, mu):
+    """`helper_sum` (token_io.rs:1134-1150): helper k covers lookups
+    (2k, 2k+1), an odd count leaves the last single."""
+    def den(l):
+        terms, cst = l
+        a = cst
+        for (i, c) in terms:
+            a = a + v[i] * K(c)
+        return alpha - a
+
+    acc = R_ZERO
+    for kk in range((len(lks) + 1) // 2):
+        h = v[h0 + kk]
+        d1 = den(lks[2 * kk])
+        if 2 * kk + 1 < len(lks):
+            d2 = den(lks[2 * kk + 1])
+            rel = h * d1 * d2 - (d1 + d2)
+        else:
+            rel = h * d1 - R_ONE
+        acc = acc + mu[kk] * rel
+    return acc
+
+
+def zeta_fold(v, planes, zeta):
+    """`zeta_fold` (token_io.rs:1153-1161): sum_j zeta^j plane_j"""
+    p = R_ONE
+    acc = R_ZERO
+    for t in planes:
+        acc = acc + p * v[t]
+        p = p * zeta
+    return acc
+
