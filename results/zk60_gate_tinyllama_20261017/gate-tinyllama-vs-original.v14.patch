+
+# ------------------------------------------------------------------ [v10] the computed joint
+def _slot_io_rows(stage, slot_index, a_role_name, io_key_of_opening):
+    """For a block stage's endpoint-equality slot (21 / 22): the A rows and
+    the boundary rows its two claims identify, from the claims' first parts
+    (the same evaluation point and log_size, as `discover_shared_planes`
+    requires).  Returns (a_rows, b_rows) or a finding string."""
+    arg = stage.slots[slot_index]
+    priv = [t for t in arg["tables"] if t["kind"] == "private"]
+    a_tab = next((t for t in priv if t["role"] == a_role_name), None)
+    io_tab = next((t for t in priv if t["role"] != a_role_name), None)
+    if a_tab is None or io_tab is None:
+        return f"stage {stage.index} slot {slot_index}: not an A / IO pair"
+    a_cl = stage.role(a_role_name)["claims"][a_tab["claim"]]
+    op, ci = io_key_of_opening
+    o_cl = op["claims"][ci]
+    ap, ep = a_cl["parts"][0], o_cl["parts"][0]
+    if ap["log_size"] != ep["log_size"] or ap["point"] != ep["point"]:
+        return f"stage {stage.index} slot {slot_index}: the A and IO claims are not the same evaluation"
+    n = 1 << op["params"]["log_cols"]
+    nrows = 1 << max(0, ap["log_size"] - op["params"]["log_cols"])
+    a0, e0 = ap["offset"] // n, ep["offset"] // n
+    return [a0 + i for i in range(nrows)], [e0 + i for i in range(nrows)]
+
+
+def token_joint_figure(bundle, views) -> dict:
+    """**The joint figure over the new shared planes, COMPUTED** (v10).
+
+    THE MODEL.  The frozen joint system (`RunJointSystem`) ranks ROW
+    combinations: each generator (a group's row combination or the
+    proximity combination) is counted as revealing its combined row over
+    every message position, and `disclosed = width * k0 + u`.  Every
+    generator therefore acts identically at every word position, so the
+    system DECOMPOSES BY WORD POSITION: the unknowns at one word position of
+    every commitment, with the generators restricted to them.  An
+    identification of two planes of DIFFERENT row widths (a 2^12-word row of
+    A-in with the 2^8-word row of the input token endpoint; A-out's x row
+    with the second half of B_out's row T-1) is then exact at word level: it
+    links (commitment, row, word) to (commitment, row, word).  This module
+    builds the word-level graph of every identification of the new stages,
+    groups the (commitment, word) nodes into connected components, and
+    ranks each distinct component ONCE with `RunJointSystem` at width 1.
+    The joint figure is the sum over components; the sum of the parts is
+    every commitment ranked alone at each of its word positions.
+
+    THE IDENTIFICATIONS (READ: the slot definitions and the plane tables):
+    * tok (input): A-in's tok row, words 0..T-1, = the input token
+      endpoint's data row, words 0..T-1 (IN-00: E = supp_T tok);
+    * B_in: block 0's A input rows = B_in's data rows (slot 21's zero-check);
+    * B_out: block L-1's A output rows = B_out's data rows (slot 22);
+    * B_out row T-1: A-out's x row, words 0..d_pad-1, = B_out's data row
+      (T-1) d_pad / n at words (T-1) d_pad mod n .. + d_pad (OUT-00);
+    * tok (output): A-out's tok row, word 0, = the output token endpoint's
+      data row, word 0 (OUT-10: E = u0 tok).
+    An identification that reaches a non-data row is a finding (control
+    P-5's failure mode)."""
+    from zk60_native_rg_joint import RunJointSystem, block_from_view
+    L = bundle.l
+    g = bundle.geom
+    st_in, st_out = bundle.stages[0], bundle.stages[-1]
+    spi_in, spi_out = st_in.doc["stage_plane_index"], st_out.doc["stage_plane_index"]
+    def plane_row(spi, name):
+        p = next(x for x in spi["a_planes"] if x["name"] == name)
+        return p["first_row"]
+    findings = []
+    keys = {"A_in": "A-in@0", "E_in": "E-token-in", "B_in": "B0", "A_first": "A@1",
+            "A_last": f"A@{L}", "B_out": f"B{L}", "A_out": f"A-out@{L + 1}", "E_out": "E-token-out"}
+    width = {k: 1 << views[v].role["params"]["log_cols"] for k, v in keys.items()}
+    edges = []   # ((key, row, word), (key, row, word))
+    tok_in = plane_row(spi_in, "A_TOK")
+    for w in range(g.tokens):
+        edges.append(((keys["A_in"], tok_in, w), (keys["E_in"], 0, w)))
+    # B_in at block stage 1, slot 21; B_out at block stage L, slot 22
+    for nm, st, slot, bkey in (("B_in", bundle.stages[1], 21, keys["B_in"]),
+                               ("B_out", bundle.stages[L], 22, keys["B_out"])):
+        op = next(r for s in bundle.stages for r in s.roles if s.key(r["role"]) == bkey)
+        src = [(c["stage"], c["slot"]) for c in op["claim_sources"]]
+        ci = src.index((st.index, slot))
+        res = _slot_io_rows(st, slot, "A", (op, ci))
+        if isinstance(res, str):
+            findings.append(res)
+            continue
+        a_rows, b_rows = res
+        akey = st.key("A")
+        for ar, br in zip(a_rows, b_rows):
+            for w in range(1 << op["params"]["log_cols"]):
+                edges.append(((akey, ar, w), (bkey, br, w)))
+    # B_out row T-1 against A-out's x (OUT-00)
+    n_b = width["B_out"]
+    base = (g.tokens - 1) * g.d_pad
+    b_row, b_col = base // n_b, base % n_b
+    x_row = plane_row(spi_out, "A_X")
+    for w in range(g.d_pad):
+        edges.append(((keys["A_out"], x_row, w), (keys["B_out"], b_row, b_col + w)))
+    # output tok (OUT-10)
+    edges.append(((keys["A_out"], plane_row(spi_out, "A_TOK"), 0), (keys["E_out"], 0, 0)))
+
+    # word-level components over (key, word)
+    parent = {}
+    def find(x):
+        while parent.setdefault(x, x) != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
+    for (k1, _r1, w1), (k2, _r2, w2) in edges:
+        a, b = find((k1, w1)), find((k2, w2))
+        if a != b:
+            parent[a] = b
+    comp_edges = {}
+    for e in edges:
+        root = find((e[0][0], e[0][2]))
+        comp_edges.setdefault(root, []).append(e)
+    comp_nodes = {}
+    for node in list(parent):
+        comp_nodes.setdefault(find(node), set()).add(node)
+    # rank each distinct component signature once
+    blocks_alone = {}
+    def alone(key):
+        if key not in blocks_alone:
+            blk = block_from_view(views[key])
+            blocks_alone[key] = RunJointSystem([blk]).disclosed(msg_width=1)
+        return blocks_alone[key]
+    sig_result, sig_count = {}, {}
+    for root, nodes in comp_nodes.items():
+        word_of = {}
+        for (k, w) in nodes:
+            word_of.setdefault(k, set()).add(w)
+        if any(len(ws) > 1 for ws in word_of.values()):
+            findings.append(f"a component holds one commitment at two word positions: {sorted(nodes)[:4]}")
+            continue
+        pairs = sorted({((e[0][0], e[0][1]), (e[1][0], e[1][1])) for e in comp_edges.get(root, [])})
+        sig = (tuple(sorted(word_of)), tuple(pairs))
+        sig_count[sig] = sig_count.get(sig, 0) + 1
+        if sig not in sig_result:
+            blocks = [block_from_view(views[k]) for k in sig[0]]
+            js = RunJointSystem(blocks, identifications=list(pairs))
+            d = js.disclosed(msg_width=1)
+            parts = sum(alone(k)["disclosed_fp"] for k in sig[0])
+            sig_result[sig] = {"commitments": list(sig[0]), "row_identifications": len(pairs),
+                               "joint_disclosed_fp_per_word": d["disclosed_fp"], "k0": d["k0"],
+                               "sum_of_parts_per_word": parts,
+                               "identification_reaches_a_non_data_row": bool(js.mixed_classes),
+                               "findings": list(js.findings)}
+    comps = []
+    joint_total = 0
+    for sig, res in sig_result.items():
+        r = dict(res)
+        r["word_positions"] = sig_count[sig]
+        joint_total += res["joint_disclosed_fp_per_word"] * sig_count[sig]
+        comps.append(r)
+    # words of each involved commitment that no identification reaches
+    covered = {}
+    for nodes in comp_nodes.values():
+        for (k, w) in nodes:
+            covered.setdefault(k, set()).add(w)
+    parts_total = 0
+    alone_rows = {}
+    for k in set(keys.values()):
+        n_k = 1 << views[k].role["params"]["log_cols"]
+        a = alone(k)
+        alone_rows[k] = {"disclosed_fp_per_word": a["disclosed_fp"], "k0": a["k0"], "words": n_k,
+                         "words_in_an_identification": len(covered.get(k, ()))}
+        parts_total += a["disclosed_fp"] * n_k
+        joint_total += a["disclosed_fp"] * (n_k - len(covered.get(k, ())))
+    out = {"what": token_joint_figure.__doc__.strip().splitlines()[0],
+           "identified_word_pairs": len(edges), "components": comps,
+           "commitments_alone": alone_rows,
+           "joint_disclosed_fp": joint_total, "sum_of_parts_fp": parts_total,
+           "joint_equals_sum_of_parts": joint_total == parts_total,
+           "findings": findings,
+           "ruling_R3": "joint == sum of parts is a consistency check of the model's coordinate classes, "
+                        "not evidence that the blinding is independent (G-R4)"}
+    out["ok"] = (not findings and out["joint_equals_sum_of_parts"] and joint_total == 0
+                 and not any(c["identification_reaches_a_non_data_row"] for c in comps))
+    return out
+
+
+def token_joint_controls(bundle, views) -> dict:
+    """[v10] Controls on the computed joint figure, each predicted to fire:
+    J-1 an identification that reaches a NON-DATA row (the input token
+    endpoint's first reserved row taken for its data row; control P-5's
+    failure mode), J-2 the same on B_in (a reserved row of B_in identified
+    with block 0's input data), J-3 a forged identification between two
+    commitments' PROXIMITY rows (a shared blinding row)."""
+    from zk60_native_rg_joint import RunJointSystem, block_from_view
+    out = {}
+    def mixed(keys, pairs):
+        js = RunJointSystem([block_from_view(views[k]) for k in keys], identifications=pairs)
+        d = js.disclosed(msg_width=1)
+        return js, d
+    e_site = views["E-token-in"].role["site_rows"][0]
+    tok_in = next(p for p in bundle.stages[0].doc["stage_plane_index"]["a_planes"] if p["name"] == "A_TOK")["first_row"]
+    js, d = mixed(["A-in@0", "E-token-in"], [(("A-in@0", tok_in), ("E-token-in", e_site))])
+    out["J-1_endpoint_reserved_row_identified_with_tok"] = {"fires": bool(js.mixed_classes),
+                                                            "findings": js.findings[:1]}
+    b_site = views["B0"].role["site_rows"][0]
+    a_x = next(p for p in bundle.run["plane_index"]["a_planes"] if p["name"] == "A_X")["first_row"]
+    js, d = mixed(["A@1", "B0"], [(("A@1", a_x), ("B0", b_site))])
+    out["J-2_B_in_reserved_row_identified_with_block_0_input"] = {"fires": bool(js.mixed_classes),
+                                                                  "findings": js.findings[:1]}
+    pa, pe = views["A-in@0"].role["prox_row"], views["E-token-in"].role["prox_row"]
+    js, d = mixed(["A-in@0", "E-token-in"], [(("A-in@0", pa), ("E-token-in", pe))])
+    alone = sum(RunJointSystem([block_from_view(views[k])]).disclosed(msg_width=1)["disclosed_fp"]
+                for k in ("A-in@0", "E-token-in"))
+    out["J-3_shared_proximity_row"] = {"fires": d["disclosed_fp"] > alone or bool(js.shared_non_data_classes),
+                                       "joint_disclosed_fp_per_word": d["disclosed_fp"],
+                                       "sum_of_parts": alone,
+                                       "shared_non_data_classes": len(js.shared_non_data_classes)}
+    return {"controls": out, "ok": all(v["fires"] for v in out.values())}
+
+
+def token_joint_preimage(bundle, views, s11, mask, joint_fig, terminals) -> dict:
+    """[v10] ONE assignment for the whole token run (`zk60_native_rg_mjoint`'s
+    four couplings, for a token run): the data block of every commitment
+    set to zero, each commitment's PCS blinding as the full-preimage arm
+    solves it, each stage's mask coefficients and M blinding as the mask arm
+    solves them.  C1: every identification (the computed joint figure's,
+    word level) reaches data coordinates only, where both sides are zero.
+    C2: published claim values two commitments share are counted (each part
+    meets the captured number, so they are respected by construction).  C3:
+    every stage's M functional values are reproduced by the mask arm.  C4:
+    the terminal identity is NONLINEAR; what is said is narrow: it holds on
+    the captured terminals at every slot (the terminal ports), which the
+    zero-data assignment does not have to reproduce -- the terminals are
+    published values the assignment meets, as in the block arm."""
+    vals = {}
+    for k, v in views.items():
+        for c in v.role["claims"]:
+            vals.setdefault(tuple(c["value"]), set()).add(k)
+    shared = {str(k): sorted(s) for k, s in vals.items() if len(s) > 1}
+    c1 = {"identified_word_pairs": joint_fig["identified_word_pairs"],
+          "reaches_a_non_data_row": any(c["identification_reaches_a_non_data_row"] for c in joint_fig["components"]),
+          "respected": joint_fig["identified_word_pairs"] > 0 and not any(
+              c["identification_reaches_a_non_data_row"] for c in joint_fig["components"])}
+    c2 = {"claim_values_published_by_two_commitments": len(shared), "respected": True,
+          "why": "each commitment's preimage meets the captured value; a shared value is one number"}
+    c3 = {"stages": len(mask["per_stage"]),
+          "entries_differing": sum(p["entries_differing"] or 0 for p in mask["per_stage"]),
+          "respected": mask["ok"]}
+    c4 = {"respected": bool(terminals and terminals.get("ok")),
+          "what": "the terminal identity on the captured terminals at every new slot and every block slot",
+          "terminal_records": {k: v.get("ok") for k, v in (terminals or {}).items() if isinstance(v, dict)}}
+    out = {"couplings": {"C1_shared_planes": c1, "C2_shared_claim_values": c2,
+                         "C3_masking_layer_against_the_slots": c3, "C4_the_terminal_identity": c4},
+           "per_commitment_preimage": {"view_entries_compared": s11.get("view_entries_compared"),
+                                       "view_entries_differing": s11.get("view_entries_differing"),
+                                       "ok": s11.get("ok")}}
+    out["all_four_couplings_respected"] = all(c["respected"] for c in out["couplings"].values())
+    out["ok"] = out["all_four_couplings_respected"] and s11.get("ok") is True \
+        and s11.get("view_entries_differing") == 0
+    return out
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
