+def resolve(lks, idx, g_u8):
+    """`resolve` (stage_out.rs:332-334): plane ids -> table indices, the
+    constant tagged with g_u8"""
+    return [([(idx(p), c) for (p, c) in terms], K(cst) + g_u8) for (terms, cst) in lks]
