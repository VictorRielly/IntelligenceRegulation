+        let (root, bytes, replay_probe) = predict(false);
+        let root_ok = p.root() == root;
+        let ends_ok = replay_probe == prover_probe;
+        let counted_ok = probe_at(bytes) == prover_probe;
+        let shifted_differs = probe_at(bytes + 16) != prover_probe;
