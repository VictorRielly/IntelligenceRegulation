+/// What the trained capture did, for the note and the log (public facts).
+struct TrainedCaptureFacts {
+    variant: String,
+    layers: Vec<u32>,
+    statement_identity: String,
+    silu: Vec<(i32, i32)>,
+    exp_e_s: Vec<i32>,
+    calibration: String,
+    parity_words: usize,
+}
