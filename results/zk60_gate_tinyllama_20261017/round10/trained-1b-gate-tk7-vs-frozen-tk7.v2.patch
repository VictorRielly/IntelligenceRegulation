+/// THE REPLAY GENERATOR: the same seeded stream, counting what the
+/// prediction draws (16 bytes per field word, 32 per extension word or salt)
+struct Draws {
+    rng: ZkRng,
+    bytes: u64,
+}
+
+impl Draws {
+    fn new() -> Draws {
+        Draws { rng: ZkRng::new(SEED, DOMAIN), bytes: 0 }
+    }
+    fn fp(&mut self) -> Fp {
+        self.bytes += 16;
+        self.rng.fp()
+    }
+    fn fp2(&mut self) -> Fp2 {
+        self.bytes += 32;
+        self.rng.fp2()
+    }
+    fn bytes32(&mut self) -> [u8; 32] {
+        self.bytes += 32;
+        self.rng.bytes32()
+    }
+}
