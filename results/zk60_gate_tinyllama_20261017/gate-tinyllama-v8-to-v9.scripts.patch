+                                        for nm, k in (("B_in", 0), ("B_out", b.l))}
+    rec["G2_claim_points"] = g2_claim_points(b)
+    tick("boundaries_and_G2", t)
+    t = time.time()
+    rec["G3_mask_cfs"] = token_mask_cfs(b, rp)
+    tick("G3", t)
+    rec["G4_support_tables"] = g4_support_tables(b)
