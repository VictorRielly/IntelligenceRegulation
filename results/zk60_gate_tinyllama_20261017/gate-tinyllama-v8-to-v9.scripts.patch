+# ------------------------------------------------------------------ driver
+def gate(directory: str, controls=True) -> dict:
+    import time
+    t0 = time.time()
+    rec = {"what": "the privacy gate's token items (DESIGN 4.2 G-1..G-7) on ONE token-I/O run capture; "
+                   "NOT a privacy result", "privacy_acceptance": False,
