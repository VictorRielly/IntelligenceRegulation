+                                     "what": "stage_out.rs's pin moved to an unread digest"}
+    man = copy.deepcopy(bundle.manifest)
+    man["source_pins"] = [p for p in man["source_pins"] if p["file"] != "src/private_block/token_io/stage_in.rs"]
+    r = token_pins(man)
