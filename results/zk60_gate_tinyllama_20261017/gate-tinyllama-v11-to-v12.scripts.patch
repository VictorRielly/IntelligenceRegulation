+#!/usr/bin/env python3
+"""[GATE ROUND 10, tools v12, 2026-10-20] NL-1's machine check, stages S1-S5,
+on the token-I/O stages' NEW slots (stage IN, 4 slots; stage OUT, 11 slots),
+by feeding the FROZEN `nl_check.py` (results/zk60_nonlinear_channel_shaped/,
+digests checked before import, no bytecode written there) a slot IR of each
+new slot built from the gate's own transcription of `define`
+(`zk60_native_rg_tokenterminals.py`, whose evaluation equals the Rust
+terminal polynomial on every token capture: v10, 15 / 15).
+
+    python3 zk60_native_rg_tokennl.py --bundle <token capture> --evidence <dir> --name <name>
+
+NOTHING HERE IS A PRIVACY RESULT OR A PRIVACY ACCEPTANCE.
+
+THE IR.  `nl_check` reads `zk60-slot-ir/1` slots (tables with a kind, nodes,
+terms with coefficients).  The block slots' IR is exported by Rust
+(`slot_ir.rs`, stage 34); the token stages have none.  Here each new slot's
+transcribed polynomial is EXPANDED (the tokenterminals Poly ring) over its
+table variables, with the challenges either
+  * at the run's RE-DERIVED values (the token replay), or
+  * at independent RANDOM values (three seeds; `nl_check`'s own convention
+    for a challenge coefficient),
+and written as a flat IR: one term per monomial, no nodes, every coefficient
+a constant.  Table kinds: an eq table -> `eq(start=s,|point|=p)`; a public
+table -> `supp(...)` when it is a support indicator, else `pub`; an A plane
+-> `A`; an H helper -> `H`; an IO endpoint / boundary -> `EP`.
+
+FIDELITY (failing-first: F-1 perturbs one coefficient and must fail).
+  F-0  the IR evaluated by `nl_check.Slot` equals the transcription evaluated
+       in the numeric ring, at random table values, three seeds per slot;
+  T-0  the same module's `check_token_terminals` on this capture: the
+       transcription equals the Rust terminal polynomial, every new slot.
+
+THE STAGES (nl_check's numbering; its functions, not copies):
+  S1  per slot: the per-extension-round premise (exact, three seeds; and the
+      syntactic walk), a public factor in every monomial, the degree walk
+      within the declared degree, the per-variable bound, the mask budget
+      L + 256 <= 512;
+  S2  the stage sums: sum L, sum dim C, the kernel;
+  S3  Fact 2.1 at every distinct (N, d) of the new slots, five regimes;
+  S4  per slot a MINIATURE honest masked run with the slot's polynomial
+      (chain accepts, Fact 3.2, terminals = cd T + cm R, offset in Im R,
+      the fibre test of Theorem 3.3), and the per-slot terminal map onto
+      Fp2^m (random tails and a shared boolean tail);
+  S5  controls, each predicted:
+      N5-1  (every slot) one monomial stripped of its public factors: the
+            premise fails and the miniature's chain rejects;
+      N5-2  (every slot at zero slack) the declared degree minus one: the
+            chain rejects;
+      N5-3  the mask one degree short at the largest new (N, d): Fact 2.1's
+            rank no longer covers C;
+      N5-4  C7 / C8 at the new stage's largest m: (cm, cm) weights at a
+            boolean tail and a shared pair at one tail are short; the honest
+            forms are onto;
+      F-1   one IR coefficient perturbed: F-0 fails.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+import os
+import resource
+import sys
+import time
+
+sys.dont_write_bytecode = True
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+import zk60_native_rg_tokenterminals as TT  # noqa: E402
+import zk60_native_rg_tokengate as TG  # noqa: E402
+
+NL_DIR = "/home/victor/IntelligenceRegulation/results/zk60_nonlinear_channel_shaped"
+NL_PINS = {"nl_check.py": "e4db99a251ddde4f432675a53bd7e9149cdeb7c9edd61bbac87f50b87d0727c7",
+           "nl_field.py": "ea8ca39263213d88ef92c3f5d18fb8f86ed73471da027bf57348f94087dbb7e4"}
+
+
+def _sha(p):
+    with open(p, "rb") as fh:
+        return hashlib.sha256(fh.read()).hexdigest()
+
+
+def load_nl():
+    got = {n: _sha(os.path.join(NL_DIR, n)) for n in NL_PINS}
+    if got != NL_PINS:
+        raise SystemExit(f"the frozen NL-1 scripts moved: {got}")
+    if NL_DIR not in sys.path:
+        sys.path.insert(0, NL_DIR)
+    import nl_check as NL  # noqa: E402
+    import nl_field as NF  # noqa: E402
+    return NL, NF
+
+
+def _fstr(v):
+    return f"{v[0]}+{v[1]}u"
+
+
+SUPPORT_HINTS = ("supp", "indicator", "support")
+
+
+def _table_kind(t, cx):
+    if t["kind"] == "eq":
+        return f"eq(start={t['start']},|point|={len(t['point'])})", f"eq({t['label']})"
+    if t["kind"] == "public":
+        desc = TT.describe(t["desc"])
+        cl = TT.table_class(t["desc"])
+        if cl == "indicator" or any(h in desc.lower() for h in SUPPORT_HINTS):
+            return f"supp({desc})", desc
+        return "pub", desc
+    role = t["role"]
+    if role.startswith("A-"):
+        return "A", t["plane"]
+    if role.startswith("H-"):
+        return "H", t["plane"]
+    return "EP", t["plane"]
+
+
+def _rand_f2(rng):
+    return (rng.randrange(TT.P), rng.randrange(TT.P))
+
+
+def slot_defs(bundle, replay, chal="run", seed=0):
+    """(stage kind, slot, arg, SlotDef, Ctx) for every new slot, the
+    challenges at the run's values or at random ones"""
+    import random
+    out = []
+    for st in (bundle.stages[0], bundle.stages[-1]):
+        kind = st.kind
+        doc = st.doc
+        logup, r_emb, dcf, _rho, _cc = TT._new_stage_challenges(bundle, replay, st, doc)
+        rng = random.Random(f"tokennl/{kind}/{seed}")
+        if chal == "random":
+            logup = [_rand_f2(rng) for _ in logup]
+            r_emb = [_rand_f2(rng) for _ in r_emb]
+        pts = {}
+        for s in range(len(doc["arguments"])):
+            arg = doc["arguments"][s]
+            cx = TT.Ctx(bundle, kind, logup, r_emb, "numeric")
+            vals = dcf(s)
+            if chal == "random":
+                vals = [_rand_f2(rng) for _ in vals]
+            dr = TT.Draws(vals, "numeric")
+            sd = TT.define_in(s, cx, dr) if kind == "IN" else TT.define_out(s, cx, dr, pts)
+            out.append((kind, s, arg, sd, cx))
+    return out
+
+
+def to_ir(kind, s, arg, sd, cx):
+    names = [f"T{i:02d}" for i in range(len(sd.tabs))]
+    P = TT.Poly._co(sd.poly([TT.Poly.var(n) for n in names]))
+    idx = {n: i for i, n in enumerate(names)}
+    tables = []
+    for t in sd.tabs:
+        k, lab = _table_kind(t, cx)
+        tables.append({"kind": k, "label": lab, "prov": "token-io transcription"})
+    terms = []
+    for mono, c in sorted(P.t.items()):
+        inner = []
+        for n, e in mono:
+            inner.extend([{"table": idx[n]}] * e)
+        terms.append({"coef": {"value": _fstr(c)}, "wrapper": [], "inner": inner,
+                      "degree": len(inner)})
+    maxdeg = max((t["degree"] for t in terms), default=0)
+    return {"slot": s, "name": f"{kind}-{s:02d} {arg['name']}", "kind": arg["kind"],
+            "main_rounds": arg["main"], "extension_rounds": arg["extension"],
+            "declared_degree": arg["degree"], "max_product_degree": maxdeg,
+            "pad_on": None, "group_bits": 0, "tables": tables, "nodes": [], "terms": terms}
+
+
+def fidelity(NL, NF, ir, sd, seeds=(1, 2, 3)):
+    import random
+    sl = NL.Slot(ir, "token", {})
+    out = []
+    for sd_ in seeds:
+        rng = random.Random(f"fid/{ir['name']}/{sd_}")
+        vals = [_rand_f2(rng) for _ in ir["tables"]]
+        comp = sl.compile(NF.Rng(7))
+        a = NL.Slot.evaluate(comp, vals)
+        b = TT.F2._co(sd.poly([TT.F2(v) for v in vals]))
+        b = b if isinstance(b, tuple) else b
+        out.append(a == b)
+    return all(out)
+
+
+def s1_row(NL, NF, sl):
+    nd, tdeg, maxdeg, stored_ok = sl.degrees()
+    pvd = sl.per_variable_degree()
+    prem = []
+    for m in range(sl.ext):
+        zeros = []
+        for seed in (1, 2, 3):
+            rng = NF.Rng(NL.sd("token", sl.name, m, seed))
+            comp = sl.compile(rng)
+            v = [rng.fp2() if (i in sl.private and sl.ext_round[i] == m) else NF.ZERO for i in range(len(sl.tables))]
+            zeros.append(NF.is_zero(NL.Slot.evaluate(comp, v)))
+        live_m, _ = sl.live([i in sl.private and sl.ext_round[i] == m for i in range(len(sl.tables))])
+        prem.append({"round": m, "exact_zero_3_of_3": all(zeros), "syntactically_zero": not live_m})
+    rng = NF.Rng(NL.sd("token", sl.name, "mech"))
+    comp = sl.compile(rng)
+    v = [rng.fp2() if i in sl.private else NF.ZERO for i in range(len(sl.tables))]
+    pf = NF.is_zero(NL.Slot.evaluate(comp, v))
+    live_pub, _ = sl.live([i in sl.private for i in range(len(sl.tables))])
+    L = NL.mask_len(sl.main + sl.ext, sl.d)
+    return {"name": sl.name, "main": sl.main, "ext": sl.ext, "declared_degree": sl.d,
+            "max_product_degree_walked": maxdeg, "stored_degrees_agree": stored_ok,
+            "per_variable_degree_bound_max": max(pvd) if pvd else 0,
+            "degree_fits": maxdeg <= sl.d and (max(pvd) if pvd else 0) <= sl.d,
+            "slack": sl.d - maxdeg, "private_tables": len(sl.private),
+            "tables": {k: sl.kinds.count(k) for k in NL.PUBLIC_KINDS + NL.PRIVATE_KINDS if sl.kinds.count(k)},
+            "premise": prem, "premise_holds": all(p["exact_zero_3_of_3"] for p in prem),
+            "public_factor_in_every_monomial_exact": pf,
+            "public_factor_in_every_monomial_syntactic": not live_pub,
+            "L": L, "dimC": (sl.main + sl.ext) * sl.d + 1, "budget_ok": L + NL.MASK_Q <= NL.MASK_MSG,
+            "terms": len(sl.terms)}
+
+
+def s3_pairs(NL, NF, pairs):
+    regimes = ["random-Fp2", "all-zero", "all-one", "alternating-0-1", "all-equal"]
+    rows, tight_n = [], 0
+    for (N, d) in pairs:
+        for reg in regimes:
+            rng = NF.Rng(NL.sd(N, d, reg, "token"))
+            if reg == "random-Fp2":
+                rho = [rng.fp2() for _ in range(N)]
+            elif reg == "all-zero":
+                rho = [NF.ZERO] * N
+            elif reg == "all-one":
+                rho = [NF.ONE] * N
+            elif reg == "alternating-0-1":
+                rho = [NF.ZERO if k % 2 == 0 else NF.ONE for k in range(N)]
+            else:
+                v = rng.fp2()
+                rho = [v] * N
+            R = NL.round_matrix_rows(N, d, rho)
+            width = 1 + N * (d + 1)
+            L = NL.mask_len(N, d)
+            rk = NF.rank(R, width)
+            crk = NL.consistency_rank(N, d, rho)
+            dimC = width - crk
+            in_c = True
+            for r in R:
+                if NF.add(r[1], r[2]) != r[0]:
+                    in_c = False
+                for j in range(1, N):
+                    o = 1 + j * (d + 1)
+                    po = 1 + (j - 1) * (d + 1)
+                    if NF.add(r[o], r[o + 1]) != NL.interp(r[po:po + d + 1], rho[j - 1]):
+                        in_c = False
+            k = NL.explicit_kernel(N, d, rho)
+            Rk = [NF.ZERO] * width
+            for i in range(L):
+                if not NF.is_zero(k[i]):
+                    Rk = [NF.add(a, NF.mul(k[i], b)) for a, b in zip(Rk, R[i])]
+            kernel_ok = all(NF.is_zero(x) for x in Rk)
+            sw = NL.dot(NL.sum_weights(N, d), k)
+            ew = NL.dot(NL.eval_weights(rho, d), k)
+            tight = (rk == N * d + 1 and dimC == N * d + 1 and in_c and kernel_ok
+                     and NF.is_zero(sw) and NF.is_zero(ew) and (L - rk) == 1)
+            tight_n += int(tight)
+            rows.append({"N": N, "d": d, "regime": reg, "L": L, "rank_R": rk, "dimC": dimC,
+                         "ImR_in_C": in_c, "explicit_kernel": kernel_ok, "tight": tight})
+    return {"pairs": [list(p) for p in pairs], "checks": len(rows), "tight": tight_n, "rows": rows}
+
+
+def s4_rows(NL, NF, slots):
+    rows = []
+    for sl in slots:
+        r = NL.miniature(sl, NF.Rng(NL.sd("token-mini", sl.name)))
+        r["name"] = sl.name
+        r["passes"] = bool(r["chain_accepts"] and r["fact32_identity"] and r["terminal_formula"]
+                           and r["rank_R"] == r["dimC_expected"] and r["offset_in_ImR"]
+                           and r.get("fibre_constructed") and r.get("fibre_same_published_view")
+                           and r.get("fibre_witness_differs") and r.get("fibre_same_V"))
+        rng = NF.Rng(NL.sd("token-pair", sl.name))
+        m = len(sl.private)
+        rk = NL.terminal_pair_rank(m, 2, rng)
+        rkb = NL.terminal_pair_rank(m, 2, rng, tail_kind="boolean", same_tail=True)
+        r["terminal_map"] = {"m": m, "fp_rank_random_tails": rk, "fp_rank_shared_boolean_tail": rkb,
+                             "onto_Fp2^m": rk == 2 * m and rkb == 2 * m}
+        rows.append(r)
+    return rows
+
+
+def _strip_public(NL, ir):
+    """N5-1: the first monomial with a private table loses every public factor"""
+    js = copy.deepcopy(ir)
+    kinds = [NL.tkind(t) for t in js["tables"]]
+    for t in js["terms"]:
+        if any(kinds[fc["table"]] in NL.PRIVATE_KINDS for fc in t["inner"]):
+            t["inner"] = [fc for fc in t["inner"] if kinds[fc["table"]] in NL.PRIVATE_KINDS]
+            t["degree"] = len(t["inner"])
+            return js, True
+    return js, False
+
+
+def controls(NL, NF, irs, slots, sds):
+    out = {"N5_1": [], "N5_2": [], "N5_3": None, "N5_4": None, "F_1": []}
+    for ir, sl, sd in zip(irs, slots, sds):
+        js, moved = _strip_public(NL, ir)
+        js["max_product_degree"] = max(t["degree"] for t in js["terms"])
+        s2 = NL.Slot(js, "token", {})
+        prem = s1_row(NL, NF, s2)["premise_holds"]
+        mini = NL.miniature(s2, NF.Rng(NL.sd("N5-1", sl.name)))
+        out["N5_1"].append({"name": sl.name, "moved": moved, "premise_holds": prem,
+                            "chain_accepts": mini["chain_accepts"],
+                            "fires": moved and not prem and not mini["chain_accepts"]})
+        deg = sl.degrees()[2]
+        if deg == sl.d:
+            mini2 = NL.miniature(sl, NF.Rng(NL.sd("N5-2", sl.name)), override={"d": sl.d - 1})
+            out["N5_2"].append({"name": sl.name, "declared": sl.d - 1, "chain_accepts": mini2["chain_accepts"],
+                                "fires": not mini2["chain_accepts"]})
+        else:
+            out["N5_2"].append({"name": sl.name, "not_applicable": f"slack {sl.d - deg}", "fires": None})
+        bad = copy.deepcopy(ir)
+        c = NF.parse(bad["terms"][0]["coef"]["value"])
+        bad["terms"][0]["coef"]["value"] = _fstr(NF.add(c, NF.ONE))
+        out["F_1"].append({"name": sl.name, "fidelity_holds_on_perturbed_ir": fidelity(NL, NF, bad, sd),
+                           "fires": not fidelity(NL, NF, bad, sd)})
+    pairs = sorted({(sl.main + sl.ext, sl.d) for sl in slots})
+    N, d = max(pairs)
+    rng = NF.Rng(0xC6 ^ N)
+    rho = [rng.fp2() for _ in range(N)]
+    rows = NL.round_matrix_rows(N, d, rho, mask_degree=d - 1)
+    rk = NF.rank(rows, 1 + N * (d + 1))
+    out["N5_3"] = {"N": N, "d": d, "rank": rk, "dimC": N * d + 1, "covers": rk == N * d + 1,
+                   "fires": rk != N * d + 1}
+    m = max(len(sl.private) for sl in slots)
+    rng = NF.Rng(0xC7 + m)
+    honest_b = NL.terminal_pair_rank(1, 2, rng, tail_kind="boolean")
+    cm_cm_b = NL.terminal_pair_rank(1, 2, rng, weights="cm1", tail_kind="boolean")
+    honest_pair = NL.terminal_pair_rank(2, 2, rng, same_tail=True)
+    shared = NL.terminal_pair_rank(2, 2, rng, share=(0, 1), same_tail=True)
+    out["N5_4"] = {"honest_pair_boolean_tail": honest_b, "cm_cm_boolean_tail": cm_cm_b,
+                   "honest_distinct_pairs_same_tail": honest_pair, "shared_pair_same_tail": shared,
+                   "fires": honest_b == 2 and cm_cm_b < 2 and honest_pair == 4 and shared < 4}
+    live = [x for x in out["N5_2"] if x["fires"] is not None]
+    out["summary"] = {
+        "N5_1_fires": f"{sum(1 for x in out['N5_1'] if x['fires'])}/{len(out['N5_1'])}",
+        "N5_2_fires": f"{sum(1 for x in live if x['fires'])}/{len(live)} (not applicable at slack > 0: "
+                      f"{len(out['N5_2']) - len(live)})",
+        "N5_3_fires": out["N5_3"]["fires"], "N5_4_fires": out["N5_4"]["fires"],
+        "F_1_fires": f"{sum(1 for x in out['F_1'] if x['fires'])}/{len(out['F_1'])}",
+    }
+    out["ok"] = (all(x["fires"] for x in out["N5_1"]) and bool(live) and all(x["fires"] for x in live)
+                 and out["N5_3"]["fires"] and out["N5_4"]["fires"] and all(x["fires"] for x in out["F_1"]))
+    return out
