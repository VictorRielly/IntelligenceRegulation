+def own_kill(pid, sig, marker):
+    """Signal `pid` only if it is one of this test's own processes: its command line
+    must contain `marker` (the test's private temp dir, or the sentinel's unique
+    argument).  Anything else raises AssertionError and is never signalled."""
+    try:
+        with open(f"/proc/{pid}/cmdline", "rb") as f:
+            cmd = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
+    except OSError:
+        return  # already gone
+    if marker not in cmd:
+        raise AssertionError(f"refusing to signal pid {pid}: {cmd[:120]!r} lacks {marker!r}")
+    os.kill(pid, sig)
 
