ZK60.ProtocolClassify.shdP_Pk0_eq_blkParams : ∀ (tag : ZK60.Exec.MTag) (ioIn ioOut : ℕ)
  (checkOpening :
    (ZK60.Exec.HIn → ZK60.Exec.Dig) →
      ZK60.Exec.Block.Cm → List ZK60.Exec.Block.ZClaim → ZK60.Exec.Tr → Except String Unit)
  (Rp : ZK60.RunShape.ClassifyRunPublicP ZK60.RunShape.Shield.shieldS0) (hR : ZK60.RunShape.Shield.ShieldRun Rp) (k : ℕ)
  (hk : k < 26),
  ZK60.ProtocolClassify.shdP_Pk0 tag ioIn ioOut checkOpening Rp k =
    let Ly := ZK60.RunShape.Shield.shieldExport[k];
    let b := Rp.blks[k];
    ZK60.ProtocolClassify.shdP_blkParams tag ioIn ioOut checkOpening Ly (cast ⋯ b.pub)
