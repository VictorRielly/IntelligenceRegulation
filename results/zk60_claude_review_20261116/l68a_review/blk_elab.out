Shield.shield_run_exists : ∃ R, ShieldRun R ∧ R.Valid
def ZK60.RunShape.Shield.ShieldRun : ClassifyRunPublicP shieldS0 → Prop :=
fun R => List.map RunBlock.cal R.blks = List.map shieldCal shieldExport
def ZK60.Exec.msbBits : (n : ℕ) → ℕ → Fin n → Bool :=
fun n idx j => decide (idx / 2 ^ (n - 1 - ↑j) % 2 = 1)
def ZK60.Layout.W16Layout.dPos : {S : BlockShape} →
  {Ct Cw Cg Cj Cd Cf : Type} → W16Layout S Ct Cw Cg Cj Cd Cf → S.Pos → Ct × Cw :=
fun {S} {Ct Cw Cg Cj Cd Cf} L p => (L.tok.emb p.1, L.wid.emb p.2)
def ZK60.ProtocolClassify.shieldDPos0 : shieldS0.Pos → (Fin 7 → Bool) × (Fin 12 → Bool) :=
fun p => (msbBits 7 ↑p.1, msbBits 12 ↑p.2)
def ZK60.ProtocolClassify.shdP_clampPk : (ℕ → BlockParams) → ℕ → BlockParams :=
fun Pk0 k => Pk0 (min k 25)
