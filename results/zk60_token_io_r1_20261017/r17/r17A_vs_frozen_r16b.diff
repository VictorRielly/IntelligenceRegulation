+struct R13Run {
+    st: ClassifyRunStatement,
+    segs: Vec<Vec<u8>>,
+    dec: Decommitment,
+    margin: i64,
+    policy: Policy,
+    chunk: ChunkRef,
+    blocks: Vec<BlockPublic>,
