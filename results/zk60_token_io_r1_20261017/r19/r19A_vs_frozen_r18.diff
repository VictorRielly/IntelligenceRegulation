+/// the end and the text of a raw string literal whose hashes (or quote)
+/// start at `h`: `r"…"`, `r#"…"#`, …
+fn raw_string(c: &[char], h: usize) -> Option<(usize, String)> {
+    let mut i = h;
+    while c.get(i) == Some(&'#') {
+        i += 1;
+    }
+    let hashes = i - h;
+    if c.get(i) != Some(&'"') {
+        return None;
+    }
+    let start = i + 1;
+    let mut j = start;
+    while j < c.len() {
+        if c[j] == '"' && (1..=hashes).all(|k| c.get(j + k) == Some(&'#')) {
+            return Some((j + 1 + hashes, c[start..j].iter().collect()));
+        }
+        j += 1;
+    }
+    None
+}
