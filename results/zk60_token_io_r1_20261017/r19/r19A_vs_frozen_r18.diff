+/// the end of a char literal (`'x'`, `'\n'`, `'\''`, `'\u{..}'`) or of a
+/// lifetime / label (`'a`) whose quote is at `q`
+fn char_or_lifetime(c: &[char], q: usize) -> Option<usize> {
+    if c.get(q + 1) == Some(&'\\') {
+        let mut j = q + 3;
+        while j < c.len() && c[j] != '\'' {
+            j += 1;
+        }
+        return (j < c.len()).then_some(j + 1);
+    }
+    if c.get(q + 2) == Some(&'\'') {
+        return Some(q + 3);
+    }
+    let mut j = q + 1;
+    while j < c.len() && (c[j].is_alphanumeric() || c[j] == '_') {
+        j += 1;
+    }
+    Some(j)
