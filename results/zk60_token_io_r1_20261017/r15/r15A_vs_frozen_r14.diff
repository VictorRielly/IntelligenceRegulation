+/// **TOKEN ROUND 15 (gate round 18, F18-1): run.json's `shape` object** —
+/// its `slots` triples and its declared `n_slots` (the shape object is cut
+/// out at its matching brace, strings skipped, and parsed strictly)
+pub(super) fn shape_slot_list(run_json: &[u8]) -> (Vec<[usize; 3]>, usize) {
+    let text = std::str::from_utf8(run_json).expect("run.json is UTF-8");
+    let at = text.find("\"shape\":{").expect("run.json has a shape object") + "\"shape\":".len();
+    let (mut depth, mut in_str, mut esc, mut end) = (0usize, false, false, None);
+    for (i, ch) in text[at..].char_indices() {
+        if in_str {
+            match (esc, ch) {
+                (true, _) => esc = false,
+                (false, '\\') => esc = true,
+                (false, '"') => in_str = false,
+                _ => {}
+            }
+            continue;
+        }
+        match ch {
+            '"' => in_str = true,
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    end = Some(at + i + 1);
+                    break;
+                }
+            }
+            _ => {}
+        }
+    }
+    let shape = super::super::trained_block::parse_json(text[at..end.expect("the shape object closes")].as_bytes()).expect("the shape object parses");
+    let n_slots = usize::try_from(shape.get("n_slots").unwrap().i64().unwrap()).unwrap();
+    let slots = shape
+        .get("slots")
+        .unwrap()
+        .arr()
+        .unwrap()
+        .iter()
+        .map(|t| {
+            let v = t.arr().unwrap();
+            assert_eq!(v.len(), 3, "a slot triple has three words");
+            [0, 1, 2].map(|k| usize::try_from(v[k].i64().unwrap()).unwrap())
+        })
+        .collect();
+    (slots, n_slots)
+}
