+    assert!(read_request(&link).is_err(), "a symlinked request is refused");
+    let fifo = cc.owners.join("r18q-fifo.json");
+    let made = std::process::Command::new("mkfifo").arg("-m").arg("600").arg(&fifo).status().unwrap();
+    assert!(made.success());
