+#[test]
+fn rv16_s2_whole_run_terms_floors_and_min_bits() {
+    use super::super::layout::{Dom, LOOKUP_DOMS};
+    let tables = shield_tables();
+    let policies = [policy_shieldstral_moderate_sexual(), policy_shieldstral_moderate_violence(), policy_shieldstral_moderate_hate(), policy_shieldstral_card()];
+    for (profile, block, want_floor) in [(RUN_PROFILE_CLASSIFY_R13_SHIELD_T128, R13_SHIELD_T128_H24, 96u32), (RUN_PROFILE_CLASSIFY_R13_SHIELD_T256, R13_SHIELD_T256_H24, 95)] {
+        let sh = shield_shape(block);
+        let u8n: u128 = LOOKUP_DOMS.iter().map(|d| sh.lookups_per_position(*d) as u128 * sh.size(*d) as u128).sum();
+        eprintln!(
+            "RV16-S2-SHAPE {{\"profile\":\"{profile}\",\"log_cols\":{},\"inv_rate\":{},\"opened_cols\":{},\"endpoint_log_n\":{},\"endpoint_inv_rate\":{},\"tokens\":{},\"t_pad\":{},\"d_pad\":{},\"u8_lookups\":{u8n},\"S\":{},\"F\":{},\"r13_numerator\":{},\"mask_vec\":{},\"mask_dom\":{},\"mask_q\":{},\"tier_q\":{},\"tier_stage_log_n\":{},\"tier_stage_inv_rate\":{},\"tier_ep_log_n\":{},\"tier_ep_inv_rate\":{},\"pcs_field\":{},\"sumcheck\":{}}}",
+            sh.log_cols, sh.inv_rate, sh.opened_cols, sh.endpoint_log_n, sh.endpoint_inv_rate, sh.tokens, sh.t_pad, sh.d_pad,
+            sh.size(Dom::S), sh.size(Dom::F),
+            super::run::r13_block_logup_numerator(&sh).unwrap(),
+            MASK_VEC, MASK_DOM, crate::zk::MASK_Q,
+            Tier::R1_MVP.opened_cols, Tier::R1_MVP.stage_log_n, Tier::R1_MVP.stage_inv_rate, Tier::R1_MVP.ep_log_n, Tier::R1_MVP.ep_inv_rate,
+            super::run::PCS_FIELD_PER_OPENING_LOG2, super::run::SUMCHECK_PER_STAGE_LOG2
+        );
+        for p in &policies {
+            let n = sh.tokens - p.prefix.len() - p.suffix.len();
+            let cp = ClassifierProfile::new(&sh, &tables, 1, SH_NORM, p, n, Tier::R1_MVP).unwrap();
+            let (on, or) = super::stage_out_c::logup_size(&super::stage_out_c::layout(&sh, &cp));
+            let (inn, inr) = super::stage_in_c::logup_size(&super::stage_in_c::layout(&sh, &cp), &cp);
+            let w = whole_run_of_classifier(&sh, 26, &cp);
+            eprintln!(
+                "RV16-S2-TERMS {{\"profile\":\"{profile}\",\"policy\":\"{}\",\"p0\":{},\"n\":{n},\"out_c_n\":{on},\"out_c_r\":{or},\"in_c_n\":{inn},\"in_c_r\":{inr},\"cp_tokens\":{},\"cp_d_pad\":{},\"openings\":{},\"column_log2\":{:.6},\"logup_log2\":{:.6},\"omitted_log2\":{:.6},\"total_log2\":{:.6},\"floor\":{}}}",
+                p.id, p.prefix.len(), cp.tokens, cp.d_pad, w.openings, w.column_log2, w.logup_log2, w.omitted_log2, w.total_log2, w.floor_bits
+            );
+            assert_eq!(w.openings, 4 * 26 + 8);
+            assert_eq!(w.floor_bits, want_floor, "{profile} / {}: floor {}", p.id, w.floor_bits);
+        }
+        // --min-bits at the floor passes the floor door; one more bit is refused
+        let (st, bound) = shield_statement(profile, &sh, &tables, &policy_shieldstral_moderate_hate(), 26).unwrap();
+        let at = verify_classify_run(&st, &[], &bound, &[], VerifierPolicy { min_whole_run_bits: want_floor }).err().unwrap();
+        assert!(!at.contains("below the verifier's minimum"), "{profile}: --min-bits {want_floor} was refused at the floor door: {at}");
+        assert!(at.contains("blocks and") && at.contains("segments were offered"), "{at}");
+        let above = verify_classify_run(&st, &[], &bound, &[], VerifierPolicy { min_whole_run_bits: want_floor + 1 }).err().unwrap();
+        assert!(above.contains("below the verifier's minimum"), "{profile}: --min-bits {} not refused at the floor door: {above}", want_floor + 1);
+        assert_eq!(super::classify_tied::min_bits_floor(profile), 95);
+        eprintln!("RV16-S2 | {profile}: floor {want_floor}; --min-bits {want_floor} passes the floor door ({at}); --min-bits {} refused ({above})", want_floor + 1);
+        drop((st, bound));
+    }
+}
