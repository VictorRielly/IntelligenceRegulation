+// ------------------------------------------------------------------ S1
+
+#[test]
+fn rv16_s1_the_policies_the_r13_shieldstral_profiles_admit() {
+    let reg: Vec<String> = registered_policies().into_iter().map(|p| p.id).collect();
+    eprintln!("RV16-S1 | registered policies (production list + none test-only): {reg:?}");
+    let t128 = shield_shape(R13_SHIELD_T128_H24);
+    let tables = shield_tables();
+    let mut admitted = Vec::new();
+    for p in registered_policies() {
+        let n = t128.tokens.saturating_sub(p.prefix.len() + p.suffix.len()).max(1);
+        match ClassifierProfile::new(&t128, &tables, 1, SH_NORM, &p, n, Tier::R1_MVP) {
+            Ok(cp) => {
+                eprintln!("RV16-S1 | T128 profile door ADMITS {} (P0 {}, chunk {})", p.id, p.prefix.len(), n);
+                admitted.push((p.id.clone(), cp.p0()));
+            }
+            Err(e) => eprintln!("RV16-S1 | T128 profile door refuses {}: {e}", p.id),
+        }
+    }
+    // the card policy through the whole statement constructor (check_policy,
+    // check_for, the chunk plan): it is admitted at the R13 T128 profile
+    let card = policy_shieldstral_card();
+    let r = shield_statement(RUN_PROFILE_CLASSIFY_R13_SHIELD_T128, &t128, &tables, &card, 26);
+    eprintln!("RV16-S1 | T128 statement under {}: {}", card.id, match &r { Ok(_) => "CONSTRUCTS (admitted)".to_string(), Err(e) => format!("refused: {e}") });
+    drop(r);
+    // the real export's margin parameters (if given) are the card policy's too
+    if let Some(path) = std::env::var_os("RV16_T128_PROFILE") {
+        let j: serde_like::J = serde_like::parse(&std::fs::read(&path).unwrap());
+        let m = j.get("classifier_margin_parameters").unwrap();
+        let (yes, no, scale, c) = (m.get("yes_id").unwrap().i64().unwrap(), m.get("no_id").unwrap().i64().unwrap(), m.get("public_scale").unwrap().f64().unwrap(), m.get("threshold_c").unwrap().i64().unwrap());
+        let same = (yes as u64, no as u64, scale.to_bits(), c) == (card.yes, card.no, card.margin_scale_bits, card.c);
+        eprintln!("RV16-S1 | the real T128 export's classifier_margin_parameters (yes {yes}, no {no}, scale {scale:e}, c {c}) equal the card policy's: {same}");
+        assert!(same);
+    }
+    // ids outside the list are refused by name
+    for id in ["shieldstral-1.0-3b-strict-sexual/1", "shieldstral-1.0-3b-moderate-sexual/2", "shieldstral-1.0-3b-moderate-self-harm/1", "shieldstral-1.0-3b-card-unsafe/2"] {
+        let e = policy_by_id(id).err().expect("AN UNREGISTERED POLICY ID WAS FOUND");
+        assert!(e.contains("not a pre-registered policy"), "{e}");
+    }
+    eprintln!("RV16-S1 | admitted at the R13 Shieldstral T128 profile: {admitted:?}");
+    // the reviewer's finding, pinned: four Shieldstral policies, not three
+    assert_eq!(admitted.len(), 4, "the admitted list changed: {admitted:?}");
+    assert!(admitted.iter().any(|(id, _)| id == "shieldstral-1.0-3b-card-unsafe/1"));
+}
