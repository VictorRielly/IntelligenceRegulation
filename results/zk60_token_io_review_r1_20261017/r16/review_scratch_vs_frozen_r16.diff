+// ------------------------------------------------------------------ S3 (item 7)
+
+fn fixtures() -> PathBuf {
+    std::env::var_os("HL_R13_LOADER_FIXTURES").map(PathBuf::from).unwrap_or_else(|| std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../loader-fixtures"))
+}
+
+/// the lane's two-stage R13 rung fixture (copied: layer 1 = layer 0 with
+/// another SiLU member, so the two layers carry different gate denominators)
+fn two_stage() -> (TrainedExport, Constants, Shape, Vec<BlockPublic>, Vec<LayerRecord>) {
+    use super::super::accuracy_public::AccuracyPublic;
+    let mut ex = TrainedExport::load(&fixtures().join("r13-h24-wide")).unwrap();
+    ex.source.checkpoint_layers = 2;
+    let c = ex.run_constants(&[0]).unwrap();
+    let seed = ex.shape_for(&c).unwrap();
+    assert_eq!(seed.profile, R13_RUNG_H24);
+    let first = ex.load_layer(&seed, &c, 0, false).unwrap();
+    let a = first.blk.accuracy().unwrap();
+    let changed = AccuracyPublic::new(a.stack(), a.geometry(), a.base(), (-4, -13), a.multipliers().clone(), a.groups().to_vec(), a.group_ids().to_vec(), a.raw_tables().to_vec()).unwrap();
+    let second = first.blk.clone().with_accuracy(changed);
+    let mut r2 = LayerRecord::of_block(1, &second, vec![]);
+    r2.manifest_sha256 = [53; 32];
+    let r1 = first.record.clone();
+    assert_ne!(r1.accuracy_gate_shift, r2.accuracy_gate_shift);
+    (ex, c, seed, vec![first.blk, second], vec![r1, r2])
+}
+
+fn model_of(ex: &TrainedExport, c: &Constants, seed: &Shape, records: Vec<LayerRecord>) -> TrainedModelStatement {
+    let prov = Provenance {
+        label: format!("export:{}", ex.variant),
+        residual_unit: ex.residual_unit,
+        quantizer_sha256: ex.tool_sha256,
+        calibration_set_sha256: ex.calibration_set_sha256,
+        export_profile_sha256: ex.profile_sha256,
+        calibration_tool_sha256: ex.tool_sha256,
+        rope_theta: c.rope_theta,
+        rope_scaling: ex.rope_scaling,
+    };
+    TrainedModelStatement::new_with_tied(seed, RUN_PROFILE_CLASSIFY_R13_RUNG_H24_TEST, ex.source.clone(), IntegerCalibration::as_the_code_proves(seed, &prov), records, None).unwrap()
+}
+
+fn bound_of(seed: &Shape, model: &TrainedModelStatement) -> BoundClassifierTables {
+    let tt = super::tests::generic_tables(seed.width, 0x7276_3136);
+    let mut s = 0x7276_6d61_7267u64;
+    let w: Vec<i16> = (0..seed.width).map(|_| (super::tests::lcg(&mut s) % 20_001) as i16 - 10_000).collect();
+    let tables = ClassifierTables::new(tt.v, tt.d, tt.emb, w).unwrap();
+    BoundClassifierTables::synthetic_for_relation_tests(tables, 1, super::tests::norm(), seed, RUN_PROFILE_CLASSIFY_R13_RUNG_H24_TEST, model, &policy_rung_dev()).unwrap()
+}
+
+fn statement_of(seed: &Shape, model: &TrainedModelStatement, bound: &BoundClassifierTables, n: usize, root: Digest, verdict: u8) -> ClassifyRunStatement {
+    let digests: Vec<Digest> = model.layers.iter().map(|r| r.block_digest).collect();
+    ClassifyRunStatement::new(RunShape::new(seed.clone(), model.layers.len(), RUN_PROFILE_CLASSIFY_R13_RUNG_H24_TEST).unwrap(), super::tests::ctx(), digests, model, bound, &policy_rung_dev(), n, Tier::R1_MVP, root, verdict).unwrap()
+}
+
+fn bump(v: &mut [i16], at: usize) {
+    v[at] = if v[at] < i16::MAX - 4 { v[at] + 3 } else { v[at] - 3 };
+}
+
+/// **item 7: the activation set is not trusted.** The prover's per-layer
+/// activations (`--seq-dir` at the CLI) are witness data. With the prover's
+/// own checks OFF (a cheating prover), a wrong set — a wrong boundary, a
+/// self-consistent chain from a wrong layer-1 input, a chain from a wrong
+/// `B_in` — must not give an accepting receipt for the SEALED input (the
+/// input root of the honest content). The control (honest values, cheating
+/// guard on) verifies.
+#[test]
+fn rv16_s3_a_wrong_activation_set_yields_no_accepting_receipt() {
+    let (ex, c, seed, blocks, records) = two_stage();
+    let model = model_of(&ex, &c, &seed, records);
+    let bound = bound_of(&seed, &model);
+    let mut s = 0x7276_3136_6974_656du64;
+    let item: Vec<u64> = (0..20).map(|_| 5 + super::tests::lcg(&mut s) % 295).collect();
+    let cp = ClassifierProfile::new(&seed, bound.tables(), bound.bos(), bound.norm(), &policy_rung_dev(), item.len(), Tier::R1_MVP).unwrap();
+    let tokens = cp.tokens_of(&item).unwrap();
+    let shapes: Vec<Shape> = model.layers.iter().map(|r| r.shape_at(&seed).unwrap()).collect();
+    let spec = input_endpoint_spec(&seed, super::tests::ctx(), &cp).unwrap();
+    let honest0 = honest_classify(&shapes, &cp, bound.tables(), &blocks, &tokens).unwrap();
+    let at = cp.p0() * seed.d_pad; // the first content row, word 0
+    let mut outcomes = Vec::new();
+    for case in ["control-honest", "wrong-boundary-1", "chain-from-wrong-layer1-input", "chain-from-wrong-B_in"] {
+        let _cheat = CheatingProver::on();
+        let mut h = honest_classify(&shapes, &cp, bound.tables(), &blocks, &tokens).unwrap();
+        let mut verdict = honest0.out_values.verdict;
+        match case {
+            "control-honest" => {}
+            "wrong-boundary-1" => bump(&mut h.planes[0], at),
+            "chain-from-wrong-layer1-input" => {
+                let mut b1 = h.planes[0].clone();
+                bump(&mut b1, at);
+                let (mut ws, ps, ov, wout) = downstream(&shapes[1..], &cp, bound.tables(), &blocks[1..], &b1, false).unwrap();
+                h.witnesses[1] = ws.remove(0);
+                h.planes[0] = b1;
+                h.planes[1] = ps[0].clone();
+                h.stage_out = wout;
+                verdict = ov.verdict;
+            }
+            "chain-from-wrong-B_in" => {
+                let mut b_in = h.b_in.clone();
+                bump(&mut b_in, at);
+                let (ws, ps, ov, wout) = downstream(&shapes, &cp, bound.tables(), &blocks, &b_in, false).unwrap();
+                h.b_in = b_in;
+                h.witnesses = ws;
+                h.planes = ps;
+                h.stage_out = wout;
+                verdict = ov.verdict;
+            }
+            _ => unreachable!(),
+        }
+        // the sealed input is ALWAYS the honest content's
+        let (root, owner) = seal_input(&spec, &honest0.in_plane, &seed.hash_tag()).unwrap();
+        let st = statement_of(&seed, &model, &bound, item.len(), root, verdict);
+        let mut segments = Vec::new();
+        let proved = prove_classify_run(&st, &blocks, &bound, &mut ClassifySource(&mut h), owner, &mut |_, b| {
+            segments.push(b);
+            Ok(())
+        });
+        drop(_cheat);
+        let outcome = match proved {
+            Err(e) => format!("the prover itself refused: {e}"),
+            Ok(_) => {
+                let fresh_model = model_of(&ex, &c, &seed, model.layers.clone());
+                let fresh_bound = bound_of(&seed, &fresh_model);
+                let fresh = statement_of(&seed, &fresh_model, &fresh_bound, item.len(), root, verdict);
+                match verify_classify_run(&fresh, &blocks, &fresh_bound, &segments, VerifierPolicy { min_whole_run_bits: 95 }) {
+                    Ok(()) => "VERIFIED".to_string(),
+                    Err(e) => format!("receipt of {} segments REFUSED by the verifier: {e}", segments.len()),
+                }
+            }
+        };
+        eprintln!("RV16-S3 | {case} (verdict {verdict}): {outcome}");
+        outcomes.push((case, outcome));
+    }
+    assert_eq!(outcomes[0].1, "VERIFIED", "the control did not verify");
+    for (case, o) in &outcomes[1..] {
+        assert!(o.contains("REFUSED by the verifier"), "{case}: {o}");
+    }
+}
