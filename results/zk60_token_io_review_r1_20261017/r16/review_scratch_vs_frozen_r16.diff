+#[test]
+fn rv16_s4_the_reused_derivation_needs_its_row_of_the_block_width() {
+    use super::super::tied_tables::{RecomputedTiedTables, TiedTokenCalibration};
+    use super::super::trained_block::{sha256, TiedDerivation};
+    use super::classify_tied::{recompute_tied_classifier_pre, stub_shieldstral_recompute};
+    let root = super::classify_cli_tests::fixture_root().join(format!("rv16-s4-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let (export, tables) = (root.join("export"), root.join("tables"));
+    std::fs::create_dir_all(&export).unwrap();
+    std::fs::create_dir_all(&tables).unwrap();
+    let policy = policy_shieldstral_moderate_sexual();
+    let profile = format!("{{\"kind\": \"rv16-s4\", \"classifier_margin_parameters\": {{\"yes_id\": {}, \"no_id\": {}, \"public_scale\": {:?}, \"threshold_c\": {}}}}}\n", policy.yes, policy.no, policy.margin_scale(), policy.c);
+    std::fs::write(export.join("profile.json"), &profile).unwrap();
+    let bound = sha256(profile.as_bytes());
+    let want = (13059u32, 2649u32, policy.margin_scale_bits);
+    let fnm = super::super::tied_tables::TiedFinalNorm { g0: 127, cn: 1024, tn: 10, ceps: 2439 };
+    let t = |margin: Option<Vec<i16>>| RecomputedTiedTables { embedding_sha256: [3; 32], head_sha256: [4; 32], multipliers_sha256: [5; 32], margin, calibration: TiedTokenCalibration { bos: 1, classifier_final_norm: fnm.clone(), head_final_norm: fnm.clone(), profile_sha256: bound } };
+    let _g = stub_shieldstral_recompute(Box::new(|_: &std::path::Path, _: (u32, u32, f64)| panic!("THE CHECKPOINT WAS STREAMED A SECOND TIME")));
+    for (what, margin) in [("no row", None), ("row 3071 wide", Some(vec![1i16; 3071])), ("row 3073 wide", Some(vec![1i16; 3073]))] {
+        let pre = TiedDerivation { margin: Some(want), tables: t(margin) };
+        let e = recompute_tied_classifier_pre(TiedSource::Shieldstral, &export, &tables, &policy, 0.0, 3072, &bound, Some(&pre)).err().expect("A REUSED DERIVATION WITHOUT A BLOCK-WIDTH ROW WAS ACCEPTED");
+        eprintln!("RV16-S4 | reused derivation with {what}: refused ({e})");
+    }
+    // a statement digest other than the profile's: refused before any derivation is consulted
+    let mut other = bound;
+    other[31] ^= 0x80;
+    let pre = TiedDerivation { margin: Some(want), tables: t(Some(vec![1; 3072])) };
+    let e = recompute_tied_classifier_pre(TiedSource::Shieldstral, &export, &tables, &policy, 0.0, 3072, &other, Some(&pre)).err().unwrap();
+    assert!(e.contains("is not the profile the trained statement binds"), "{e}");
+    eprintln!("RV16-S4 | a reused derivation under another statement digest: refused at the bound-profile read ({e})");
+    let _ = std::fs::remove_dir_all(&root);
+}
