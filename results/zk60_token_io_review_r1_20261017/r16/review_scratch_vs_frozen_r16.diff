+const SH_NORM: FinalNorm = FinalNorm { g0: 127, cn: 1024, tn: 10, ceps: 2439 };
+
+fn shield_shape(block: &str) -> Shape {
+    Shape::accuracy_trained(block, &r13_census_calibration(), 9, 20).unwrap()
+}
+
+/// one V = 131,072 x d = 3,072 synthetic table set (805 MB; built once per test)
+fn shield_tables() -> ClassifierTables {
+    let (v, d) = (131_072usize, 3_072usize);
+    let emb: Vec<i16> = (0..v * d).map(|i| ((i * 7919) % 12_001) as i16 - 6_000).collect();
+    let w: Vec<i16> = (0..d).map(|i| (i as i16 % 2000) - 1000).collect();
+    ClassifierTables::new(v, d, emb, w).unwrap()
+}
+
+/// a classifier run statement at an R13 Shieldstral profile under `policy`
+/// (synthetic records, each its gate shift; the census's construction with
+/// the policy as a parameter). Clones the tables once (dropped on return).
+fn shield_statement(profile: &'static str, sh: &Shape, tables: &ClassifierTables, policy: &Policy, l: usize) -> Result<(ClassifyRunStatement, BoundClassifierTables), String> {
+    let gates: Vec<u32> = (0..l).map(|k| 17 + (k as u32 % 8)).collect();
+    let model = r13_synthetic_model(sh, profile, &gates, [9; 32], 1.0 / 512.0);
+    let digests: Vec<Digest> = model.layers.iter().map(|r| r.block_digest).collect();
+    let bound = BoundClassifierTables::synthetic_for_relation_tests(tables.clone(), 1, SH_NORM, sh, profile, &model, policy)?;
+    let n = sh.tokens - policy.prefix.len() - policy.suffix.len();
+    let st = ClassifyRunStatement::new(RunShape::new(sh.clone(), l, profile)?, super::tests::ctx(), digests, &model, &bound, policy, n, Tier::R1_MVP, [7u8; 32], 1)?;
+    Ok((st, bound))
+}
