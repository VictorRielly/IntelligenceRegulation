+    for (role, ctx) in [("transcript", zkp_core::hashtag::CTX_TRANSCRIPT), ("column", zkp_core::hashtag::CTX_COLUMN), ("leaf", zkp_core::hashtag::CTX_LEAF), ("node", zkp_core::hashtag::CTX_NODE)] {
