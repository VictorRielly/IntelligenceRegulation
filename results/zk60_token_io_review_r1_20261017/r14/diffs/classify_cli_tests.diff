+/// git work tree (the CLI refuses an owner directory inside one, TR5-3 (a)).
+/// Each fixture removes its directories on drop.
+pub(super) fn fixture_root() -> PathBuf {
+    let root = match std::env::var_os("HL_TIO_FIXTURE_DIR") {
+        Some(d) => {
+            let d = PathBuf::from(d);
+            assert!(d.is_absolute(), "HL_TIO_FIXTURE_DIR must be an absolute path");
+            d
