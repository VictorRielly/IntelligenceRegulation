+fn classify_stage_begin(r: &mut Rec, k: usize, kind: &'static str, bytes: &[u8], start_tag: [u8; 32], b_root: Option<Digest>, a_root: Digest, h_root: Digest, mask_root: Digest, planes: &StagePlanes<'_>, tr: &Transcript) {
