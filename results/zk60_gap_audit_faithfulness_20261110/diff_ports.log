-
-/-- `Enc.OnCode` says that every row of f agrees on S with a word of the code over E. -/
-theorem Enc.onCode_iff (C : Enc F) {R : Type} (f : R → Fin C.n → E) (S : Finset (Fin C.n)) :
-    C.OnCode E f S ↔ ∀ a, f a ∈ agreeOn (C.codeE E) S := by
-  constructor
-  · rintro ⟨M, hM⟩ a
-    exact ⟨_, ⟨M a, rfl⟩, fun j hj => hM j hj a⟩
-  · intro h
-    choose u hu hfu using fun a => mem_agreeOn.mp (h a)
-    choose M hM using hu
-    refine ⟨M, fun j hj a => ?_⟩
-    rw [hfu a j hj, ← hM a]
-    rfl
-
-/-- `Enc.MCA` is mutual correlated agreement of the code over E. -/
-theorem Enc.mca_iff [Finite E] (C : Enc F) (e bad : ℕ) :
-    C.MCA E e bad ↔ Code.MCA (C.codeE E) e bad := by
-  have key : ∀ (R : Type) (f₀ f₁ : R → Fin C.n → E) (θ : E),
-      (∃ S : Finset (Fin C.n),
-        C.n ≤ S.card + e ∧
-        C.OnCode E (fun a j => f₀ a j + θ * f₁ a j) S ∧
-        ¬ (C.OnCode E f₀ S ∧ C.OnCode E f₁ S)) ↔
-      (∃ S : Finset (Fin C.n),
-        Fintype.card (Fin C.n) ≤ S.card + e ∧
-        (∀ a, f₀ a + θ • f₁ a ∈ agreeOn (C.codeE E) S) ∧
-        ¬ ((∀ a, f₀ a ∈ agreeOn (C.codeE E) S) ∧ ∀ a, f₁ a ∈ agreeOn (C.codeE E) S)) := by
-    intro R f₀ f₁ θ
-    refine exists_congr fun S => ?_
-    rw [Fintype.card_fin, C.onCode_iff, C.onCode_iff, C.onCode_iff]
-    rfl
-  constructor
-  · intro h R _ f₀ f₁
-    rw [← cnt_congr (key R f₀ f₁)]
-    exact h R f₀ f₁
-  · intro h R _ f₀ f₁
-    rw [cnt_congr (key R f₀ f₁)]
-    exact h R f₀ f₁
-
-/-- If (P1) (`Enc.Props.dist`, Code/Iface.lean) holds of the generator over F with the number d, the
-code over E has distance at least d. -/
-theorem Enc.minDist_codeE (C : Enc F) {d : ℕ}
-    (h : ∀ v : Fin C.k → F, v ≠ 0 → d ≤ cnt (fun j => C.G.mulVec v j ≠ 0)) :
-    MinDist (C.codeE E) d := by
-  unfold Enc.codeE Enc.GE
-  rw [range_mulVecLin_map]
-  exact (minDist_range_mulVecLin h).extendCode
-
-/-- `mca_third` for a code with encoder. If every non-zero vector over F has an image under the
-generator with at least d non-zero symbols, and 3 e < d, then the code has mutual correlated
-agreement on lines over E at the radius e with at most e + 1 bad values. -/
-theorem Enc.mca_third [Finite E] (C : Enc F) {d e : ℕ}
-    (h : ∀ v : Fin C.k → F, v ≠ 0 → d ≤ cnt (fun j => C.G.mulVec v j ≠ 0)) (h3 : 3 * e < d) :
-    C.MCA E e (e + 1) :=
-  (C.mca_iff (E := E) e (e + 1)).mpr (Code.mca_third (C.minDist_codeE h) h3)
-
-end Interface
-
 end Code
