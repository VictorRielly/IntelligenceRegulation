-/-- The code over E of a code with encoder: the range of its generator matrix over E. -/
-def Enc.codeE (C : Enc F) (E : Type) [Field E] [Algebra F E] : Submodule E (Fin C.n → E) :=
-  LinearMap.range (C.GE E).mulVecLin
