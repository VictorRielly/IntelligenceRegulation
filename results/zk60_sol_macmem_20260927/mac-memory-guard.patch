+//! Process RSS telemetry for diagnostics and bounded heavy tests.
+//! Missing or invalid observations remain NaN so callers can fail closed.
+
+#[cfg(target_os = "linux")]
+fn linux_field_mib(status: &str, name: &str) -> f64 {
+    status
+        .lines()
+        .find(|line| line.starts_with(name))
+        .and_then(|line| line.split_whitespace().nth(1))
+        .and_then(|value| value.parse::<f64>().ok())
+        .map(|kb| kb / 1024.0)
+        .unwrap_or(f64::NAN)
+}
+
+#[cfg(target_os = "macos")]
+fn macos_peak_rss_mib() -> f64 {
+    let mut usage = std::mem::MaybeUninit::<libc::rusage>::uninit();
+    // SAFETY: getrusage initializes `usage` on success; it is not read on
+    // failure. RUSAGE_SELF queries this process, including its peak RSS.
+    if unsafe { libc::getrusage(libc::RUSAGE_SELF, usage.as_mut_ptr()) } != 0 {
+        return f64::NAN;
+    }
+    // Current XNU stores resident_size_max in bytes in ru_maxrss. A zero or
+    // negative result is not a usable memory ceiling observation.
+    let bytes = unsafe { usage.assume_init() }.ru_maxrss;
+    peak_bytes_to_mib(bytes as i64)
+}
+
+#[cfg(any(target_os = "macos", test))]
+fn peak_bytes_to_mib(bytes: i64) -> f64 {
+    if bytes <= 0 {
+        f64::NAN
+    } else {
+        bytes as f64 / (1024.0 * 1024.0)
+    }
+}
+
+pub(super) fn process_memory_mib() -> (f64, f64) {
+    #[cfg(target_os = "linux")]
+    {
+        let Ok(status) = std::fs::read_to_string("/proc/self/status") else {
+            return (f64::NAN, f64::NAN);
+        };
+        return (
+            linux_field_mib(&status, "VmRSS:"),
+            linux_field_mib(&status, "VmHWM:"),
+        );
+    }
+    #[cfg(target_os = "macos")]
+    {
+        // The phase recorder can show a process peak; current RSS was never
+        // needed for the heavy-test ceiling and has no portable std API.
+        return (f64::NAN, macos_peak_rss_mib());
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    {
+        (f64::NAN, f64::NAN)
+    }
+}
+
+pub(super) fn peak_rss_mib() -> f64 {
+    process_memory_mib().1
+}
+
+/// A ceiling must never turn an unavailable reading into a pass.
+pub(super) fn required_peak_rss_mib(observed: f64) -> Result<f64, &'static str> {
+    if observed.is_finite() && observed > 0.0 {
+        Ok(observed)
+    } else {
+        Err("peak RSS telemetry is unavailable; refusing the bounded 125M run")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unavailable_peak_never_passes_the_heavy_test_guard() {
+        for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY, 0.0, -1.0] {
+            assert!(required_peak_rss_mib(value).is_err());
+        }
+        assert_eq!(required_peak_rss_mib(11.0).unwrap(), 11.0);
+    }
+
+    #[test]
+    fn macos_peak_bytes_are_converted_without_linux_kib_scaling() {
+        assert_eq!(peak_bytes_to_mib(1024 * 1024), 1.0);
+        assert_eq!(peak_bytes_to_mib(11 * 1024 * 1024), 11.0);
+        assert!(peak_bytes_to_mib(0).is_nan());
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn linux_proc_fields_keep_the_existing_kib_to_mib_conversion() {
+        let status = "Name:\tprover\nVmRSS:\t2048 kB\nVmHWM:\t4096 kB\n";
+        assert_eq!(linux_field_mib(status, "VmRSS:"), 2.0);
+        assert_eq!(linux_field_mib(status, "VmHWM:"), 4.0);
+        assert!(linux_field_mib("VmRSS: invalid kB\n", "VmRSS:").is_nan());
+        let (current, peak) = process_memory_mib();
+        assert!(current.is_finite() && current > 0.0);
+        assert!(peak.is_finite() && peak >= current);
+    }
+}
