+    fn check(&self) -> Result<(), String> {
+        if self.kind == SourceKind::HfCheckpoint {
+            let hex_ok = self.revision.len() == 40 && self.revision.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c));
+            if !hex_ok {
