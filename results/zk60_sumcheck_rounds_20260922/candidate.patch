+/// Additive round-evaluator entry point. The original masked_prove remains
+/// the oracle for legacy callers. Evaluators return unmasked rounds; this
+/// wrapper publishes only the rounds produced by the existing CFS masker.
+pub(crate) fn masked_prove_rounds<R: sumcheck::SumcheckRounds + ?Sized>(
+    evaluator: &mut R, mask: &CfsMask, c: Fp2, tr: &mut Transcript,
+) -> (Vec<Vec<Fp2>>, Vec<Fp2>, Vec<Fp2>) {
+    assert!(!c.is_zero(), "zero mask challenge: abandon proof attempt");
+    assert_eq!(evaluator.degree(), mask.degree, "masked evaluator degree mismatch");
+    assert!(evaluator.n_vars() <= mask.n_vars, "masked evaluator variable count");
+    tr.set_masker(Box::new(CfsMasker { mask: mask.clone(), c, challenges: Vec::new() }));
+    let out = sumcheck::prove_rounds(evaluator, tr);
+    let (_, masked) = tr.take_masker();
+    (masked, out.challenges, out.finals)
+}
