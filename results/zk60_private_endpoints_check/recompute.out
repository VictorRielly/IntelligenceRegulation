binding: n_vars=127 L=256 L+256=512 OK
mask_commit assert (zk.rs:442): L + MASK_Q(256) <= 2^MASK_LOG_MSG(512)  =>  L <= 256  =>  n_vars <= 127  =>  log2 N <= 126
sum_weights (sumcheck.rs:223-224) '1u64 << n_vars'   => n_vars <= 63 => log2 N <= 62
