+    fn plane(n: usize, seed: u64) -> Vec<i8> {
+        let mut x = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+        (0..n)
+            .map(|i| {
+                x ^= x << 13;
+                x ^= x >> 7;
+                x ^= x << 17;
+                match i % 37 {
+                    0 => -128i8,
+                    1 => 127,
+                    2 => 0,
+                    3 => -1,
+                    _ => (x >> 24) as i8,
+                }
+            })
+            .collect()
+    }
