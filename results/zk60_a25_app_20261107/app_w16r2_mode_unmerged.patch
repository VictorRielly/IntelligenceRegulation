+"""DEVELOPMENT CANDIDATE (lane A25): Shieldstral classifier proofs through the resident servers,
+the 26 blocks at the UNREGISTERED W16R2 development profile. PUBLIC POSTS ONLY.
+
+PM_PROVER=shieldstral-fast-w16r2. A24's ShieldstralFastProver (the same policies, templates,
+chunk plans, statement checks, input-owner binding, category aggregate and publication gates,
+re-run by the app on the service's outputs with the same ClassifierCLI collectors), reading
+its pins from shieldstral_fast_w16r2_runtime: the A25 binary, the W16R2 development trained
+statement identity, the native servers started with `--dev-w16r2-public-content-only`, its own
+service directory and screening set. Every accepted label still comes from a FRESH verification
+in the separate resident verifier process; the app additionally checks that each verified
+statement names the W16R2 development run and block profiles and says it is development-only.
+
+Not registered for real content (efficiency plan A10 awaits Victor's ruling). Privacy
+statement PENDING (D58 covers the named r16b CPU binary only). Not production (D63).
+"""
+from . import shieldstral_fast_w16r2_runtime as runtime
+from .shieldstral_fast_prover import ShieldstralFastProver
+
+
+class ShieldstralFastW16R2Prover(ShieldstralFastProver):
+    kind = runtime.KIND
+    label = 'Shieldstral-1.0-3B classifier (resident GPU servers, W16R2 development profile: public posts only)'
+    max_running = runtime.JOBS_IN_FLIGHT
+    runtime = runtime
+    verifier_name = 'pinned A25 resident verifier (W16R2 development profile), its own process'
+    recheck_name = 'fresh A25 resident verifier (W16R2 development profile) and input-owner'
+
+    def describe(self):
+        return {**super().describe(), 'public_posts_only': True,
+                'development_profile': self.runtime.DEVELOPMENT_PROFILE}
+
+    def notes(self, describe):
+        return ['DEVELOPMENT CANDIDATE (A25): resident GPU servers; blocks at the UNREGISTERED W16R2 development '
+                'profile (public posts only; not for real content: A10 awaits Victor\'s ruling); registered moderate policies (D61).',
+                describe['privacy_status'] + ': D58 covers the named r16b CPU binary only; not production (D63).']
+
+    def check_statement(self, statement):
+        self.runtime.check_statement(statement)
