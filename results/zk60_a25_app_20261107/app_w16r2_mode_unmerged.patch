+"""[A25] The shieldstral-fast-w16r2 development candidate (the blocks at the UNREGISTERED W16R2
+development profile; public posts only): mode selection, metadata, pins, the servers' switch,
+the service tool's runtime selector and the service lifecycle, with simulated servers (never a
+native proof). A24's shieldstral-fast mode is checked unchanged beside it.
+
+The native proofs, fresh verifications and negative controls of this mode are tested natively
+(hashline `classify_w16r2_tests.rs`) and measured in results/zk60_a25_app_20261107/.
+"""
+from contextlib import contextmanager, ExitStack
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from unittest.mock import patch
+
+from native_fixtures import use_context
+from proven_media import config, fast_service, hardware_profiles
+from proven_media import shieldstral_fast_runtime as fast
+from proven_media import shieldstral_fast_w16r2_runtime as w16r2
+from proven_media.classifier_cli import ProverError
+from proven_media.classifier_privacy import statement_info
+from proven_media.items import TextItem
+from proven_media.shieldstral_text import ShieldstralTextEncoder
+from test_shieldstral_fast import FAKE_SERVER, FAKE_WRITER
+
+
+@contextmanager
+def w16r2_fixture(root):
+    """non-executable binary bytes and a stand-in writer, with their real digests (the pins'
+    checks stay active); not native validation"""
+    with ExitStack() as stack:
+        binary = root / 'NOT-A-NATIVE-PROVER-W16R2'
+        binary.write_bytes(b'TEST FIXTURE ONLY (A25): native execution must be simulated\n')
+        writer_root = root / 'writer'
+        writer_root.mkdir()
+        (writer_root / 'write_item_activations.py').write_text(FAKE_WRITER)
+        deps = {}
+        for name in ('mac_model.py', 'source-pins.json'):
+            (writer_root / name).write_text('fixture\n')
+            deps[writer_root / name] = hashlib.sha256(b'fixture\n').hexdigest()
+        sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
+        stack.enter_context(patch.object(w16r2, 'BINARY', binary))
+        stack.enter_context(patch.object(w16r2, 'BINARY_SHA', sha(binary)))
+        stack.enter_context(patch.object(w16r2, 'WRITER', writer_root / 'write_item_activations.py'))
+        stack.enter_context(patch.object(w16r2, 'WRITER_SHA', sha(writer_root / 'write_item_activations.py')))
+        stack.enter_context(patch.object(w16r2, 'WRITER_DEPENDENCIES', deps))
+        stack.enter_context(patch.object(w16r2, 'WRITER_PYTHON', sys.executable))
+        yield binary
+
+
+def statement_of(run_profile, block_profile, scope):
+    return {'run_profile': run_profile, 'block_profile': block_profile, 'scope': scope}
+
+
+class W16R2ModeTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve()
+        use_context(self, w16r2_fixture(self.root))
+        patches = [patch.dict(os.environ, {'PM_PROVER': 'shieldstral-fast-w16r2'}),
+                   patch.object(config, 'PRIVATE_DIR', self.root / 'private'),
+                   patch.object(config, 'JOBS_DIR', self.root / 'private/jobs'),
+                   patch.object(config, 'RUNS_DIR', self.root / 'public/runs'),
+                   patch.object(config, 'HOLD_FILE', self.root / 'HOLD')]
+        self.encoder = object.__new__(ShieldstralTextEncoder)
+        self.encoder.content_ids = lambda text: tuple(range(1000, 1000 + len(text.split())))
+        patches.append(patch('proven_media.shieldstral_fast_prover.ShieldstralTextEncoder', return_value=self.encoder))
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+        self.launches = []
+        from proven_media.shieldstral_fast_w16r2_prover import ShieldstralFastW16R2Prover
+        self.prover = ShieldstralFastW16R2Prover(launcher=lambda argv: self.launches.append(argv))
+        self.text = 'a calm afternoon in the garden'
+
+    def test_mode_selection_is_explicit_and_separately_screened(self):
+        from proven_media.provers import make_prover
+        self.assertEqual(config.prover_mode(), 'shieldstral-fast-w16r2')
+        self.assertTrue(config.is_shieldstral_mode())
+        self.assertEqual(config.category_set_id(), 'shieldstral-moderate-fast-w16r2-dev-v1')
+        self.assertEqual(config.deploy()['profile'], 'shieldstral-t128-fast-w16r2')
+        with patch.dict(os.environ, {'PM_PROVER': 'shieldstral-fast'}):
+            a24 = config.category_set_id()
+        with patch.dict(os.environ, {'PM_PROVER': 'shieldstral'}):
+            reviewed = config.category_set_id()
+        os.environ.pop('PM_PROVER')
+        stub = config.category_set_id()
+        os.environ['PM_PROVER'] = 'shieldstral-fast-w16r2'
+        self.assertEqual(len({a24, reviewed, stub, config.category_set_id()}), 4, 'a post screened in one mode is never finalized by another')
+        self.assertEqual(type(make_prover()).__name__, 'ShieldstralFastW16R2Prover')
+        with patch.dict(os.environ, {'PM_PROVER': 'shieldstral-fast'}):
+            with self.assertRaises(ProverError):
+                type(self.prover)(launcher=lambda argv: None)
+        self.assertEqual([c['policy_id'] for c in config.registered_categories()],
+                         [f'shieldstral-1.0-3b-moderate-{c}/1' for c in ('sexual', 'violence', 'hate')], 'D61 policies unchanged')
+
+    def test_metadata_says_w16r2_development_public_only_privacy_pending_not_production(self):
+        d = self.prover.describe()
+        self.assertEqual(d['kind'], 'shieldstral-fast-w16r2')
+        self.assertEqual((d['run_profile'], d['block_profile']), (w16r2.RUN_PROFILE, w16r2.BLOCK_PROFILE))
+        self.assertIn('unregistered', d['development_profile'])
+        self.assertIs(d['public_posts_only'], True)
+        self.assertEqual(d['privacy_status'], 'privacy statement pending')
+        self.assertFalse(d['privacy_statement']['accepted'])
+        self.assertFalse(d['privacy_statement']['permits_non_public_posts'])
+        self.assertIs(d['production'], False)
+        self.assertIs(d['development_candidate'], True)
+        self.assertEqual(d['model_digest'], w16r2.IDENTITY)
+        self.assertNotEqual(w16r2.IDENTITY, fast.IDENTITY, 'the W16R2 profile has its own trained statement identity')
+        self.assertNotEqual(w16r2.RUN_PROFILE, fast.RUN_PROFILE)
+        spoof = {**w16r2.descriptor(), 'kind': 'shieldstral', 'device': 'cpu', 'proof_mode': 'per-category',
+                 'privacy_adapter_supported': True}
+        self.assertFalse(statement_info(spoof)['accepted'], 'the W16R2 binary/profile is never D58\'s')
+
+    def test_preparation_pins_the_candidate_and_launches_its_own_service(self):
+        item = TextItem(self.text)
+        plan = self.prover.plan_text(item.text)
+        for ch in plan:
+            job = config.JOBS_DIR / 'post' / ('prove' if ch['index'] == 0 else f'prove-c{ch["index"]}')
+            self.prover.start('post', item, job, ch)
+            spec = json.loads((job / 'classifier-job.json').read_text())
+            self.assertEqual(spec['deployment']['binary_sha256'], w16r2.BINARY_SHA)
+            self.assertEqual(spec['deployment']['statement_identity'], w16r2.IDENTITY)
+            req = w16r2.service_dir() / 'spool' / (job / 'service.request').read_text().strip()
+            self.assertEqual(json.loads(req.read_text()), {'schema': 'pm-fast-request/1', 'op': 'prove', 'job': str(job.resolve())})
+        self.assertNotEqual(w16r2.service_dir(), fast.service_dir(), 'the two services share a directory')
+        self.assertEqual(len(self.launches), 1)
+        argv = self.launches[0]
+        self.assertEqual(argv[-3:], [str(w16r2.service_dir()), '--runtime', 'w16r2'])
+        self.assertEqual(argv[argv.index('--label') + 1], 'pm-fast-w16r2-service')
+        # A24's guard command is what it was (no runtime selector, its own label)
+        a24 = fast_service.guard_command(fast.service_dir(), fast)
+        self.assertEqual(a24[-1], str(fast.service_dir()))
+        self.assertEqual(a24[a24.index('--label') + 1], 'pm-fast-service')
+
+    def test_both_servers_carry_the_w16r2_switch_and_a24s_do_not(self):
+        for kind in ('prove', 'check'):
+            argv = w16r2.server_argv(kind)
+            self.assertEqual(argv[-1], '--dev-w16r2-public-content-only')
+            self.assertEqual(argv[0], str(w16r2.BINARY))
+            self.assertNotIn('--dev-w16r2-public-content-only', fast.server_argv(kind))
+        check = w16r2.server_argv('check')
+        self.assertEqual(check[check.index('--expect-statement') + 1], w16r2.IDENTITY)
+
+    def test_the_app_refuses_a_verified_statement_of_another_profile(self):
+        good = statement_of(w16r2.RUN_PROFILE, w16r2.BLOCK_PROFILE, 'a DEVELOPMENT classifier proof ... for PUBLIC development content only')
+        self.prover.check_statement(good)
+        for bad in (statement_of(fast.RUN_PROFILE, 'hashline-zk-mr1/private-block-shieldstral-3b-t128-lowh24-blocks/2', 'a classifier proof'),
+                    statement_of(w16r2.RUN_PROFILE, 'hashline-zk-mr1/private-block-shieldstral-3b-t128-lowh24-blocks/2', good['scope']),
+                    statement_of(w16r2.RUN_PROFILE, w16r2.BLOCK_PROFILE, 'a classifier proof'), None):
+            with self.assertRaises(ProverError):
+                self.prover.check_statement(bad)
+
+    def test_the_hardware_profile_validates_and_refuses_retuning(self):
+        with ExitStack() as stack:
+            src = Path(w16r2.__file__).read_text()
+            stack.enter_context(patch.object(w16r2, 'BINARY_SHA', src.split("BINARY_SHA = '")[1].split("'")[0]))
+            p = hardware_profiles.fast_w16r2_classifier_profile()
+            self.assertTrue(p['validated_against_runtime'])
+            data = json.loads(config.DEPLOY_FILE.read_text())
+            for key, value in (('prover_mode', 'shieldstral-fast'), ('public_posts_only', False), ('run_profile', fast.RUN_PROFILE)):
+                changed = json.loads(json.dumps(data))
+                changed['classifier_profiles'][hardware_profiles.FAST_W16R2_PROFILE][key] = value
+                path = self.root / f'deploy-{key}.json'
+                path.write_text(json.dumps(changed))
+                with self.assertRaises(Exception):
+                    hardware_profiles.fast_w16r2_classifier_profile(path)
+
+
+class W16R2ServiceTests(unittest.TestCase):
