+(the blocks at W16R2_SHIELD_T128_H24: D59's rate 1/2, Q = 280; stages IN-C and OUT-C
+unchanged), and that profile's own trained statement identity.
+
+Why a sibling mode and not a switch inside shieldstral-fast: every record, statement and
+receipt names its mode, binary, identity and run profile, so a W16R2 receipt is never
+mistaken for an R13 one; A24's R13 path keeps its pins and its tests byte for byte; and the
+two services keep separate directories and screening sets.
+
+Not registered for real content: efficiency plan A10 ("register W16R2 for real content")
+waits for the W16R2 privacy gate on GPU-made bundles, D60's conditions and Victor's ruling.
+D58 covers the named r16b CPU binary only: privacy statement PENDING. Not production (D63).
+"""
+from pathlib import Path
+import os
+
+from . import config, records
+from . import shieldstral_fast_runtime as base
+from .classifier_cli import Deployment, R_C3_SCHEMA, require
+
+KIND = 'shieldstral-fast-w16r2'
+# the same public export and tied tables as the R13 fast path (the profile digest still decides)
+EXPORT_ROOT = base.EXPORT_ROOT
+EXPORT = base.EXPORT
+VERIFIER_EXPORT = base.VERIFIER_EXPORT
+PROFILE_SHA = base.PROFILE_SHA
+# outside the repository (D62); the pin below is the authority. Built from lane A25's tree with
+# `--features gpu-metal`.
+BINARY = Path(os.environ.get('PM_FAST_W16R2_BINARY', str(config.HOME / 'zk60-artifacts/proven-media-fast/bin/zk60_classify.a25')))
+BINARY_SHA = '32a386ff0260df854d800ad9cb06abd57f8df5df741b80bbaa9ee73700b63a16'
+# the W16R2 development profile's trained statement identity on the R13 T128 export (it names
+# both the block profile and the run profile, so it is not the R13 identity)
+IDENTITY = 'PENDING-A25-IDENTITY'
+RUN_PROFILE = 'hashline-zk-mr1/private-classify-run-shieldstral-3b-t128-w16r2-dev-only/2'
+BLOCK_PROFILE = 'hashline-zk-mr1/private-block-shieldstral-3b-t128-lh24-w16r2/2'
+DEV_SWITCH = '--dev-w16r2-public-content-only'
+CLI_DESCRIPTION = 'zk60_classify A25 serve/check-serve, W16R2 development profile (unregistered), T128, Metal'
+# the activation writer is profile-independent (the same model arithmetic); A24's pins
+WRITER_ROOT = base.WRITER_ROOT
+WRITER = base.WRITER
+WRITER_SHA = base.WRITER_SHA
+WRITER_DEPENDENCIES = dict(base.WRITER_DEPENDENCIES)
+NATIVE_MODELS = base.NATIVE_MODELS
+WRITER_PYTHON = base.WRITER_PYTHON
+TEKKEN = base.TEKKEN
+
+# Server settings: A24's (measured on the M3 Ultra for R13); see
+# results/zk60_a25_app_20261107/README.md for the W16R2 measurements.
+PROVER_LANES = base.PROVER_LANES
+PROVER_LANE_THREADS = base.PROVER_LANE_THREADS
+WITNESS_CACHE_GIB = base.WITNESS_CACHE_GIB
+CHECK_LANES = base.CHECK_LANES
+CHECK_LANE_THREADS = base.CHECK_LANE_THREADS
+WRITER_THREADS = base.WRITER_THREADS
+WRITERS_AT_ONCE = base.WRITERS_AT_ONCE
+JOBS_IN_FLIGHT = PROVER_LANES + CHECK_LANES
+SERVICE_NEED_GIB = base.SERVICE_NEED_GIB
+SERVICE_CAP_GIB = base.SERVICE_CAP_GIB
+SERVICE_MAX_SECONDS = base.SERVICE_MAX_SECONDS
+SERVICE_IDLE_SECONDS = base.SERVICE_IDLE_SECONDS
+STEP_TIMEOUTS = dict(base.STEP_TIMEOUTS)
+# the service tool's runtime selector and the guard label (fast_service.guard_command)
+SERVICE_TOOL_ARGS = ('--runtime', 'w16r2')
+SERVICE_LABEL = 'pm-fast-w16r2-service'
+DEVELOPMENT_PROFILE = ('W16R2 development profile (unregistered; PUBLIC development posts only; '
+                       'not for real content: efficiency plan A10 awaits Victor\'s ruling)')
+
+
+def categories():
+    return base.categories()
+
+
+def templates():
+    return base.templates()
+
+
+def native_environment():
+    return base.native_environment()
+
+
+def privacy_statement():
+    from .classifier_privacy import statement_info
+    return statement_info(descriptor())
+
+
+def descriptor():
+    return {'kind': KIND, 'binary_sha256': BINARY_SHA, 'model_digest': IDENTITY,
+            'token_profile_digest': PROFILE_SHA, 'run_profile': RUN_PROFILE, 'block_profile': BLOCK_PROFILE,
+            'cli': CLI_DESCRIPTION, 'device': 'metal', 'proof_mode': 'resident-server, categories proved concurrently',
+            'development_profile': DEVELOPMENT_PROFILE,
+            'policy_ids': [c['policy_id'] for c in categories()],
+            'privacy_adapter_supported': False, 'batch_proving': False}
+
+
+def deployment(template):
+    return Deployment(BINARY, BINARY_SHA, EXPORT, VERIFIER_EXPORT, VERIFIER_EXPORT / 'token_io',
+                      IDENTITY, template.policy_id, template.chunk_size, 8, 95, False, R_C3_SCHEMA)
+
+
+def validate(deploy):
+    require(not deploy.development and deploy.binary == BINARY and deploy.binary_sha256 == BINARY_SHA
+            and deploy.statement_identity == IDENTITY and deploy.statement_schema == R_C3_SCHEMA
+            and deploy.min_bits == 95 and deploy.overlap == 8, 'deployment differs from the pinned A25 candidate')
+    by_policy = {t.policy_id: t for t in templates()}
+    require(deploy.policy in by_policy and deploy.chunk_size == by_policy[deploy.policy].chunk_size,
+            'real category or geometry changed')
+    for directory in (deploy.prover_export, deploy.verifier_export):
+        require(records.sha256_file(directory / 'profile.json') == PROFILE_SHA, 'real export profile changed')
+    require(deploy.tables.resolve() == (deploy.verifier_export / 'token_io').resolve(), 'real tied tables differ')
+    require(records.sha256_file(WRITER) == WRITER_SHA, 'activation writer differs from tested source')
+    for path, expected in WRITER_DEPENDENCIES.items():
+        require(records.sha256_file(path) == expected, 'activation writer dependency changed')
+    deploy.validate()
+
+
+def check_statement(statement):
+    """the W16R2 development statement names this mode's profiles and says it is development-only"""
+    require(isinstance(statement, dict) and statement.get('run_profile') == RUN_PROFILE
+            and statement.get('block_profile') == BLOCK_PROFILE
+            and 'DEVELOPMENT' in str(statement.get('scope', '')) and 'PUBLIC' in str(statement.get('scope', '')),
+            'statement is not the W16R2 development profile\'s')
+
+
+def service_dir():
+    return config.PRIVATE_DIR / 'fast-service-w16r2'
+
+
+def server_argv(kind):
+    """The two native servers' command lines (public paths and settings only), each with the
+    W16R2 development switch."""
+    policies = ','.join(c['policy_id'] for c in categories())
+    tables = str(VERIFIER_EXPORT / 'token_io')
+    if kind == 'prove':
+        return [str(BINARY), 'serve', '--export', str(EXPORT), '--tables', tables, '--policies', policies,
+                '--label', 'zk60-classify-verdict', '--lanes', str(PROVER_LANES),
+                '--lane-threads', str(PROVER_LANE_THREADS), '--witness-cache-gib', str(WITNESS_CACHE_GIB), DEV_SWITCH]
+    require(kind == 'check', 'unknown native server')
+    return [str(BINARY), 'check-serve', '--export', str(VERIFIER_EXPORT), '--tables', tables, '--policies', policies,
+            '--label', 'zk60-classify-verdict', '--expect-statement', IDENTITY, '--min-bits', '95',
+            '--lanes', str(CHECK_LANES), '--lane-threads', str(CHECK_LANE_THREADS), DEV_SWITCH]
