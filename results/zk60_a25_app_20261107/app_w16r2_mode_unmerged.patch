+        patches = [patch.dict(os.environ, {'PM_PROVER': 'shieldstral-fast-w16r2'}),
+                   patch.object(config, 'PRIVATE_DIR', self.root / 'private'),
+                   patch.object(config, 'JOBS_DIR', self.root / 'private/jobs'),
+                   patch.object(config, 'RUNS_DIR', self.root / 'public/runs')]
+        encoder = object.__new__(ShieldstralTextEncoder)
+        encoder.content_ids = lambda text: tuple(range(1000, 1000 + len(text.split())))
+        patches.append(patch('proven_media.shieldstral_fast_prover.ShieldstralTextEncoder', return_value=encoder))
+        self.server = self.root / 'fake_server.py'
+        self.server.write_text(FAKE_SERVER)
+        patches.append(patch.object(w16r2, 'native_environment', lambda: {}))
+        patches.append(patch.object(w16r2, 'SERVICE_IDLE_SECONDS', 600))
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+        spec = importlib.util.spec_from_file_location('fast_service_tool_w16r2', config.TOOLS_DIR / 'fast_service.py')
+        self.tool = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.tool)
+        from proven_media.shieldstral_fast_w16r2_prover import ShieldstralFastW16R2Prover
+        self.prover = ShieldstralFastW16R2Prover(launcher=lambda argv: None)
+
+    def test_the_runtime_selector(self):
+        self.assertIs(self.tool.select_runtime(['/x'])[1], fast, 'A24\'s runtime by default')
+        root, rt = self.tool.select_runtime(['/x', '--runtime', 'w16r2'])
+        self.assertEqual((root, rt.KIND), ('/x', 'shieldstral-fast-w16r2'))
+        for bad in (['/x', '--runtime', 'r14'], ['/x', '--runtime'], ['/x', 'w16r2', '--runtime']):
+            with self.assertRaises(ProverError):
+                self.tool.select_runtime(bad)
+
+    def test_a_refused_prove_fails_the_job_closed_and_stop_ends_the_service(self):
+        item = TextItem('a calm afternoon in the garden')
+        plan = self.prover.plan_text(item.text)
+        job = config.JOBS_DIR / 'post-w' / 'prove'
+        self.prover.start('post-w', item, job, plan[0])
