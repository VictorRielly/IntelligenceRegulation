+/// R4-2's generic 8B calibration (`r4_tests::generic_8b_calibration`)
+fn generic_8b() -> Shape {
+    Shape::llama3_8b_t32_trained(&NormCalibration { cn_a: 6380, cn_m: 6672, ..llama3_8b_calibration() }, 9).expect("the generic 8B shape")
