 // ---------------------------------------------------------------------------
+// [ZK60-GZC] THE PRIVATE BLOCK'S SLOT 18 (SC_FZC) MASKED SUMCHECK BODY ON THE
+// DEVICE (`gpu/fzc.rs` carries the description, the switch and the dispatch).
+// A `zkp_core::sumcheck::SumcheckRounds` evaluator: `round` returns the
+// UNMASKED sums (the unchanged `zk::masked_prove_rounds` driver masks,
+// absorbs and draws), `fold` folds at the host's challenge, `finals` returns
+// the surviving entries in table order. The R1d claim recovery is
+// `ClosureRounds::recover_one`'s, line for line.
+
+/// Seconds and COUNTED logical bytes of one device slot-18 sumcheck (or the
+/// process total). Bytes are what the kernels must read and write for the
+/// algorithm, not hardware counters.
+#[derive(Clone, Debug, Default)]
+pub struct FzcStats {
+    pub sumchecks: u64,
+    pub n: usize,
+    pub k: usize,
+    pub degree: usize,
+    pub secs_build: f64,
+    pub secs_round: f64,
+    pub secs_fused: f64,
+    pub secs_reduce: f64,
+    pub secs_fold: f64,
+    pub secs_finals: f64,
+    pub secs_total: f64,
+    pub bytes_build: u64,
+    pub bytes_h2d: u64,
+    pub bytes_round: u64,
+    pub bytes_fused: u64,
+    pub bytes_fold: u64,
+    pub pairs: u64,
+    pub evals: u64,
+}
+
+impl FzcStats {
+    fn add(&mut self, o: &FzcStats) {
+        self.sumchecks += o.sumchecks;
+        (self.n, self.k, self.degree) = (o.n, o.k, o.degree);
+        self.secs_build += o.secs_build;
+        self.secs_round += o.secs_round;
+        self.secs_fused += o.secs_fused;
+        self.secs_reduce += o.secs_reduce;
+        self.secs_fold += o.secs_fold;
+        self.secs_finals += o.secs_finals;
+        self.secs_total += o.secs_total;
+        self.bytes_build += o.bytes_build;
+        self.bytes_h2d += o.bytes_h2d;
+        self.bytes_round += o.bytes_round;
+        self.bytes_fused += o.bytes_fused;
+        self.bytes_fold += o.bytes_fold;
+        self.pairs += o.pairs;
+        self.evals += o.evals;
+    }
+    /// counted device bytes (build + rounds + fused + folds; H2D apart)
+    pub fn device_bytes(&self) -> u64 {
+        self.bytes_build + self.bytes_round + self.bytes_fused + self.bytes_fold
+    }
+    /// one report line (rates in GB/s of counted bytes over that phase's own seconds)
+    pub fn line(&self, tag: &str) -> String {
+        let gbs = |b: u64, s: f64| if s > 0.0 { b as f64 / s / 1e9 } else { 0.0 };
+        format!(
+            "{tag} | sumchecks {} | n {} k {} D {} | total {:.3} ms | build {:.3} ms ({:.1} GB/s; H2D {} B) | rounds {:.3} ms ({:.1} GB/s) | fused fold+round {:.3} ms ({:.1} GB/s) | folds {:.3} ms ({:.1} GB/s) | reduce+D2H+host {:.3} ms | finals {:.3} ms | counted device bytes {} ({:.1} GB/s over the total) | pairs {} | P evals {}",
+            self.sumchecks, self.n, self.k, self.degree,
+            self.secs_total * 1e3,
+            self.secs_build * 1e3, gbs(self.bytes_build, self.secs_build), self.bytes_h2d,
+            self.secs_round * 1e3, gbs(self.bytes_round, self.secs_round),
+            self.secs_fused * 1e3, gbs(self.bytes_fused, self.secs_fused),
+            self.secs_fold * 1e3, gbs(self.bytes_fold, self.secs_fold),
+            self.secs_reduce * 1e3, self.secs_finals * 1e3,
+            self.device_bytes(), gbs(self.device_bytes(), self.secs_total),
+            self.pairs, self.evals,
+        )
+    }
+}
+
+static FZC_TOTALS: Mutex<Option<FzcStats>> = Mutex::new(None);
+
+/// the process's accumulated device slot-18 statistics
+pub fn fzc_totals() -> FzcStats {
+    FZC_TOTALS.lock().unwrap().clone().unwrap_or_default()
+}
+
+/// [ZK60-GZC] the round kernels' source: one variant per NVRTC module,
+/// compiled at first use behind `kernels.cu`'s field-primitive section (the
+/// same code, prepended verbatim), so the main module's start-up compile is
+/// unchanged when the device slot 18 is not asked for.
+const FZC_SRC: &str = include_str!("fzc_kernels.cu");
+static FZC_COMPILE_SECS: Mutex<f64> = Mutex::new(0.0);
+
+/// seconds spent compiling the slot-18 modules in this process
+pub fn fzc_compile_secs() -> f64 {
+    *FZC_COMPILE_SECS.lock().unwrap()
+}
+
+/// `HL_GZC_LEAN=1` selects the v3 lean evaluation (staged, stepped linear
+/// forms, Karatsuba products); the default is the direct evaluation (v1/v2).
+/// Same values either way.
+fn fzc_lean() -> bool {
+    std::env::var("HL_GZC_LEAN").map(|v| v == "1").unwrap_or(false)
+}
+
+/// The NVRTC module holding `k_fzc_round` / `k_fzc_fold_round` for one
+/// (degree, gate, variant), compiled and loaded on first use.
+fn fzc_module(g: &Gpu, degree: usize, supp: bool, lean: bool) -> Result<&'static str, String> {
+    const NAMES: [&str; 8] = ["gzc_d4", "gzc_d4s", "gzc_d5", "gzc_d5s", "gzl_d4", "gzl_d4s", "gzl_d5", "gzl_d5s"];
+    if degree != 4 && degree != 5 {
+        return Err(format!("fzc: no kernel for degree {degree}"));
+    }
+    let name = NAMES[usize::from(lean) * 4 + (degree - 4) * 2 + usize::from(supp)];
+    if g.dev.has_func(name, "k_fzc_round") {
+        return Ok(name);
+    }
+    let t0 = Instant::now();
+    let prims = KSRC.find("// The probe: mul").map(|i| &KSRC[..i]).ok_or("fzc: the primitive section of kernels.cu moved")?;
+    let src = format!("#define FZ_D {degree}\n#define FZ_SUPP {}\n#define FZ_LEAN {}\n{prims}{FZC_SRC}", u8::from(supp), u8::from(lean));
+    let opts = CompileOptions { arch: arch_str(g.cc), ..Default::default() };
+    let ptx = compile_ptx_with_opts(src, opts).map_err(|e| format!("fzc NVRTC compile ({name}): {e}"))?;
+    g.dev.load_ptx(ptx, name, &["k_fzc_round", "k_fzc_fold_round", "k_fzc_spin"]).map_err(|e| format!("fzc module load ({name}): {e}"))?;
+    let secs = t0.elapsed().as_secs_f64();
+    *FZC_COMPILE_SECS.lock().unwrap() += secs;
+    if verbose() || super::fzc::profile() {
+        eprintln!("[ZK60-GZC] compiled the slot-18 module {name} in {secs:.2} s (once per process)");
+    }
+    Ok(name)
+}
+
+/// `HL_GZC_FUSED=0` keeps the separate fold and round kernels (v1); the
+/// fused fold + next round (v2) is the default. Same values either way.
+fn fzc_fused() -> bool {
+    std::env::var("HL_GZC_FUSED").map(|v| v != "0").unwrap_or(true)
+}
+
+pub struct DevFzcRounds {
+    dev: Arc<CudaDevice>,
+    tabs: Pooled,
+    k: usize,
+    /// the ORIGINAL table stride 2^n (table t lives at [t * stride, ..))
+    stride: usize,
+    n_vars: usize,
+    degree: usize,
+    /// the current PHYSICAL length of every table (pre-fold while a fold is deferred)
+    len: usize,
+    d_prm: CudaSlice<u64>,
+    d_part: CudaSlice<u64>,
+    d_sums: CudaSlice<u64>,
+    d_fin: CudaSlice<u64>,
+    supp: bool,
+    fused: bool,
+    module: &'static str,
+    blocks_cap: u32,
+    deferred: Option<Fp2>,
+    next: usize,
+    pending: Option<Vec<Fp2>>,
+    claim: Option<Fp2>,
+    finals: Vec<Fp2>,
+    err: Option<String>,
+    prof: bool,
+    st: FzcStats,
+    t0: Instant,
+    /// profile mode only: per round (entering length, kernel kind, kernel
+    /// seconds, reduce + D2H seconds), printed under `HL_GZC_ROUNDS=1`
+    rounds_log: Vec<(usize, &'static str, f64, f64)>,
+}
+
+impl DevFzcRounds {
+    /// Build the tables on the device and stage the parameters.
+    pub fn new(srcs: &[super::fzc::FzcSrc], n: usize, degree: usize, prm: &[u64], supp: bool, claim: Option<Fp2>) -> Result<DevFzcRounds, String> {
+        use super::fzc::FzcSrc;
+        let g = gpu().ok_or_else(init_err)?;
+        let g = g.lock().unwrap();
+        let dev = g.dev.clone();
+        let t0 = Instant::now();
+        let prof = super::fzc::profile();
+        if prof {
+            // diagnosis aid (profile mode only): the card's state as slot 18
+            // starts — free device memory and the pool's idle buffers
+            if let Ok((free, total)) = cu::mem_get_info() {
+                let (held, held_b) = {
+                    let pool = POOL.lock().unwrap();
+                    (pool.len(), pool.iter().map(|b| b.len() * 8).sum::<usize>())
+                };
+                println!("PB-GZC-MEM slot 18 start | device free {} MiB of {} MiB | pool holds {held} idle buffers ({} MiB)", free >> 20, total >> 20, held_b >> 20);
+            }
+        }
+        // DIAGNOSIS AID (`HL_GZC_WARM_MS=W`, off by default): before anything
+        // of slot 18 touches the device, spin a pure-arithmetic kernel (no
+        // table, no transcript, no randomness) for about W ms and report the
+        // first and last launch times: a falling spin time is the SM clock
+        // rising (the laptop GPU's DVFS), measured with no memory involved.
+        let warm_ms: f64 = std::env::var("HL_GZC_WARM_MS").ok().and_then(|v| v.parse().ok()).unwrap_or(0.0);
+        if warm_ms > 0.0 {
+            let m = fzc_module(&g, degree, supp, fzc_lean())?;
+            let f = dev.get_func(m, "k_fzc_spin").ok_or("k_fzc_spin missing")?;
+            let mut d_out = dev.alloc_zeros::<u64>(1).map_err(|e| e.to_string())?;
+            let cfg = LaunchConfig { grid_dim: ((g.sms as u32).max(1) * 8, 1, 1), block_dim: (128, 1, 1), shared_mem_bytes: 0 };
+            let tw = Instant::now();
+            let mut times: Vec<f64> = Vec::new();
+            while tw.elapsed().as_secs_f64() * 1e3 < warm_ms && times.len() < 10_000 {
+                let ts = Instant::now();
+                unsafe { f.clone().launch(cfg, (&mut d_out, 2048i32)) }.map_err(|e| format!("k_fzc_spin: {e}"))?;
+                dev.synchronize().map_err(|e| e.to_string())?;
+                times.push(ts.elapsed().as_secs_f64() * 1e6);
+            }
+            let n = times.len();
+            let q = |a: usize, b: usize| times[a..b].iter().sum::<f64>() / (b - a).max(1) as f64;
+            println!(
+                "PB-GZC-WARM slot 18 | {:.1} ms, {n} spin launches | first {:.0} us | mean of first 5 {:.0} us | mean of last 5 {:.0} us | min {:.0} us",
+                tw.elapsed().as_secs_f64() * 1e3,
+                times[0],
+                q(0, n.min(5)),
+                q(n.saturating_sub(5), n),
+                times.iter().cloned().fold(f64::INFINITY, f64::min)
+            );
+        }
+        let k = srcs.len();
+        let l = 1usize << n;
+        if n == 0 || n > 26 || l * k * 2 >= (1usize << 31) {
+            return Err(format!("fzc: cube 2^{n} x {k} tables is outside the kernel's index range"));
+        }
+        let mut st = FzcStats { sumchecks: 1, n, k, degree, ..Default::default() };
+        // AT LEAST k x 2^n Fp2 (`take_min`): inside a proof the pool holds
+        // the commitments' idle scratch (encode / Merkle buffers, ~2.9 GiB
+        // at TinyLlama T128), so the tables reuse one of those instead of
+        // adding 336 MiB of VRAM (lane finding 2026-10-17, 4 GiB rule). Every
+        // entry a kernel reads is written first (table t lives at
+        // [t * 2^n, (t + 1) * 2^n)); a longer buffer's tail is inert. It
+        // returns to the pool when this evaluator drops, before slot 19.
+        let mut tabs = Pooled::take_min(&dev, k * l * 2)?;
+        let f_fp = dev.get_func(MODULE, "k_tab_from_fp").ok_or("k_tab_from_fp missing")?;
+        let f_fp2 = dev.get_func(MODULE, "k_tab_from_fp2").ok_or("k_tab_from_fp2 missing")?;
+        let f_exp = dev.get_func(MODULE, "k_fzc_expand").ok_or("k_fzc_expand missing")?;
+        let mut keep: Vec<CudaSlice<u64>> = Vec::new();
+        for (t, sp) in srcs.iter().enumerate() {
+            let mut dst = tabs.get_mut().slice_mut(t * l * 2..(t + 1) * l * 2);
+            let cfg = LaunchConfig::for_num_elems(l as u32);
+            match sp {
+                FzcSrc::Base { dev: dc, host, off } => {
+                    match dc {
+                        Some(dc) => {
+                            if off + l > dc.data.get().len() {
+                                return Err("fzc: a plane runs past the resident commitment".into());
+                            }
+                            let src = dc.data.get().slice(*off..*off + l);
+                            unsafe { f_fp.clone().launch(cfg, (&src, &mut dst, l as i32)) }.map_err(|e| format!("k_tab_from_fp: {e}"))?;
+                        }
+                        None => {
+                            let d_src = dev.htod_sync_copy(as_u64s(&host[*off..*off + l])).map_err(|e| format!("fzc upload: {e}"))?;
+                            unsafe { f_fp.clone().launch(cfg, (&d_src, &mut dst, l as i32)) }.map_err(|e| format!("k_tab_from_fp: {e}"))?;
+                            keep.push(d_src);
+                            st.bytes_h2d += 8 * l as u64;
+                        }
+                    }
+                    st.bytes_build += 24 * l as u64;
+                }
+                FzcSrc::Pair { dev: dc, host, re, im } => {
+                    match dc {
+                        Some(dc) => {
+                            if re.max(im) + l > dc.data.get().len() {
+                                return Err("fzc: a helper runs past the resident commitment".into());
+                            }
+                            let s_re = dc.data.get().slice(*re..*re + l);
+                            let s_im = dc.data.get().slice(*im..*im + l);
+                            unsafe { f_fp2.clone().launch(cfg, (&s_re, &s_im, &mut dst, l as i32)) }.map_err(|e| format!("k_tab_from_fp2: {e}"))?;
+                        }
+                        None => {
+                            let d_re = dev.htod_sync_copy(as_u64s(&host[*re..*re + l])).map_err(|e| format!("fzc upload: {e}"))?;
+                            let d_im = dev.htod_sync_copy(as_u64s(&host[*im..*im + l])).map_err(|e| format!("fzc upload: {e}"))?;
+                            unsafe { f_fp2.clone().launch(cfg, (&d_re, &d_im, &mut dst, l as i32)) }.map_err(|e| format!("k_tab_from_fp2: {e}"))?;
+                            keep.push(d_re);
+                            keep.push(d_im);
+                            st.bytes_h2d += 16 * l as u64;
+                        }
+                    }
+                    st.bytes_build += 32 * l as u64;
+                }
+                FzcSrc::Eq { point, start } => {
+                    let bits = point.len();
+                    if start + bits > n {
+                        return Err(format!("fzc: eq table precondition start + |point| <= n violated ({start} + {bits} > {n})"));
+                    }
+                    if *start == 0 && bits == n {
+                        keep.extend(g.eq_table_into(point, &mut dst)?);
+                    } else {
+                        let m = 1usize << bits;
+                        let mut d_e = unsafe { dev.alloc::<u64>(2 * m) }.map_err(|e| e.to_string())?;
+                        keep.extend(g.eq_table_into(point, &mut d_e.slice_mut(..))?);
+                        let shift = n - start - bits;
+                        unsafe { f_exp.clone().launch(cfg, (&d_e, m as i32, shift as i32, &mut dst, l as i64)) }.map_err(|e| format!("k_fzc_expand: {e}"))?;
+                        keep.push(d_e);
+                    }
+                    st.bytes_build += 16 * l as u64;
+                }
+                FzcSrc::Host(v) => {
+                    if v.len() != l {
+                        return Err(format!("fzc: host table {t} has {} entries, the cube {l}", v.len()));
+                    }
+                    dev.htod_sync_copy_into(&as_u64s_f2(v), &mut dst).map_err(|e| format!("fzc upload: {e}"))?;
+                    st.bytes_h2d += 16 * l as u64;
+                }
+            }
+        }
+        let d_prm = dev.htod_sync_copy(prm).map_err(|e| e.to_string())?;
+        let nv = degree + 1;
+        let module = fzc_module(&g, degree, supp, fzc_lean())?;
+        let f_round = dev.get_func(module, "k_fzc_round").ok_or("k_fzc_round missing")?;
+        let occ = f_round.occupancy_max_active_blocks_per_multiprocessor(FZ_THREADS, 0, None).map_err(|e| format!("occupancy: {e}"))?.max(1);
+        let blocks_cap = (g.sms as u32).max(1) * occ;
+        let d_part = unsafe { dev.alloc::<u64>(blocks_cap as usize * nv * 2) }.map_err(|e| e.to_string())?;
+        let d_sums = unsafe { dev.alloc::<u64>(nv * 2) }.map_err(|e| e.to_string())?;
+        let d_fin = unsafe { dev.alloc::<u64>(k * 2) }.map_err(|e| e.to_string())?;
+        dev.synchronize().map_err(|e| format!("fzc build: {e}"))?;
+        drop(keep);
+        note_vram(&g);
+        st.secs_build = t0.elapsed().as_secs_f64();
+        if verbose() {
+            eprintln!("[ZK60-GZC] slot 18 device tables: 2^{n} x {k}, degree {degree}, module {module}, {} resident blocks per SM x {} SMs, built in {:.3} ms", occ, g.sms, st.secs_build * 1e3);
+        }
+        Ok(DevFzcRounds {
+            dev, tabs, k, stride: l, n_vars: n, degree, len: l, d_prm, d_part, d_sums, d_fin, supp, fused: fzc_fused(), module, blocks_cap,
+            deferred: None, next: 0, pending: None, claim, finals: Vec::new(), err: None, prof, st, t0, rounds_log: Vec::new(),
+        })
+    }
+
+    /// the first device error, if any (the caller then discards the attempt)
+    pub fn error(&self) -> Option<String> {
+        self.err.clone()
+    }
+
+    /// print this sumcheck's line (profile mode) and fold it into the process totals
+    pub fn report(&mut self) {
+        self.st.secs_total = self.t0.elapsed().as_secs_f64();
+        if self.prof {
+            println!("{}", self.st.line(&format!("PB-GZC slot 18 [{} {}]", self.module, if self.fused { "fused" } else { "unfused" })));
+            if std::env::var("HL_GZC_ROUNDS").map(|v| v == "1").unwrap_or(false) {
+                for (j, (len, kind, ks, rs)) in self.rounds_log.iter().enumerate() {
+                    println!("PB-GZC-ROUND {j} | {kind} | entering len {len} | kernel {:.1} us | reduce+D2H+host {:.1} us", ks * 1e6, rs * 1e6);
+                }
+            }
+        }
+        let mut tot = FZC_TOTALS.lock().unwrap();
+        tot.get_or_insert_with(FzcStats::default).add(&self.st);
+        stats_with(|s| s.secs_sumcheck += self.st.secs_total);
+    }
+
+    fn sync_if_prof(&self) -> Result<(), String> {
+        if self.prof {
+            self.dev.synchronize().map_err(|e| e.to_string())
+        } else {
+            Ok(())
+        }
+    }
+
+    fn try_round(&mut self, eval_one: bool) -> Result<Vec<Fp2>, String> {
+        let g = gpu().ok_or_else(init_err)?;
+        let _g = g.lock().unwrap();
+        let nv = self.degree + 1;
+        let one = i32::from(eval_one);
+        let pts = (if eval_one { nv } else { nv - 1 }) as u64;
+        let len0 = self.len;
+        let kind: &'static str = if self.deferred.is_some() { "fused fold+round" } else { "round" };
+        let ta = Instant::now();
+        let (blocks, pairs) = if let Some(r) = self.deferred.take() {
+            let hp = self.len / 2;
+            let q = hp / 2;
+            let blocks = ((q as u32 + FZ_THREADS - 1) / FZ_THREADS).clamp(1, self.blocks_cap);
+            let f = self.dev.get_func(self.module, "k_fzc_fold_round").ok_or("k_fzc_fold_round missing")?;
+            let cfg = LaunchConfig { grid_dim: (blocks, 1, 1), block_dim: (FZ_THREADS, 1, 1), shared_mem_bytes: 0 };
+            unsafe { f.launch(cfg, (self.tabs.get_mut(), hp as i32, self.stride as i64, r.c0.0, r.c1.0, &self.d_prm, one, &mut self.d_part)) }.map_err(|e| format!("k_fzc_fold_round: {e}"))?;
+            self.sync_if_prof()?;
+            self.st.secs_fused += ta.elapsed().as_secs_f64();
+            self.st.bytes_fused += 24 * (self.k * self.len) as u64;
+            self.len = hp;
+            (blocks, q)
+        } else {
+            let half = self.len / 2;
+            let blocks = ((half as u32 + FZ_THREADS - 1) / FZ_THREADS).clamp(1, self.blocks_cap);
+            let f = self.dev.get_func(self.module, "k_fzc_round").ok_or("k_fzc_round missing")?;
+            let cfg = LaunchConfig { grid_dim: (blocks, 1, 1), block_dim: (FZ_THREADS, 1, 1), shared_mem_bytes: 0 };
+            unsafe { f.launch(cfg, (self.tabs.get(), half as i32, self.stride as i64, &self.d_prm, one, &mut self.d_part)) }.map_err(|e| format!("k_fzc_round: {e}"))?;
+            self.sync_if_prof()?;
+            self.st.secs_round += ta.elapsed().as_secs_f64();
+            self.st.bytes_round += 16 * (self.k * self.len) as u64;
+            (blocks, half)
+        };
+        self.st.pairs += pairs as u64;
+        self.st.evals += pairs as u64 * pts;
+        let k_secs = ta.elapsed().as_secs_f64();
+        let tb = Instant::now();
+        let f_red = self.dev.get_func(MODULE, "k_reduce_f2").ok_or("k_reduce_f2 missing")?;
+        let cfg_r = LaunchConfig { grid_dim: (1, 1, 1), block_dim: (1024, 1, 1), shared_mem_bytes: 0 };
+        unsafe { f_red.launch(cfg_r, (&self.d_part, blocks as i32, nv as i32, &mut self.d_sums)) }.map_err(|e| format!("k_reduce_f2: {e}"))?;
+        let h = self.dev.dtoh_sync_copy(&self.d_sums).map_err(|e| e.to_string())?;
+        let r_secs = tb.elapsed().as_secs_f64();
+        self.st.secs_reduce += r_secs;
+        if self.prof {
+            self.rounds_log.push((len0, kind, k_secs, r_secs));
+        }
+        Ok((0..nv).map(|d| Fp2::new(Fp(h[2 * d]), Fp(h[2 * d + 1]))).collect())
+    }
+
+    fn try_fold(&mut self, r: Fp2) -> Result<(), String> {
+        let g = gpu().ok_or_else(init_err)?;
+        let _g = g.lock().unwrap();
+        let last = self.next + 1 >= self.n_vars;
+        if self.fused && !last && self.len >= 4 {
+            self.deferred = Some(r);
+        } else {
+            let ta = Instant::now();
+            let half = self.len / 2;
+            let f_fold = self.dev.get_func(MODULE, "k_sc_fold").ok_or("k_sc_fold missing")?;
+            let cfg = LaunchConfig::for_num_elems((self.k * half) as u32);
+            unsafe { f_fold.launch(cfg, (self.tabs.get_mut(), self.k as i32, half as i32, self.stride as i32, r.c0.0, r.c1.0)) }.map_err(|e| format!("k_sc_fold: {e}"))?;
+            self.sync_if_prof()?;
+            let f_secs = ta.elapsed().as_secs_f64();
+            self.st.secs_fold += f_secs;
+            self.st.bytes_fold += 24 * (self.k * self.len) as u64;
+            if self.prof {
+                self.rounds_log.push((self.len, "fold", f_secs, 0.0));
+            }
+            self.len = half;
+        }
+        if last {
+            let ta = Instant::now();
+            let f = self.dev.get_func(MODULE, "k_fzc_finals").ok_or("k_fzc_finals missing")?;
+            let cfg = LaunchConfig::for_num_elems(self.k as u32);
+            unsafe { f.launch(cfg, (self.tabs.get(), self.k as i32, self.stride as i64, &mut self.d_fin)) }.map_err(|e| format!("k_fzc_finals: {e}"))?;
+            let h = self.dev.dtoh_sync_copy(&self.d_fin).map_err(|e| e.to_string())?;
+            self.finals = (0..self.k).map(|t| Fp2::new(Fp(h[2 * t]), Fp(h[2 * t + 1]))).collect();
+            self.st.secs_finals += ta.elapsed().as_secs_f64();
+        }
+        Ok(())
+    }
+}
