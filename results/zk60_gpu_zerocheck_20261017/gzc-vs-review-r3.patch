+/// the split kernel's warps per block: one per term group (8 with the
+/// support indicator, 7 without; `fzc_kernels.cu` FZS_NT)
+fn fzs_groups(supp: bool) -> u32 {
+    if supp {
+        8
+    } else {
+        7
