+    __shared__ u64 red[FZ_THREADS * (D + 1) * 2];
+    for (int i = threadIdx.x; i < FZ_LEN; i += blockDim.x) sp[i] = prm[i];
+    __syncthreads();
+    f2 acc[D + 1];
+    #pragma unroll
+    for (int d = 0; d <= D; d++) acc[d] = f2_zero();
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < half; i += gridDim.x * blockDim.x)
