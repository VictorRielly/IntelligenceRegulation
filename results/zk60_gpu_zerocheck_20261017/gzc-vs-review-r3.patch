+/// [ZK60-GZC] the round kernels' block size (kernels.cu FZ_THREADS)
+const FZ_THREADS: u32 = 128;
+
+impl crate::sumcheck::SumcheckRounds for DevFzcRounds {
+    fn n_vars(&self) -> usize {
+        self.n_vars
+    }
+    fn degree(&self) -> usize {
+        self.degree
+    }
+    fn round(&mut self, j: usize) -> Vec<Fp2> {
+        assert_eq!(j, self.next, "sumcheck evaluator round order");
+        assert!(j < self.n_vars && self.pending.is_none(), "round needs the preceding fold");
+        // ClosureRounds::recover_one, line for line
+        let claim = self.claim;
+        let eval_one = claim.is_none() || cfg!(debug_assertions);
+        let mut sums = if self.err.is_some() {
+            vec![Fp2::ZERO; self.degree + 1]
+        } else {
+            match self.try_round(eval_one) {
+                Ok(s) => s,
+                Err(e) => {
+                    self.err = Some(e);
+                    vec![Fp2::ZERO; self.degree + 1]
+                }
+            }
+        };
+        if let Some(claim) = claim {
+            if self.err.is_none() {
+                debug_assert_eq!(sums[0].add(sums[1]), claim, "R1d unmasked claim mismatch (device fzc)");
+            }
+            sums[1] = claim.sub(sums[0]);
+        }
+        self.pending = Some(sums.clone());
+        sums
+    }
+    fn fold(&mut self, r: Fp2) {
+        let sums = self.pending.take().expect("fold needs a round");
+        self.claim = Some(crate::mle::interpolate_eval(&sums, r));
+        if self.err.is_none() {
+            if let Err(e) = self.try_fold(r) {
+                self.err = Some(e);
+            }
+        }
+        self.next += 1;
+    }
+    fn finals(&self) -> Vec<Fp2> {
+        assert_eq!(self.next, self.n_vars, "finals need all folds");
+        assert!(self.pending.is_none());
+        if self.err.is_some() || self.finals.len() != self.k {
+            return vec![Fp2::ZERO; self.k];
+        }
+        self.finals.clone()
+    }
+}
