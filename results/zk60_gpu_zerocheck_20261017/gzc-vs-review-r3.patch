+// eq(e, x) expanded over a cube: dst[x] = e[(x >> shift) & (m - 1)] (the
+// host's `eq_cube`: each entry of the small table repeated 2^shift times, the
+// block repeated 2^start times). A copy, no arithmetic.
+extern "C" __global__ void k_fzc_expand(const u64* __restrict__ e, int m, int shift, u64* __restrict__ dst, long long n) {
+    long long x = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (x >= n) return;
+    long long j = (x >> shift) & (long long)(m - 1);
+    dst[2 * x] = e[2 * j];
+    dst[2 * x + 1] = e[2 * j + 1];
