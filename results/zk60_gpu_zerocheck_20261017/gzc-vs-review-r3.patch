+/// [ZK60-GZC] TEST AID: a device-resident copy of a committed matrix's rows
+/// with no encoding (`enc: None`), the form the slot-18 body reads
+/// (`DevCommit.data`). Opening it is not supported (no pads, no encoding).
+pub fn dev_resident_rows(data: &[Fp], log_n: u32) -> Result<DevCommit, String> {
+    let g = gpu().ok_or_else(init_err)?;
+    let mut g = g.lock().unwrap();
+    let n = 1usize << log_n;
+    if data.is_empty() || data.len() % n != 0 {
+        return Err("resident rows: not a whole number of rows".into());
+    }
+    let dev = g.dev.clone();
+    let mut d_data = Pooled::take(&dev, data.len())?;
+    g.upload_sync(d_data.get_mut(), as_u64s(data))?;
+    Ok(DevCommit { rows: data.len() / n, log_n, log_nn: log_n, data: d_data, enc: None, zk: None })
+}
+
+/// [ZK60-GZC] the card's streaming reference for the bandwidth fractions: a
+/// device-to-device copy of `n` u64 (best of five), in GB/s with the read
+/// and the write both counted. A measurement aid; no proof path calls it.
+pub fn dev_copy_bandwidth(n: usize) -> Result<f64, String> {
+    let g = gpu().ok_or_else(init_err)?;
+    let g = g.lock().unwrap();
+    let dev = g.dev.clone();
+    let src = dev.alloc_zeros::<u64>(n).map_err(|e| e.to_string())?;
+    let mut dst = dev.alloc_zeros::<u64>(n).map_err(|e| e.to_string())?;
+    dev.synchronize().map_err(|e| e.to_string())?;
+    let mut best = f64::INFINITY;
+    for _ in 0..5 {
+        let t0 = Instant::now();
+        dev.dtod_copy(&src, &mut dst).map_err(|e| e.to_string())?;
+        dev.synchronize().map_err(|e| e.to_string())?;
+        best = best.min(t0.elapsed().as_secs_f64());
+    }
+    Ok(2.0 * 8.0 * n as f64 / best / 1e9)
+}
