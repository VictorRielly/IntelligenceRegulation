 fn pcs_hash_column(col: &[Fp]) -> Digest {
     let bytes: Vec<u8> = col.iter().flat_map(|v| v.to_bytes()).collect();
     *blake3::hash(&bytes).as_bytes()
+}
+
+/// [ZK60 D19, ruling T-1] `pcs_hash_column` under a tagged profile's COLUMN
+/// key. `pcs_hash_column` above keeps its own body; keyed BLAKE3 has no
+/// one-shot `blake3::hash` equivalent, so this builds the hasher.
+fn pcs_hash_column_keyed(col: &[Fp], key: Option<&[u8; 32]>) -> Digest {
+    let bytes: Vec<u8> = col.iter().flat_map(|v| v.to_bytes()).collect();
+    let mut h = zkp_core::hashtag::hasher(key);
+    h.update(&bytes);
+    *h.finalize().as_bytes()
 }
 
