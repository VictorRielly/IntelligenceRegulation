slotsLoop_ok : ∀ (H : HIn → Dig) (P : BlockParams) (b g a : Fp2) (sps : List SlotProof) (recs : List SlotRec) (j : ℕ)
  (acc : Block.Acc) (t : Tr) (recs' : List SlotRec) (acc' : Block.Acc) (t' : Tr),
  (∀ i < sps.length, 1 ≤ (slotShape P (j + i)).2.2) →
    slotsLoop H P b g a recs j sps acc t = Except.ok (recs', acc', t') →
      ∃ rs,
        recs' = recs ++ rs ∧
          rs.length = sps.length ∧
            ∀ (i : ℕ) (sp : SlotProof) (r : SlotRec),
              sps[i]? = some sp →
                rs[i]? = some r →
                  (r.draws, r.c, List.flatMap Fp2.toBytes [r.scalar]) = preVals H P (slotTr H P t j sps i) (j + i) sp ∧
                    r.scalar = sp.scalar ∧
                      (∃ df,
                          P.define (j + i) (histOf b g a (recs ++ List.take i rs)) r.draws = Except.ok df ∧
                            hostedSum (acc.scalars ++ List.map SlotRec.scalar (List.take i rs)) sp.scalar df.hosted =
                              Except.ok r.claimed) ∧
                        (scVerify H r.claimed (slotShape P (j + i)).2.2
                              ((slotShape P (j + i)).1 + (slotShape P (j + i)).2.1) sp.rounds
                              (runOps H (slotTr H P t j sps i) (slotPreOps P (j + i) sp))).1 =
                          Except.ok (r.fin, r.rho ++ r.es)
slotStep_ok : ∀ (H : HIn → Dig) (P : BlockParams) (s : ℕ) (hist : Hist) (sp : SlotProof) (acc : Block.Acc) (t : Tr)
  (r : SlotRec) (acc' : Block.Acc) (t' : Tr),
  slotStep H P s hist sp acc t = Except.ok (r, acc', t') →
    ∃ df,
      P.define s hist (Tr.challengeFp2Vec H t (P.draws s)).1 = Except.ok df ∧
        hostedSum acc.scalars sp.scalar df.hosted = Except.ok r.claimed ∧
          (scVerify H r.claimed (slotShape P s).2.2 ((slotShape P s).1 + (slotShape P s).2.1) sp.rounds
                  (runOps H t (slotPreOps P s sp))).1 =
              Except.ok (r.fin, r.rho ++ r.es) ∧
            t' =
                Tr.absorb H
                  (scVerify H r.claimed (slotShape P s).2.2 ((slotShape P s).1 + (slotShape P s).2.1) sp.rounds
                      (runOps H t (slotPreOps P s sp))).2
                  labPbTerm (List.flatMap Fp2.toBytes sp.terms) ∧
              r.draws = (Tr.challengeFp2Vec H t (P.draws s)).1 ∧
                r.c =
                    (Tr.challengeFp2 H
                        (Tr.absorbU64 H (Tr.challengeFp2Vec H t (P.draws s)).2 labPbSlot (UInt64.ofNat s))).1 ∧
                  r.scalar = sp.scalar ∧ acc'.scalars = acc.scalars ++ [sp.scalar]
blockSlots_eq : ∀ (H : HIn → Dig) (P : BlockParams) (core : Core) (t : Tr),
  blockSlots H P core t =
    match
      slotsLoop H P (Tr.challengeFp2 H (runOps H t (rootOpsA P core))).1
        (Tr.challengeFp2 H (Tr.challengeFp2 H (runOps H t (rootOpsA P core))).2).1
        (Tr.challengeFp2 H (Tr.challengeFp2 H (Tr.challengeFp2 H (runOps H t (rootOpsA P core))).2).2).1 [] 0 core.slots
        { } (runOps H t (rootOps P core)) with
    | Except.ok r =>
      Except.ok
        (((Tr.challengeFp2 H (runOps H t (rootOpsA P core))).1,
            (Tr.challengeFp2 H (Tr.challengeFp2 H (runOps H t (rootOpsA P core))).2).1,
            (Tr.challengeFp2 H (Tr.challengeFp2 H (Tr.challengeFp2 H (runOps H t (rootOpsA P core))).2).2).1),
          r)
    | Except.error e => Except.error e
