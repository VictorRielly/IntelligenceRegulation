+/// **[A36] `HL_A36_CORE_AHEAD`: gate G0 (correctness, no timing).** A classifier run (L = 2) proved
+/// with the switch OFF and with it ON, over a resident slice (`ResidentBlocks`), over the server's
+/// resident blocks with their kept records handed (`KeptResidentBlocks`) and over a loading source
+/// (not resident: the switch falls back to the loop as before): every receipt is accepted by the
+/// UNCHANGED verifier (`verify_classify_run`), the owner's check holds, the segment lengths are the
+/// counted ones and the same in every run, and a tampered receipt made with the switch on is
+/// refused. The thread's counters show which path ran: the A36 path makes one second stream and
+/// proves both blocks through it, and block 1's ahead work ran on a thread other than the
+/// caller's; off, and over the loading source, none of that happens.
+#[test]
+fn a36_core_ahead_proves_receipts_the_unchanged_verifier_accepts() {
+    use super::super::run::fork::KeptBlock;
+    use super::super::run::BlockRef;
+    use super::run::{KeptResidentBlocks, ResidentBlocks, TokenBlocks};
+    /// a loading source: hands blocks out through `&mut self`, claims no residency
+    struct Loading<'a>(&'a [BlockPublic]);
+    impl TokenBlocks for Loading<'_> {
+        fn count(&self) -> usize {
+            self.0.len()
+        }
+        fn block(&mut self, k: usize) -> Result<BlockRef<'_>, String> {
+            self.0.get(k).map(BlockRef::Borrowed).ok_or_else(|| format!("no block {k}"))
+        }
+    }
+    let cx = cx();
+    let c = content(&cx, 0x3636);
+    let kept: Vec<std::sync::Arc<KeptBlock>> = cx.blocks.iter().map(|b| KeptBlock::new(b.clone(), std::slice::from_ref(&cx.sh))).collect();
+    // source: 0 a resident slice, 1 the server's resident blocks with kept records handed, 2 a loading source
+    let prove = |on: bool, source: u8| -> (Run, (u64, u64, u64)) {
+        set_a36_core_ahead_for_test(Some(on));
+        let before = a36_stats();
+        let mut p = pipe(&cx, &item_tokens(&cx.policy, &c));
+        let cp = profile(&cx);
+        let (root, owner) = seal_input(&input_endpoint_spec(&cx.sh, ctx(), &cp).unwrap(), &p.in_plane, &cx.sh.hash_tag()).unwrap();
+        let st = statement(&cx, root, p.out_values.verdict).unwrap();
+        let mut segs = Vec::new();
+        let (mut res, mut kres, mut load) = (ResidentBlocks(&cx.blocks), KeptResidentBlocks(&kept), Loading(&cx.blocks));
+        let (blocks, kp): (&mut dyn TokenBlocks, Option<&[std::sync::Arc<KeptBlock>]>) = match source {
+            0 => (&mut res, None),
+            1 => (&mut kres, Some(&kept)),
+            _ => (&mut load, None),
+        };
+        let r = prove_classify_run_with(&st, blocks, kp, &cx.bound, &mut ClassifySource(&mut p), owner, &mut |_, b| {
+            segs.push(b);
