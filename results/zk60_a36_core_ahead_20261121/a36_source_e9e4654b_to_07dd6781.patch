+        set_a36_core_ahead_for_test(None);
+        let (_, dec) = r.unwrap_or_else(|e| panic!("switch {on}, source {source}: the honest run is refused: {e}"));
+        (Run { st, segs, dec }, (after.0 - before.0, after.1 - before.1, after.2 - before.2))
+    };
+    let mut lens: Option<Vec<usize>> = None;
+    let mut last_on: Option<Run> = None;
+    for (on, source) in [(false, 0u8), (false, 1), (true, 0), (true, 1), (true, 2), (false, 2)] {
+        let (r, (streams, blocks_ahead, beside)) = prove(on, source);
+        verify(&cx, &r).unwrap_or_else(|e| panic!("switch {on}, source {source}: the unchanged verifier refuses the receipt: {e}"));
+        owner_check_input(&r.st, &r.dec, &c).unwrap_or_else(|e| panic!("switch {on}, source {source}: the owner's check: {e}"));
+        let these: Vec<usize> = r.segs.iter().map(|s| s.len()).collect();
+        assert_eq!(*lens.get_or_insert_with(|| these.clone()), these, "switch {on}, source {source}: the receipt's segment lengths moved");
+        assert_eq!(these, r.st.segment_lens().unwrap(), "switch {on}, source {source}: the segments are not the counted lengths");
+        if on && source < 2 {
+            assert_eq!((streams, blocks_ahead, beside), (1, L as u64, L as u64 - 1), "switch on, source {source}: the A36 path did not run as designed (second streams, blocks proved through it, blocks 1.. worked beside the caller)");
+            last_on = Some(r);
+        } else {
+            assert_eq!((streams, blocks_ahead, beside), (0, 0, 0), "switch {on}, source {source}: the A36 path ran where it must not");
+        }
+        eprintln!("A36 G0 | switch {on} source {source}: verified; second streams {streams}, blocks through the A36 path {blocks_ahead}, blocks worked beside the caller {beside}");
+    }
