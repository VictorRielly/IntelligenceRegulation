+/// **[A36] the entropy boundary (Sol's review 492): the second stream is seeded BEFORE the header and
+/// before anything reaches the sink.** Two halves. (1) A source-order check in the style of the S25
+/// scan: in `prove_classify_run_with` the call of `core_ahead_stream` comes before the first
+/// `sink(` call, and `prove_blocks_core_ahead` contains no call of `core_ahead_stream` and no
+/// `from_os`. (2) A run check: with the switch on, the second stream's construction is already
+/// recorded when segment 0 reaches the sink (and when the run header was built); with it off, no
+/// second stream is ever made.
+#[test]
+fn a36_the_second_stream_is_seeded_before_the_header_and_before_segment_0() {
+    let text = std::fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/src/private_block/token_io/classify_run.rs")).unwrap();
+    let body_of = |signature: &str| -> String {
+        let start = text.find(signature).unwrap_or_else(|| panic!("classify_run.rs: `{signature}` is gone"));
+        let rest = &text[start..];
+        let end = rest[1..].find("\n}\n").map(|i| i + 2).unwrap_or(rest.len());
+        // code only: comment lines are prose
+        rest[..end].lines().filter(|l| !l.trim_start().starts_with("//")).collect::<Vec<_>>().join("\n")
+    };
+    let run = body_of("pub(crate) fn prove_classify_run_with(");
+    let made = run.find("core_ahead_stream(st)").expect("prove_classify_run_with no longer makes the A36 stream");
+    let header = run.find("st.transcript()").expect("the run header");
+    let first_sink = run.find("sink(").expect("the first sink call");
+    assert!(made < header && made < first_sink, "the A36 stream is no longer seeded before the header and the first sink call (Sol 492)");
+    let ahead = body_of("fn prove_blocks_core_ahead<'b>(");
+    assert!(!ahead.contains("core_ahead_stream(") && !ahead.contains("from_os"), "prove_blocks_core_ahead makes an OS-seeded stream itself");
+    assert!(ahead.contains("stream_a"), "prove_blocks_core_ahead does not take the stream as a parameter");
+    // the run check
+    let cx = cx();
+    let c = content(&cx, 0x4949);
+    for on in [true, false] {
+        set_a36_core_ahead_for_test(Some(on));
+        let before = a36_stats();
+        let headers = classify_headers();
+        let mut p = pipe(&cx, &item_tokens(&cx.policy, &c));
+        let cp = profile(&cx);
+        let (root, owner) = seal_input(&input_endpoint_spec(&cx.sh, ctx(), &cp).unwrap(), &p.in_plane, &cx.sh.hash_tag()).unwrap();
+        let st = statement(&cx, root, p.out_values.verdict).unwrap();
+        // (segment index, streams made so far, headers built so far) at each sink call
+        let mut at_sink: Vec<(usize, u64, u64)> = Vec::new();
+        let r = prove_classify_run(&st, &cx.blocks, &cx.bound, &mut ClassifySource(&mut p), owner, &mut |k, _| {
+            at_sink.push((k, a36_stats().0 - before.0, classify_headers() - headers));
+            Ok(())
+        });
+        set_a36_core_ahead_for_test(None);
+        r.unwrap_or_else(|e| panic!("switch {on}: the honest run is refused: {e}"));
+        assert_eq!(at_sink.len(), L + 2, "switch {on}: every segment reaches the sink");
+        let want_streams = u64::from(on);
+        assert_eq!(at_sink[0], (0, want_streams, 1), "switch {on}: at segment 0 the second stream must already be made (and the header built): (segment, streams, headers)");
+        assert!(at_sink.iter().all(|(_, s, _)| *s == want_streams), "switch {on}: the second stream count moved during the run: {at_sink:?}");
+    }
