              64 ≤ Lq →
                8 * Cin.R ≤ Lq →
                  (Coins → Salt) → ℕ → Protocol (Exec.QB Lq) Exec.Dig Coins (TokenRun.classifyModel S R) :=
fun {Hdr Salt Coins : Type} (S : Block.BlockShape) (R : TokenRun.ClassifyRunPublic S) (Lq : ℕ)
    (V : ProtocolClassify.RunV Hdr) (P : ProtocolClassify.RunP Hdr (S.Tok → ℕ) Coins)
    (Cin : Exec.PlaneCommit (S.Tok → ℕ) (ProtocolClassify.ClsStmt Hdr) Salt) (h64 : 64 ≤ Lq) (hr : 8 * Cin.R ≤ Lq)
    (base : Coins → Salt) (e : ℕ) =>
  { Stmt := ProtocolClassify.ClsStmt Hdr, Receipt := ProtocolClassify.ClsReceipt, Salt := Salt,
    Leak := ProtocolClassify.ClsLeak, leak := ProtocolClassify.clsLeak S R,
    ypub := fun (s : ProtocolClassify.ClsStmt Hdr) => s.verdict,
    opensIn :=
      fun (G : Exec.QB Lq → Exec.Dig) (s : ProtocolClassify.ClsStmt Hdr) (x : (TokenRun.classifyModel S R).Input)
        (r : Salt) =>
      Cin.OpensU Lq h64 hr e G s x r,
    opensOut :=
      fun (G : Exec.QB Lq → Exec.Dig) (s : ProtocolClassify.ClsStmt Hdr) (y : (TokenRun.classifyModel S R).HidOut)
        (r : Salt) =>
      Exec.opensUnit G s y r,
    prove :=
      fun (G : Exec.QB Lq → Exec.Dig) (x : (TokenRun.classifyModel S R).Weights)
        (x_1 : (TokenRun.classifyModel S R).Input) (c : Coins) =>
      ProtocolClassify.runProve V P (TokenRun.classifyModel S R).admissible (Exec.liftH G)
        (ProtocolClassify.honestRoot Cin Lq h64 hr G x_1 (base c)) ((TokenRun.classifySpec R x_1).getD 0) x_1 c,
    verify :=
      fun (G : Exec.QB Lq → Exec.Dig) (x : (TokenRun.classifyModel S R).Weights) (s : ProtocolClassify.ClsStmt Hdr)
        (rc : ProtocolClassify.ClsReceipt) =>
      ProtocolClassify.okB (ProtocolClassify.classifyVerifyE V (Exec.liftH G) s rc) }
