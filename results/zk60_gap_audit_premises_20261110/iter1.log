constructor:
  ZK60.ProtocolClassify.ClassifyOpen.mk {S : Block.BlockShape} {Hdr Salt Coins : Type} [Fintype Coins] [Nonempty Coins]
    [Inhabited Coins] {K : Type} [Field K] [Algebra Circuit.GF K] {R : TokenRun.ClassifyRunPublic S} {Lq : ℕ}
    {V : ProtocolClassify.RunV Hdr} {P : ProtocolClassify.RunP Hdr (S.Tok → ℕ) Coins}
    {Cin : Exec.PlaneCommit (S.Tok → ℕ) (ProtocolClassify.ClsStmt Hdr) Salt} {h64 : 64 ≤ Lq} {hr : 8 * Cin.R ≤ Lq}
    {hon : ProtocolClassify.HonestIn Coins Cin} {U : K} {ι : Type} [Fintype ι]
    {site : (S.Tok → ℕ) → ι → ProtocolClassify.Site (Exec.QB Lq) Coins K} {kOf : ι → ℕ} {δOf : ι → ENNReal}
    {E :
      List (Exec.QB Lq × Exec.Dig) →
        ProtocolClassify.ClsStmt Hdr → ProtocolClassify.ClsReceipt → ProtocolClassify.RunExt S Salt}
    {εin εblk εout εep : ℕ → ENNReal} {εzk : ℕ → ℕ → ENNReal} (shape : S.Valid) (weights : ∀ B ∈ R.Ps, B.Valid)
    (inPub : R.inp.Valid) (outPub : R.out.Valid) (blocks : 0 < R.Ps.length ∧ V.L = R.Ps.length)
    (commit :
      (∀ (x : S.Tok → ℕ), (∀ (t : S.Tok), x t < Circuit.gP) → Cin.ok x) ∧
        Cin.N ≤ 2 ^ Cin.depth ∧ (∀ (s : ProtocolClassify.ClsStmt Hdr), Cin.root s = s.inRoot) ∧ Cin.depth ≤ 64)
    (policy : V.preA P.hdr = Except.ok () ∧ V.preB P.hdr = Except.ok ())
    (parts :
      List.Forall₂
        (ProtocolClassify.SegComplete (TokenRun.classifyModel S R).admissible Exec.liftH
          (ProtocolClassify.clsStmtOf R Lq P Cin h64 hr hon.base))
        (P.parts V.L) V.parts)
    (refuse :
      ∀ (x : (TokenRun.classifyModel S R).Input),
        (TokenRun.classifyModel S R).admissible x →
          ∀ (G : Exec.QB Lq → Exec.Dig) (c : Coins),
            (∀ (i : ι), ¬ProtocolClassify.Site.fires U (site x i) G c) →
              ∃ (r : List (List UInt8) × ProtocolClassify.Carry × Exec.Tr),
                ProtocolClassify.honestSegs V P (Exec.liftH G)
                    (ProtocolClassify.honestRoot Cin Lq h64 hr G x (hon.base c)) ((TokenRun.classifySpec R x).getD 0) x
                    c =
                  Except.ok r)
    (counts :
      (∀ (x : S.Tok → ℕ) (i : ι), (site x i).k ≤ kOf i) ∧
        (∀ (x : S.Tok → ℕ) (i : ι), (site x i).δ ≤ δOf i) ∧ ∑ i : ι, kOf i ≤ 2 ^ 85 ∧ ∑ i : ι, δOf i ≤ 2⁻¹ ^ 41)
    (extIn :
      ∀ (q : ℕ) (A : OC (Exec.QB Lq) Exec.Dig (ProtocolClassify.ClsStmt Hdr × ProtocolClassify.ClsReceipt)),
        A.Bounded q →
          (prH fun (G : Exec.QB Lq → Exec.Dig) =>
              (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base).verify G () (OC.runLog G A).1.1
                    (OC.runLog G A).1.2 =
                  true ∧
                ¬ProtocolClassify.InOk R (E (OC.runLog G A).2 (OC.runLog G A).1.1 (OC.runLog G A).1.2)) ≤
            εin q)
    (extBlocks :
      ∀ (q : ℕ) (A : OC (Exec.QB Lq) Exec.Dig (ProtocolClassify.ClsStmt Hdr × ProtocolClassify.ClsReceipt)),
        A.Bounded q →
          (prH fun (G : Exec.QB Lq → Exec.Dig) =>
              (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base).verify G () (OC.runLog G A).1.1
                    (OC.runLog G A).1.2 =
                  true ∧
                ¬ProtocolClassify.BlocksOk R (E (OC.runLog G A).2 (OC.runLog G A).1.1 (OC.runLog G A).1.2)) ≤
            εblk q)
    (extOut :
      ∀ (q : ℕ) (A : OC (Exec.QB Lq) Exec.Dig (ProtocolClassify.ClsStmt Hdr × ProtocolClassify.ClsReceipt)),
        A.Bounded q →
          (prH fun (G : Exec.QB Lq → Exec.Dig) =>
              (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base).verify G () (OC.runLog G A).1.1
                    (OC.runLog G A).1.2 =
                  true ∧
                ¬ProtocolClassify.OutOk R
                    ((ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base).ypub (OC.runLog G A).1.1)
                    (E (OC.runLog G A).2 (OC.runLog G A).1.1 (OC.runLog G A).1.2)) ≤
            εout q)
    (extEp :
      ∀ (q : ℕ) (A : OC (Exec.QB Lq) Exec.Dig (ProtocolClassify.ClsStmt Hdr × ProtocolClassify.ClsReceipt)),
        A.Bounded q →
          (prH fun (G : Exec.QB Lq → Exec.Dig) =>
              (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base).verify G () (OC.runLog G A).1.1
                    (OC.runLog G A).1.2 =
                  true ∧
                ¬ProtocolClassify.EpOk (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base) G
                    (OC.runLog G A).1.1 (E (OC.runLog G A).2 (OC.runLog G A).1.1 (OC.runLog G A).1.2)) ≤
            εep q)
    (zk :
      ZeroKnowledge (TokenRun.classifyModel S R) (ProtocolClassify.classifyProtocol S R Lq V P Cin h64 hr hon.base)
        εzk) :
    ProtocolClassify.ClassifyOpen R Lq V P Cin h64 hr hon U site kOf δOf E εin εblk εout εep εzk
