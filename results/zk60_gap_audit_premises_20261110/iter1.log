  ZK60.ProtocolClassify.XTest.mk {F κ μ Cl : Type} [Field F] [Fintype F] [DecidableEq F] [Fintype κ] [DecidableEq κ]
    [Fintype Cl] [DecidableEq Cl] {h : ℕ} (enc : (μ → F) →ₗ[F] Fin (2 ^ h) → F) (d e A : ℕ)
    (hd : Code.MinDist enc.range d) (h2 : 2 * e < d) (hA : e + 1 ≤ A) (hAN : A ≤ 2 ^ h)
    (hca : Code.CAOn Unit enc.range e A) (d₀ : Sound.Dg) (w0 : ℕ) (chalLR : (Fin w0 → Sound.Dg) → (Cl → F) × (κ → F))
    (βLR : ENNReal)
    (hLR :
      ∀ (Ev : (Cl → F) × (κ → F) → Prop),
        (PMF.uniformOfFintype (Fin w0 → Sound.Dg)).toOuterMeasure {b : Fin w0 → Sound.Dg | Ev (chalLR b)} ≤
          (PMF.uniformOfFintype ((Cl → F) × (κ → F))).toOuterMeasure {y : (Cl → F) × (κ → F) | Ev y} * βLR)
    (m nQ : ℕ) (chalJ : (Fin m → Sound.Dg) → Fin nQ → Fin (2 ^ h)) (βJ : ENNReal)
