def ZK60.ProtocolClassify.InOk : {S : ZK60.Block.BlockShape} →
  ZK60.TokenRun.ClassifyRunPublic S → {Salt : Type} → ZK60.ProtocolClassify.RunExt S Salt → Prop :=
fun {S : ZK60.Block.BlockShape} (R : ZK60.TokenRun.ClassifyRunPublic S) {Salt : Type}
    (e : ZK60.ProtocolClassify.RunExt S Salt) =>
  ZK60.TokenRun.InSat R.inp e.tokW (e.planes 0) ∧ ∀ (t : S.Tok), e.epW t = e.tokW t
def ZK60.ProtocolClassify.OutOk : {S : ZK60.Block.BlockShape} →
  ZK60.TokenRun.ClassifyRunPublic S → {Salt : Type} → ℕ → ZK60.ProtocolClassify.RunExt S Salt → Prop :=
fun {S : ZK60.Block.BlockShape} (R : ZK60.TokenRun.ClassifyRunPublic S) {Salt : Type} (b : ℕ)
    (e : ZK60.ProtocolClassify.RunExt S Salt) =>
  b ≤ 1 ∧ ZK60.Out.OutCSat R.out e.xC b ∧ ∀ (i : Fin S.d), e.xC i = e.planes R.Ps.length (R.row, i)
def ZK60.ProtocolClassify.BlockOn : {S : ZK60.Block.BlockShape} →
  ZK60.Block.BlockPublic S → (S.Pos → ZK60.Circuit.GF) → (S.Pos → ZK60.Circuit.GF) → Prop :=
fun {S : ZK60.Block.BlockShape} (P : ZK60.Block.BlockPublic S) (Xin Xout : S.Pos → ZK60.Circuit.GF) =>
  ∃ (x : S.Pos → ℤ) (x' : S.Pos → ℤ),
    (∀ (p : S.Pos), ZK60.Block.i16 (x p)) ∧
      (∀ (p : S.Pos), ZK60.Block.i16 (x' p)) ∧
        (∀ (p : S.Pos), Xin p = ↑(x p)) ∧
          (∀ (p : S.Pos), Xout p = ↑(x' p)) ∧
            ∃ (w : ZK60.Block.BlockWit S),
              ZK60.Block.BlockSat P (fun (p : S.Pos) => ↑(x p)) (fun (p : S.Pos) => ↑(x' p)) w
