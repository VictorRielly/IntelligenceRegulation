def ZK60.ProtocolClassify.SegComplete : {St X Coins Γ : Type} →
  (X → Prop) →
    (Γ → ZK60.Exec.HIn → ZK60.Exec.Dig) →
      (Γ → X → Coins → St) → ZK60.ProtocolClassify.SegP St X Coins → ZK60.ProtocolClassify.SegV St → Prop :=
fun {St X Coins Γ : Type} (adm : X → Prop) (hOf : Γ → ZK60.Exec.HIn → ZK60.Exec.Dig) (stOf : Γ → X → Coins → St)
    (p : ZK60.ProtocolClassify.SegP St X Coins) (v : ZK60.ProtocolClassify.SegV St) =>
  ∀ (g : Γ) (x : X) (c : Coins) (bnd : ZK60.Exec.Dig) (cr : ZK60.ProtocolClassify.Carry) (t : ZK60.Exec.Tr)
    (enc : ZK60.Exec.Dig → List UInt8) (cr' : ZK60.ProtocolClassify.Carry) (t' : ZK60.Exec.Tr),
    adm x →
      p.run (hOf g) (stOf g x c) x c bnd (ZK60.Exec.Block.posTag (hOf g) t) cr t = Except.ok (enc, cr', t') →
        v.run (hOf g) (stOf g x c) (enc (ZK60.Exec.Block.posTag (hOf g) t')) bnd (ZK60.Exec.Block.posTag (hOf g) t) cr
            t =
          Except.ok (cr', t', ZK60.Exec.Block.posTag (hOf g) t')
