+    /// A small STRICT JSON reader, independent of `js`: no raw control bytes in
+    /// strings, the standard escapes and `\uXXXX` (this writer never emits a
+    /// surrogate escape), and no trailing bytes. The crate has no JSON
+    /// dependency, so the round-trip is checked against this and against
+    /// trusted literals.
+    #[derive(Debug, Clone, PartialEq)]
+    enum J {
+        Null,
+        Bool(bool),
+        Num(String),
+        Str(String),
+        Arr(Vec<J>),
+        Obj(Vec<(String, J)>),
+    }
+
+    struct Rd<'a> {
+        b: &'a [u8],
+        i: usize,
+    }
+
+    fn parse_json(s: &str) -> Result<J, String> {
+        let mut p = Rd { b: s.as_bytes(), i: 0 };
+        let v = p.value()?;
+        p.ws();
+        if p.i != p.b.len() {
+            return Err("trailing bytes after the JSON value".into());
+        }
+        Ok(v)
+    }
+
+    impl Rd<'_> {
+        fn ws(&mut self) {
+            while self.i < self.b.len() && matches!(self.b[self.i], b' ' | b'\t' | b'\n' | b'\r') {
+                self.i += 1;
+            }
+        }
+        fn lit(&mut self, w: &str, v: J) -> Result<J, String> {
+            if self.b[self.i..].starts_with(w.as_bytes()) {
+                self.i += w.len();
+                Ok(v)
+            } else {
+                Err(format!("bad literal at {}", self.i))
+            }
+        }
+        fn value(&mut self) -> Result<J, String> {
+            self.ws();
+            match self.b.get(self.i).copied() {
+                Some(b'{') => self.object(),
+                Some(b'[') => self.array(),
+                Some(b'"') => Ok(J::Str(self.string()?)),
+                Some(b't') => self.lit("true", J::Bool(true)),
+                Some(b'f') => self.lit("false", J::Bool(false)),
+                Some(b'n') => self.lit("null", J::Null),
+                Some(c) if c == b'-' || c.is_ascii_digit() => {
+                    let st = self.i;
+                    while self.i < self.b.len() && (self.b[self.i].is_ascii_digit() || b"-+.eE".contains(&self.b[self.i])) {
+                        self.i += 1;
+                    }
+                    Ok(J::Num(String::from_utf8(self.b[st..self.i].to_vec()).unwrap()))
+                }
+                _ => Err(format!("no JSON value at byte {}", self.i)),
+            }
+        }
+        fn string(&mut self) -> Result<String, String> {
+            self.i += 1;
+            let mut out: Vec<u8> = Vec::new();
+            loop {
+                let c = *self.b.get(self.i).ok_or("unterminated string")?;
+                self.i += 1;
+                match c {
+                    b'"' => return String::from_utf8(out).map_err(|e| e.to_string()),
+                    b'\\' => {
+                        let e = *self.b.get(self.i).ok_or("dangling escape")?;
+                        self.i += 1;
+                        match e {
+                            b'"' => out.push(b'"'),
+                            b'\\' => out.push(b'\\'),
+                            b'/' => out.push(b'/'),
+                            b'b' => out.push(8),
+                            b'f' => out.push(12),
+                            b'n' => out.push(b'\n'),
+                            b'r' => out.push(b'\r'),
+                            b't' => out.push(b'\t'),
+                            b'u' => {
+                                let h = std::str::from_utf8(self.b.get(self.i..self.i + 4).ok_or("short \\u escape")?).map_err(|e| e.to_string())?;
+                                let cp = u32::from_str_radix(h, 16).map_err(|e| e.to_string())?;
+                                self.i += 4;
+                                let ch = char::from_u32(cp).ok_or("a surrogate \\u escape, which this writer never emits")?;
+                                let mut tmp = [0u8; 4];
+                                out.extend_from_slice(ch.encode_utf8(&mut tmp).as_bytes());
+                            }
+                            _ => return Err("unknown escape".into()),
+                        }
+                    }
+                    0..=0x1f => return Err(format!("a raw control byte {c:#04x} inside a string")),
+                    _ => out.push(c),
+                }
+            }
+        }
+        fn array(&mut self) -> Result<J, String> {
+            self.i += 1;
+            let mut v = Vec::new();
+            self.ws();
+            if self.b.get(self.i) == Some(&b']') {
+                self.i += 1;
+                return Ok(J::Arr(v));
+            }
+            loop {
+                v.push(self.value()?);
+                self.ws();
+                match self.b.get(self.i) {
+                    Some(b',') => self.i += 1,
+                    Some(b']') => {
+                        self.i += 1;
+                        return Ok(J::Arr(v));
+                    }
+                    _ => return Err("unterminated array".into()),
+                }
+            }
+        }
+        fn object(&mut self) -> Result<J, String> {
+            self.i += 1;
+            let mut v: Vec<(String, J)> = Vec::new();
+            self.ws();
+            if self.b.get(self.i) == Some(&b'}') {
+                self.i += 1;
+                return Ok(J::Obj(v));
+            }
+            loop {
+                self.ws();
+                if self.b.get(self.i) != Some(&b'"') {
+                    return Err("an object key is not a string".into());
+                }
+                let k = self.string()?;
+                self.ws();
+                if self.b.get(self.i) != Some(&b':') {
+                    return Err("no colon after a key".into());
+                }
+                self.i += 1;
+                let val = self.value()?;
+                v.push((k, val));
+                self.ws();
+                match self.b.get(self.i) {
+                    Some(b',') => self.i += 1,
+                    Some(b'}') => {
+                        self.i += 1;
+                        return Ok(J::Obj(v));
+                    }
+                    _ => return Err("unterminated object".into()),
+                }
+            }
+        }
+    }
