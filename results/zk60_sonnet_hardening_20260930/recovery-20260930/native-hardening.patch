+
+fn read_segment_bounded(source: impl std::io::Read, max: usize) -> Result<Vec<u8>, String> {
+    use std::io::Read;
+    let limit = u64::try_from(max).ok().and_then(|n| n.checked_add(1))
+        .ok_or_else(|| "invalid segment read bound".to_string())?;
+    let mut bytes = Vec::new();
+    source.take(limit).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+    if bytes.len() > max {
+        return Err("segment exceeds the wire bound while being read".into());
+    }
+    Ok(bytes)
+}
