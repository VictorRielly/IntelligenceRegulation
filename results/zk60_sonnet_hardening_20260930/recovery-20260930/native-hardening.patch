+/// Read everything `r` yields, but never more than `max` bytes are accepted and
+/// never more than `max + 1` are READ: a source that grows, or lies about its
+/// length, is cut off at the cap and refused, not read to its end. `hint` only
+/// sizes the first allocation.
+fn read_capped<R: Read>(r: R, max: u64, hint: u64) -> Result<Vec<u8>, String> {
+    let mut buf = Vec::with_capacity(hint.min(max) as usize);
+    r.take(max.saturating_add(1)).read_to_end(&mut buf).map_err(|e| e.to_string())?;
+    if buf.len() as u64 > max {
+        return Err(format!("larger than the {max}-byte bound"));
+    }
+    Ok(buf)
+}
