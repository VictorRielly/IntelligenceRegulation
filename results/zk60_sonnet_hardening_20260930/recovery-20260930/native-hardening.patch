+#[cfg(test)]
+mod bounded_segment_tests {
+    use super::read_segment_bounded;
+    use std::io::{self, Read};
+
+    #[test]
+    fn a_growing_segment_cannot_make_the_reader_consume_past_its_bound() {
+        struct Growing { consumed: usize }
+        impl Read for Growing {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                self.consumed += buf.len();
+                assert!(self.consumed <= 33, "reader consumed beyond max + 1");
+                buf.fill(0);
+                Ok(buf.len())
+            }
+        }
+        let error = read_segment_bounded(Growing { consumed: 0 }, 32).unwrap_err();
+        assert!(error.contains("exceeds the wire bound"));
+    }
+
+    #[test]
+    fn bounded_reads_preserve_exact_bytes_and_report_io_errors() {
+        let bytes: Vec<u8> = (0..32).collect();
+        assert_eq!(read_segment_bounded(bytes.as_slice(), 32).unwrap(), bytes);
+        assert!(read_segment_bounded(bytes.as_slice(), 31).is_err());
+        struct Fails;
+        impl Read for Fails {
+            fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+                Err(io::Error::new(io::ErrorKind::UnexpectedEof, "interrupted segment"))
+            }
+        }
+        assert!(read_segment_bounded(Fails, 32).unwrap_err().contains("interrupted segment"));
+    }
