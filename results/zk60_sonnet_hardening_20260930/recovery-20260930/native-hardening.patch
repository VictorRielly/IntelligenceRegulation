+    fn capture<T>(f: impl FnOnce() -> T) -> (T, Vec<String>) {
+        CAPTURE.with(|c| *c.borrow_mut() = Some(Vec::new()));
+        let r = f();
+        let lines = CAPTURE.with(|c| c.borrow_mut().take().unwrap());
+        (r, lines)
+    }
