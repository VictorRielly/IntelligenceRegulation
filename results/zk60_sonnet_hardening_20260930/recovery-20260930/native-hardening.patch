+    /// item 3: the cap is enforced on the bytes read, not on a length someone promised
+    #[test]
+    fn the_bounded_reader_stops_a_growing_or_lying_source_at_the_cap() {
+        use std::cell::Cell;
+        use std::rc::Rc;
+        struct Count<R> {
+            r: R,
+            n: Rc<Cell<u64>>,
+        }
+        impl<R: Read> Read for Count<R> {
+            fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+                let k = self.r.read(buf)?;
+                self.n.set(self.n.get() + k as u64);
+                Ok(k)
+            }
+        }
+        // an endless source (the limit case of a file that keeps growing) is cut at max + 1 bytes read
+        let n = Rc::new(Cell::new(0));
+        let e = read_capped(Count { r: std::io::repeat(7), n: n.clone() }, 1000, 0).unwrap_err();
+        assert!(e.contains("larger than the 1000-byte bound"), "{e}");
+        assert_eq!(n.get(), 1001, "more than max + 1 bytes were read");
+        // exactly `max` is accepted, one more is not
+        assert_eq!(read_capped(std::io::repeat(1).take(1000), 1000, 1000).unwrap().len(), 1000);
+        assert!(read_capped(std::io::repeat(1).take(1001), 1000, 1000).is_err());
+        // a wild length hint does not size an allocation past the cap
+        assert_eq!(read_capped(&b"abc"[..], 10, u64::MAX).unwrap(), b"abc");
+    }
