+    /// a POSIX-shell word splitter that REFUSES any unquoted expansion or
+    /// control metacharacter: it proves both that quoting round-trips and that
+    /// nothing hostile is left bare. It executes nothing.
+    fn sh_split(line: &str) -> Result<Vec<String>, String> {
+        let mut words = Vec::new();
+        let mut cur = String::new();
+        let (mut in_word, mut quoted) = (false, false);
+        let mut it = line.chars();
+        while let Some(c) = it.next() {
+            if quoted {
+                if c == '\'' {
+                    quoted = false;
+                } else {
+                    cur.push(c);
+                }
+                continue;
+            }
+            match c {
+                '\'' => {
+                    quoted = true;
+                    in_word = true;
+                }
+                ' ' | '\t' | '\n' => {
+                    if in_word {
+                        words.push(std::mem::take(&mut cur));
+                        in_word = false;
+                    }
+                }
+                '\\' => {
+                    cur.push(it.next().ok_or("a dangling backslash")?);
+                    in_word = true;
+                }
+                '$' | '`' | '"' | ';' | '&' | '|' | '<' | '>' | '(' | ')' | '*' | '?' | '[' | ']' | '~' | '#' | '!' | '{' | '}' => return Err(format!("an unquoted metacharacter {c:?}")),
+                c => {
+                    cur.push(c);
+                    in_word = true;
+                }
+            }
+        }
+        if quoted {
+            return Err("an unterminated quote".into());
+        }
+        if in_word {
+            words.push(cur);
+        }
+        Ok(words)
+    }
