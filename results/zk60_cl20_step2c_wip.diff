+use super::statement::{rem_index, rem_rows, tag_rem_v3, Layout, TAG_ACT16, TAG_INT16};
+use super::witness::Witness;
+use crate::field::{batch_inverse2, Fp, Fp2};
+use crate::mle::eq_table_msb;
+use rayon::prelude::*;
+
+pub fn to_fp_i32(v: &[i32]) -> Vec<Fp> {
+    v.par_iter().map(|&x| Fp::from_i64(x as i64)).collect()
+}
+pub fn to_fp2_i32(v: &[i32]) -> Vec<Fp2> {
+    v.par_iter().map(|&x| Fp2::from_i64(x as i64)).collect()
+}
+
+/// Evaluate several base-field slices at one point (one eq table).
+pub fn eval_many(data: &[Fp], slices: &[(usize, usize)], point: &[Fp2]) -> Vec<Fp2> {
+    let eq = eq_table_msb(point);
+    slices
+        .iter()
+        .map(|&(off, len)| {
+            assert_eq!(len, eq.len());
+            data[off..off + len].par_iter().zip(eq.par_iter()).map(|(a, e)| e.mul_base(*a)).reduce(|| Fp2::ZERO, |a, b| a.add(b))
+        })
+        .collect()
+}
+
+pub fn sum_fp2(v: &[Fp2]) -> Fp2 {
+    v.par_iter().copied().reduce(|| Fp2::ZERO, |a, b| a.add(b))
+}
+
+/// The LogUp helper column h = 1/(alpha - l1) + 1/(alpha - l2).
+pub fn helper_column(l1: &[Fp2], l2: &[Fp2], alpha: Fp2) -> Vec<Fp2> {
+    let n = l1.len();
+    let mut den: Vec<Fp2> = Vec::with_capacity(2 * n);
+    den.extend(l1.iter().map(|v| alpha.sub(*v)));
+    den.extend(l2.iter().map(|v| alpha.sub(*v)));
+    den.par_chunks_mut(4096).for_each(|c| batch_inverse2(c));
+    (0..n).into_par_iter().map(|i| den[i].add(den[n + i])).collect()
+}
+
+/// The zero-check constraint for a helper: h (a - l1)(a - l2) - (2a - l1 - l2).
+#[inline(always)]
+pub fn helper_constraint(h: Fp2, l1: Fp2, l2: Fp2, alpha: Fp2) -> Fp2 {
+    let d1 = alpha.sub(l1);
+    let d2 = alpha.sub(l2);
+    h.mul(d1).mul(d2).sub(d1.add(d2))
+}
+
+/// [UPERF3-AL] `fold_cols_base` over ONE `w_data` block, read straight from
+/// the int8 source plane instead of from the converted 64-bit copy.
+///
+/// The prover lays the block at `wg[c * nb_f + b]` out as
+/// `blk[kp * fb + jp] = Fp::from_i64(wg_t[(c * db + kp) * f + b * fb + jp])`,
+/// so folding the block's columns is a STRIDED fold over the plane: rows
+/// `row0 .. row0 + rows` of a `stride`-wide matrix, columns
+/// `col0 .. col0 + cols`. Byte-identical by construction — the field is
+/// Z_p, every operation is exact, and skipping a zero adds zero (which is
+/// what `fold_cols_i8` already does elsewhere).
+pub fn fold_block_i8(src: &[i8], row0: usize, rows: usize, stride: usize, col0: usize, cols: usize, c: &[Fp2]) -> Vec<Fp2> {
+    debug_assert_eq!(c.len(), cols);
+    (0..rows)
+        .into_par_iter()
+        .map(|i| {
+            let base = (row0 + i) * stride + col0;
+            let row = &src[base..base + cols];
+            let mut acc = Fp2::ZERO;
+            for (&v, &cw) in row.iter().zip(c.iter()) {
+                let v = v as i64;
+                if v == 0 {
+                    continue;
+                }
+                acc = acc.add(cw.mul_base(Fp::from_i64(v)));
+            }
+            acc
+        })
+        .collect()
+}
+
+/// Multiplicity tables from the (possibly tampered) witness columns: values
+/// outside a table are counted into entry 0 so the totals still match and
+/// only the LogUp identity can catch them (what the tamper legs test).
+pub fn multiplicities(w: &Witness<'_>, shifts: (i32, i32, i32, i32), lay: &Layout) -> Vec<(u64, Vec<u32>)> {
+    let tf = lay.t_rows * lay.f;
+    let td = lay.t_rows * lay.d;
+    let mut act = vec![0u32; 256];
+    for &g in &w.g8[..tf] {
+        if (-128..=127).contains(&g) { act[(g + 128) as usize] += 1; } else { act[0] += 1; }
+    }
+    let mut i16t = vec![0u32; 1 << 16];
+    for col in [&w.u16[..tf], &w.h16[..tf], &w.z16[..td]] {
+        for &v in col {
+            if (-32768..=32767).contains(&v) { i16t[(v + 32768) as usize] += 1; } else { i16t[0] += 1; }
+        }
+    }
+    let (sg, su, sh, sz) = shifts;
+    let mut out = vec![(TAG_ACT16, act), (TAG_INT16, i16t)];
+    let mut shifts: Vec<i32> = vec![sg, su, sh, sz];
+    shifts.sort();
+    shifts.dedup();
+    for s in shifts {
+        let mut m = vec![0u32; rem_rows(s)];
+        let cols: Vec<&[i32]> = [(sg, &w.rg[..tf]), (su, &w.ru[..tf]), (sh, &w.rh[..tf]), (sz, &w.rd[..td])]
+            .into_iter().filter(|(c, _)| *c == s).map(|(_, v)| v).collect();
+        for col in cols {
+            for &r in col {
+                match rem_index(s, r) { Some(i) => m[i] += 1, None => m[0] += 1 }
+            }
+        }
+        out.push((tag_rem_v3(s), m));
+    }
+    out
+}
