+//! The seam between the layer RELATION (the core's prover and verifier) and
+//! everything that is policy around it: how the three commitments W, A, H
+//! are made, where their host staging buffers come from, how the openings
+//! are produced and checked. The core's [`Dense`] is the plain path — the
+//! Ligero commitment over a [`Backend`], three dense openings, fresh
+//! buffers. hashline's adapter implements the same two traits with its
+//! per-model weight cache, the `--pcs compact` batched opening, its pooled
+//! buffers and its test-only lookup fault injection; the relation, the
+//! transcript order and the bytes are the core's in both cases.
+
+use super::proof::{ExtraOpening, NoExtra, Proof};
+use crate::field::{Fp, Fp2};
+use crate::ntt::NttTables;
+use crate::pcs::{self, Backend, Claim, Commitment, Committed, Opening, PcsParams};
+use crate::transcript::Transcript;
+
+/// The two host staging buffers a layer fills (the W and the A matrices).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BufSlot {
+    W,
+    A,
+}
+
+/// How the three openings are produced: three dense Ligero openings in the
+/// order W, A, H, or one batched opening carried in the proof's extra slot.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OpenMode {
+    Dense,
+    Batched,
+}
+
+/// What identifies a layer's weight matrix to a cache: the layer index,
+/// the widths and the three int8 planes it is built from.
+#[derive(Clone, Copy, Debug)]
+pub struct WeightKey<'a> {
+    pub l: usize,
+    pub d: usize,
+    pub f: usize,
+    pub wg_t: &'a [i8],
+    pub wu_t: &'a [i8],
+    pub wd_t: &'a [i8],
+}
+
+/// The prover's side of the seam.
+pub trait CommitScheme<X: ExtraOpening> {
+    type Backend: Backend;
+    /// A committed matrix; may borrow the data it was built from.
+    type Cm<'d>
+    where
+        Self: 'd;
+
+    fn backend(&self) -> &Self::Backend;
+    /// Commit the W matrix (a cache may serve it by `key`).
+    fn commit_w<'d>(&'d self, pcs: &PcsParams, data: &'d [Fp], ntt: &NttTables, key: &WeightKey<'_>) -> Self::Cm<'d>;
+    /// Commit A, or the host-built H.
+    fn commit<'d>(&'d self, pcs: &PcsParams, data: &'d [Fp], ntt: &NttTables) -> Self::Cm<'d>;
+    /// Adopt a commitment the backend built (the device-resident H).
+    fn wrap<'d>(&'d self, cm: Committed<<Self::Backend as Backend>::Store>) -> Self::Cm<'d>;
+    fn commitment(&self, cm: &Self::Cm<'_>) -> Commitment;
+    /// The Ligero form behind `cm`, if it has one (the backend hooks need its store).
+    fn ligero<'c>(&self, cm: &'c Self::Cm<'_>) -> Option<&'c Committed<<Self::Backend as Backend>::Store>>;
+    fn open_mode(&self) -> OpenMode {
+        OpenMode::Dense
+    }
+    /// One dense opening; consumes the commitment so its encoding is released before the next.
+    fn open_dense(&self, cm: Self::Cm<'_>, claims: &[Claim], tr: &mut Transcript) -> Opening;
+    /// The batched opening of all three (only when `open_mode` is `Batched`).
+    fn open_batched(&self, w: Self::Cm<'_>, wc: &[Claim], a: Self::Cm<'_>, ac: &[Claim], h: Self::Cm<'_>, hc: &[Claim], tr: &mut Transcript) -> X;
+    /// A host buffer of exactly `len` elements whose contents are ARBITRARY:
+    /// the prover writes every element before reading any.
+    fn take_buffer(&self, _slot: BufSlot, len: usize) -> Vec<Fp> {
+        vec![Fp::ZERO; len]
+    }
+    fn give_buffer(&self, _slot: BufSlot, _v: Vec<Fp>) {}
+}
+
+/// The verifier's side of the seam.
+pub trait VerifyScheme<X: ExtraOpening> {
+    /// Check the three openings (W, A, H in this order) against their
+    /// commitments and claims — three dense checks, or the proof's batched
+    /// extra opening.
+    fn verify_openings(&self, batch: [(&PcsParams, &Commitment, &[Claim]); 3], proof: &Proof<X>, ntt: &NttTables, tr: &mut Transcript) -> Result<(), String>;
+    /// The LogUp lookup challenge as the verifier uses it for one table
+    /// row. Identity in production; a consumer's hardening test may return
+    /// `table_value` once to make the denominator zero and check the refusal.
+    fn lookup_alpha(&self, alpha: Fp2, _table_value: Fp2) -> Fp2 {
+        alpha
+    }
+}
+
+/// The core's scheme: Ligero commitments through `backend`, three dense
+/// openings, fresh buffers, no extra opening.
+pub struct Dense<B: Backend>(pub B);
+
+impl<B: Backend> CommitScheme<NoExtra> for Dense<B> {
+    type Backend = B;
+    type Cm<'d>
+        = Committed<B::Store>
+    where
+        Self: 'd;
+
+    fn backend(&self) -> &B {
+        &self.0
+    }
+    fn commit_w<'d>(&'d self, pcs: &PcsParams, data: &'d [Fp], ntt: &NttTables, _key: &WeightKey<'_>) -> Committed<B::Store> {
+        pcs::commit_with(&self.0, pcs, data, ntt)
+    }
+    fn commit<'d>(&'d self, pcs: &PcsParams, data: &'d [Fp], ntt: &NttTables) -> Committed<B::Store> {
+        pcs::commit_with(&self.0, pcs, data, ntt)
+    }
+    fn wrap<'d>(&'d self, cm: Committed<B::Store>) -> Committed<B::Store> {
+        cm
+    }
+    fn commitment(&self, cm: &Committed<B::Store>) -> Commitment {
+        cm.commitment()
+    }
+    fn ligero<'c>(&self, cm: &'c Committed<B::Store>) -> Option<&'c Committed<B::Store>> {
+        Some(cm)
+    }
+    fn open_dense(&self, cm: Committed<B::Store>, claims: &[Claim], tr: &mut Transcript) -> Opening {
+        pcs::open(&cm, claims, tr)
+    }
+    fn open_batched(&self, _w: Committed<B::Store>, _wc: &[Claim], _a: Committed<B::Store>, _ac: &[Claim], _h: Committed<B::Store>, _hc: &[Claim], _tr: &mut Transcript) -> NoExtra {
+        unreachable!("the dense scheme never batches its openings")
+    }
+}
+
+impl<B: Backend> VerifyScheme<NoExtra> for Dense<B> {
+    fn verify_openings(&self, batch: [(&PcsParams, &Commitment, &[Claim]); 3], proof: &Proof<NoExtra>, ntt: &NttTables, tr: &mut Transcript) -> Result<(), String> {
+        let [(w_pcs, w_com, w_claims), (a_pcs, a_com, a_claims), (h_pcs, h_com, h_claims)] = batch;
+        pcs::verify(w_pcs, w_com, w_claims, &proof.w_open, ntt, tr).map_err(|e| format!("W: {e}"))?;
+        pcs::verify(a_pcs, a_com, a_claims, &proof.a_open, ntt, tr).map_err(|e| format!("A: {e}"))?;
+        pcs::verify(h_pcs, h_com, h_claims, &proof.h_open, ntt, tr).map_err(|e| format!("H: {e}"))?;
+        Ok(())
+    }
+}
diff --git a/zkp-core/src/ffn_v3/tamper.rs b/zkp-core/src/ffn_v3/tamper.rs
new file mode 100644
index 0000000..2767ab4
--- /dev/null
+++ b/zkp-core/src/ffn_v3/tamper.rs
@@ -0,0 +1,90 @@
+//! The tamper legs of the v3 layer: eight ways to break the witness that
+//! the verifier must refuse (soundness checks, D3). Moved from
+//! `hashline/src/layer.rs` (`TamperV3`, `apply_tamper_v3`,
+//! `recompute_v3_from_a16`); they edit the planes in place through
+//! [`PlanesMut`].
+
+use super::witness::{matmul_i32_i8_i64, requant_round, PlanesMut};
+
+/// Tamper legs applied to a witness before proving (plane indices are
+/// row-major over the first t_rows rows).
+#[derive(Clone, Copy, Debug)]
+pub enum Tamper {
+    None,
+    /// X[idx] += 1
+    FlipX(usize),
+    /// WgT[idx] += 1
+    FlipW(usize),
+    /// rg[idx] += 2^sh_g, g8[idx] -= 1 (identity kept; the remainder leaves its window)
+    RemainderOutOfRange(usize),
+    /// a16[idx] += 1 (a wrong int16 table entry) with the downstream chain recomputed consistently
+    WrongTableEntry(usize),
+    /// h16[idx] += 1 with rh unchanged (the Hadamard requant identity breaks)
+    WrongRequant(usize),
+    /// z16[idx] += 1 (the d matmul identity breaks)
+    WrongZ(usize),
+    /// FLOOR instead of round at the first gate element at/after idx where they differ, carried
+    /// through the chain consistently: only the rounding rule (the remainder window) breaks
+    WrongRounding(usize),
+    /// z16[idx] += 65536 with rd compensated (identity kept; z16 leaves the int16 class)
+    OutOfRangeInt16(usize),
+}
+
+/// Recompute h16/rh at one element and the down row that consumes it.
+fn recompute_from_a16(w: &mut PlanesMut<'_>, shifts: (i32, i32, i32, i32), d: usize, f: usize, i: usize) {
+    let sh_h = shifts.2;
+    let sh_z = shifts.3;
+    let hh = w.a16[i] as i64 * w.u16[i] as i64;
+    let (h, rh) = requant_round(&[hh], sh_h);
+    w.h16[i] = h[0] as i32;
+    w.rh[i] = rh[0] as i32;
+    let row = i / f;
+    let dacc = matmul_i32_i8_i64(&w.h16[row * f..(row + 1) * f], w.wd_t, 1, f, d);
+    let (z, rd) = requant_round(&dacc, sh_z);
+    for n in 0..d {
+        w.z16[row * d + n] = z[n] as i32;
+        w.rd[row * d + n] = rd[n] as i32;
+    }
+}
+
+/// Apply one leg to the planes of a `t_rows x d / f` layer with the given
+/// shifts and activation table.
+pub fn apply_tamper(w: &mut PlanesMut<'_>, table: &[i16; 256], shifts: (i32, i32, i32, i32), t_rows: usize, d: usize, f: usize, t: Tamper) {
+    match t {
+        Tamper::None => {}
+        Tamper::FlipX(i) => { w.x[i] = w.x[i].wrapping_add(1); }
+        Tamper::FlipW(i) => { w.wg_t[i] = w.wg_t[i].wrapping_add(1); }
+        Tamper::RemainderOutOfRange(i) => { w.rg[i] += 1 << shifts.0; w.g8[i] -= 1; }
+        Tamper::WrongTableEntry(i) => { w.a16[i] += 1; recompute_from_a16(w, shifts, d, f, i); }
+        Tamper::WrongRequant(i) => { w.h16[i] += 1; }
+        Tamper::WrongZ(i) => { w.z16[i] += 1; }
+        Tamper::WrongRounding(i) => {
+            let n = t_rows * f;
+            let mut j = i % n;
+            let mut found = false;
+            for _ in 0..n {
+                if w.rg[j] < 0 { found = true; break; }
+                j = (j + 1) % n;
+            }
+            assert!(found, "no gate element rounds up — cannot build the wrong-rounding leg");
+            w.g8[j] -= 1;
+            w.rg[j] += 1 << shifts.0;
+            w.a16[j] = table[((w.g8[j] + 128).clamp(0, 255)) as usize] as i32;
+            recompute_from_a16(w, shifts, d, f, j);
+        }
+        Tamper::OutOfRangeInt16(i) => { w.z16[i] += 65536; w.rd[i] -= 65536i32 << shifts.3; }
+    }
+}
+
+/// The eight legs at the indices hashline's `layer --all-tampers` uses,
+/// reduced modulo the plane sizes of a tiny layer by the caller.
+pub const ALL_LEGS: [fn(usize) -> Tamper; 8] = [
+    Tamper::FlipX,
+    Tamper::FlipW,
+    Tamper::RemainderOutOfRange,
+    Tamper::WrongTableEntry,
+    Tamper::WrongRequant,
+    Tamper::WrongZ,
+    Tamper::WrongRounding,
+    Tamper::OutOfRangeInt16,
+];
diff --git a/zkp-core/src/ffn_v3/verify.rs b/zkp-core/src/ffn_v3/verify.rs
new file mode 100644
index 0000000..6c4c8d3
--- /dev/null
+++ b/zkp-core/src/ffn_v3/verify.rs
@@ -0,0 +1,268 @@
+//! The verifier of the non-hiding v3 FFN layer proof and the seam-point
+//! replay. Moved from `hashline/src/layer.rs::{verify_layer_v3, replay_sc,
+//! v3_zcd_point}` (CL20 step 2c); the checks, the transcript order and the
+//! error strings are unchanged. The opening check and the LogUp lookup
+//! challenge go through [`VerifyScheme`] (dense Ligero in the core;
+//! hashline's adapter adds the `--pcs compact` arm and its test-only
+//! fault injection).
+
+use super::logup::helper_constraint;
+use super::proof::{ExtraOpening, Proof};
+use super::prove::build_claims;
+use super::scheme::VerifyScheme;
+use super::statement::{absorb_com, absorb_mults, absorb_statement, pow2_signed, rem_rows, rem_value, tag_rem_v3, Layout, Params, Statement, TAG_ACT16, TAG_INT16};
+use crate::field::{batch_inverse2_checked, Fp, Fp2};
+use crate::mle::eq_point;
+use crate::ntt::NttTables;
+use crate::sumcheck::{self, SumcheckProof};
+use crate::transcript::Transcript;
+
+/// Verify one v3 layer proof against the public statement.
+pub fn verify_layer_v3<V, X>(scheme: &V, st: &Statement, proof: &Proof<X>, params: &Params, ntt: &NttTables, tr: &mut Transcript) -> Result<(), String>
+where
+    X: ExtraOpening,
+    V: VerifyScheme<X>,
+{
+    let lay = Layout::new(st.t_rows, st.d, st.f);
+    let (nb_d, nb_f) = (lay.nb_d, lay.nb_f);
+    let tf = st.t_rows * st.f;
+    let td = st.t_rows * st.d;
+    let (sh_g, sh_u, sh_h, sh_z) = st.shifts;
+    absorb_statement(tr, st);
+    let w_com = proof.w_com.as_ref().ok_or("missing W commitment")?;
+    let a_com = proof.a_com.as_ref().ok_or("missing A commitment")?;
+    let h_com = proof.h_com.as_ref().ok_or("missing H commitment")?;
+    let w_pcs = params.pcs_for(lay.log_wb);
+    let a_pcs = params.pcs_for(lay.log_a_min);
+    let h_pcs = params.pcs_for(lay.log_a_min);
+    if w_com.rows != lay.w_len / w_pcs.cols() { return Err("W commitment rows".into()); }
+    if a_com.rows != lay.a_len / a_pcs.cols() { return Err("A commitment rows".into()); }
+    if h_com.rows != lay.h_len / h_pcs.cols() { return Err("H commitment rows".into()); }
+    absorb_com(tr, b"W", w_com);
+    absorb_com(tr, b"A", a_com);
+    // multiplicities: shape + totals
+    let mut shifts: Vec<i32> = vec![sh_g, sh_u, sh_h, sh_z];
+    shifts.sort();
+    shifts.dedup();
+    if proof.mults.len() != 2 + shifts.len() { return Err("multiplicity table count".into()); }
+    if proof.mults[0].0 != TAG_ACT16 || proof.mults[0].1.len() != 256 { return Err("act16 multiplicities".into()); }
+    if proof.mults[1].0 != TAG_INT16 || proof.mults[1].1.len() != 1 << 16 { return Err("int16 multiplicities".into()); }
+    for (i, s) in shifts.iter().enumerate() {
+        let (tag, m) = &proof.mults[2 + i];
+        if *tag != tag_rem_v3(*s) || m.len() != rem_rows(*s) { return Err(format!("rem({s}) multiplicities")); }
+        let want: usize = [(sh_g, tf), (sh_u, tf), (sh_h, tf), (sh_z, td)].iter().filter(|(c, _)| c == s).map(|(_, n)| n).sum();
+        let got: u64 = m.iter().map(|&x| x as u64).sum();
+        if got != want as u64 { return Err(format!("rem({s}) multiplicity total {got} != {want}")); }
+    }
+    let act_total: u64 = proof.mults[0].1.iter().map(|&x| x as u64).sum();
+    if act_total != tf as u64 { return Err("act16 multiplicity total".into()); }
+    let i16_total: u64 = proof.mults[1].1.iter().map(|&x| x as u64).sum();
+    if i16_total != (2 * tf + td) as u64 { return Err("int16 multiplicity total".into()); }
+    absorb_mults(tr, &proof.mults);
+    let beta = tr.challenge_fp2();
+    let gamma = tr.challenge_fp2();
+    let alpha = tr.challenge_fp2();
+    absorb_com(tr, b"H", h_com);
+    let g_act = gamma.mul_base(Fp::new(TAG_ACT16));
+    let g_i16 = gamma.mul_base(Fp::new(TAG_INT16));
+    let g_rg = gamma.mul_base(Fp::new(tag_rem_v3(sh_g)));
+    let g_ru = gamma.mul_base(Fp::new(tag_rem_v3(sh_u)));
+    let g_rh = gamma.mul_base(Fp::new(tag_rem_v3(sh_h)));
+    let g_rd = gamma.mul_base(Fp::new(tag_rem_v3(sh_z)));
+    let (p_g, p_u, p_h, p_z) = (pow2_signed(sh_g), pow2_signed(sh_u), pow2_signed(sh_h), pow2_signed(sh_z));
+
+    // ---- g/u matmul ----
+    let r_i = tr.challenge_fp2_vec(lay.log_t as usize);
+    let r_j = tr.challenge_fp2_vec(lay.log_fb as usize);
+    let lam_gu = tr.challenge_fp2();
+    let lam_f = tr.challenge_fp2_vec(nb_f);
+    let mut p1 = r_i.clone();
+    p1.extend_from_slice(&r_j);
+    if proof.gu_claims.len() != 2 * nb_f { return Err("gu claims".into()); }
+    tr.absorb_fp2(b"gu-claims", &proof.gu_claims);
+    let claim = (0..nb_f).fold(Fp2::ZERO, |a, b| a.add(lam_f[b].mul(proof.gu_claims[2 * b].add(lam_gu.mul(proof.gu_claims[2 * b + 1])))));
+    let (fin, r_kp) = sumcheck::verify(claim, 2, lay.log_db as usize, &proof.gu_sc, tr)?;
+    if proof.gu_term.len() != nb_d + 2 * nb_d * nb_f { return Err("gu terminal".into()); }
+    let mut want = Fp2::ZERO;
+    for c in 0..nb_d {
+        let mut wsum = Fp2::ZERO;
+        for b in 0..nb_f {
+            let wg = proof.gu_term[nb_d + c * nb_f + b];
+            let wu = proof.gu_term[nb_d + nb_d * nb_f + c * nb_f + b];
+            wsum = wsum.add(lam_f[b].mul(wg.add(lam_gu.mul(wu))));
+        }
+        want = want.add(proof.gu_term[c].mul(wsum));
+    }
+    if want != fin { return Err("g/u matmul sumcheck terminal check fails".into()); }
+    tr.absorb_fp2(b"gu-term", &proof.gu_term);
+    let mut p2 = r_i.clone();
+    p2.extend_from_slice(&r_kp);
+    let mut p3 = r_kp.clone();
+    p3.extend_from_slice(&r_j);
+
+    // ---- d matmul ----
+    let r_ip = tr.challenge_fp2_vec(lay.log_t as usize);
+    let r_jp = tr.challenge_fp2_vec(lay.log_db as usize);
+    let lam_d = tr.challenge_fp2_vec(nb_d);
+    let mut p4 = r_ip.clone();
+    p4.extend_from_slice(&r_jp);
+    if proof.d_claims.len() != nb_d { return Err("d claims".into()); }
+    tr.absorb_fp2(b"d-claims", &proof.d_claims);
+    let d_sum = (0..nb_d).fold(Fp2::ZERO, |a, c| a.add(lam_d[c].mul(proof.d_claims[c])));
+    let (fin, r_k) = sumcheck::verify(d_sum, 2, lay.log_fb as usize, &proof.d_sc, tr)?;
+    if proof.d_term.len() != nb_f + nb_f * nb_d { return Err("d terminal".into()); }
+    let mut want = Fp2::ZERO;
+    for b in 0..nb_f {
+        let wd_comb = (0..nb_d).fold(Fp2::ZERO, |a, c| a.add(lam_d[c].mul(proof.d_term[nb_f + b * nb_d + c])));
+        want = want.add(proof.d_term[b].mul(wd_comb));
+    }
+    if want != fin { return Err("d matmul sumcheck terminal check fails".into()); }
+    tr.absorb_fp2(b"d-term", &proof.d_term);
+    let mut p5 = r_ip.clone();
+    p5.extend_from_slice(&r_k);
+    let mut p6 = r_k.clone();
+    p6.extend_from_slice(&r_jp);
+
+    // ---- zero-check F ----
+    let tau = tr.challenge_fp2_vec((lay.log_t + lay.log_fb) as usize);
+    let mu = tr.challenge_fp2_vec(4 * nb_f);
+    let nu = tr.challenge_fp2_vec(3 * nb_f);
+    let mut claimed = Fp2::ZERO;
+    for b in 0..nb_f {
+        claimed = claimed.add(nu[3 * b].mul(proof.gu_claims[2 * b])).add(nu[3 * b + 1].mul(proof.gu_claims[2 * b + 1])).add(nu[3 * b + 2].mul(proof.d_term[b]));
+    }
+    let (fin, rho_f) = sumcheck::verify(claimed, 4, (lay.log_t + lay.log_fb) as usize, &proof.zcf_sc, tr)?;
+    if proof.zcf_term.len() != 10 * nb_f { return Err("zcF terminal".into()); }
+    {
+        let v = &proof.zcf_term;
+        let mut zc = Fp2::ZERO;
+        let mut f1 = Fp2::ZERO;
+        let mut f5 = Fp2::ZERO;
+        for b in 0..nb_f {
+            let o = 10 * b;
+            let (g8, rg, a16, u16, ru, h16, rh, hg, hu, hh) = (v[o], v[o + 1], v[o + 2], v[o + 3], v[o + 4], v[o + 5], v[o + 6], v[o + 7], v[o + 8], v[o + 9]);
+            let c_had = a16.mul(u16).sub(h16.mul_base(p_h)).sub(rh);
+            let c_hg = helper_constraint(hg, g8.add(beta.mul(a16)).add(g_act), rg.add(g_rg), alpha);
+            let c_hu = helper_constraint(hu, u16.add(g_i16), ru.add(g_ru), alpha);
+            let c_hh = helper_constraint(hh, h16.add(g_i16), rh.add(g_rh), alpha);
+            zc = zc.add(mu[4 * b].mul(c_had)).add(mu[4 * b + 1].mul(c_hg)).add(mu[4 * b + 2].mul(c_hu)).add(mu[4 * b + 3].mul(c_hh));
+            f1 = f1.add(nu[3 * b].mul(g8.mul_base(p_g).add(rg))).add(nu[3 * b + 1].mul(u16.mul_base(p_u).add(ru)));
+            f5 = f5.add(nu[3 * b + 2].mul(h16));
+        }
+        let want = eq_point(&tau, &rho_f).mul(zc).add(eq_point(&p1, &rho_f).mul(f1)).add(eq_point(&p5, &rho_f).mul(f5));
+        if want != fin { return Err("zero-check F terminal check fails".into()); }
+    }
+    tr.absorb_fp2(b"zcf-term", &proof.zcf_term);
+
+    // ---- zero-check D ----
+    let tau2 = tr.challenge_fp2_vec((lay.log_t + lay.log_db) as usize);
+    let mu2 = tr.challenge_fp2_vec(nb_d);
+    let nu_x = tr.challenge_fp2_vec(nb_d);
+    let nu_z = tr.challenge_fp2_vec(nb_d);
+    let claimed = (0..nb_d).fold(Fp2::ZERO, |a, c| a.add(nu_x[c].mul(proof.gu_term[c])).add(nu_z[c].mul(proof.d_claims[c])));
+    let (fin, rho_d) = sumcheck::verify(claimed, 4, (lay.log_t + lay.log_db) as usize, &proof.zcd_sc, tr)?;
+    if proof.zcd_term.len() != 4 * nb_d { return Err("zcD terminal".into()); }
+    {
+        let v = &proof.zcd_term;
+        let mut zc = Fp2::ZERO;
+        let mut fx = Fp2::ZERO;
+        let mut fz = Fp2::ZERO;
+        for c in 0..nb_d {
+            let (x, z, rd, h) = (v[c], v[nb_d + c], v[2 * nb_d + c], v[3 * nb_d + c]);
+            zc = zc.add(mu2[c].mul(helper_constraint(h, z.add(g_i16), rd.add(g_rd), alpha)));
+            fx = fx.add(nu_x[c].mul(x));
+            fz = fz.add(nu_z[c].mul(z.mul_base(p_z).add(rd)));
+        }
+        let want = eq_point(&tau2, &rho_d).mul(zc).add(eq_point(&p2, &rho_d).mul(fx)).add(eq_point(&p4, &rho_d).mul(fz));
+        if want != fin { return Err("zero-check D terminal check fails".into()); }
+    }
+    tr.absorb_fp2(b"zcd-term", &proof.zcd_term);
+
+    // ---- helper sums vs the multiplicity side (the LogUp identity) ----
+    if proof.helper_sums.len() != 3 * nb_f + nb_d { return Err("helper sums".into()); }
+    tr.absorb_fp2(b"helper-sums", &proof.helper_sums);
+    let witness_side = proof.helper_sums.iter().fold(Fp2::ZERO, |a, b| a.add(*b));
+    let mut dens: Vec<Fp2> = Vec::new();
+    let mut nums: Vec<Fp> = Vec::new();
+    for (tag, m) in &proof.mults {
+        for (i, &cnt) in m.iter().enumerate() {
+            if cnt == 0 { continue; }
+            let tval = if *tag == TAG_ACT16 {
+                Fp2::from_i64(i as i64 - 128).add(beta.mul_base(Fp::from_i64(st.table[i] as i64))).add(g_act)
+            } else if *tag == TAG_INT16 {
+                Fp2::from_i64(i as i64 - 32768).add(g_i16)
+            } else {
+                let sh = *tag as i32 - 64 - 8;
+                Fp2::from_i64(rem_value(sh, i)).add(gamma.mul_base(Fp::new(*tag)))
+            };
+            let alpha = scheme.lookup_alpha(alpha, tval);
+            dens.push(alpha.sub(tval));
+            nums.push(Fp::new(cnt as u64));
+        }
+    }
+    batch_inverse2_checked(&mut dens)
+        .map_err(|_| "FFN v3 LogUp: zero lookup denominator".to_string())?;
+    let table_side = dens.iter().zip(nums.iter()).fold(Fp2::ZERO, |a, (d, n)| a.add(d.mul_base(*n)));
+    if witness_side != table_side { return Err("LogUp identity fails (a lookup is not in its table)".into()); }
+
+    // ---- PCS openings ----
+    let (w_claims, a_claims, h_claims) = build_claims(&lay, proof, &p3, &p6, &rho_f, &rho_d);
+    scheme.verify_openings([(&w_pcs, w_com, &w_claims), (&a_pcs, a_com, &a_claims), (&h_pcs, h_com, &h_claims)], proof, ntt, tr)
+}
+
+// ===========================================================================
+// THE SEAM POINT of a v3 layer proof. The full-layer statement binds the
+// attention half's xm8 to the FFN half's X (and its z16 copy to the FFN's
+// z16) at the point the v3 zero-check D drew — a point drawn AFTER both A
+// commitments, which is exactly what the seam needs. Neither the prover
+// nor the verifier returns it, so this replays their (identical)
+// transcript walk on a CLONE and returns rho_d. It absorbs nothing into
+// the caller's transcript.
+// ===========================================================================
+
+fn replay_sc(tr: &mut Transcript, sc: &SumcheckProof) -> Vec<Fp2> {
+    let mut ch = Vec::with_capacity(sc.rounds.len());
+    for s in &sc.rounds {
+        tr.absorb_fp2(b"sc-round", s);
+        ch.push(tr.challenge_fp2());
+    }
+    ch
+}
+
+/// rho_d: the zero-check-D challenge point of a v3 layer proof, given the
+/// transcript state BEFORE the prover / verifier ran.
+pub fn zcd_point<X>(st: &Statement, proof: &Proof<X>, before: &Transcript) -> Vec<Fp2> {
+    let lay = Layout::new(st.t_rows, st.d, st.f);
+    let mut tr = Transcript::clone_state(before);
+    absorb_statement(&mut tr, st);
+    absorb_com(&mut tr, b"W", proof.w_com.as_ref().expect("W"));
+    absorb_com(&mut tr, b"A", proof.a_com.as_ref().expect("A"));
+    absorb_mults(&mut tr, &proof.mults);
+    let _beta = tr.challenge_fp2();
+    let _gamma = tr.challenge_fp2();
+    let _alpha = tr.challenge_fp2();
+    absorb_com(&mut tr, b"H", proof.h_com.as_ref().expect("H"));
+    let _r_i = tr.challenge_fp2_vec(lay.log_t as usize);
+    let _r_j = tr.challenge_fp2_vec(lay.log_fb as usize);
+    let _lam_gu = tr.challenge_fp2();
+    let _lam_f = tr.challenge_fp2_vec(lay.nb_f);
+    tr.absorb_fp2(b"gu-claims", &proof.gu_claims);
+    replay_sc(&mut tr, &proof.gu_sc);
+    tr.absorb_fp2(b"gu-term", &proof.gu_term);
+    let _r_ip = tr.challenge_fp2_vec(lay.log_t as usize);
+    let _r_jp = tr.challenge_fp2_vec(lay.log_db as usize);
+    let _lam_d = tr.challenge_fp2_vec(lay.nb_d);
+    tr.absorb_fp2(b"d-claims", &proof.d_claims);
+    replay_sc(&mut tr, &proof.d_sc);
+    tr.absorb_fp2(b"d-term", &proof.d_term);
+    let _tau = tr.challenge_fp2_vec((lay.log_t + lay.log_fb) as usize);
+    let _mu = tr.challenge_fp2_vec(4 * lay.nb_f);
+    let _nu = tr.challenge_fp2_vec(3 * lay.nb_f);
+    replay_sc(&mut tr, &proof.zcf_sc);
+    tr.absorb_fp2(b"zcf-term", &proof.zcf_term);
+    let _tau2 = tr.challenge_fp2_vec((lay.log_t + lay.log_db) as usize);
+    let _mu2 = tr.challenge_fp2_vec(lay.nb_d);
+    let _nu_x = tr.challenge_fp2_vec(lay.nb_d);
+    let _nu_z = tr.challenge_fp2_vec(lay.nb_d);
+    replay_sc(&mut tr, &proof.zcd_sc)
+}
diff --git a/zkp-core/src/ffn_v3/witness.rs b/zkp-core/src/ffn_v3/witness.rs
new file mode 100644
index 0000000..0c2820a
--- /dev/null
+++ b/zkp-core/src/ffn_v3/witness.rs
@@ -0,0 +1,264 @@
+//! The witness planes of the v3 FFN layer and the exact integer chain that
+//! derives them.
+//!
+//! Moved from `hashline/src/export_v3.rs` (CL20 step 2c): `requant_round`,
+//! `in_i16_class`, `in_rem_window` and the arithmetic of
+//! `matmul_i32_i8_i64` are the canonical implementations (hashline
+//! re-exports the first three and wraps the matmul with its allocation
+//! span). [`Witness`] is the borrowed-planes form the prover reads;
+//! hashline's `export_v3::V3Witness` (the loader's owned product with its
+//! export dims, exponents and sidecar digests) lends its planes to it.
+//! [`derive`] is the exact chain of `export_v3::derive_v3_with_table`
+//! without hashline's phase-profile spans; both compositions are kept
+//! deliberately (the spans are consumed by hashline's CLI reports) and the
+//! parity test `hashline/tests/zk60_cl20_parity.rs` asserts their planes
+//! are identical.
+
+use rayon::prelude::*;
+
+/// The planes the prover reads, row-major over the first `t_rows` rows of
+/// the layer. `x` is `T x d` (int8), the weights transposed as the export
+/// lays them out (`wg_t`, `wu_t`: `d x f`; `wd_t`: `f x d`), the derived
+/// planes `t_rows x f` (`g8`, `rg`, `a16`, `u16`, `ru`, `h16`, `rh`) and
+/// `t_rows x d` (`z16`, `rd`). Planes may be longer than `t_rows` rows;
+/// the prover slices what it needs.
+#[derive(Clone, Copy, Debug)]
+pub struct Witness<'a> {
+    pub x: &'a [i8],
+    pub wg_t: &'a [i8],
+    pub wu_t: &'a [i8],
+    pub wd_t: &'a [i8],
+    pub g8: &'a [i32],
+    pub rg: &'a [i32],
+    pub a16: &'a [i32],
+    pub u16: &'a [i32],
+    pub ru: &'a [i32],
+    pub h16: &'a [i32],
+    pub rh: &'a [i32],
+    pub z16: &'a [i32],
+    pub rd: &'a [i32],
+}
+
+/// The same planes mutably (the tamper legs edit them in place).
+pub struct PlanesMut<'a> {
+    pub x: &'a mut [i8],
+    pub wg_t: &'a mut [i8],
+    pub wu_t: &'a mut [i8],
+    pub wd_t: &'a mut [i8],
+    pub g8: &'a mut [i32],
+    pub rg: &'a mut [i32],
+    pub a16: &'a mut [i32],
+    pub u16: &'a mut [i32],
+    pub ru: &'a mut [i32],
+    pub h16: &'a mut [i32],
+    pub rh: &'a mut [i32],
+    pub z16: &'a mut [i32],
+    pub rd: &'a mut [i32],
+}
+
+/// The owned planes `derive` produces (the example's and the tests' form).
+#[derive(Clone, Debug)]
+pub struct OwnedWitness {
+    pub t_rows: usize,
+    pub d: usize,
+    pub f: usize,
+    pub x: Vec<i8>,
+    pub wg_t: Vec<i8>,
+    pub wu_t: Vec<i8>,
+    pub wd_t: Vec<i8>,
+    pub g8: Vec<i32>,
+    pub rg: Vec<i32>,
+    pub a16: Vec<i32>,
+    pub u16: Vec<i32>,
+    pub ru: Vec<i32>,
+    pub h16: Vec<i32>,
+    pub rh: Vec<i32>,
+    pub z16: Vec<i32>,
+    pub rd: Vec<i32>,
+    /// Every derived value inside its class/window (`in_i16_class`, the
+    /// int8 gate class, `in_rem_window`); a false witness proves but is refused.
+    pub range_ok: bool,
+}
+
+impl OwnedWitness {
+    pub fn as_ref(&self) -> Witness<'_> {
+        Witness {
+            x: &self.x, wg_t: &self.wg_t, wu_t: &self.wu_t, wd_t: &self.wd_t,
+            g8: &self.g8, rg: &self.rg, a16: &self.a16, u16: &self.u16, ru: &self.ru, h16: &self.h16, rh: &self.rh, z16: &self.z16, rd: &self.rd,
+        }
+    }
+    pub fn as_mut(&mut self) -> PlanesMut<'_> {
+        PlanesMut {
+            x: &mut self.x, wg_t: &mut self.wg_t, wu_t: &mut self.wu_t, wd_t: &mut self.wd_t,
+            g8: &mut self.g8, rg: &mut self.rg, a16: &mut self.a16, u16: &mut self.u16, ru: &mut self.ru, h16: &mut self.h16, rh: &mut self.rh,
+            z16: &mut self.z16, rd: &mut self.rd,
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// the exact chain
+// ---------------------------------------------------------------------------
+
+/// c[i][j] = sum_k a[i][k] * b_t[k][j] in i64 (a i32 rows x inner, b_t int8 inner x cols), into `c`.
+pub fn matmul_i32_i8_i64_into(a: &[i32], b_t: &[i8], rows: usize, inner: usize, cols: usize, c: &mut [i64]) {
+    assert_eq!(c.len(), rows * cols);
+    c.par_chunks_mut(cols).enumerate().for_each(|(i, crow)| {
+        for k in 0..inner {
+            let av = a[i * inner + k] as i64;
+            if av == 0 {
+                continue;
+            }
+            let brow = &b_t[k * cols..(k + 1) * cols];
+            for (cv, &bv) in crow.iter_mut().zip(brow.iter()) {
+                *cv += av * bv as i64;
+            }
+        }
+    });
+}
+
+/// `matmul_i32_i8_i64_into` over a fresh zeroed output.
+pub fn matmul_i32_i8_i64(a: &[i32], b_t: &[i8], rows: usize, inner: usize, cols: usize) -> Vec<i64> {
+    let mut c = vec![0i64; rows * cols];
+    matmul_i32_i8_i64_into(a, b_t, rows, inner, cols, &mut c);
+    c
+}
+
+/// c[i][j] = sum_k a[i][k] * b_t[k][j] in i32 (a int8 rows x inner, b_t int8 inner x cols): the gate/up
+/// matmuls of the chain (hashline's `chain::matmul_i8_i32`, widened to i64 by the caller).
+pub fn matmul_i8_i8_i64(a: &[i8], b_t: &[i8], rows: usize, inner: usize, cols: usize) -> Vec<i64> {
+    let mut c = vec![0i64; rows * cols];
+    c.par_chunks_mut(cols).enumerate().for_each(|(i, crow)| {
+        for k in 0..inner {
+            let av = a[i * inner + k] as i64;
+            if av == 0 {
+                continue;
+            }
+            let brow = &b_t[k * cols..(k + 1) * cols];
+            for (cv, &bv) in crow.iter_mut().zip(brow.iter()) {
+                *cv += av * bv as i64;
+            }
+        }
+    });
+    c
+}
+
+/// The v3 requantization at a SIGNED shift: (y, r) with v = 2^s y + r and
+/// r in the BALANCED window [-2^(s-1), 2^(s-1)) for s > 0 (= round-to-
+/// nearest, half up); y = v * 2^-s, r = 0 for s <= 0 (exact up-scaling).
+pub fn requant_round(acc: &[i64], sh: i32) -> (Vec<i64>, Vec<i64>) {
+    if sh <= 0 {
+        let scale = 1i64 << (-sh);
+        return (acc.par_iter().map(|&a| a * scale).collect(), vec![0i64; acc.len()]);
+    }
+    let half = 1i64 << (sh - 1);
+    let y: Vec<i64> = acc.par_iter().map(|&a| (a + half) >> sh).collect();
+    let r: Vec<i64> = acc.par_iter().zip(y.par_iter()).map(|(&a, &yy)| a - (yy << sh)).collect();
+    (y, r)
+}
+
+#[inline]
+pub fn in_i16_class(v: i64) -> bool {
+    (-32768..=32767).contains(&v)
+}
+#[inline]
+pub fn in_rem_window(r: i64, sh: i32) -> bool {
+    if sh <= 0 {
+        r == 0
+    } else {
+        let half = 1i64 << (sh - 1);
+        (-half..half).contains(&r)
+    }
+}
+
+fn to_i32(v: Vec<i64>) -> Vec<i32> {
+    v.into_par_iter().map(|x| x.clamp(i32::MIN as i64, i32::MAX as i64) as i32).collect()
+}
+
+/// Derive the chain from X and the weights over the first `t_rows` rows
+/// (`x` is `T x d` with `T >= t_rows`): gate/up matmuls, the signed
+/// requantizations with balanced remainders, the int16-out table lookup,
+/// the Hadamard product, the down matmul. The planes are `t_rows x f` /
+/// `t_rows x d`; `range_ok` records every class and window check.
+pub fn derive(x: &[i8], wg_t: &[i8], wu_t: &[i8], wd_t: &[i8], t_rows: usize, d: usize, f: usize, shifts: (i32, i32, i32, i32), table: &[i16; 256]) -> OwnedWitness {
+    assert!(t_rows >= 1 && x.len() >= t_rows * d, "x holds {} entries, {t_rows} x {d} needed", x.len());
+    assert_eq!(wg_t.len(), d * f);
+    assert_eq!(wu_t.len(), d * f);
+    assert_eq!(wd_t.len(), f * d);
+    let (sh_g, sh_u, sh_h, sh_z) = shifts;
+    let gacc = matmul_i8_i8_i64(&x[..t_rows * d], wg_t, t_rows, d, f);
+    let uacc = matmul_i8_i8_i64(&x[..t_rows * d], wu_t, t_rows, d, f);
+    let (g8, rg) = requant_round(&gacc, sh_g);
+    let (u16v, ru) = requant_round(&uacc, sh_u);
+    drop(gacc);
+    drop(uacc);
+    let g_ok = g8.iter().all(|&g| (-128..=127).contains(&g));
+    let u_ok = u16v.iter().all(|&u| in_i16_class(u));
+    let a16: Vec<i64> = g8.par_iter().map(|&g| table[((g + 128).clamp(0, 255)) as usize] as i64).collect();
+    let hh: Vec<i64> = a16.par_iter().zip(u16v.par_iter()).map(|(&a, &u)| a * u).collect();
+    let (h16, rh) = requant_round(&hh, sh_h);
+    drop(hh);
+    let h_ok = h16.iter().all(|&h| in_i16_class(h));
+    let h16_32 = to_i32(h16);
+    let dacc = matmul_i32_i8_i64(&h16_32, wd_t, t_rows, f, d);
+    let (z16, rd) = requant_round(&dacc, sh_z);
+    drop(dacc);
+    let z_ok = z16.iter().all(|&z| in_i16_class(z));
+    let rem_ok = rg.iter().all(|&r| in_rem_window(r, sh_g))
+        && ru.iter().all(|&r| in_rem_window(r, sh_u))
+        && rh.iter().all(|&r| in_rem_window(r, sh_h))
+        && rd.iter().all(|&r| in_rem_window(r, sh_z));
+    OwnedWitness {
+        t_rows,
+        d,
+        f,
+        x: x[..t_rows * d].to_vec(),
+        wg_t: wg_t.to_vec(),
+        wu_t: wu_t.to_vec(),
+        wd_t: wd_t.to_vec(),
+        g8: to_i32(g8),
+        rg: to_i32(rg),
+        a16: to_i32(a16),
+        u16: to_i32(u16v),
+        ru: to_i32(ru),
+        h16: h16_32,
+        rh: to_i32(rh),
+        z16: to_i32(z16),
+        rd: to_i32(rd),
+        range_ok: g_ok && u_ok && h_ok && z_ok && rem_ok,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn requant_and_windows_match_the_definition() {
+        let (y, r) = requant_round(&[0, 1, 2, 3, 4, -1, -2, -3, -4, 100], 2);
+        assert_eq!(y, vec![0, 0, 1, 1, 1, 0, 0, -1, -1, 25]);
+        assert_eq!(r, vec![0, 1, -2, -1, 0, -1, -2, 1, 0, 0]);
+        for (a, yy, rr) in [(3i64, 1i64, -1i64), (2, 1, -2)] {
+            assert_eq!(a, (yy << 2) + rr);
+        }
+        assert!(r.iter().all(|&v| in_rem_window(v, 2)));
+        assert!(!in_rem_window(2, 2));
+        assert!(in_rem_window(-2, 2));
+        let (y0, r0) = requant_round(&[5, -7], 0);
+        assert_eq!((y0, r0), (vec![5, -7], vec![0, 0]));
+        let (ym, rm) = requant_round(&[5, -7], -2);
+        assert_eq!((ym, rm), (vec![20, -28], vec![0, 0]));
+        assert!(in_i16_class(32767) && !in_i16_class(32768) && in_i16_class(-32768) && !in_i16_class(-32769));
+    }
+
+    #[test]
+    fn matmul_forms_agree() {
+        let a32 = vec![1i32, -2, 3, 4, 0, -6];
+        let a8: Vec<i8> = a32.iter().map(|&v| v as i8).collect();
+        let b_t = vec![2i8, -1, 0, 5, 7, 1];
+        let c1 = matmul_i32_i8_i64(&a32, &b_t, 2, 3, 2);
+        let c2 = matmul_i8_i8_i64(&a8, &b_t, 2, 3, 2);
+        assert_eq!(c1, c2);
+        assert_eq!(c1, vec![1 * 2 + (-2) * 0 + 3 * 7, 1 * (-1) + (-2) * 5 + 3 * 1, 4 * 2 + 0 + (-6) * 7, 4 * (-1) + 0 + (-6) * 1]);
+    }
+}
