+//! CL20 step 2c (round 15): old/new parity of the non-hiding v3 FFN layer
+//! proof. The "old" side is the legacy hashline prover BEFORE the move
+//! (its tiny-fixture digests are frozen below, recorded from the tree at
+//! the round-15 pin before `layer.rs` was reduced to adapters); the "new"
+//! side is the maintained core's `zkp_core::ffn_v3::prove_layer_v3` over
+//! the CPU `Dense` scheme, and hashline's adapter, which is the same core
+//! prover over the hashline scheme (cache / compact / pooled buffers).
+//! Explicit seeds are PUBLIC test fixtures; T=2 and T=32 at d=f=16 with
+//! deliberately tiny parameters; no security claim.
+use hashline::export_v3::{derive_v3, sha256_hex, V3Dims, V3Exps, V3LayerExport, V3Witness};
+use hashline::layer::{prove_layer_v3, verify_layer_v3, LayerParams, LayerProofV3, StatementV3};
+use hashline::ntt::NttTables;
+use hashline::tables_v3::{int16out_member, Act16Fn};
+use hashline::transcript::Transcript;
+
+const DOMAIN: &[u8] = b"hashline-layer-v3";
+
+/// sha256 of `LayerProofV3::to_bytes()` of the legacy prover at the
+/// round-15 pin (`0b2b830`), T2 and T32, `params()`; recorded by this
+/// test's first run before the move and frozen here.
+const LEGACY_T2_SHA256: &str = "6132d0c493a50c070a924e5f10653a27e0738527a29f76c9ddf84ccb8c143f0e"; // 348,784 B
+const LEGACY_T32_SHA256: &str = "";
+
+fn params() -> LayerParams {
+    LayerParams { log_cols: 5, inv_rate: 4, num_col_checks: 12 }
+}
+
+fn ntt(p: &LayerParams) -> NttTables {
+    NttTables::new(p.log_cols + p.inv_rate.trailing_zeros())
+}
+
+/// The seeded d=f=16 synthetic layer of the identity-gap / mask diagnostics
+/// (LCG seed 1), derived through hashline's exact chain at `t` rows.
+pub fn synth(t: usize) -> V3Witness {
+    let (d, f) = (16usize, 16usize);
+    let mut seed = 1u64;
+    let mut next = |m: i64| -> i8 {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (((seed >> 33) as i64) % (2 * m + 1) - m) as i8
+    };
+    let x = (0..t * d).map(|_| next(127)).collect();
+    let wg_t = (0..d * f).map(|_| next(4)).collect();
+    let wu_t = (0..d * f).map(|_| next(4)).collect();
+    let wd_t = (0..f * d).map(|_| next(4)).collect();
+    let (table, table_digest) = int16out_member(Act16Fn::Silu, -3, -11).unwrap();
+    let export = V3LayerExport {
+        l: 0,
+        dims: V3Dims { t, d, f, layers: 1 },
+        x,
+        wg_t,
+        wu_t,
+        wd_t,
+        a16: vec![],
+        u16: vec![],
+        h16: vec![],
+        z16: vec![],
+        exps: V3Exps { e_x: 0, e_g: -3, e_a16: -11, e_u16: 0, e_h16: 3, e_z16: 0, e_wg: -10, e_wu: 0, e_wd: -9 },
+        shifts: (7, 0, 14, 6),
+        act: Act16Fn::Silu,
+        table,
+        table_digest,
+        digest_checks: vec![],
+    };
+    let w = derive_v3(&export, t);
+    assert!(w.range_ok, "the T{t} fixture must be in range");
+    w
+}
+
+fn statement(w: &V3Witness) -> StatementV3 {
+    StatementV3 { l: w.l, t_rows: w.t_rows, d: w.dims.d, f: w.dims.f, shifts: w.shifts, act: w.act, table: w.table, table_digest: w.table_digest.clone() }
+}
+
+fn legacy_prove(w: &V3Witness, p: &LayerParams, ntt: &NttTables) -> LayerProofV3 {
+    prove_layer_v3(w, w.t_rows, p, ntt, &mut Transcript::new(DOMAIN)).proof
+}
+
+fn legacy_verify(st: &StatementV3, proof: &LayerProofV3, p: &LayerParams, ntt: &NttTables) -> Result<(), String> {
+    verify_layer_v3(st, proof, p, ntt, &mut Transcript::new(DOMAIN))
+}
+
+/// The frozen tiny digests: the hashline path must reproduce the bytes the
+/// legacy prover produced before the move, at both fixture sizes.
+#[test]
+fn hashline_path_reproduces_the_frozen_legacy_tiny_digests() {
+    let p = params();
+    let table = ntt(&p);
+    for (t, want) in [(2usize, LEGACY_T2_SHA256), (32usize, LEGACY_T32_SHA256)] {
+        let w = synth(t);
+        let st = statement(&w);
+        let proof = legacy_prove(&w, &p, &table);
+        legacy_verify(&st, &proof, &p, &table).unwrap();
+        let got = sha256_hex(&proof.to_bytes());
+        assert_eq!(got, want, "T{t}: legacy tiny digest (bytes {})", proof.size_bytes());
+    }
+}
