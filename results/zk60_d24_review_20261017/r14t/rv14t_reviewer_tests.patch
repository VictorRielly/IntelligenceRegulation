+    /// Fresh verification of Sol's retained tiered frame through the library
+    /// minimum API (which refuses before any block I/O), with this build.
+    #[test]
+    #[ignore = "reviewer: retained tiered dense frame; explicit DD/input"]
+    fn rv14t_retained_frame_library_minimum() {
+        use crate::private_block::trained_block::{hex, unhex32};
+        let dir = std::path::PathBuf::from(std::env::var("HL_R14_TIER_INPUT").unwrap());
+        let text = std::fs::read_to_string(dir.join("statement.txt")).unwrap();
+        let f: std::collections::BTreeMap<_, _> = text.lines().skip(1).map(|l| l.split_once('=').unwrap()).collect();
+        let (sh, blocks, model, _) = dense(explicit_dd());
+        let p = plan(&sh, &blocks, &model).with_security_source(Tier::Mvp95, &mut Borrowed(&blocks)).unwrap();
+        assert_eq!(f["security"], hex(&p.security().unwrap().encode()));
+        let st = p.bind(unhex32(f["input_root"]).unwrap(), unhex32(f["output_root"]).unwrap()).unwrap();
+        assert_eq!(f["binding"], hex(&st.binding()));
+        let bytes = std::fs::read(dir.join("segment0.bin")).unwrap();
+        for (min, accept) in [(Tier::Mvp95, true), (Tier::Bits100, false), (Tier::Bits128, false)] {
+            let r = split_run::Verifier::with_source_minimum(&st, Box::new(Borrowed(&blocks)), min)
+                .and_then(|mut v| { v.verify_next(&bytes)?; v.finish() });
+            assert_eq!(r.is_ok(), accept, "{min:?}: {r:?}");
+        }
+        // The same frame under the untiered reconstruction is refused.
+        let old = plan(&sh, &blocks, &model).bind(unhex32(f["input_root"]).unwrap(), unhex32(f["output_root"]).unwrap()).unwrap();
+        let r = split_run::Verifier::with_source(&old, Box::new(Borrowed(&blocks)))
+            .and_then(|mut v| { v.verify_next(&bytes)?; v.finish() });
+        assert!(r.is_err());
+        eprintln!("RV14T_RETAINED_FRAME_LIBRARY_MINIMUM PASS dd={} untiered_refusal={:?}", explicit_dd(), r.err());
+    }
