+            fn boundary_plane(&mut self, _k: usize) -> Result<Vec<i16>, String> {
+                Err("one block".into())
+            }
+        }
+        let mut segs = 0usize;
+        let e = super::run::prove_run(&st, &blocks, &mut One(Some(w_ok)), owners, &mut |_, _| {
+            segs += 1;
+            Ok(())
