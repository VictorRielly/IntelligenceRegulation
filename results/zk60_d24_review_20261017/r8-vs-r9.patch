+pub(crate) fn dd_tuples(lay: &Layout, wit: &Witness, ecol: &[i64], beta: Fp2, g_dd: Fp2) -> (Vec<Fp2>, Vec<Fp2>) {
+    let (sh, ids) = (lay.shape(), lay.ids());
