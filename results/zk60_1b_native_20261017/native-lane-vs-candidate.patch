+#[derive(Clone, Copy)]
+pub(super) struct SiteAt {
+    d: usize,
+    dsq: usize,
+    limb: usize,
+    y: usize,
+    rho0: usize,
+    sig0: usize,
+    x: usize,
+    cn: i64,
+    is_m: bool,
+}
