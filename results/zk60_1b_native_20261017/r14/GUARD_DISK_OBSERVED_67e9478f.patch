+def host_drive_free_gib() -> float | None:
+    """Free GiB on HOST_DRIVE, or None when there is none to check on this box."""
+    if not HOST_DRIVE:
+        return None
+    try:
+        st = os.statvfs(HOST_DRIVE)
+    except OSError:
+        return None
+    return st.f_bavail * st.f_frsize / GIB
 
 
