+/// R14 public blocks, resident or loaded one at a time. Reuse the native
+/// borrowed/Arc block handle so a cache need not clone all public weights.
+pub(crate) trait PublicBlockSource {
+    fn count(&self) -> usize;
+    fn block(&mut self, k: usize) -> Result<super::run::BlockRef<'_>, String>;
+}
+
+// This check belongs to the protocol, so a source cannot override it.
+fn preflight_blocks(blocks: &mut dyn PublicBlockSource, plan: &Plan) -> Result<(), String> {
+    if blocks.count() != plan.len() {
+        return Err("R14 run: public block count differs".into());
+    }
+    for k in 0..plan.len() {
+        let block = blocks.block(k)?;
+        plan.check_block(k, &block)?;
+    }
+    Ok(())
+}
+
+struct ResidentBlocks<'a>(&'a [BlockPublic]);
+impl PublicBlockSource for ResidentBlocks<'_> {
+    fn count(&self) -> usize {
+        self.0.len()
+    }
+    fn block(&mut self, k: usize) -> Result<super::run::BlockRef<'_>, String> {
+        self.0
+            .get(k)
+            .map(super::run::BlockRef::Borrowed)
+            .ok_or_else(|| "R14 run: public block source index differs".into())
+    }
+}
