+/// Public calibrated norm constants, read from the profile rather than a
+/// classifier's copy. The calling token proof must bind its own relation.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TiedFinalNorm {
+    pub g0: i64,
+    pub cn: i64,
+    pub tn: u32,
+    pub ceps: i64,
+}
