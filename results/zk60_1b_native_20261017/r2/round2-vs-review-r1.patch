+        let l = ex.load_layer(&sh, &c, 0, false).unwrap();
+        (ex.variant.clone(), ex.statement(&sh, &c, &[&l]).unwrap().identity())
+    };
+    let (a, b, c) = (id(&v1), id(&v2), id(&v3));
+    assert_eq!(a, b, "two directory names gave two identities");
