+    let prove_s = t.elapsed().as_secs_f64();
+    let witness_s = src.busy_s;
+    drop(src);
+    if let Err(e) = stats {
+        return Err(format!("prove_run: {e}"));
+    }
+    let hwm = peak_rss_mib();
+    // ---- in-process verification from the directory
+    let t = Instant::now();
+    let verdict = run::verify_run_from_dir(&rst, &blocks, &out);
