+/// `HL_FSP_ROW_FOLD=0` retains the per-element field arithmetic for a
+/// same-binary differential measurement. The protocol and output order are
+/// unchanged: only the representation of the intermediate sum differs.
+fn deferred_rows() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("HL_FSP_ROW_FOLD").map(|v| v != "0").unwrap_or(true))
+}
+
+/// Fold signed integers by reducing once per output, rather than once per
+/// input. For bias B, sum_i w_i v_i = sum_i w_i (v_i+B) - B sum_i w_i.
+/// Each extension component is accumulated as an exact unsigned integer.
+/// The only callers have v in [-B, B-1], for B = 128 or 2^31.
+///
+/// Use the full u64 bound for coefficients so the accumulator cannot wrap
+/// even before relying on the field's canonical-representation invariant.
+/// Rows beyond this bound use the inherited field-arithmetic path. B and
+/// max_value are public type constants; this choice does not inspect data.
+fn fold_rows_deferred<T, F>(m: &[T], rows: usize, cols: usize, w: &[Fp2], bias: i64, value: F) -> Option<Vec<Fp2>>
+where
+    T: Copy + Sync,
+    F: Fn(T) -> i64 + Sync,
+{
+    let max_value = (2 * bias - 1) as u128;
+    if rows as u128 > u128::MAX / (u64::MAX as u128 * max_value) {
+        return None;
+    }
+    let shift = w.iter().fold(Fp2::ZERO, |sum, &wi| sum.add(wi))
+        .mul_base(Fp::from_i64(bias));
+    let chunk = 256usize.min(cols);
+    let mut out = vec![Fp2::ZERO; cols];
+    out.par_chunks_mut(chunk).enumerate().for_each(|(ci, oc)| {
+        let c0 = ci * chunk;
+        // Fixed per-task scratch; no allocation inside the row loop.
+        let mut sums = [(0u128, 0u128); 256];
+        for (i, &wi) in w.iter().enumerate() {
+            let row = &m[i * cols + c0..i * cols + c0 + oc.len()];
+            for (sum, &v) in sums.iter_mut().zip(row) {
+                let u = (value(v) + bias) as u128;
+                sum.0 += wi.c0.0 as u128 * u;
+                sum.1 += wi.c1.0 as u128 * u;
+            }
+        }
+        for (o, &(s0, s1)) in oc.iter_mut().zip(&sums) {
+            *o = Fp2::new(Fp::from_u128(s0), Fp::from_u128(s1)).sub(shift);
+        }
+    });
+    Some(out)
+}
