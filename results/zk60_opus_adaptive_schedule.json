 "circular_dependencies": [
  {
   "id": "C1",
   "name": "commit-then-mask",
   "cycle": "M root absorbed (zk.rs:3521) -> beta/gamma/alpha and every later challenge -> the masked round messages those challenges constrain -> the slot coefficients that had to be inside M",
   "why_it_matters": "the mask coefficients are fixed before the challenges they must satisfy are known",
   "known_break": "FA8 programs the round challenges at squeeze points; that is a random-oracle programming argument, not a plain reduction",
   "resolved": false
  },
  {
   "id": "C2",
   "name": "commit-then-open",
   "cycle": "endpoint masks and pads -> encoded rows -> Merkle root -> absorbed in the 112-byte policy before everything -> transcript -> opening challenges -> which columns must be explained -> the masks and pads",
   "why_it_matters": "round 24 samples masks and pads AFTER fixing which columns are opened; in the real schedule the root that binds them is absorbed first",
   "known_break": "round 23's deferred Merkle preparation issues a root first and programs salted leaves later; real BLAKE3 cannot be programmed",
   "resolved": false
  },
  {
   "id": "C3",
   "name": "shared-plane consistency",
   "cycle": "A rows 14..17 alias Input rows 0..1 and Output rows 0..1 -> both roots are absorbed before any challenge -> a simulator must fix one shared X/z16 plane that simultaneously satisfies A's 20 claims over 7 groups and both endpoints' single claims",
   "why_it_matters": "round 24 samples one endpoint in isolation and neither resamples nor consults A",
   "known_break": "none; the joint field-view sampler is the open Codex task",
   "resolved": false
  },
  {
   "id": "C4",
   "name": "slot-total to gamma",
   "cycle": "io gamma = c * mask[slot].total() (zk_ffn_fresh_io.rs:296) -> c is squeezed immediately before -> the total was fixed at M commitment time",
   "why_it_matters": "the simulator picks totals blind, and gamma is then forced by a challenge it does not control",
   "known_break": "round 21 checks the conditional fibre at fixed challenges only",
   "resolved": false
  }
 ],
