k(cudaGraphDestroy(_graph));\nL436: \nL437: cudaErrCheck(cudaGraphExecDestroy(_graph_exec));\nL438: \nL439: _instantiated = false;\nL440: \nL441: }\nL442: \nL443: }\nL444: \nL445: void gpu_graph_t::begin_capture(cudaStream_t s) {\nL446: \nL447: cudaErrCheck(cudaStreamBeginCapture(s, cudaStreamCaptureModeGlobal));\nL448: \nL449: }\nL450: \nL451: void gpu_graph_t::end_capture(cudaStream_t s) {\nL452: \nL453: if (_instantiated) { cudaErrCheck(cudaGraphDestroy(_graph)); }\nL454: \nL455: cudaErrCheck(cudaStreamEndCapture(s, &_graph));\nL456: \nL457: bool need_instantiation;\nL458: if (_instantiated) {\nL459: \nL460: cudaGraphExecUpdateResult updateResult;\nL461: \nL462: cudaGraphNode_t errorNode;\nL463: \nL464: // First we try to update the graph as this is much cheaper than re-instantiation\nL465: \nL466: cudaErrCheck(cudaGraphExecUpdate(_graph_exec, _graph, &errorNode, &updateResult));\nL467: \nL468: if (_graph_exec == nullptr || updateResult != cudaGraphExecUpdateSuccess) {\nL469: \nL470: // The update is unsuccessful, need to re-instantiate\nL471: \nL472: cudaGetLastError(); // <- Clear the error state\nL473: if (_graph_exec != nullptr) { cudaErrCheck(cudaGraphExecDestroy(_graph_exec)); }\nL474: \nL475: need_instantiation = true;\nL476: \nL477: } else {\n"
