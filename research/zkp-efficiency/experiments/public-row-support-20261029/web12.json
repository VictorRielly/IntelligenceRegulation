"statesync-gkr/crates/protocol/src/reduce.rs at main · Oraclizer/statesync-gkr · GitHub (https://github.com/Oraclizer/statesync-gkr/blob/main/crates/protocol/src/reduce.rs)\nciteturn11view0 [wordlim: 200] Crawled: last week; Content type: text/html; Source: open({\"ref_id\":\"turn9view1\",\"lineno\":2571}); Total lines: 3953\nL2475: /// fully bound at `x*` (Phase 2) the `x`-only factors are the scalars\nL2476: \nL2477: /// `L* = lin~(x*)`, `P* = pow3~(x*)`, `V* = V(x*)`, and the sum runs over\nL2478: \nL2494: /// Build `O(#gates + 2^s)`; per round `O(2^{remaining})` over a single\nL2495: \nL2496: /// `s`-bit cube. No `2^{2s}` allocation anywhere; peak memory\nL2497: \nL2498: /// `O(2^s + #Mul)` (vs the dense `O(2^{2s})`).\nL2499: \nL2500: struct SparseLayerOracle {\nL2501: \nL2502: /// `s_in`: the `x` and `y` blocks are each `s` bits (total `2s` vars).\nL2503: \nL2504: s: usize,\nL2505: \nL2506: /// Variables not yet bound (starts at `2s`; Phase 1 while `> s`).\nL2507: \nL2508: remaining: usize,\nL2509: \nL2510: // --- Phase 1 tables (x-block), size `2^(remaining - s)` while binding x.\nL2511: /// `sum_k c_k lin~(z_k, x)` over the current x-cube.\nL2512: \nL2513: lin_x: Vec<ChallengeField>,\nL2514: \nL2515: /// `sum_k c_k pow3~(z_k, x)` over the current x-cube.\nL2516: \nL2517: pow_x: Vec<ChallengeField>,\nL2518: \nL2519: /// `V(x)` over the current x-cube.\nL2520: \nL2521: vx: Vec<ChallengeField>,\nL2522: \nL2523: /// Booking table `amul(x) = sum_y mul~(z,x,y) * V(y)` over the current\nL2524: \nL2525: /// x-cube (the `mul` term's y-sum, precomputed and folded in x).\nL2526: \nL2527: amul_x: Vec<ChallengeField>,\nL2528: \nL2529: // --- retained from construction, consumed at the Phase-2 build.\nL2530: /// Sparse `Mul` gates `(in1, in2, weight = coeff * w[out])`.\nL2531: \nL2532: mul_gates: Vec<(u32, u32, ChallengeField)>,\nL2533: \nL2534: /// `V` (layer-below MLE) embedded, size `2^s`; becomes `vy` at the\nL2535: \nL2536: /// phase transition.\nL2537: \nL2538: v_embed: Vec<ChallengeField>,\nL2539: \nL2540: /// The x-challenges accumulated during Phase 1 (= `x*` once complete).\nL2541: \nL2542: xstar: Vec<ChallengeField>,\nL2543: \nL2544: // --- Phase 2 tables (y-block), size `2^remaining` while binding y.\nL2545: \nL2546: /// `beta(y)` = all-zero indicator over the current y-cube.\nL2547: \nL2548: beta_y: Vec<ChallengeField>,\nL2549: /// `V(y)` over the current y-cube.\nL2550: \nL2551: vy: Vec<ChallengeField>,\nL2552: \nL2553: /// `mulx(y) = sum_k c_k mul~(z_k, x*, y)` over the current y-cube.\nL2554: \nL2555: mulx_y: Vec<ChallengeField>,\nL2556: \nL2557: /// `L* = sum_k c_k lin~(z_k, x*)` (Phase 2 scalar).\nL2558: \nL2559: lstar: ChallengeField,\nL2560: \nL2561: /// `P* = sum_k c_k pow3~(z_k, x*)` (Phase 2 scalar).\nL2562: \nL2563: pstar: ChallengeField,\nL2564: \nL2565: /// `V* = V(x*)` (Phase 2 scalar).\nL2566: \nL2567: vstar: ChallengeField,\nL2568: \nL2569: }\nL2570: \nL2571: impl SparseLayerOracle {\nL2572: \nL2573: /// Build the oracle for layer `i` from its gates, the incoming claim\nL2574: /// points, and the layer-below values. Same signature as\nL2575: \nL2576: /// [`DenseLayerOracle::new`] so the two share one prover driver.\nL2577: \nL2578: fn new(\nL2579: \nL2580: layer: &Layer<BaseField>,\nL2581: \nL2582: s_in: usize,\nL2583: \nL2584: incoming: &[(Vec<ChallengeField>, ChallengeField)],\nL2585: \nL2586: v_below: &[BaseField],\nL2587: \nL2588: ) -> Self {\nL2589: \nL2590: let s_out = layer.width_bits;\nL2591: \nL2592: let out_len = 1usize << s_out;\nL2593: \nL2594: let in_len = 1usize << s_in;\nL2595: \nL2596: // w[o] = sum_k c_k eq(z_k, o): fold the incoming points into a weight\nL2597: \nL2598: // per output wire so the gate loop stays a single pass. (Identical\nL2599: // to the dense oracle.)\nL2600: \nL2601: let mut w = vec![ChallengeField::ZERO; out_len];\nL2602: \nL2603: for (z, c) in incoming {\nL2604: \nL2605: for (o, wo) in w.iter_mut().enumerate() {\nL2606: \nL2607: *wo += *c * eq_point_index(z, o);\nL2608: \nL2609: }\nL2610: \nL2611: }\nL2612: \nL2613: // Per-kind weights. Lin/Pow3 collapse onto an x-table; Mul stays a\nL2614: \nL2615: // gate list and is NEVER expanded into a 2^{2s} table.\nL2616: \nL2617: let mut lin_x = vec![ChallengeField::ZERO; in_len];\nL2618: \nL2619: let mut pow_x = vec![ChallengeField::ZERO; in_len];\nL2620: \nL2621: let mut mul_gates: Vec<(u32, u32, ChallengeField)> = Vec::new();\nL2622: \nL2623: for g in &layer.gates {\nL2624: let weight = embed(g.coeff) * w[g.out as usize];\nL2625: \nL2626: match g.kind {\nL2627: \nL2628: GateKind::Lin => lin_x[g.in1 as usize] += weight,\nL2629: \nL2630: GateKind::Pow3 => pow_x[g.in1 as usize] += weight,\nL2631: \nL2632: GateKind::Mul => mul_gates.push((g.in1, g.in2, weight)),\nL2633: \nL2634: }\nL2635: \nL2636: }\nL2637: \nL2638: // V embedded over the input block (indexed the same way the dense\nL2639: \nL2640: // oracle indexes both `vx[x]` and `vy[y]`).\nL2641: \nL2642: let v_embed: Vec<ChallengeField> = (0..in_len).map(|x| embed(v_below[x])).collect();\nL2643: \nL2644: // Booking table amul(x) = sum_y mul(x,y) * V(y), accumulated from the\nL2645: // sparse Mul list in O(#Mul). Duplicate (in1, in2) gates simply add.\nL2646: \nL2647: let mut amul_x = vec![ChallengeField::ZERO; in_len];\nL2648: \nL2649: for &(in1, in2, weight) in &mul_gates {\nL2650: \nL2651: amul_x[in1 as usize] += weight * v_embed[in2 as usize];\nL2652: \nL2653: }\nL2654: \nL2655: let vx = v_embed.clone();\nL2656: \nL2657: Self {\nL2658: \nL2659: s: s_in,\nL2660: \nL2661: remaining: 2 * s_in,\nL2662: \nL2663: lin_x,\nL2664: \nL2665: pow_x,\nL2666: \nL2667: vx,\nL2668: \nL2669: amul_x,\nL2670: \nL2671: mul_gates,\nL2672: \nL2673: v_embed,\nL2674: \nL2675: xstar: Vec::with_capacity(s_in),\nL2676: \nL2677: beta_y: Vec::new(),\nL2678: \nL2679: vy: Vec::new(),\nL2680: \nL2681: mulx_y: Vec::new(),\nL2682: \nL2683: lstar: ChallengeField::ZERO,\nL2684: \nL2685: pstar: ChallengeField::ZERO,\nL2686: vstar: ChallengeField::ZERO,\nL2687: \nL2688: }\nL2689: \nL2690: }\nL2691: \nL2692: /// At the Phase 1 -> Phase 2 boundary (`x` fully bound at `x*`, so the\nL2693: \nL2694: /// four x-tables are length 1): read the x-only scalars and build the\nL2695: \nL2696: /// three y-block tables.\nL2697: \nL2698: ///\nL2699: \nL2700: /// FV-CONTRACT (Creusot, seal-extension session - design contract,\nL2701: \nL2702: /// NOT tool-checked):\nL2703: \nL2704: /// #[ensures((^self).remaining@ == (*self).remaining@)]\nL2705: \nL2706: /// TOOL WALL (honest carry-over; refinement_status section 17): the\nL2707: \nL2708: /// counter-preservation ensures cannot be activated at this rev -\nL2709: /// this body's vc is a monolithic chunk that split_vc cannot\nL2710: \nL2711: /// decompose (depth 16 probed), and once the `vec![ZERO; _]` calls\nL2712: \nL2713: /// enter it the solvers diverge (all-timeout, R1 wall-2\nL2714: \nL2715: /// phenomenology). A full activation attempt (six machine-width /\nL2716: \nL2717: /// call-domain `requires` including the model's `gates_in` mirror, a\nL2718: \nL2719: /// claim-free `AddAssign` spec, bridge-axiom references) was measured\nL2720: \nL2721: /// no-score and reverted. The preservation clause itself IS\nL2722: /// machine-provable: the scalars + shift + `mem::take` prefix variant\nL2723: \nL2724: /// proved green with the ensures active - the blocker is the\nL2725: \nL2726: /// monolith, not the semantics. Consequence: `bind`'s arity\nL2727: \nL2728: /// postcondition is machine-checked on the non-boundary paths and\nL2729: \nL2730: /// stays a wall-pinned open subgoal on the phase-boundary path\nL2731: \nL2732: /// (where this helper's frame havocs the counter).\nL2733: \nL2734: fn build_phase2(&mut self) {\nL2735: \nL2736: self.vstar = self.vx[0];\nL2737: \nL2738: self.lstar = self.lin_x[0];\nL2739: \nL2740: self.pstar = self.pow_x[0];\n--------------------------------------------------------------------------------\nmerge-spmm/graphblas/backend at master · owensgroup/merge-spmm · 