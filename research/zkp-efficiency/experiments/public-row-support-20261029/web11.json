783: // Trait contracts are restated verbatim on the impl methods below:\nL2784: \nL2785: // this toolchain rev does not inherit trait contracts into impls\nL2786: \nL2787: // (an uncontracted impl gets the trivial contract and the refines\nL2788: \nL2789: // check then fails) - same convention as the R1 `HashGadget` /\nL2790: \nL2791: // `Poseidon2Gadget` restatement.\nL2957: /// tables over the `(x, y)` hypercube and folds the current MSB variable of\nL2958: \nL2959: /// all of them each round. This is the semantic anchor (D-33 (8)) the\nL2960: \nL2961: /// production [`SparseLayerOracle`] is proven observationally equal to; it\nL2962: \nL2963: /// is retained solely to drive the equivalence tests.\nL2964: #[cfg(test)]\nL2965: \nL2966: struct DenseLayerOracle {\nL2967: \nL2968: /// `sum_k c_k lin~(z_k, x)` as a table over `x` (redundant over `y`).\nL2969: \nL2970: lin: Vec<ChallengeField>,\nL2971: \nL2972: /// `sum_k c_k pow3~(z_k, x)` as a table over `x` (redundant over `y`).\nL2973: \nL2974: pow: Vec<ChallengeField>,\nL2975: \nL2976: /// `V(x)` (layer-below MLE, indexed by the x-block).\nL2977: \nL2978: vx: Vec<ChallengeField>,\nL2979: \nL2980: /// `V(y)` (same values, indexed by the y-block).\nL2981: \nL2982: vy: Vec<ChallengeField>,\nL2983: \nL2984: /// `beta(y)` = all-zero indicator over the y-block.\nL2985: \nL2986: beta: Vec<ChallengeField>,\nL2996: #[cfg(test)]\nL2997: \nL2998: impl DenseLayerOracle {\nL2999: \nL3000: /// Build the dense oracle (same signature as [`SparseLayerOracle::new`]).\nL3001: \nL3002: fn new(\nL3003: \nL3004: layer: &Layer<BaseField>,\nL3005: \nL3006: s_in: usize,\nL3007: \nL3008: incoming: &[(Vec<ChallengeField>, ChallengeField)],\nL3009: \nL3010: v_below: &[BaseField],\nL3011: \nL3012: ) -> Self {\nL3013: \nL3014: let s_out = layer.width_bits;\nL3015: \nL3016: let out_len = 1usize << s_out;\nL3017: \nL3018: let in_len = 1usize << s_in;\nL3019: \nL3020: // w[o] = sum_k c_k eq(z_k, o): fold the incoming points into a weight\nL3021: \nL3022: // per output wire so the gate loop stays a single pass.\nL3215: #[cfg_attr(creusot, ensures(result@.len() == count@))]\nL3216: \nL3217: fn draw_point(transcript: &mut Transcript, count: usize) -> Vec<ChallengeField> {\nL3218: \nL3219: (0..count).map(|_| transcript.sample_challenge()).collect()\nL3220: \nL3221: }\nL3222: \nL3223: /// Core prover driver, generic over the per-layer oracle constructor so the\nL3224: \nL3225: /// production ([`SparseLayerOracle`]) and the test-only dense reference\nL3226: \nL3227: /// ([`DenseLayerOracle`]) share one message-ordering path - which is what\nL3228: \nL3229: /// makes \"same transcript\" mechanically guaranteed rather than duplicated.\nL3374: /// the end-to-end round-trip tests.\nL3375: \nL3376: pub fn prove(\nL3377: \nL3378: circuit: &LayeredCircuit<BaseField>,\nL3379: \nL3380: witness: &CircuitWitness<BaseField>,\nL3381: \nL3382: transcript: &mut Transcript,\nL3383: \nL3384: ) -> GkrProof {\nL3385: \nL3386: prove_impl(circuit, witness, transcript, SparseLayerOracle::new)\nL3387: \nL3388: }\nL3389: \nL3390: /// Test-only: the same driver against the dense reference oracle. Used by\nL3391: \nL3392: /// the observational-equivalence tests to compare whole proofs.\n--------------------------------------------------------------------------------\nstatesync-gkr/crates/protocol/src/reduce.rs at main · Oraclizer/statesync-gkr · GitHub (https://github.com/Oraclizer/statesync-gkr/blob/main/crates/protocol/src/reduce.rs)\nciteturn10view2 [wordlim: 200] Crawled: last week; Content type: text/html; Source: find({\"ref_id\":\"turn9view1\",\"pattern\":\"booking\"}); Total lines: 3953\nL2413: #[inline]\nL2414: \nL2415: fn extrap(t: &[ChallengeField], i: usize, half: usize, x: ChallengeField) -> ChallengeField {\nL2416: \nL2417: t[i] + x * (t[i + half] - t[i])\nL2418: \nL2419: }\nL2420: \nL2421: /// Prover-side sumcheck oracle for one layer reduction, using Libra-style\nL2422: \nL2423: /// two-phase sparse booking. This is the production oracle (the N3\nL2424: \nL2425: /// optimization of the v0.1 dense oracle, D-33 (8)); it stays\nL2426: \nL2427: /// observationally equal to [`DenseLayerOracle`] (the test-only reference)\nL2428: \nL2429: /// - every round emits a bit-identical [`RoundPoly`].\nL2430: \nL2431: ///\nL2432: /// # Why this equals the dense oracle\nL2433: \nL2434: ///\nL2435: \nL2436: /// The dense oracle materializes six `2^{2s}` factor tables over the full\nL2437: \nL2438: /// `(x, y)` hypercube and, each round, sums\nL2439: \nL2440: /// `lin*vx*beta + mul*vx*vy + pow*vx^3*beta` over the remaining cube. Three\nL2441: \nL2442: /// of those tables (`lin`, `pow`, `vx`) depend only on `x`, two (`vy`,\nL2443: \nL2444: /// `beta`) only on `y`, and `mul` is `#gates`-sparse. Splitting\nL2445: \nL2446: /// `sum_{x,y}` into `sum_x sum_y` collapses the inner `y` sum in closed\nL2447: /// form, which is what makes the sparse node values *equal* the dense ones\nL2448: \nL2449: /// (the regrouping uses only field distributivity/commutativity, exact in\nL2450: \nL2451: /// a finite field, so the results are bit-identical, hence the interpolated\nL2452: \nL2453: /// coefficient vectors - trailing zeros included - are identical):\nL2454: \nL2455: ///\nL2456: \nL2457: /// - `beta(y) = [y == 0]`, so `sum_y beta(y) = 1`: the `lin` and `pow`\nL2458: \nL2459: /// terms lose their `y` sum entirely (they become `x`-only).\nL2460: /// - the `mul` term factors as `vx(x) * (sum_y mul(x,y) * vy(y))`; the\nL2461: \nL2462: /// inner `y` sum is precomputed into a booking table\nL2463: \nL2464: /// `amul(x) = sum_y mul(x,y) * vy(y)`, built in `O(#Mul)` from the gate\nL2465: \nL2466: /// list.\nL2467: \nL2468: ///\nL2469: \nL2470: /// So while `x` is bound (Phase 1) the oracle keeps only four `2^s`-sized\nL2471: \nL2472: /// `x`-tables (`lin_x`, `pow_x`, `vx`, `amul_x`) and each round evaluates\nL2473: \nL2474: /// `lin*vx + amul*vx + pow*vx^3` over the remaining `x`-cube. Once `x` is\nL2475: /// fully bound at `x*` (Phase 2) the `x`-only factors are the scalars\nL2476: \nL2477: /// `L* = lin~(x*)`, `P* = pow3~(x*)`, `V* = V(x*)`, and the sum runs over\nL2478: \nL2479: /// `y`: `(L*V* + P*V*^3)*beta(y) + V* * mulx(y) * vy(y)`, where\nL2480: \nL2481: /// `mulx(y) = sum_k c_k mul~(z_k, x*, y) = sum_{Mul gates} weight *\nL2482: \nL2483: /// eq(x*, in1)` accumulated at `in2` (built in `O(#Mul * s)` at the phase\nL2484: \nL2485: /// transition). This is exactly the polynomial the dense oracle sums in\nL2486: \nL2487: /// its second `s` rounds.\nL2488: \nL2489: ///\nL2490: \nL2491: /// # Complexity\nL2492: \nL2493: ///\nL2494: /// Build `O(#gates + 2^s)`; per round `O(2^{remaining})` over a single\nL2495: \nL2496: /// `s`-bit cube. No `2^{2s}` allocation anywhere; peak memory\nL2497: \nL2498: /// `O(2^s + #Mul)` (vs the dense `O(2^{2s})`).\nL2499: \nL2500: struct SparseLayerOracle {\nL2501: \nL2502: /// `s_in`: the `x` and `y` blocks are each `s` bits (total `2s` vars).\nL2503: \nL2504: s: usize,\nL2505: \nL2506: /// Variables not yet bound (starts at `2s`; Phase 1 while `> s`).\nL2507: \nL2508: remaining: usize,\nL2509: \nL2510: // --- Phase 1 tables (x-block), size `2^(remaining - s)` while binding x.\nL2511: /// `sum_k c_k lin~(z_k, x)` over the current x-cube.\nL2512: \nL2513: lin_x: Vec<ChallengeField>,\nL2514: \nL2515: /// `sum_k c_k pow3~(z_k, x)` over the current x-cube.\nL2516: \nL2517: pow_x: Vec<ChallengeField>,\nL2518: \nL2519: /// `V(x)` over the current x-cube.\nL2520: \nL2521: vx: Vec<ChallengeField>,\nL2522: \nL2523: /// Booking table `amul(x) = sum_y mul~(z,x,y) * V(y)` over the current\nL2524: \nL2525: /// x-cube (the `mul` term's y-sum, precomputed and folded in x).\nL2526: \nL2527: amul_x: Vec<ChallengeField>,\nL2528: \nL2529: // --- retained from construction, consumed at the Phase-2 build.\nL2530: /// Sparse `Mul` gates `(in1, in2, weight = coeff * w[out])`.\nL2531: \nL2532: mul_gates: Vec<(u32, u32, ChallengeField)>,\nL2533: \nL2534: /// `V` (layer-below MLE) embedded, size `2^s`; becomes `vy` at the\nL2535: \nL2536: /// phase transition.\nL2537: \nL2538: v_embed: Vec<ChallengeField>,\nL2539: \nL2540: /// The x-challenges accumulated during Phase 1 (= `x*` once complete).\nL2541: \nL2542: xstar: Vec<ChallengeField>,\nL2543: \nL2544: // --- Phase 2 tables (y-block), size `2^remaining` while binding y.\nL2545: \nL2546: /// `beta(y)` = all-zero indicator over the current y-cube.\nL2547: \nL2548: beta_y: Vec<ChallengeField>,\nL2549: /// `V(y)` over the current y-cube.\nL2550: \nL2551: vy: Vec<ChallengeField>,\nL2552: \nL2624: let weight = embed(g.coeff) * w[g.out as usize];\nL2625: \nL2626: match g.kind {\nL2627: \nL2628: GateKind::Lin => lin_x[g.in1 as usize] += weight,\nL2629: \nL2630: GateKind::Pow3 => pow_x[g.in1 as usize] += weight,\nL2631: \nL2632: GateKind::Mul => mul_gates.push((g.in1, g.in2, weight)),\nL2633: \nL2634: }\nL2635: \nL2636: }\nL2637: \nL2638: // V embedded over the input block (indexed the same way the dense\nL2639: \nL2640: // oracle indexes both `vx[x]` and `vy[y]`).\nL2641: \nL2642: let v_embed: Vec<ChallengeField> = (0..in_len).map(|x| embed(v_below[x])).collect();\nL2643: \nL2644: // Booking table amul(x) = sum_y mul(x,y) * V(y), accumulated from the\n--------------------------------------------------------------------------------\nmerge-spmm/graphblas/backend at master · owensgroup/merge-spmm · GitHub (https://github.com/owensgroup/merge-spmm/tree/master/graphblas/backend)\nciteturn10view3 [wordlim: 200] Crawled: 2 months ago; Content type: text/html; Source: find({\"ref_id\":\"turn9view2\",\"pattern\":\"cuda\"}); Total lines: 201\nNo matching text found for \"cuda\""
