ogN, fr_zero());\nL1063: \nL1064: for (int b = 0; b < s.nu; ++b) r[b] = fr_u64((row >> b) & 1ULL);\nL1065: for (int b = 0; b < s.m; ++b) r[s.nu + b] = fr_u64((col >> b) & 1ULL);\nL1066: \nL1067: return r;\nL1068: \nL1069: }\nL1070: \nL1071: static Fr chi_zero(const std::vector<Fr>& r_idx) {\nL1072: \nL1073: Fr acc = fr_one();\nL1074: \nL1075: Fr one = fr_one();\nL1076: \nL1077: for (const auto& x : r_idx) {\nL1078: \nL1079: Fr term; Fr::sub(term, one, x);\nL1080: \nL1081: Fr::mul(acc, acc, term);\nL1082: \nL1083: }\nL1084: \nL1085: return acc;\nL1086: \nL1087: }\nL1088: \nL1089: // P_m^alpha(r) = MLE of the vector [1_{z<m} alpha^z] at r.\nL1090: \nL1091: // r_idx is in standard integer bit order, bit 0 first.\nL1092: \nL1093: static Fr weighted_prefix_eval(const Fr& alpha, uint64_t m, int ell, const std::vector<Fr>& r_idx) {\nL1094: if ((int)r_idx.size() != ell) throw std::runtime_error(\"bad r_idx size\");\nL1095: \nL1096: if (m == 0) return fr_zero();\nL1097: \nL1098: const uint64_t N = uint64_t(1) << ell;\nL1099: \nL1100: std::vector<Fr> a(ell); // a[k] = alpha^{2^k}\nL1101: \nL1102: a[0] = alpha;\nL1103: \nL1104: for (int k = 1; k < ell; ++k) Fr::mul(a[k], a[k-1], a[k-1]);\nL1105: \nL1106: std::vector<Fr> L(ell + 1);\nL1107: \nL1108: L[0] = fr_one();\nL1109: \nL1110: Fr one = fr_one();\n--------------------------------------------------------------------------------\nCeler/dory_pcs.hpp at main · quwenjie/Celer · GitHub (https://github.com/quwenjie/Celer/blob/main/dory_pcs.hpp)\nciteturn6view4 [wordlim: 200] Crawled: last week; Content type: text/html; Source: click({\"ref_id\":\"turn5view4\",\"id\":88}); Total lines: 1342\n--------------------------------------------------------------------------------\nCeler/celer_prove.hpp at main · quwenjie/Celer · GitHub (https://github.com/quwenjie/Celer/blob/main/celer_prove.hpp)\nciteturn6view5 [wordlim: 200] Crawled: 6 days ago; Content type: text/html; Source: click({\"ref_id\":\"turn5view4\",\"id\":86}); Total li