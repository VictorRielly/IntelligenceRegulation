 // bits are [col bits | row bits]. This function maps a row-major vector into a\nL916: \nL917: // table whose low bits follow Dory's coordinate order [row bits | col bits].\nL918: \nL919: static std::vector<Fr> reorder_rowmajor_to_dory_order(const Setup& s, const std::vector<Fr>& row_major) {\nL920: \nL921: if (row_major.size() != s.N) throw std::runtime_error(\"bad vector size in reorder\");\nL922: \nL923: std::vector<Fr> out(s.N);\nL924: \nL925: for (size_t row = 0; row < s.rows; ++row) {\nL926: \nL927: for (size_t col = 0; col < s.n; ++col) {\nL928: \nL929: const size_t z_rowmajor = row * s.n + col;\nL930: const size_t z_dory = row + s.rows * col;\nL931: \nL932: out[z_dory] = row_major[z_rowmajor];\nL933: \nL934: }\nL935: \nL936: }\nL937: \nL938: return out;\nL939: \nL940: }\nL941: \nL942: // Convert a Dory-coordinate point [row bits | col bits] into standard integer\nL943: \nL944: // bit order [col bits | row bits], used by alpha^z weighted-prefix evaluation.\nL945: \nL946: static std::vector<Fr> dory_point_to_index_bits(const Setup& s, const std::vector<Fr>& r_dory) {\nL947: \nL948: if ((int)r_dory.size() != s.logN) throw std::runtime_error(\"bad point size\");\nL949: \nL950: std::vector<Fr> r_idx(s.logN);\nL951: for (int b = 0; b < s.m; ++b) { // column bits are low index bits\nL952: \nL953: r_idx[b] = r_dory[s.nu + b];\nL954: \nL955: }\nL956: \nL957: for (int b = 0; b < s.nu; ++b) { // row bits are high index bits\nL958: \nL959: r_idx[s.m + b] = r_dory[b];\nL960: \nL961: }\nL962: \nL963: return r_idx;\nL964: \nL965: }\nL966: \nL967: static std::vector<Fr> index_bits_to_dory_point(const Setup& s, const std::vector<Fr>& r_idx) {\nL968: \nL969: if ((int)r_idx.size() != s.logN) throw std::runtime_error(\"bad index-bit point size\");\nL970: \nL971: std::vector<Fr> r_dory(s.logN);\nL972: \nL973: for (int b = 0; b < s.m; ++b) { // low integer bits are column bits\nL974: r_dory[s.nu + b] = r_idx[b];\nL975: \nL976: }\nL977: \nL978: for (int b = 0; b < s.nu; ++b) { //