+/// The initialized destination prefix is the source; no second table buffer.
+#[inline]
+fn repeat_encoded_u8_rows(len: usize, mut row: impl FnMut(usize) -> Fp2) -> Vec<Fp2> {
+    let mut out = Vec::with_capacity(len);
+    for i in 0..len.min(U8_LEN) {
+        out.push(row(i));
+    }
+    while out.len() < len {
+        let take = (len - out.len()).min(out.len());
+        out.extend_from_within(..take);
+    }
+    out
