:from_random_bytes(&hash);\nL1469: \nL1470: let mut j = 0u64;\nL1471: \nL1472: while p.is_none() {\nL1473: \nL1474: let mut bytes = PROTOCOL_NAME.to_vec();\nL1475: \nL1476: bytes.extend(i.to_le_bytes());\nL1477: \nL1478: bytes.extend(j.to_le_bytes());\nL1479: \nL1480: let hash = Blake2s256::digest(bytes.as_slice());\nL1481: \nL1482: p = G::from_random_bytes(&hash);\nL1483: \nL1484: j += 1;\nL1485: \nL1486: }\nL1487: \nL1488: let point = p.unwrap();\nL1489: \nL1490: point.mul_by_cofactor_to_group()\nL1491: \nL1492: })\nL1493: \nL1494: .collect();\nL1495: \nL1496: // Converting from projective to affine representation\nL1497: let mut points = G::Group::normalize_batch(&points);\nL1498: \nL1499: let h: G = points.pop().unwrap();\nL1500: \nL1501: Ok(HyraxUniversalParams { com_key: points, h })\nL1502: \nL1503: }\nL1504: \nL1505: /// Trims a key into a prover key and a verifier key. This should only\nL1506: \nL1507: /// amount to discarding some of the points in said key if the prover\nL1508: \nL1509: /// and verifier only wish to commit to polynomials with fewer variables\nL1510: \nL1511: /// than the key can support. Since the number of variables is not\nL1512: \nL1513: /// considered in the prototype, this function currently simply clones the\nL1514: \nL1515: /// key.\nL1516: fn trim(\nL1517: \nL1518: pp: &Self::UniversalParams,\nL1519: \nL1520: _supported_degree: usize,\nL1521: \nL1522: _supported_hiding_bound: usize,\nL1523: \nL1524: _enforced_degree_bounds: Option<&[usize]>,\nL1525: \nL1526: ) -> Result<(Self::CommitterKey, Self::VerifierKey), Self::Error> {\nL1527: \nL1528: Ok((pp.clone(), pp.clone()))\nL1529: \nL1530: }\nL1531: \nL1532: /// Produces a list of commitments to the passed polynomials. Cf. the\nL1533: \nL1534: /// section \"Square-root commitment scheme\" from the reference article.\nL1535: \nL1536: ///\nL1537: \nL1538: /// # Panics\nL1539: \nL1540: ///\nL1541: \nL1542: /// Panics if `rng` is None, since Hyrax requires randomness in order to\nL1543: /// commit to a polynomial\nL1544: #[allow(unused_variables)]\nL1545: \nL1546: fn commit<'a>(\nL1547: \nL1548: ck: &Self::CommitterKey,\nL1549: \nL1550: polynomials: impl IntoIterator<Item = &'a LabeledPolynomial<G::ScalarField, P>>,\nL1551: \nL1552: rng: Option<&mut dyn RngCore>,\nL1553: \nL1554: ) -> Result<\nL1555: \nL1556: (\nL1557: \nL1558: Vec<LabeledCommitment<Self::Commitment>>,\nL1559: \nL1560: Vec<Self::CommitmentState>,\nL1561: \nL1562: ),\nL1563: \nL1564: Self::Error,\nL1565: \nL1566: >\nL1567: \nL1568: where\nL1569: \nL1570: P: 'a,\nL1571: \nL1572: {\nL1573: \nL1574: let mut coms = Vec::new();\nL1575: \nL1576: let mut states = Vec::new();\nL1577: #[cfg(not(feature = \"parallel\"))]\nL1578: \nL1579: let rng_inner = rng.expect(\"Committing to polynomials requires a random generator\");\nL1580: \nL1581: for l_poly in polynomials {\nL1582: \nL1583: let label = l_poly.label();\nL1584: \nL1585: let poly = l_poly.polynomial();\nL1586: \nL1587: let n = poly.num_vars();\nL1588: \nL1589: let dim = 1 << n / 2;\nL1590: \nL1591: if n % 2 == 1 {\nL1592: \nL1593: // Only polynomials with an even number of variables are\nL1594: \nL1595: // supported in this implementation\nL1596: \nL1597: return Err(Error::InvalidNumberOfVariables);\nL1598: \nL1599: }\nL1600: \nL1601: if n > ck.com_key.len() {\nL1602: \nL1603: return Err(Error::InvalidNumberOfVariables);\nL1604: \nL1605: }\nL1606: let m = flat_to_matrix_column_major(&poly.to_evaluations(), dim, dim);\nL1607: \nL1608: // Commiting to the matrix with one multi-commitment per row\nL1609: \nL1610: let (row_coms, com_rands): (Vec<_>, Vec<_>) = cfg_iter!(m)\nL1611: \nL1612: .map(|row| {\nL1613: #[cfg(not(feature = \"parallel\"))]\nL1614: \nL1615: let r = G::ScalarField::rand(rng_inner);\nL1616: #[cfg(feature = \"parallel\")]\nL1617: \nL1618: let r = G::ScalarField::rand(&mut rand::thread_rng());\nL1619: \nL1620: let c = (Self::pedersen_commit(&ck.com_key, row) + ck.h * r).into();\nL1621: \nL1622: (c, r)\nL1623: \nL1624: })\nL