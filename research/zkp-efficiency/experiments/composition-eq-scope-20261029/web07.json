f::Commitment: 'a,\nL1698: \nL1699: Self::CommitmentState: 'a,\nL1700: \nL1701: P: 'a,\nL1702: \nL1703: {\nL1704: \nL1705: let n = point.len();\nL1706: \nL1707: if n % 2 == 1 {\nL1708: \nL1709: // Only polynomials with an even number of variables are\nL1710: \nL1711: // supported in this implementation\nL1712: \nL1713: return Err(Error::InvalidNumberOfVariables);\nL1714: \nL1715: }\nL1716: \nL1717: let dim = 1 << n / 2;\nL1718: \nL1719: // Reversing the point is necessary because the MLE interface returns\nL1720: \nL1721: // evaluations in little-endian order\nL1722: let point_rev: Vec<G::ScalarField> = point.iter().rev().cloned().collect();\nL1723: \nL1724: let point_lower = &point_rev[n / 2..];\nL1725: \nL1726: let point_upper = &point_rev[..n / 2];\nL1727: \nL1728: // Deriving the tensors which result in the evaluation of the polynomial\nL1729: \nL1730: // when they are multiplied by the coefficient matrix.\nL1731: \nL1732: let l = tensor_prime(point_lower);\nL1733: \nL1734: let r = tensor_prime(point_upper);\nL1735: \nL1736: let mut proofs = Vec::new();\nL1737: \nL1738: let rng_inner = rng.expect(\"Opening polynomials requires randomness\");\nL1739: for (l_poly, (l_com, state)) in labeled_polynomials\nL1740: \nL1741: .into_iter()\nL1742: \nL1743: .zip(commitments.into_iter().zip(states.into_iter()))\nL1744: \nL1745: {\nL1746: \nL1747: let label = l_poly.label();\nL1748: \nL1749: if label != l_com.label() {\nL1750: \nL1751: return Err(Error::MismatchedLabels {\nL1752: \nL1753: commitment_label: l_com.label().to_string(),\nL1754: \nL1755: polynomial_label: label.to_string(),\nL1756: \nL1757: });\nL1758: \nL1759: }\nL1760: \nL1761: let poly = l_poly.polynomial();\nL1762: \nL1763: let com = l_com.commitment();\nL1764: \nL1765: if poly.num_vars() != n {\nL1766: \nL1767: return Err(Error::MismatchedNumVars {\nL1768: \nL1769: poly_nv: poly.num_vars(),\nL1770: \nL1771: point_nv: n,\nL1772: \nL1773: });\nL1774: \nL1775: }\nL1776: // Absorbing public parameters\nL1777: \nL1778: sponge.absorb(&serialize_to_vec!(*ck).map_err(|_| Error::TranscriptError)?);\nL1779: \nL1780: // Absorbing the commitment to the polynomial\nL1781: \nL1782: sponge.absorb(&serialize_to_vec!(com.row_coms).map_err(|_| Error::TranscriptError)?);\nL1783: \nL1784: // Absorbing the point\nL1785: \nL1786: sponge.absorb(point);\nL1787: \nL1788: // Commiting to the matrix formed by the polynomial coefficients\nL1789: \nL1790: let t = &state.mat;\nL1791: \nL1792: let lt = t.row_mul(&l);\nL1793: \nL1794: // t_prime coincides witht he Pedersen commitment to lt with the\nL1795: \nL1796: // randomnes r_lt computed here\nL1797: let r_lt = cfg_iter!(l)\nL1798: \nL1799: .zip(&state.randomness)\nL1800: \nL1801: .map(|(l, r)| *l * r)\nL1802: \nL1803: .sum::<G::ScalarField>();\nL1804: \nL1805: let eval = inner_product(&lt, &r);\nL1806: \nL1807: // Singleton commit\nL1808: \nL1809: let (com_eval, r_eval) = {\nL1810: \nL1811: let r = G::ScalarField::rand(rng_inner);\nL1812: \nL1813: ((ck.com_key[0] * eval + ck.h * r).into(), r)\nL1814: \nL1815: };\nL1816: \nL1817: // ******** Dot product argument ********\nL1818: \nL1819: // Appendix A.2 in the reference article\nL1820: \nL1821: let d: Vec<G::ScalarField> =\nL1822: \nL1823: (0..dim).map(|_| G::ScalarField::rand(rng_inner)).collect();\nL1824: \nL1825: let b = inner_product(&r, &d);\nL1826: \nL1827: // Multi-commit\nL1828: let r_d = G::ScalarField::rand(rng_inner);\nL1829: \nL1830: let com_d = (Self::pedersen_commit(&ck.com_key, &d) + ck.h * r_d).into();\nL1831: \nL1832: // Singleton commit\nL1833: \nL1834: let r_b = G::ScalarField::rand(rng_inner);\nL1835: \nL1836: let com_b = (ck.com_key[0] * b + ck.h * r_b).into();\nL1837: \nL1838: // Absorbing the commitment to the evaluation\nL1839: \nL1840: sponge.absorb(&serialize_to_vec!(com_eval).map_err(|_| Error::TranscriptError)?);\nL1841: \nL1842: // Absorbing the two auxiliary commitments\nL1843: \nL1844: sponge.absorb(&serialize_to_vec!(com_d).map_err(|_| Error::TranscriptError)?);\nL1845: sponge.absorb(&serialize_to_vec!(com_b).map_err(|_| Error::TranscriptError)?);\nL1846: \nL1847: // Receive the random challenge c from the verifier, i.e. squeeze\nL1848: \nL1849: // it from the transcript.\nL1850: \nL1851: let c = sponge.squeeze_field_elements(1)[0];\nL1852: \nL1853: let z = vector_sum(&d, &scalar_by_vector(c, &lt));\nL1854: \nL1855: let z_d = c * r_lt + r_d;\nL1856: \nL1857: let z_b = c * r_eval + r_b;\nL1858: \nL1859: proofs.push(HyraxProof {\nL1860: \nL1861: com_eval,\nL1862: \nL1863: com_d,\nL1864: \nL1865: com_b,\nL1866: \nL1867: z,\nL1868: \nL1869: z_d,\nL1870: \nL1871: z_b,\nL1872: \nL1873: });\nL1874: \nL1875: }\nL1876: \nL1877: Ok(proofs)\nL1878: \nL1879: }\nL1880: \nL1881: /// Verifies a list of opening proofs and confirms the evaluation of the\nL1882: /// committed polynomials at the desired point.\nL1883: \nL1884: ///\nL1885: \nL1886: /// # Panics\nL1887: \nL1888: /// - If the point doesn't have an even number of variables.\nL1889: \nL1890: /// - If the length of a commitment does not correspond to the length of the\nL1891: \nL1892: /// point (specifically, commitment length should be 2^(point-length/2)).\nL1893: \nL1894: ///\nL1895: \nL1896: /// # Disregarded arguments\nL1897: \nL1898: /// - `rng`\nL1899: \nL1900: fn check<'a>(\nL1901: \nL1902: vk: &Self::VerifierKey,\nL1903: \nL1904: commitments: impl IntoIterator<Item = &'a LabeledCommitment<Self::Commitment>>,\nL1905: \nL1906: point: &'a P::Point,\nL1907: _values: impl IntoIterator<Item = G::ScalarField>,\nL1908: \nL1909: proof: &Self::Proof,\nL1910: \nL1911: sponge: &mut impl CryptographicSponge,\nL1912: \nL1913: _rng: Option<&mut dyn RngCore>,\nL1914: \nL1915: ) -> Result<bool, Self::Error>\nL1916: \nL1917: where\nL1918: \nL1919: Self::Commitment: 'a,\nL1920: \nL1921: {\nL1922: \nL1923: let n = point.len();\nL1924: \nL1925: if n % 2 == 1 {\nL1926: \nL1927: // Only polynomials with an even number of variables are\nL1928: \nL1929: // supported in this implementation\nL1930: \nL1931: return Err(Error::InvalidNumberOfVariables);\nL1932: \nL1933: }\nL1934: \nL1935: // Reversing the point is necessary because the MLE interface returns\nL1936: \nL1937: // evaluations in little-endian order\nL1938: let point_rev: Vec<G::ScalarField> = point.iter().rev().cloned().collect();\nL1939: \nL1940: let point_lower = &point_rev[n / 2..];\nL1941: \nL1942: let point_upper = &point_rev[..n / 2];\nL1943: \nL1944: // Deriving the tensors which result in the evaluation of the polynomial\nL1945: \nL1946: // when they are multiplied by the coefficient matrix.\nL1947: \nL1948: let l = tensor_prime(point_lower);\nL1949: \nL1950: let r = tensor_prime(point_upper);\nL1951: \nL1952: for (com, h_proof) in commitments.into_iter().zip(proof.iter()) {\nL1953: \nL1954: let row_coms = &com.commitment().row_coms;\nL1955: \nL1956: // extract each field from h_proof\nL1957: let HyraxProof {\nL1958: \nL1959: com_eval,\nL1960: \nL1961: com_d,\nL1962: \nL1963: com_b,\nL1964: \nL1965: z,\nL1966: \nL1967: z_d,\nL1968: \nL1969: z_b,\nL1970: \nL1971: } = h_proof;\nL1972: \nL1973: if row_coms.len() != 1 << n / 2 {\nL1974: \nL1975: return Err(Error::IncorrectCommitmentSize {\nL1976: \nL1977: encountered: row_coms.len(),\nL1978: \nL1979: expected: 1 << n / 2,\nL1980: \nL1981: });\nL1982: \nL1983: }\nL1984: \nL1985: // Absorbing public parameters\nL1986: \nL1987: sponge.absorb(&serialize_to_vec!(*vk).map_err(|_| Error::TranscriptError)?);\nL1988: \nL1989: // Absorbing the commitment to the polynomial\nL1990: \nL1991: sponge.absorb(&serialize_to_vec!(*row_coms).map_err(|_| Error::TranscriptError)?);\nL1992: \nL1993: // Absorbing the point\nL1994: \nL1995: sponge.absorb(point);\nL1996: // Absorbing the commitment to the evaluation\nL1997: \nL1998: sponge.absorb(&serialize_to_vec!(*com_eval).map_err(|_| Error::TranscriptError)?);\nL1999: \nL2000: // Absorbing the two auxiliary commitments\nL2001: \nL2002: sponge.absorb(&serialize_to_vec!(*com_d).map_err(|_| Error::TranscriptError)?);\nL2003: \nL2004: sponge.absorb(&serialize_to_vec!(*com_b).map_err(|_| Error::TranscriptError)?);\nL2005: \nL2006: // Receive the random challenge c from the verifier, i.e. squeeze\nL2007: \nL2008: // it from the transcript.\nL2009: \nL2010: let c: G::ScalarField = sponge.squeeze_field_elements(1)[0];\nL2011: // Second check from the paper (figure 6, equation (14))\nL2012: \nL2013: // Moved here for potential early return\nL2014: \nL2015: let com_dp = (vk.com_key[0] * inner_product(&r, z) + vk.h * z_b).into();\nL2016: \nL2017: if com_dp != (com_eval.mul(c) + com_b).into() {\nL2018: \nL2019: return Ok(false);\nL2020: \nL2021: }\nL2022: \nL2023: // Computing t_prime with a multi-exponentiation\nL2024: \nL2025: let l_bigint = cfg_iter!(l)\nL2026: \nL2027: .map(|chi| chi.into_bigint())\nL2028: \nL2029: .collect::<Vec<_>>();\nL2030: \nL2031: let t_prime: G = <G::Group as VariableBaseMSM>::msm_bigint(&row_coms, &l_bigint).into();\nL2032: // First check from the paper (figure 6, equation (13))\nL2033: \nL2034: let com_z_zd = (Self::pedersen_commit(&vk.com_key, z) + vk.h * z_d).into();\nL2035: \nL2036: if com_z_zd != (t_prime.mul(c) + com_d).into() {\nL2037: \nL2038: return Ok(false);\nL2039: \nL2040: }\nL2041: \nL2042: }\nL2043: \nL2044: Ok(true)\nL2045: \nL2046: }\nL2047: \nL2048: }\nL2049: \nL2050: You can’t perform that action at this time.\n--------------------------------------------------------------------------------\nGitHub - hyraxZK/fennel: Python reference implementation of Hyrax · GitHub (https://github.com/hyraxZK/fennel)\nciteturn7view4 [wordlim: 200] Crawled: yesterday; Content type: text/html; Source: find({\"ref_id\":\"turn6view1\",\"pattern\":\"LICENSE\"}); Total lines: 279\nL185: ## Folders and files\nL186: \nL187: Name  | Name  | Last commit message  | Last commit date\nL188: --- | --- | --- | ---\nL189: 【79†libfennel】  | 【79†libfennel】  |    |\nL190: 【80†libfenneltests】  | 【80†libfenneltests】  |    |\nL191: 【81†.gitignore】  | 【81†.gitignore】  |    |\nL192: 【82†LICENSE】  | 【82†LICENSE】  |    |\nL193: 【83†README.md】  | 【83†README.md】  |    |\nL194: 【84†pymiracl】  | 【84†pymiracl】  |    |\nL195: 【85†pypws】  | 【85†pypws】  |    |\nL196: 【86†run_fennel.py】  | 【86†run_fennel.py】  |    |\nL197: ## Repository files navigation\nL198: \nL199:   *   * 【87†README】\nL200:   * 【87†Apache-2.0 license】\nL201: \nL202: More items\nL203: \nL204: # libfennel - Hyrax reference implementation\nL205: \nL206: libfennel is the reference implementation of 【88†Hyrax†hyrax.crypto.fyi】, a zkSNARK that requires no trusted setup.\nL207: \nL208: This implementation is written in Python and C/C++. It is compatible with both Python 2.7 and PyPy. (Porting to Python 3.0 would be trivial, but would reduce performance.)\nL209: ## Building and using\nL210: \nL211: The code in this directory is pure Python, but to read PWS files and for elliptic curve operations we use C/C++ extensions. These extensions live in their own repositories, 【89†pymiracl】 and 【90†libpws】. The easiest way to use the whole system is to check out the 【91†hyraxZK】 \"meta-repository\", which links all the necessary submodules and has a top-level Makefile.\nL212: ## Running\nL213: \nL214: If you want to run a PWS file, you should use `run_fennel.py` like so:\nL215: \nL216:     `./run_fennel.py -p /path/to/PWS/file\nL217:     `\nL218: \nL219: Execute `./run_fennel.py` with no arguments to see all of the possible arguments.\nL220: \nL221: ## Tests\nL222: \nL223: The `libfenneltests/` subdir has a pretty complete set of tests for libfennel.\nL224: \nL225: You can run the tests like so:\nL226: \nL227:     `python libfenneltests/\nL228:     `\nL229: # License\nL230: \nL231: Copyright 2017 Riad S. Wahby rsw@cs.stanford.edu and the Hyrax authors.\nL232: \nL233: Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain a copy of the License at\nL234: \nL235: 【92†http://www.apache.org/licenses/LICENSE-2.0†www.apache.org】\nL236: Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.\nL237: # Questions?\nL238: \nL239:     `rsw@cs.stanford.edu\nL240:     `\nL241: \nL242: ## About\nL243: \nL244: Python reference implementation of Hyrax\nL245: \nL246: ### Resources\nL247: \nL248: 【71†Readme】\nL249: \nL250: 【72†Apache-2.0 license】\nL251: \nL252: 【73†Activity】\nL253: \nL254: 【74†Custom properties】\nL255: \nL256: ### Stars\nL257: \nL258: 6 stars\nL259: \nL260: ### Watchers\nL261: \nL262: 0 watching\nL263: \nL264: ### Forks\nL265: \nL266: 【75†2 forks】\nL267: \nL268: 【76†Report repository】\nL269: \nL270: ## Releases\nL271: \nL272: ## Packages\nL273: \nL274: ## Contributors\nL275: \nL276: ## Languages\nL277: \nL278: You can’t perform that action at this time.\n--------------------------------------------------------------------------------\nFlexProofs: A Vector Commitment with Flexible Linear Time for Computing All Proofs (https://arxiv.org/html/2601.03031v2)\nciteturn7view5 [wordlim: 200] Crawled: 6 days ago; Content type: text/html; Source: find({\"ref_id\":\"turn5view0\",\"pattern\":\"Implementation\"}); Total lines: 725\nL64: The scheme achieves constant-size commitments and logarithmic-size proofs, and is proven secure in the algebraic group model (AGM) and the random oracle model (ROM) under the $n$-ASDBP and $q$-SDH assumptions; our implementation confirms the high efficiency of batch opening.\nL65: FlexProofs. We introduce FlexProofs, a new vector commitment (VC) scheme that achieves two key properties. First, the prover can generate all proofs for a vector of size $N$ in optimal time ${\\cal O}(N)$, which is incurred by ${\\cal O}(N)$ field operations and ${\\cal O}(N/b+\\sqrt{N}\\log N)$ cryptographic operations, where batch size $b$ ranges from $1$ to $\\sqrt{N}$.\n"
