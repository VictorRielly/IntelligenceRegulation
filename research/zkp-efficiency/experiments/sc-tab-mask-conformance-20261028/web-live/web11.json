tract(const std::uint64_t a, const std::uint64_t b) const {\nL365: \nL366: return (a >= b) ? (a - b) : (a - b + modulus);\nL367: \nL368: }\nL369: \nL370: std::uint64_t multiply(const std::uint64_t a, const std::uint64_t b) const {\nL371: \nL372: return a * static_cast<unsigned __int128>(b) % modulus;\nL373: \nL374: }\nL375: \nL376: std::uint64_t power(std::uint64_t a, std::int64_t e) const {\nL377: \nL378: if (e < 0) {\nL379: \nL380: return power(a, Modulus(modulus - 1).multiply(modulus - 2, -e));\nL381: \nL382: }\nL383: \nL384: std::uint64_t b = 1;\nL385: \nL386: for (; e; e >>= 1) {\nL387: \nL388: if (e & 1) {\nL389: \nL390: b = multiply(b, a);\nL391: \nL392: }\nL393: a = multiply(a, a);\nL394: \nL395: }\nL396: \nL397: return b;\nL398: \nL399: }\nL400: \nL401: std::uint64_t invert(const std::uint64_t a) const {\nL402: \nL403: return power(a, modulus - 2);\nL404: \nL405: }\nL406: \nL407: /* Note: Assuming the specified root exists. */\nL408: \nL409: std::uint64_t get_root_forward(const std::uint64_t order) const {\nL410: \nL411: return power(generator, (modulus - 1) / order);\nL412: \nL413: }\nL414: \nL415: /* Note: Assuming the specified root exists. */\nL416: \nL417: std::uint64_t get_root_inverse(const std::uint64_t order) const {\nL418: \nL419: return power(\nL420: \nL421: generator,\nL422: \nL423: Modulus(modulus - 1).multiply((modulus - 1) / order, modulus - 2));\nL424: \nL425: }\nL426: \nL427: };\nL428: } // namespace polyarith\nL429: #endif /* POLYARITH_MODULUS_CUH_INCLUDED */\nL430: \nL431: You can’t perform that action at this time.\n--------------------------------------------------------------------------------\ntensor-core-ntt/include/polyarith/modular.cuh at main · Terminus-IMRC/tensor-core-ntt · GitHub (https://github.com/Terminus-IMRC/tensor-core-ntt/blob/main/include/polyarith/modular.cuh)\nciteturn10view2 [wordlim: 200] Crawled: last month; Content type: text/html; Source: click({\"ref_id\":\"turn9view0\",\"id\":74}); Total lines: 1775\nL0: 【0†