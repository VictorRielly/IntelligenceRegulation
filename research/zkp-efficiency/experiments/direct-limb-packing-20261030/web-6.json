pl<T, A1: Allocator, A2: Allocator> SpecExtend<T, IntoIter<T, A2>> for Vec<T, A1> {\nL414: \nL415:  fn spec_extend(&mut self, iterator: IntoIter<T, A2>) {\nL416: \nL417:  unsafe {\nL418: \nL419:  self.append_elements(iterator.as_slice() as _);\nL420: \nL421:  }\nL422: \nL423:  iterator.forget_remaining_elements_and_dealloc();\nL424: \nL425:  }\nL426: \nL427: }\nL428: \nL429: impl<'a, T: 'a, I, A: Allocator> SpecExtend<&'a T, I> for Vec<T, A>\nL430: \nL431: where\nL432: \nL433:  I: Iterator<Item = &'a T>,\nL434: \nL435:  T: Clone,\nL436: \nL437: {\nL438:  default fn spec_extend(&mut self, iterator: I) {\nL439: \nL440:  self.spec_extend(iterator.cloned())\nL441: \nL442:  }\nL443: \nL444: }\nL445: \nL446: impl<'a, T: 'a, A: Allocator> SpecExtend<&'a T, slice::Iter<'a, T>> for Vec<T, A>\nL447: \nL448: where\nL449: \nL450:  T: TrivialClone,\nL451: \nL452: {\nL453: \nL454:  fn spec_extend(&mut self, iterator: slice::Iter<'a, T>) {\nL455: \nL456:  let slice = iterator.as_slice();\nL457: \nL458:  unsafe { self.append_elements(slice) };\nL459: \nL460:  }\nL461: \nL462: }\nL463: ## Footer\nL464: \nL465: 【78† 】  © 2026 GitHub, Inc.\nL466: \nL467: ### Footer navigation\nL468: \nL469:   * 【79†Terms†docs.github.com】\nL470:   * 【80†Privacy†docs.github.com】\nL471:   * 【81†Security】\nL472:   * 【82†Status†www.githubstatus.com】\nL473:   * 【83†Community†github.community】\nL474:   * 【84†Docs†docs.github.com】\nL475:   * 【85†Contact†support.github.com】\nL476:   * Manage cookies\nL477:   * Do not share my personal information\nL478: \nL479:   You can’t perform that action at this time.\n"
