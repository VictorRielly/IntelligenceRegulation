+// UNCOMPILED research proposal: current slot, public challenge weights only.
+#[derive(Default)]
+struct MaskTailWeights {
+    point: Vec<Fp2>,
+    eq: Vec<Fp2>,
+}
+
+impl MaskTailWeights {
+    fn at(&mut self, point: &[Fp2]) -> &[Fp2] {
+        if self.eq.is_empty() || self.point.as_slice() != point {
+            // Drop the old vector before allocating its replacement.
+            self.eq = Vec::new();
+            self.point.clear();
+            self.point.extend_from_slice(point);
+            self.eq = eq_table_msb(point);
+        }
+        &self.eq
+    }
+}
+
+/// the mask pair's value at the claim's column tail
+fn mask_eval_cached(sh: &Shape, p: &Priv, data: &[Fp], point: &[Fp2], weights: &mut MaskTailWeights) -> Fp2 {
+    let (log_n, n) = (row_log(sh, p.cm), 1usize << row_log(sh, p.cm));
+    let logm = p.log.min(log_n);
+    let c0 = if p.log < log_n { p.slices[0].0 % n } else { 0 };
+    let eq = weights.at(&point[p.log - logm..]);
     let row = |r: usize| {
         data[r * n + c0..r * n + c0 + eq.len()].iter().zip(eq.iter()).fold(Fp2::ZERO, |a, (x, e)| a.add(e.mul_base(*x)))
     };
