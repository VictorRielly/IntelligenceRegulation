" (https://raw.githubusercontent.com/rapidsai/cudf/main/cpp/include/cudf/detail/utilities/cuda_memcpy.hpp)\nciteturn4view0 [wordlim: 200] Crawled: today; Content type: text/plain; Source: open({\"ref_id\":\"https://raw.githubusercontent.com/rapidsai/cudf/main/cpp/include/cudf/detail/utilities/cuda_memcpy.hpp\",\"lineno\":null}); Total lines: 138\nL0: /*\nL1:  * SPDX-FileCopyrightText: Copyright (c) 2024-2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nL2:  * SPDX-License-Identifier: Apache-2.0\nL3:  */\nL4: \nL5: #pragma once\nL6: \nL7: #include <cudf/detail/utilities/cuda.hpp>\nL8: #include <cudf/utilities/error.hpp>\nL9: #include <cudf/utilities/export.hpp>\nL10: #include <cudf/utilities/span.hpp>\nL11: #include <cuda/stream>\nL12: \nL13: namespace CUDF_EXPORT cudf {\nL14: namespace detail {\nL15: \nL16: enum class host_memory_kind : uint8_t { PINNED, PAGEABLE };\nL17: \nL18: void cuda_memcpy_async_impl(\nL19:   void* dst, void const* src, size_t size, host_memory_kind kind, cuda::stream_ref stream);\nL20: /**\nL21:  * @brief Wrapper around cudaMemcpyBatchAsync\nL22:  *\nL23:  * Uses `cudaMemcpyBatchAsync` on CUDA 13.0+ with `cudaMemcpySrcAccessOrderStream`, which defers\nL24:  * reading the source buffers until the stream reaches each copy. The source buffers must therefore\nL25:  * remain valid until the stream has executed the copies; for device memory this is naturally\nL26:  * satisfied, but for host memory the caller must ensure the source is not freed before the stream\nL27:  * is synchronized.\nL28:  *\nL29:  * A batch uses `cudaMemcpyFlagPreferOverlapWithCompute` when every copy is 128 KiB or less. If\nL30:  * any copy is larger, the batch uses `cudaMemcpyFlagDefault`.\nL31:  *\nL32:  * @param dsts Host pointer to a list of destination pointers.\nL33:  * @param srcs Host pointer to a list of source pointers.\nL34:  * @param sizes Host pointer to a list of sizes.\nL35:  * @param count Size of dsts, srcs, sizes arrays\nL36:  * @param stream CUDA stream on which copies are enqueued\nL37:  *\nL38:  * @note if \\p stream is the default stream, this function will fallback to `cudaMemcpyAsync` for\nL39:  * each copy.\nL40:  */\nL41: [[nodiscard]] cudaError_t memcpy_batch_async(void* const* dsts,\nL42:                                              void const* const* srcs,\nL43:                                              std::size_t const* sizes,\nL44:                                              std::size_t count,\nL45:                                              cuda::stream_ref stream);\nL46: /**\nL47:  * @brief Asynchronously copies a single buffer, wrapping `memcpy_batch_async`.\nL48:  *\nL49:  * Carries the same source-lifetime requirement as `memcpy_batch_async`: the source buffer must\nL50:  * remain valid until the stream has executed the copy.\nL51:  *\nL52:  * Prefer `cudf::detail::cuda_memcpy_async` for host/device copies involving typed spans.\nL53:  * Use this function for device-to-device copies or when a raw `void*` interface is required.\nL54:  * The copy direction is inferred from the pointer types (`cudaMemcpyDefault`).\nL55:  *\nL56:  * @param dst Destination memory address\nL57:  * @param src Source memory address\nL58:  * @param count Size in bytes to copy\nL59:  * @param stream CUDA stream on which the copy is enqueued\nL60:  * @return cudaError_t CUDA error code\nL61:  */\nL62: [[nodiscard]] cudaError_t memcpy_async(void* dst,\nL63:                                        void const* src,\nL64:                                        size_t count,\nL65:                                        cuda::stream_ref stream);\nL66: /**\nL67:  * @brief Asynchronously copies data from host to device memory.\nL68:  *\nL69:  * Implementation may use different strategies depending on the size and type of host data.\nL70:  *\nL71:  * @param dst Destination device memory\nL72:  * @param src Source host memory\nL73:  * @param stream CUDA stream used for the copy\nL74:  */\nL75: template <typename T>\nL76: void cuda_memcpy_async(device_span<T> dst, host_span<T const> src, cuda::stream_ref stream)\nL77: {\nL78:   CUDF_EXPECTS(dst.size() == src.size(), \"Mismatched sizes in cuda_memcpy_async\");\nL79:   auto const is_pinned = src.is_device_accessible();\nL80:   cuda_memcpy_async_impl(dst.data(),\nL81:                          src.data(),\nL82:                          src.size_bytes(),\nL83:                          is_pinned ? host_memory_kind::PINNED : host_memory_kind::PAGEABLE,\nL84:                          stream);\nL85: }\nL86: /**\nL87:  * @brief Asynchronously copies data from device to host memory.\nL88:  *\nL89:  * Implementation may use different strategies depending on the size and type of host data.\nL90:  *\nL91:  * @param dst Destination host memory\nL92:  * @param src Source device memory\nL93:  * @param stream CUDA stream used for the copy\nL94:  */\nL95: template <typename T>\nL96: void cuda_memcpy_async(host_span<T> dst, device_span<T const> src, cuda::stream_ref stream)\nL97: {\nL98:   CUDF_EXPECTS(dst.size() == src.size(), \"Mismatched sizes in cuda_memcpy_async\");\nL99:   auto const is_pinned = dst.is_device_accessible();\nL100:   cuda_memcpy_async_impl(dst.data(),\nL101:                          src.data(),\nL102:                          src.size_bytes(),\nL103:                          is_pinned ? host_memory_kind::PINNED : host_memory_kind::PAGEABLE,\nL104:                          stream);\nL105: }\nL106: /**\nL107:  * @brief Synchronously copies data from host to device memory.\nL108:  *\nL109:  * Implementation may use different strategies depending on the size and type of host data.\nL110:  *\nL111:  * @param dst Destination device memory\nL112:  * @param src Source host memory\nL113:  * @param stream CUDA stream used for the copy\nL114:  */\nL115: template <typename T>\nL116: void cuda_memcpy(device_span<T> dst, host_span<T const> src, cuda::stream_ref stream)\nL117: {\nL118:   cuda_memcpy_async(dst, src, stream);\nL119:   cudf::detail::sync_stream(stream);\nL120: }\nL121: /**\nL122:  * @brief Synchronously copies data from device to host memory.\nL123:  *\nL124:  * Implementation may use different strategies depending on the size and type of host data.\nL125:  *\nL126:  * @param dst Destination host memory\nL127:  * @param src Source device memory\nL128:  * @param stream CUDA stream used for the copy\nL129:  */\nL130: template <typename T>\nL131: void cuda_memcpy(host_span<T> dst, device_span<T const> src, cuda::stream_ref stream)\nL132: {\nL133:   cuda_memcpy_async(dst, src, stream);\nL134:   cudf::detail::sync_stream(stream);\nL135: }\nL136: }  // namespace detail\nL137: }  // namespace CUDF_EXPORT cudf\n--------------------------------------------------------------------------------\n (https://raw.githubusercontent.com/rapidsai/cudf/main/LICENSE)\nciteturn4view1 [wordlim: 200] Crawled: last month; Content type: text/plain; Source: open({\"ref_id\":\"https://raw.githubusercontent.com/rapidsai/cudf/main/LICENSE\",\"lineno\":null}); Total lines: 180\nL0: Apache License\nL1:                            Version 2.0, January 2004\nL2:                         http://www.apache.org/licenses/\nL3: \nL4:    TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION\nL5: \nL6:    1. Definitions.\nL7: \nL8:       \"License\" shall mean the terms and conditions for use, reproduction,\nL9:       and distribution as defined by Sections 1 through 9 of this document.\nL10: \nL11:       \"Licensor\" shall mean the copyright owner or entity authorized by\nL12:       the copyright owner that is granting the License.\nL13:       \"Legal Entity\" shall mean the union of the acting entity and all\nL14:       other entities that control, are controlled by, or are under common\nL15:       control with that entity. For the purposes of this definition,\nL16:       \"control\" means (i) the power, direct or indirect, to cause the\nL17:       direction or management of such entity, whether by contract or\nL18:      