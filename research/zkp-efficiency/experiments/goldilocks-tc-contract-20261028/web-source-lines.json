      "23": "template <class reduction_type_> class NttForward16x16Coalesced {",
      "24": "",
      "25": "public:",
      "26": "  using reduction_type = reduction_type_;",
      "27": "",
      "28": "private:",
      "29": "  struct {",
      "30": "    struct {",
      "31": "      std::uint64_t value;",
      "32": "    } by_lane[32];",
      "33": "  } values[8];",
      "34": "",
      "35": "public:",
      "36": "  NttForward16x16Coalesced(void) = default;",
      "37": "  NttForward16x16Coalesced(const Modulus &modulus) {",
      "38": "    const std::uint64_t factor = modulus.power(2, reduction_type::get_factor());",
      "39": "    const std::uint64_t root = modulus.get_root_forward(16);",
      "40": "",
      "41": "    std::uint64_t forward_ntt[16][16];",
      "42": "    for (int row = 0; row < 16; ++row) {",
      "43": "      for (int col = 0; col < 16; ++col) {",
      "44": "        forward_ntt[row][col] = modulus.multiply(",
      "45": "            modulus.power(",
      "46": "                root, arithmetic::bitswap_within<std::uint32_t>(row, 4) * col),",
      "47": "            factor);",
      "48": "      }",
      "49": "    }",
      "50": "    for (int laneId = 0; laneId < 32; ++laneId) {",
      "51": "      std::uint64_t a[8];",
      "52": "      load_matrix_16x16_packed4cols_n_lane(a, &forward_ntt[0][0], 16, laneId);",
      "53": "      for (int pos = 0; pos < 8; ++pos) {",
      "54": "        std::uint8_t aa[8];",
      "55": "        for (int i = 0; i < 8; ++i) {",
      "56": "          aa[i] = a[i] >> (8 * pos);",
      "57": "        }",
      "58": "        std::memcpy(&values[pos].by_lane[laneId].value, aa, 8);",
      "59": "      }",
      "60": "    }",
      "61": "  }",
      "62": "",
      "63": "  __device__ void get(void *const out) const {",
      "64": "    const int laneId = get_laneId();",
      "65": "    for (int i = 0; i < (reduction_type::modulus_bits + 7) / 8; ++i) {",
      "66": "      reinterpret_cast<std::uint64_t *>(out)[i] =",
      "67": "          values[i].by_lane[laneId].value;",
      "68": "    }",
      "69": "  }",
      "70": "private:",
      "71": "  static __device__ void multiply_ntt_matrix(std::uint64_t uu[8],",
      "72": "                                             const std::uint32_t aa[8][2],",
      "73": "                                             const std::uint32_t bb[8][2],",
      "74": "                                             const std::uint64_t modulus,",
      "75": "                                             const reduction_type &reduction) {",
      "76": "    std::uint32_t ss[15][8]{};",
      "77": "    std::uint32_t tt[8][8]{};",
      "78": "    constexpr int num_digits = (reduction_type::modulus_bits + 7) / 8;",
      "79": "    for (int i = 0; i <= 2 * (num_digits - 1); ++i) {",
      "80": "      for (int j = 0; j < num_digits; ++j) {",
      "81": "        const int k = i - j;",
      "82": "        if (0 <= k && k < num_digits) {",
      "83": "          mma_m16n16k16(ss[i], aa[j], bb[k], ss[i]);",
      "84": "        }",
      "85": "      }",
      "86": "    }",
      "87": "    for (int i = 0; i < num_digits - 1; ++i) {",
      "88": "      for (int j = 0; j < 8; ++j) {",
      "89": "        tt[i][j] = ss[2 * i + 0][j] + (ss[2 * i + 1][j] << 8);",
      "90": "      }",
      "91": "    }",
      "92": "    for (int j = 0; j < 8; ++j) {",
      "93": "      tt[num_digits - 1][j] = ss[2 * (num_digits - 1)][j];",
      "94": "    }",
      "95": "",
      "96": "    for (int i = 0; i < 8; ++i) {",
      "97": "      uu[i] = reduction.reduce(tt[0][i], tt[1][i], tt[2][i], tt[3][i], tt[4][i],",
      "98": "                               tt[5][i], tt[6][i], tt[7][i], modulus);",
      "99": "    }",
      "100": "  }",
      "101": "public:",
      "102": "  __device__ void compute_2n(std::uint64_t a[8], const std::uint64_t modulus,",
      "103": "                             const reduction_type &reduction) const {",
      "104": "    const int laneId = get_laneId();",
      "105": "    const dim3 groupIdx(laneId % 4, laneId / 4);",
      "106": "",
      "107": "    std::uint32_t aa[8][2];",
      "108": "    matrix_16x16_decompose_u64_to_u8<reduction_type::modulus_bits>(aa, a);",
      "109": "",
      "110": "    __align__(16) std::uint32_t forward_ntt[8][2];",
      "111": "    get(forward_ntt);",
      "112": "    // mma(A, N^T) = A N",
      "113": "    // mma(A^T, N^T) = A^T N",
      "114": "    multiply_ntt_matrix(a, aa, forward_ntt, modulus, reduction);",
      "115": "  }",
      "116": "",
      "117": "  __device__ void compute_2t(std::uint64_t a[8], const std::uint64_t modulus,",
      "118": "                             const reduction_type &reduction) const {",
      "119": "    const int laneId = get_laneId();",
      "120": "    const dim3 groupIdx(laneId % 4, laneId / 4);",
      "121": "",
      "122": "    std::uint32_t aa[8][2];",
      "123": "    matrix_16x16_decompose_u64_to_u8<reduction_type::modulus_bits>(aa, a);",
      "124": "    __align__(16) std::uint32_t forward_ntt[8][2];",
      "125": "    get(forward_ntt);",
      "126": "",
      "127": "    // mma(N^T, A) = N^T A^T = (A N)^T",
      "128": "    // mma(N^T, A^T) = N^T A = (A^T N)^T",
      "129": "    multiply_ntt_matrix(a, forward_ntt, aa, modulus, reduction);",
      "130": "  }",
      "131": "};",
      "132": "",
      "133": "template <class reduction_type_> class NttForwardWmma16x16 {",
      "134": "",
      "135": "public:",
      "136": "  using reduction_type = reduction_type_;",
      "137": "",
      "138": "private:",
      "139": "  std::uint8_t values[8][16][16];",
      "140": "",
      "141": "public:",
      "142": "  NttForwardWmma16x16(void) = default;",
      "143": "  NttForwardWmma16x16(const Modulus &modulus) {",
      "144": "    const std::uint64_t factor = modulus.power(2, reduction_type::get_factor());",
      "145": "    const std::uint64_t root = modulus.get_root_forward(16);",
      "146": "",
      "147": "    std::uint64_t forward_ntt[16][16];",
      "148": "    for (int row = 0; row < 16; ++row) {",
      "149": "      for (int col = 0; col < 16; ++col) {",
      "150": "        forward_ntt[row][col] = modulus.multiply(",
      "151": "            modulus.power(",
      "152": "                root, arithmetic::bitswap_within<std::uint32_t>(row, 4) * col),",
      "153": "            factor);",
      "154": "      }",
      "155": "    }",
      "156": "    for (int row = 0; row < 16; ++row) {",
      "157": "      for (int col = 0; col < 16; ++col) {",
      "158": "        for (int pos = 0; pos < 8; ++pos) {",
      "159": "          values[pos][row][col] = forward_ntt[row][col] >> (8 * pos);",
      "160": "        }",
      "161": "      }",
      "162": "    }",
      "163": "  }",
      "164": "private:",
      "165": "  static __device__ void multiply_ntt_matrix_wmma(",
      "166": "      std::uint64_t uu[8],",
      "167": "      const nvcuda::wmma::fragment<nvcuda::wmma::matrix_a, 16, 16, 16,",
      "168": "                                   std::uint8_t, nvcuda::wmma::row_major>",
      "169": "          aa[8],",
      "170": "      const nvcuda::wmma::fragment<nvcuda::wmma::matrix_b, 16, 16, 16,",
      "171": "                                   std::uint8_t, nvcuda::wmma::col_major>",
      "172": "          bb[8],",
      "173": "      const nvcuda::wmma::layout_t layout, const std::uint64_t modulus,",
      "174": "      const reduction_type &reduction) {",
      "175": "    const int laneId = get_laneId();",
      "176": "    const int warpId = get_warpId<2>();",
      "177": "    nvcuda::wmma::fragment<nvcuda::wmma::accumulator, 16, 16, 16, std::int32_t>",
      "178": "        ss[15], tt[8];",
      "179": "    for (int i = 0; i < 15; ++i) {",
      "180": "      nvcuda::wmma::fill_fragment(ss[i], 0);",
      "181": "    }",
      "182": "    constexpr int num_digits = (reduction_type::modulus_bits + 7) / 8;",
      "183": "    for (int i = 0; i <= 2 * (num_digits - 1); ++i) {",
      "184": "      for (int j = 0; j < num_digits; ++j) {",
      "185": "        const int k = i - j;",
      "186": "        if (0 <= k && k < num_digits) {",
      "187": "          nvcuda::wmma::mma_sync(ss[i], aa[j], bb[k], ss[i]);",
      "188": "        }",
      "189": "      }",
      "190": "    }",
      "191": "    for (int i = 0; i < num_digits - 1; ++i) {",
      "192": "      for (int j = 0; j < 8; ++j) {",
      "193": "        tt[i].x[j] = ss[2 * i + 0].x[j] + (ss[2 * i + 1].x[j] << 8);",
      "194": "      }",
      "195": "    }",
      "196": "    for (int j = 0; j < 8; ++j) {",
      "197": "      tt[num_digits - 1].x[j] = ss[2 * (num_digits - 1)].x[j];",
      "198": "    }",
      "199": "",
      "200": "    extern __shared__ std::int32_t vv[][8][16][16];",
      "201": "    for (int i = 0; i < 8; ++i) {",
      "202": "      nvcuda::wmma::store_matrix_sync(&vv[warpId][i][0][0], tt[i], 16, layout);",
      "203": "    }",
      "204": "",
      "205": "    __syncwarp();",
      "206": "    for (int i = 0; i < 8; ++i) {",
      "207": "      const int row = 2 * i + 1 * (laneId / 16);",
      "208": "      const int col = laneId % 16;",
      "209": "      uu[i] = reduction.reduce(vv[warpId][0][row][col], vv[warpId][1][row][col],",
      "210": "                               vv[warpId][2][row][col], vv[warpId][3][row][col],",
      "211": "                               vv[warpId][4][row][col], vv[warpId][5][row][col],",
      "212": "                               vv[warpId][6][row][col], vv[warpId][7][row][col],",
      "213": "                               modulus);",
      "214": "    }",
      "215": "  }",
      "216": "public:",
      "217": "  __device__ void compute(std::uint64_t a[8],",
      "218": "                          const nvcuda::wmma::layout_t layout,",
      "219": "                          const std::uint64_t modulus,",
      "220": "                          const reduction_type &reduction) const {",
      "221": "    const int laneId = get_laneId();",
      "222": "    const int warpId = get_warpId<2>();",
      "223": "",
      "224": "    std::uint32_t aa[8][2];",
      "225": "    matrix_16x16_decompose_u64_to_u8<reduction_type::modulus_bits>(aa, a);",
      "226": "    extern __shared__ std::uint8_t bb[][8][16][16];",
      "227": "    for (int pos = 0; pos < 8; ++pos) {",
      "228": "      for (int i = 0; i < 8; ++i) {",
      "229": "        const int row = 2 * i + 1 * (laneId / 16);",
      "230": "        const int col = laneId % 16;",
      "231": "        // XXX",
      "232": "        bb[warpId * 4][pos][row][col] =",
      "233": "            aa[pos][(i < 4) ? 0 : 1] >> (8 * (i % 4));",
      "234": "      }",
      "235": "    }",
      "236": "",
      "237": "    __syncwarp();",
      "238": "    nvcuda::wmma::fragment<nvcuda::wmma::matrix_a, 16, 16, 16, std::uint8_t,",
      "239": "                           nvcuda::wmma::row_major>",
      "240": "        cc[8];",
      "241": "    nvcuda::wmma::fragment<nvcuda::wmma::matrix_b, 16, 16, 16, std::uint8_t,",
      "242": "                           nvcuda::wmma::col_major>",
      "243": "        dd[8];",
      "244": "    for (int pos = 0; pos < 8; ++pos) {",
      "245": "      nvcuda::wmma::load_matrix_sync(cc[pos], &bb[warpId * 4][pos][0][0], 16);",
      "246": "      nvcuda::wmma::load_matrix_sync(dd[pos], &values[pos][0][0], 16);",
      "247": "    }",
      "248": "    // mma(A, N^T) = A N",
      "249": "    // mma(A^T, N^T) = A^T N",
      "250": "    multiply_ntt_matrix_wmma(a, cc, dd, layout, modulus, reduction);",
      "251": "  }",
      "252": "};",
      "253": "",
      "254": "template <int n_, int radix_> class NttForwardScalarIterative {",
      "255": "",
      "256": "public:",
      "257": "  static constexpr int n = n_;",
      "258": "  static constexpr int radix = radix_;",
      "259": "",
      "260": "private:",
      "261": "  using multiplier_type = modular::MontgomeryFriendlyMultiplier64;",
      "262": "",
      "263": "  multiplier_type values[radix - 1][n / radix];",
      "264": "",
      "265": "public:",
      "266": "  NttForwardScalarIterative(void) = default;",
      "267": "  NttForwardScalarIterative(const Modulus &modulus) {",
      "268": "    const std::uint64_t root = modulus.get_root_forward(n);",
      "269": "#pragma omp parallel for",
      "270": "    for (int i = 0; i < n / radix; ++i) {",
      "271": "      std::vector<int> indices;",
      "272": "      indices.reserve(radix - 1);",
      "273": "      for (int subradix = radix; subradix > 1; subradix /= 2) {",
      "274": "        for (int j = 0; j < subradix / 2; ++j) {",
      "275": "          indices.push_back(i * (radix / subradix) + n / subradix * j);",
      "276": "        }",
      "277": "      }",
      "278": "      if (indices.size() != radix - 1) {",
      "279": "        throw std::runtime_error(\"internal error\");",
      "280": "      }",
      "281": "      for (int j = 0; j < radix - 1; ++j) {",
      "282": "        values[j][i] = multiplier_type(modulus.power(root, indices[j]),",
      "283": "                                       modulus.get_modulus());",
      "284": "      }",
      "285": "    }",
      "286": "  }",
      "287": "  __device__ void get(multiplier_type out[radix - 1], const int index) const {",
      "288": "    for (int i = 0; i < radix - 1; ++i) {",
      "289": "      out[i] = values[i][index];",
      "290": "    }",
      "291": "  }",
      "292": "",
      "293": "private:",
      "294": "  static __device__ void",
      "295": "  montgomery_butterfly(std::uint64_t &a0, std::uint64_t &a1,",
      "296": "                       const modular::MontgomeryFriendlyMultiplier64 omega,",
      "297": "                       const std::uint64_t N) {",
      "298": "    std::uint64_t b0;",
      "299": "    b0 = a0 + a1;",
      "300": "    if (b0 >= N * 2) {",
      "301": "      b0 -= N * 2;",
      "302": "    }",
      "303": "    std::uint64_t b1;",
      "304": "    b1 = a0 - a1 + N * 2;",
      "305": "    b1 = omega.multiply(b1, N);",
      "306": "",
      "307": "    a0 = b0;",
      "308": "    a1 = b1;",
      "309": "  }",
      "310": "",
      "311": "  template <int radix>",
      "312": "  static __device__ void montgomery_butterfly(",
      "313": "      std::uint64_t a[radix],",
      "314": "      const modular::MontgomeryFriendlyMultiplier64 omega[radix - 1],",
      "315": "      const std::uint64_t N) {",
      "316": "    for (int i = 0; i < radix / 2; ++i) {",
      "317": "      montgomery_butterfly(a[radix / 2 * 0 + i], a[radix / 2 * 1 + i], omega[i],",
      "318": "                           N);",
      "319": "    }",
      "320": "    if constexpr (radix / 2 > 1) {",
      "321": "      montgomery_butterfly<radix / 2>(&a[radix / 2 * 0], &omega[radix / 2], N);",
      "322": "      montgomery_butterfly<radix / 2>(&a[radix / 2 * 1], &omega[radix / 2], N);",
      "323": "    }",
      "324": "  }",
      "325": "",
      "326": "public:",
      "327": "  __device__ void compute(std::uint64_t a[radix], const int index,",
      "328": "                          const std::uint64_t modulus) const {",
      "329": "    multiplier_type omega[radix - 1];",
      "330": "    get(omega, index);",
      "331": "",
      "332": "    montgomery_butterfly<radix>(a, omega, modulus);",
      "333": "  }",
      "334": "};",
      "335": "",
      "336": "} // namespace cuda",
      "337": "} // namespace polyarith",
      "338": "#endif /* POLYARITH_CUDA_NTT_CUH_INCLUDED */"
