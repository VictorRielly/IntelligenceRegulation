      "226": "  /* Up to 62 bits. */",
      "227": "  __device__ std::uint64_t",
      "228": "  reduce_impl(const std::uint32_t t0, const std::uint32_t t1,",
      "229": "              const std::uint32_t t2, const std::uint32_t t3,",
      "230": "              const std::uint32_t t4, const std::uint32_t t5,",
      "231": "              const std::uint32_t t6, std::uint32_t t7,",
      "232": "              const std::uint64_t modulus) const {",
      "233": "    std::uint64_t u;",
      "234": "",
      "235": "    asm(\"{\\n\\t\\t\"",
      "236": "        \".reg.u64 N;\\n\\t\\t\"",
