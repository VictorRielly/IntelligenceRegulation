      "298": "",
      "299": "public:",
      "300": "  MontgomeryFriendlyReductionBy64(void) = default;",
      "301": "  MontgomeryFriendlyReductionBy64(const std::uint64_t modulus) {",
      "302": "    if (std::bit_width(modulus) >= 63) {",
      "303": "      throw std::runtime_error(\"modulus needs to be within 62 bits for now\");",
      "304": "    } else if (static_cast<std::uint32_t>(modulus) != 1) {",
      "305": "      throw std::runtime_error(\"modulus needs to be Montgomery friendly\");",
      "306": "    } else if constexpr (modulus_bits != 64) {",
      "307": "      /* Check in two steps to supress compiler warning. */",
      "308": "      if ((modulus >> modulus_bits) != 0) {",
      "309": "        throw std::runtime_error(\"modulus exceeds the specified bit size\");",
      "310": "      }",
      "311": "    }",
      "312": "  }",
      "313": "  static __host__ __device__ int get_factor(void) {",
      "314": "    if constexpr (modulus_bits <= 40) {",
      "315": "      return 32 * 2;",
      "316": "    } else if constexpr (modulus_bits <= 48) {",
      "317": "      return 32 * 3;",
      "318": "    } else if constexpr (modulus_bits <= 56) {",
      "319": "      return 32 * 3;",
      "320": "    }",
      "321": "    return 32 * 4;",
      "322": "  }",
      "323": "  __device__ std::uint64_t",
      "324": "  reduce(const std::uint32_t t0, const std::uint32_t t1, const std::uint32_t t2,",
      "325": "         const std::uint32_t t3, const std::uint32_t t4, const std::uint32_t t5,",
      "326": "         const std::uint32_t t6, std::uint32_t t7,",
      "327": "         const std::uint64_t modulus) const {",
      "328": "    if constexpr (modulus_bits <= 40) {",
      "329": "      return reduce_impl(t0, t1, t2, t3, t4, modulus);",
      "330": "    } else if constexpr (modulus_bits <= 48) {",
      "331": "      return reduce_impl(t0, t1, t2, t3, t4, t5, modulus);",
      "332": "    } else if constexpr (modulus_bits <= 56) {",
      "333": "      return reduce_impl(t0, t1, t2, t3, t4, t5, t6, modulus);",
      "334": "    }",
      "335": "    return reduce_impl(t0, t1, t2, t3, t4, t5, t6, t7, modulus);",
      "336": "  }",
      "337": "};",
      "338": "class MontgomeryMultiplier64 {",
