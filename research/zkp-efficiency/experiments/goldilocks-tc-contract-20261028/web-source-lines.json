      "13": "namespace modular {",
      "14": "",
      "15": "static __host__ __device__ std::uint32_t",
      "16": "calculate_montgomery_inverse(const std::uint32_t modulus) {",
      "17": "  std::uint32_t num, den, t;",
      "18": "  num = (modulus * 3) ^ 2; /* 5 */",
      "19": "  den = num * modulus;",
      "20": "",
      "21": "  t = 2 - den;",
      "22": "  num *= t; /* 10 */",
      "23": "  den *= t;",
      "24": "",
      "25": "  t = 2 - den;",
      "26": "  num *= t; /* 20 */",
      "27": "  den *= t;",
      "28": "",
      "29": "  t = 2 - den;",
      "30": "  num *= t; /* 32 */",
      "31": "",
      "32": "  return num;",
      "33": "}",
      "34": "static __host__ __device__ std::uint64_t",
      "35": "calculate_montgomery_inverse(const std::uint64_t modulus) {",
      "36": "  const std::uint32_t inverse =",
      "37": "      calculate_montgomery_inverse(static_cast<std::uint32_t>(modulus));",
      "38": "  return inverse * (2 - modulus * inverse); /* 32 -> 64 */",
      "39": "}",
      "40": "",
      "41": "template <int modulus_bits_> class MontgomeryFriendlyReductionBy64 {",
      "42": "",
      "43": "public:",
      "44": "  constexpr static int modulus_bits = modulus_bits_;",
      "45": "private:",
      "46": "  __device__ std::uint64_t normalize(const std::uint64_t u,",
      "47": "                                     const std::uint64_t modulus) const {",
      "48": "    const std::uint32_t N1 = static_cast<std::uint32_t>(modulus >> 32);",
      "49": "    if (static_cast<std::uint32_t>(u) >= 2 &&",
      "50": "        static_cast<std::uint32_t>(u >> 32) >= N1 * 2) {",
      "51": "      return u - modulus * 2;",
      "52": "    } else if (static_cast<std::uint32_t>(u) >= 1 &&",
      "53": "               static_cast<std::uint32_t>(u >> 32) >= N1) {",
      "54": "      return u - modulus;",
      "55": "    }",
      "56": "    return u;",
      "57": "  }",
      "58": "  /* Up to 40 bits. */",
      "59": "  __device__ std::uint64_t",
      "60": "  reduce_impl(const std::uint32_t t0, const std::uint32_t t1,",
      "61": "              const std::uint32_t t2, const std::uint32_t t3,",
      "62": "              const std::uint32_t t4, const std::uint64_t modulus) const {",
      "63": "    std::uint64_t u;",
      "64": "",
      "65": "    asm(\"{\\n\\t\\t\"",
      "66": "        \".reg.u64 N;\\n\\t\\t\"",
      "67": "        \".reg.u32 N1;\\n\\t\\t\"",
      "68": "        \"mov.b64 N, %1;\\n\\t\\t\"",
      "69": "        \"mov.b64 {_, N1}, N;\\n\\t\\t\"",
      "70": "        \".reg.u32 s<8>;\\n\\t\\t\"",
      "71": "        \"mov.b32 s0, %2;\\n\\t\\t\"",
      "72": "        \"mov.b32 s1, %3;\\n\\t\\t\"",
      "73": "        \"mov.b32 s2, %4;\\n\\t\\t\"",
      "74": "        \"mov.b32 s3, %5;\\n\\t\\t\"",
      "75": "        \"mov.b32 s4, %6;\\n\\t\\t\"",
      "76": "",
      "77": "        \".reg.u64 c, t;\\n\\t\\t\"",
      "78": "        \".reg.u32 c0, c1, u;\\n\\t\\t\"",
      "79": "",
      "80": "        \"shl.b32 u, s1, 16;\\n\\t\\t\"",
      "81": "        \"add.cc.u32 s0, s0, u;\\n\\t\\t\"",
      "82": "        \"mul.wide.u32 c, s0, N1;\\n\\t\\t\"",
      "83": "        \"sub.u64 c, N, c;\\n\\t\\t\"",
      "84": "        \"shr.b32 u, s1, 16;\\n\\t\\t\"",
      "85": "        \"addc.u32 s2, s2, u;\\n\\t\\t\"",
      "86": "        \"shl.b32 u, s3, 16;\\n\\t\\t\"",
      "87": "        \"add.cc.u32 s2, s2, u;\\n\\t\\t\"",
      "88": "        \"mov.b64 t, {s2, 0};\\n\\t\\t\"",
      "89": "        \"add.u64 c, c, t;\\n\\t\\t\"",
      "90": "        \"mov.b64 {c0, c1}, c;\\n\\t\\t\"",
      "91": "        \"mul.wide.u32 c, c0, N1;\\n\\t\\t\"",
      "92": "        \"mov.b64 t, {c1, 0};\\n\\t\\t\"",
      "93": "        \"sub.u64 c, t, c;\\n\\t\\t\"",
      "94": "        \"add.u64 c, c, N;\\n\\t\\t\"",
      "95": "        \"shr.b32 u, s3, 16;\\n\\t\\t\"",
      "96": "        \"addc.u32 s4, s4, u;\\n\\t\\t\"",
      "97": "        \"mov.b64 t, {s4, 0};\\n\\t\\t\"",
      "98": "        \"add.u64 %0, c, t;\\n\\t\\t\"",
      "99": "        \"}\"",
      "100": "        : \"=l\"(u)",
      "101": "        : \"l\"(modulus), \"r\"(t0), \"r\"(t1), \"r\"(t2), \"r\"(t3), \"r\"(t4));",
      "102": "",
      "103": "    return normalize(u, modulus);",
      "104": "  }",
