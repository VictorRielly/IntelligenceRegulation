      "146": "        \"shl.b32 u, s5, 16;\\n\\t\\t\"",
      "147": "        \"add.cc.u32 s4, s4, u;\\n\\t\\t\"",
      "148": "        \"mov.b64 t, {s4, 0};\\n\\t\\t\"",
      "149": "        \"add.u64 c, c, t;\\n\\t\\t\"",
      "150": "        \"mov.b64 {c0, c1}, c;\\n\\t\\t\"",
      "151": "        \"mul.wide.u32 c, c0, N1;\\n\\t\\t\"",
      "152": "        \"mov.b64 t, {c1, 0};\\n\\t\\t\"",
      "153": "        \"sub.u64 c, t, c;\\n\\t\\t\"",
      "154": "        \"add.u64 c, c, N;\\n\\t\\t\"",
      "155": "        \"shr.b32 u, s5, 16;\\n\\t\\t\"",
      "156": "        \"mov.b64 t, {u, 0};\\n\\t\\t\"",
