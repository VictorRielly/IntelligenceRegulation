      "346": "  MontgomeryMultiplier64(const std::uint64_t multiplier,",
      "347": "                         const std::uint64_t modulus) {",
      "348": "    b = arithmetic::multiply_wide(multiplier, -modulus) % modulus;",
      "349": "    bp = b * calculate_montgomery_inverse(modulus);",
      "350": "  }",
      "351": "  __host__ __device__ std::uint64_t multiply(const std::uint64_t a,",
      "352": "                                             const std::uint64_t N) const {",
      "353": "    const std::uint64_t ab1 = arithmetic::multiply_high(a, b);",
      "354": "    const std::uint64_t q = a * bp;",
      "355": "    const std::uint64_t qN1 = arithmetic::multiply_high(q, N);",
      "356": "    return arithmetic::subtract_and_add_if_borrows(ab1, qN1, N);",
      "357": "  }",
      "358": "};",
      "359": "",
      "360": "class MontgomeryFriendlyMultiplier64 {",
      "361": "",
      "362": "  std::uint64_t b;",
      "363": "",
      "364": "public:",
      "365": "  MontgomeryFriendlyMultiplier64(void) = default;",
      "366": "  MontgomeryFriendlyMultiplier64(const std::uint64_t multiplier,",
      "367": "                                 const std::uint64_t modulus) {",
      "368": "    if (std::bit_width(modulus) >= 63) {",
      "369": "      throw std::runtime_error(\"modulus needs to be within 62 bits for now\");",
      "370": "    } else if (static_cast<std::uint32_t>(modulus) != 1) {",
      "371": "      throw std::runtime_error(\"modulus needs to be Montgomery friendly\");",
      "372": "    }",
      "373": "",
      "374": "    b = arithmetic::multiply_wide(multiplier, -modulus) % modulus;",
      "375": "  }",
      "376": "  __host__ __device__ std::uint64_t get_b(void) const { return b; }",
      "377": "",
      "378": "  __host__ __device__ std::uint64_t multiply(const std::uint64_t a,",
      "379": "                                             const std::uint64_t N) const {",
      "380": "    const std::uint32_t a0 = a;",
      "381": "    const std::uint32_t a1 = a >> 32;",
      "382": "    const std::uint32_t b0 = b;",
      "383": "    const std::uint32_t b1 = b >> 32;",
      "384": "    const std::uint32_t N1 = N >> 32;",
      "385": "    std::uint64_t c;",
      "386": "    c = arithmetic::multiply_wide(a0, b0) + (std::uint64_t(1) << 32);",
      "387": "    c = arithmetic::concatenate<std::uint32_t>(c >> 32, N1 + 1) -",
      "388": "        arithmetic::multiply_wide<std::uint32_t>(c, N1) +",
      "389": "        arithmetic::multiply_wide(a0, b1) + arithmetic::multiply_wide(a1, b0);",
      "390": "    c = arithmetic::concatenate<std::uint32_t>(c >> 32, N1) -",
      "391": "        arithmetic::multiply_wide<std::uint32_t>(c, N1) +",
      "392": "        arithmetic::multiply_wide(a1, b1);",
      "393": "    if (static_cast<std::uint32_t>(c) >= 1 &&",
      "394": "        static_cast<std::uint32_t>(c >> 32) >= N1) {",
      "395": "      c -= N;",
      "396": "    }",
      "397": "",
      "398": "    return c;",
      "399": "  }",
      "400": "};",
      "401": "",
      "402": "} // namespace modular",
      "403": "",
      "404": "} // namespace polyarith",
