+        fh = f2_sub(fh, f2_mul_base(fzs_a(sv, sd, 8, x, hi), p1));
+        return f2_add(f2_add(fz_mulk(prm_f2(s, FZ_MU + 0), f0l), fz_mulk(prm_f2(s, FZ_MU + 2), f1)), fz_mulk(prm_f2(s, FZ_MU + 4), fh));
+    }
