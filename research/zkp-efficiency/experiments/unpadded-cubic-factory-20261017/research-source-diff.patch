+        deps=shape_dependencies(cf,*shape)
+        rp=CSERowPlan(cf,con,Plan(generalize(cf),con['alpha'],con['gu8']),deps)
+        vals=[F(2,3) for _ in cf['names']];ds=[F(5,7) for _ in vals]
+        total=Counter()
+        for j in range(n):
