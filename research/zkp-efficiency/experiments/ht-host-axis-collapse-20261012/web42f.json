 proptest! {\nL1876:     cite1870†1869 #[test]\nL1877:     cite1871†1870 fn prop_fold_and_round_coefficients_suffix_matches_bind_then_measure(\nL1878:     cite1872†1871 k in 2usize..=16,\nL1879:     cite1873†1872 seed in any::<u64>(),\nL1880:     cite1874†1873 ) {\nL1881:     cite1875†1874 // Invariant: the fused suffix pass is bind-then-measure, in one traversal.\nL1882:     cite1876†1875 //\nL1883:     cite1877†1876 //     two passes: bind the tables, then measure the bound pair\nL1884:     cite1878†1877 //     fused     : one pass binding and measuring each block\nL1885:     cite1879†1878 //\nL1886:     cite1880†1879 // Both the bound tables and the message have to come out identical.\nL1887:     cite1881†1880 // A prover on the fused path would otherwise send a different transcript.\nL1888:     cite1882†1881 //\nL1889:     cite1883†1882 // Fixture state: 2^k paired random entries, one random challenge.\nL1890:     cite1884†1883 // The range straddles the 8-wide tiled body and the par-vs-serial split.\nL1891:     cite1885†1884 let mut rng = SmallRng::seed_from_u64(seed);\nL1892:     cite1886†1885 let n = 1usize << k;\nL1893:     cite1887†1886 let evals: Vec<EF> = (0..n).map(|_| rng.random()).collect();\nL1894:     cite1888†1887 let weights: Vec<EF> = (0..n).map(|_| rng.random()).collect();\nL1895:     cite1889†1888 let r: EF = rng.random();\nL1896:     cite1890†1889 L1897:     cite1891†1890 // Reference arm: bind both tables, then measure the bound pair.\nL1898:     cite1892†1891 let mut want_evals = Poly::new(evals.clone());\nL1899:     cite1893†1892 let mut want_weights = Poly::new(weights.clone());\nL1900:     cite1894†1893 want_evals.fix_suffix_var_mut(r);\nL1901:     cite1895†1894 want_weights.fix_suffix_var_mut(r);\nL1902:     cite1896†1895 let want = super::sumcheck_coefficients_suffix(\nL1903:     cite1897†1896 want_evals.as_slice(),\nL1904:     cite1898†1897 want_weights.as_slice(),\nL1905:     cite1899†1898 );\nL1906:     cite1900†1899 L1907:     cite1901†1900 // Fused arm: one pass binds both tables and measures the bound pair.\nL1908:     cite1902†1901 let mut got_evals = Poly::new(evals);\nL1909:     cite1903†1902 let mut got_weights = Poly::new(weights);\nL1910:     cite1904†1903 let got =\nL1911:     cite1905†1904 super::fold_and_round_coefficients_suffix(&mut got_evals, &mut got_weights, r);\nL1912:     cite1906†1905 L1913:     cite1907†1906 // The bound tables must agree entry for entry.\nL1914:     cite1908†1907 prop_assert_eq!(got_evals.as_slice(), want_evals.as_slice());\nL1915:     cite1909†1908 prop_assert_eq!(got_weights.as_slice(), want_weights.as_slice());\nL1916:     cite1910†1909 L1917:     cite1911†1910 // And so must the two values the round sends.\nL1918:     cite1912†1911 prop_assert_eq!(got.c_a, want.c_a);\nL1919:     cite1913†1912 prop_assert_eq!(got.c_inf, want.c_inf);\nL1920:     cite1914†1913 }\nL1921:     cite1915†1914 }\nL1922:     cite1916†1915 L1923:     cite1917†1916 #[test]\nL1924:     cite1918†1917 fn every_suffix_round_binds_correctly_down_to_half_length() {\nL1925:     cite1919†1918 // Invariant: a round binds both tables down to their lower half.\nL1926:     cite1920†1919 //\nL1927:     cite1921†1920 // So every round of a ladder agrees with binding and measuring separately.\nL1928:     cite1922†1921 //\nL1929:     cite1923†1922 // Fixture state: 2^15 paired entries, bound down to 4.\nL1930:     cite1924†1923 // The first rounds run the threaded branch, the last ones the serial branch.\nL1931:     cite1925†1924 //\nL1932:     cite1926†1925 //     round 1: tables 2^15 -> 2^14\nL1933:     cite1927†1926 //     round 2: tables 2^14 -> 2^13\nL1934:     cite1928†1927 //     ...\nL1935:     cite1929†1928 //     round 13: tables 4 -> 2           the shortest fusable table\nL1936:     cite1930†1929 const NUM_VARIABLES: usize = 15;\nL1937:     cite1931†1930 L1938:     cite1932†1931 let mut rng = SmallRng::seed_from_u64(0xB0FFE7);\nL1939:     cite1933†1932 let evals = Poly::<EF>::rand(&mut rng, NUM_VARIABLES);\nL1940:     cite1934†1933 let weights = Poly::<EF>::rand(&mut rng, NUM_VARIABLES);\nL1941:     cite1935†1934 L1942:     cite1936†1935 // Reference arm: bind on the spot, measure the bound pair separately.\nL1943:     cite1937†1936 let mut want_evals = evals.clone();\nL1944:     cite1938†1937 let mut want_weights = weights.clone();\nL1945:     cite1939†1938 L1946:     cite1940†1939 // Arm under test: one fused pass per round.\nL1947:     cite1941†1940 let mut got_evals = evals;\nL1948:     cite1942†1941 let mut got_weights = weights;\nL1949:     cite1943†1942 L1950:     cite1944†1943 // Stop with four entries left: below that the pass has no variable to measure.\nL1951:     cite1945†1944 for round in 0..NUM_VARIABLES - 1 {\nL1952:     cite1946†1945 let r: EF = rng.random();\nL1953:     cite1947†1946 L1954:     cite1948†1947 want_evals.fix_suffix_var_mut(r);\nL1955:     cite1949†1948 want_weights.fix_suffix_var_mut(r);\nL1956:     cite1950†1949 let want =\nL1957:     cite1951†1950 super::sumcheck_coefficients_suffix(want_evals.as_slice(), want_weights.as_slice());\nL1958:     cite1952†1951 L1959:     cite1953†1952 let got =\nL1960:     cite1954†1953 super::fold_and_round_coefficients_suffix(&mut got_evals, &mut got_weights, r);\nL1961:     cite1955†1954 L1962:     cite1956†1955 assert_eq!(got_evals.as_slice(), want_evals.as_slice(), \"round {round}\");\nL1963:     cite1957†1956 assert_eq!(\nL1964:     cite1958†1957 got_weights.as_slice(),\nL1965:     cite1959†1958 want_weights.as_slice(),\nL1966:     cite1960†1959 \"round {round}\"\nL1967:     cite1961†1960 );\nL1968:     cite1962†1961 assert_eq!(got.c_a, want.c_a, \"round {round}\");\nL1969:     cite1963†1962 assert_eq!(got.c_inf, want.c_inf, \"round {round}\");\nL1970:     cite1964†1963 L1971:     cite1965†1964 // Binding halves both tables, so the next round starts from half this length.\nL1972:     cite1966†1965 //\nL1973:     cite1967†1966 //     round 0 leaves 2^14, round 1 leaves 2^13, and so on down to 2\nL1974:     cite1968†1967 let live = 1 << (NUM_VARIABLES - 1 - round);\nL1975:     cite1969†1968 assert_eq!(got_evals.num_evals(), live, \"round {round}\");\nL1976:     cite1970†1969 assert_eq!(got_weights.num_evals(), live, \"round {round}\");\nL2414:     cite2408†2407 // with tables the binding never reached.\nL2415:     cite2409†2408 //\nL2416:     cite2410†2409 // Fixture state: a fully bound pair, so the fused pass has no variable to bind.\nL2417:     cite2411†2410 //\nL2418:     cite2412†2411 //     held    : ONE\nL2419:     cite2413†2412 //     measured: panics inside the fold, because the ladder is past its last variable\nL2420:     cite2414†2413 //     after   : ONE must still be held\nL2421:     cite2415†2414 let evals = Poly::new(vec![EF::ONE]);\nL2560:     cite2554†2553 extern crate std;\nL2561:     cite2555†2554 use std::panic::{AssertUnwindSafe, catch_unwind};\nL2562:     cite2556†2555 L2563:     cite2557†2556 use crate::product_polynomial::ProductPolynomial;\nL2564:     cite2558†2557 L2565:     cite2559†2558 // Invariant: at most one binding is ever held.\nL2566:     cite2560†2559 //\nL2567:     cite2561†2560 // Two unapplied bindings cannot be fused into a single pass.\nL2568:     cite2562†2561 //\nL2569:     cite2563†2562 // The second would overwrite the first and lose a variable with nothing noticing.\nL2570:     cite2564†2563 //\nL2571:     cite2565†2564 // Fixture state: four paired entries, one challenge already held.\nL2572:     cite2566†2565 //\nL2573:     cite2567†2566 //     held    : ONE\nL2574:     cite2568†2567 //     offered : TWO   -> rejected, and ONE must survive the rejection\nL2575:     cite2569†2568 let evals = Poly::new(vec![EF::ONE; 4]);\n--------------------------------------------------------------------------------\nstrategy.rs - source (https://docs.rs/p3-sumcheck/0.8.0/src/p3_sumcheck/strategy.rs.html)\nciteturn6view5 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"turn5view0\",\"pattern\":\"bind and measure\"}); Total lines: 2604\nL1401:     cite1395†1394 pub fn eval(&mut self, point: &Point<EF>) -> EF {\nL1402:     cite1396†1395 self.settle();\nL1403:     cite1397†1396 self.poly.eval(point)\nL1404:     cite1398†1397 }\nL1405:     cite1399†1398 L1406:     cite1400†1399 /// Measures the current round, first applying any outstanding binding.\nL1407:     cite1401†1400 ///\nL1408:     cite1402†1401 /// An outstanding binding is absorbed into the measuring pass.\nL1409:     cite1403†1402 /// The round then reads its tables once instead of twice.\nL1410:     cite1404†1403 ///\nL1411:     cite1405†1404 /// The slot is cleared once the pass has returned.\nL1412:     cite1406†1405 /// The caller puts this round's own challenge back into it.\nL1413:     cite1407†1406 ///\nL1414:     cite1408†1407 /// Clearing it first would drop the challenge if the pass panicked.\nL1415:     cite1409†1408 /// The prover would then read as settled with tables a round stale.\nL1416:     cite1410†1409 pub(crate) fn measure_round(&mut self) -> (EF, EF) {\nL1417:     cite1411†1410 let message = match self.outstanding {\nL1418:     cite1412†1411 // A challenge is waiting, so bind and measure in one pass.\nL1419:     cite1413†1412 Some(r) => self.poly.fold_round_coefficients(r),\nL1420:     cite1414†1413 // Nothing waiting, so this is a plain measuring pass.\nL1421:     cite1415†1414 None => self.poly.round_coefficients(),\nL1422:     cite1416†1415 };\nL1423:     cite1417†1416 L1424:     cite1418†1417 // Reached only once the binding landed, so a caught unwind still holds it.\nL1425:     cite1419†1418 self.outstanding = None;\nL1426:     cite1420†1419 L1427:     cite1421†1420 // Invariant: the claim is the inner product of the pair this round measured.\nL1428:     cite1422†1421 //\nL1429:     cite1423†1422 // The claim describes the table this pass measured.\nL1430:     cite1424†1423 // The binding this pass absorbed is what brought the tables up to it.\nL1431:     cite1425†1424 //\nL1432:     cite1426†1425 // A stale table, or a binding that landed wrong, breaks the equality here.\nL1433:     cite1427†1426 debug_assert_eq!(self.sum, self.poly.dot_product());\nL1434:     cite1428†1427 L1435:     cite1429†1428 message\nL1436:     cite1430†1429 }\nL1437:     cite1431†1430 L1438:     cite1432†1431 /// Holds a challenge back for the next measuring pass to absorb.\nL1439:     cite1433†1432 ///\nL1440:     cite1434†1433 /// # Panics\nL1441:     cite1435†1434 ///\nL1442:     cite1436†1435 /// Panics if a challenge is already outstanding.\nL1443:     cite1437†1436 /// Two unapplied bindings cannot be fused into one pass.\nL1444:     cite1438†1437 ///\nL1445:     cite1439†1438 /// The second would overwrite the first and lose a variable.\nL1446:     cite1440†1439 pub(crate) fn hold(&mut self, r: EF) {\nL1447:     cite1441†1440 // Checked before the write, so a rejected challenge leaves the held one intact.\nL1448:     cite1442†1441 assert!(\nL1449:     cite1443†1442 self.outstanding.is_none(),\nL1450:     cite1444†1443 \"a challenge is already outstanding\"\nL1451:     cite1445†1444 );\nL1452:     cite1446†1445 self.outstanding = Some(r);\nL1453:     cite1447†1446 }\nL1454:     cite1448†1447 L1455:     cite1449†1448 /// Advances the running claim to the round polynomial at the challenge.\nL1456:     cite1450†1449 ///\nL1457:     cite1451†1450 /// This is the quadratic extrapolation through 0, 1 and infinity the verifier applies.\nL1458:     cite1452†1451 /// The binding itself is left to the caller.\nL1459:     cite1453†1452 pub(crate) fn reduce_claim_with_coefficients(&mut self, c0: EF, c_inf: EF, gamma: EF) {\nL1460:     cite1454†1453 self.sum = extrapolate_01inf(c0, self.sum - c0, c_inf, gamma);\nL1461:     cite1455†1454 }\nL1462:     cite1456†1455 L1463:     cite1457†1456 /// Applies a scalar to the weight side and the matching residual claim.\nL1464:     cite1458†1457 ///\nL1465:     cite1459†1458 /// Leaves the evaluation side untouched, so downstream reductions can\nL1466:     cite1460†1459 /// reuse it as the honest folded message.\nL1467:     cite1461†1460 pub(crate) fn scale_weights_and_claim(&mut self, scale: EF) {\nL1468:     cite1462†1461 // Scaling every entry commutes with binding, so the order does not change the result.\n"
