+fn absorb_i8_bounded(h: &mut blake3::Hasher, words: &[i8]) {
+    let mut scratch = [0u8; 64 * 1024];
+    for chunk in words.chunks(scratch.len()) {
+        for (out, value) in scratch.iter_mut().zip(chunk) {
+            *out = *value as u8;
+        }
+        h.update(&scratch[..chunk.len()]);
+    }
