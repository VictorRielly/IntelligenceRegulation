e p3_maybe_rayon::PARALLEL_ENABLED;\nL25:     【19†18】use p3_maybe_rayon::prelude::*;\nL26:     【20†19】use p3_multilinear_util::point::Point;\nL27:     【21†20】use p3_multilinear_util::poly::{Poly, PolyMaybePackedView};\nL28:     【22†21】pub use repr::{FromTable, IntoTranscriptField, ReprSumcheckProver};\nL29:     【23†22】\nL30:     【24†23】use crate::constraints::{Constraint, Statements};\nL31:     【25†24】use crate::product_polynomial::ProductPolynomial;\nL32:     【26†25】use crate::transcript::{ProverTranscript, SumcheckShape};\nL33:     【27†26】use crate::{SumcheckData, extrapolate_01inf};\nL34:     【28†27】\nL35:     【29†28】/// Input size at which the round-coefficient routines switch from serial to parallel execution.\nL36:     【30†29】///\nL37:     【31†30】/// # Why this value\nL38:     【32†31】///\nL39:     【33†32】/// - Below `2^14` paired elements, the rayon splitting and join overhead outweighs the parallel work.\nL40:     【34†33】/// - Above it, the fold-reduce amortises the splitting cost.\nL41:     【35†34】const PAR_THRESHOLD: usize = 1 << 14;\nL42:     【36†35】\nL43:     【37†36】/// Table length from which a threaded suffix binding writes over its own tables.\nL44:     【38†37】///\nL45:     【39†38】/// # Why this value\nL46:     【40†39】///\nL47:     【41†40】/// - In place, the blocks of a binding run in levels, one parallel dispatch per level.\nL48:     【42†41】/// - Below `2^23` entries those dispatches cost more than a fresh half-length table.\nL49:     【43†42】/// - Above it, the fresh table's page faults and release dominate instead.\nL50:     【44†43】///\nL51:     【45†44】/// A table bound in place keeps its buffer, until a round below this length replaces it.\nL52:     【46†45】///\nL53:     【47†46】/// Without the `parallel` feature there is no dispatch to amortise, so every length\nL54:     【48†47】/// binds in place regardless of this threshold.\nL55:     【49†48】const SUFFIX_IN_PLACE_THRESHOLD: usize = 1 << 23;\nL56:     【50†49】\nL57:     【51†50】/// Tile size for the chunked round-coefficient kernel.\nL58:     【52†51】///\nL59:     【53†52】/// Monty-31 spells out a single-reduction dot product per tile size.\nL60:     【54†53】/// The set of sizes that get one depends on the target:\nL61:     【55†54】///\nL62:     【56†55】/// ```text\nL63:     【57†56】///     scalar          every length\nL64:     【58†57】///     AVX2, AVX-512   2, 4, 5, 6, 7, 8\nL65:     【59†58】///     NEON            2, 3, 4, 5, 8\nL66:     【60†59】/// ```\nL67:     【61†60】///\nL68:     【62†61】/// So `8` is a single-reduction tile on every target.\nL69:     【63†62】/// Binary fields fold the modulus once at any tile size, so the choice is free there.\nL70:     【64†63】///\nL71:     【65†64】/// - Larger overruns the integer-multiply pipeline depth;\nL72:     【66†65】/// - Smaller dilutes the delayed-reduction win.\nL73:     【67†66】const K: usize = 8;\nL74:     【68†67】\nL75:     【69†68】/// Per-tile MAC: extends a `(constant, leading)` accumulator pair.\nL76:     【70†69】///\nL77:     【71†70】/// # Algorithm\nL78:     【72†71】///\nL79:     【73†72】/// Folding the active variable in `h(X) = sum_b f(X, b) * w(X, b)` gives:\nL80:     【74†73】///\nL81:     【75†74】/// ```text\nL82:     【76†75】///     constant += sum_i  w_lo[i] * e_lo[i]\nL83:     【77†76】///     leading  += sum_i  (w_hi[i] - w_lo[i]) * (e_hi[i] - e_lo[i])\nL84:     【78†77】/// ```\nL85:     【79†78】///\nL86:     【80†79】/// where `lo`, `hi` are the two faces of the active variable.\nL87:     【81†80】///\nL88:     【82†81】/// Each sum is one dot product over `K` pairs, reduced as late as the target permits.\nL89:     【83†82】/// A binary field folds the modulus once for the whole sum.\nL90:     【84†83】/// A Monty-31 packing pays one Montgomery reduction at this tile size on every target.\nL91:     【85†84】#[inline(always)]\nL92:     【86†85】fn chunk_round_step<B, A>(e_lo: &[B; K], e_hi: &[B; K], w_lo: &[A; K], w_hi: &[A; K]) -> (A, A)\nL93:     【87†86】where\nL94:     【88†87】    B: PrimeCharacteristicRing + Copy,\nL95:     【89†88】    A: Algebra<B> + Copy,\nL96:     【90†89】{\nL97:     【91†90】    // Constant term: one delayed-reduction dot product over the b_0 = 0 face.\nL98:     【92†91】    let acc0 = A::mixed_dot_product::<K>(w_lo, e_lo);\nL99:     【93†92】\nL100:     【94†93】    // Materialise the differences (b_0 = 1 minus b_0 = 0) tile-locally so\nL101:     【95†94】    // they can feed the same primitive. `K` base subs, no reductions.\nL102:     【96†95】    let diffs_e: [B; K] = core::array::from_fn(|i| e_hi[i] - e_lo[i]);\nL103:     【97†96】    let diffs_w: [A; K] = core::array::from_fn(|i| w_hi[i] - w_lo[i]);\nL104:     【98†97】\nL105:     【99†98】    // Leading coefficient: dot product of the differences.\nL106:     【100†99】    let acc_inf = A::mixed_dot_product::<K>(&diffs_w, &diffs_e);\nL107:     【101†100】\nL108:     【102†101】    (acc0, acc_inf)\nL109:     【103†102】}\nL110:     【104†103】\nL111:     【105†104】/// Per-pair MAC for the streaming tail (at most `K - 1` leftover pairs).\nL112:     【106†105】#[inline(always)]\nL113:     【107†106】fn round_step<B, A>((acc0, acc_inf): (A, A), e0: B, e1: B, w0: A, w1: A) -> (A, A)\nL114:     【108†107】where\nL115:     【109†108】    B: PrimeCharacteristicRing + Copy,\nL116:     【110†109】    A: Algebra<B> + Copy,\nL117:     【111†110】{\nL118:     【112†111】    (acc0 + w0 * e0, acc_inf + (w1 - w0) * (e1 - e0))\nL119:     【113†112】}\nL120:     【114†113】\nL121:     【115†114】/// Splits a `2K`-wide chunk into the two faces of the suffix round variable.\nL122:     【116†115】///\nL123:     【117†116】/// The suffix variable is the low index bit.\nL124:     【118†117】///\nL125:     【119†118】/// So the two faces of a point are adjacent entries:\nL126:     【120†119】///\nL127:     【121†120】/// ```text\nL128:     【122†121】///     chunk : [ t0, t1, t2, t3, ... ]\nL129:     【123†122】///     lo    : [ t0, t2, ... ]           the variable at 0\nL130:     【124†123】///     hi    : [ t1, t3, ... ]           the variable at 1\nL131:     【125†124】/// ```\nL132:     【126†125】#[inline(always)]\nL133:     【127†126】fn gather_pairs<T: Copy>(chunk: &[T]) -> ([T; K], [T; K]) {\nL134:     【128†127】    let lo: [T; K] = core::array::from_fn(|i| chunk[2 * i]);\nL135:     【129†128】    let hi: [T; K] = core::array::from_fn(|i| chunk[2 * i + 1]);\nL136:     【130†129】    (lo, hi)\nL137:     【131†130】}\nL138:     【132†131】\nL139:     【133†132】/// Component-wise sum of two `(constant, leading)` accumulator pairs.\nL140:     【134†133】#[inline(always)]\nL141:     【135†134】fn round_reduce<A: Copy + PrimeCharacteristicRing>(a: (A, A), b: (A, A)) -> (A, A) {\nL142:     【136†135】    (a.0 + b.0, a.1 + b.1)\nL143:     【137†136】}\nL144:     【138†137】\nL145:     【139†138】/// Projective per-tile MAC (eprint 2026/762, Fig. 3).\nL146:     【140†139】///\nL147:     【141†140】/// Like [`chunk_round_step`], but the tables are interpreted as monomial\nL148:     【142†141】/// coefficients, so the round message is `[s(1), s(inf)]` and the verifier\nL149:     【143†142】/// derives `s(0) := C - s(inf)` from the projective round identity. The\nL150:     【144†143】/// `X = 1` evaluation of a coefficient pair is `lo + hi`, so the differences\nL151:     【145†144】/// of the evaluation basis become sums:\nL152:     【146†145】///\nL153:     【147†146】/// ```text\nL154:     【148†147】///     at_one  += sum_i  (w_lo[i] + w_hi[i]) * (e_lo[i] + e_hi[i])\nL155:     【149†148】///     leading += sum_i  w_hi[i] * e_hi[i]\nL156:     【150†149】/// ```\nL157:     【151†150】#[inline(always)]\nL158:     【152†151】fn chunk_round_step_projective<B, A>(\nL159:     【153†152】    e_lo: &[B; K],\nL160:     【154†153】    e_hi: &[B; K],\nL161:     【155†154】    w_lo: &[A; K],\nL162:     【156†155】    w_hi: &[A; K],\nL163:     【157†156】) -> (A, A)\nL164:     【158†157】where\nL165:     【159†158】    B: PrimeCharacteristicRing + Copy,\nL166:     【160†159】    A: Algebra<B> + Copy,\nL167:     【161†160】{\nL168:     【162†161】    // Materialise the X = 1 evaluations (lo + hi) tile-locally so they can\nL169:     【163†162】    // feed the same delayed-reduction primitive. `K` base adds, no reductions.\nL170:     【164†163】    let ones_e: [B; K] = core::array::from_fn(|i| e_lo[i] + e_hi[i]);\nL171:     【165†164】    let ones_w: [A; K] = core::array::from_fn(|i| w_lo[i] + w_hi[i]);\nL172:     【166†165】\nL173:     【167†166】    let acc1 = A::mixed_dot_product::<K>(&ones_w, &ones_e);\nL174:     【168†167】\nL175:     【169†168】    // Leading coefficient: dot product of the high (coefficient) faces.\nL176:     【170†169】    let acc_inf = A::mixed_dot_product::<K>(w_hi, e_hi);\nL177:     【171†170】\nL178:     【172†171】    (acc1, acc_inf)\nL179:     【173†172】}\nL180:     【174†173】\nL181:     【175†174】/// Projective per-pair MAC for the streaming tail (no subtraction).\nL182:     【176†175】#[inline(always)]\nL183:     【177†176】fn round_step_projective<B, A>((acc1, acc_inf): (A, A), e0: B, e1: B, w0: A, w1: A) -> (A, A)\nL184:     【178†177】where\nL185:     【179†178】    B: PrimeCharacteristicRing + Copy,\nL186:     【180†179】    A: Algebra<B> + Copy,\nL187:     【181†180】{\nL188:     【182†181】    (acc1 + (w0 + w1) * (e0 + e1), acc_inf + w1 * e1)\nL189:     【183†182】}\nL190:     【184†183】\nL191:     【185†184】/// The two prover-sent values of a quadratic sumcheck round.\nL192:     【186†185】///\nL193:     【187†186】/// The round polynomial has three unknowns; the verifier recovers the third\nL194:     【188†187】/// from the running claim `C`, so only two values cross the transcript. Which\n"
