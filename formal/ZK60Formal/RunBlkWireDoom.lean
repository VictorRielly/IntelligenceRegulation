section EqVanish

variable {K : Type} [Field K]

/-- Boolean point `b : Fin n → Bool` embedded into `Fin n → K` as `{0, 1}^n`. -/
def ptB {n : ℕ} (b : Fin n → Bool) : Fin n → K :=
  fun i => if b i then 1 else 0

/-- Univariate equality factor `eq1(t, bit)`. -/
def eq1 (t : K) (bit : Bool) : K :=
  if bit then t else 1 - t

/-- Multilinear equality kernel `eqB(τ, b) = ∏_i eq1(τ_i, b_i)`. -/
def eqB {n : ℕ} (τ : Fin n → K) (b : Fin n → Bool) : K :=
  ∏ i : Fin n, eq1 (τ i) (b i)

theorem eqB_ptB_self {n : ℕ} (b0 : Fin n → Bool) : eqB (ptB (K := K) b0) b0 = 1 := by
  unfold eqB
  refine Finset.prod_eq_one fun i _ => ?_
  cases h : b0 i <;> simp [ptB, eq1, h]

theorem eqB_ptB_ne {n : ℕ} (b0 b : Fin n → Bool) (hne : b ≠ b0) : eqB (ptB (K := K) b0) b = 0 := by
  have hex : ∃ i : Fin n, b i ≠ b0 i := by
    by_contra hc
    apply hne
    funext i
    by_contra hi
    exact hc ⟨i, hi⟩
  obtain ⟨i, hi⟩ := hex
  unfold eqB
  refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
  cases hb : b i <;> cases hb0 : b0 i <;> simp_all [ptB, eq1]

/-- **If `Σ_b eqB(τ, b) · Δ(b) = 0` for every `τ : Fin n → K`, then `Δ = 0` pointwise on `{0, 1}^n`.** -/
theorem eqB_vanish_zero {n : ℕ} (Δ : (Fin n → Bool) → K)
    (hvan : ∀ τ : Fin n → K, (∑ b : Fin n → Bool, eqB τ b * Δ b) = 0) :
    ∀ b0 : Fin n → Bool, Δ b0 = 0 := by
  intro b0
  have h0 := hvan (ptB b0)
  have hsum : (∑ b : Fin n → Bool, eqB (ptB (K := K) b0) b * Δ b) = Δ b0 := by
    rw [Finset.sum_eq_single b0]
    · rw [eqB_ptB_self b0, one_mul]
    · intro b _ hne
      rw [eqB_ptB_ne b0 b hne, zero_mul]
    · intro habs
      exact absurd (Finset.mem_univ b0) habs
  rw [hsum] at h0
  exact h0

end EqVanish

section IoSched

variable {K : Type} [Field K] [Algebra GF K] {Lq : ℕ}

/-- **Adversary-free boundary IO define schedule (`ks = [21, 22]`, degree `1`)** over `HdrX Lq`. -/
noncomputable def ioDefSchedB (P : BlockParams) (n : ℕ) (h21 : n ≤ P.draws 21) (h22 : n ≤ P.draws 22)
    (aIn aOut : Cuts3 Lq → RootsO → (Fin n → Bool) → K)
    (bIn bOut : HdrX Lq → (Fin n → Bool) → K) : DefSchedB K Lq P where
  ks := [21, 22]
  dg := fun _ => 1
  Φ cu rt hx s _ y :=
    if hs21 : s = 21 then
      ∑ b : Fin n → Bool,
        eqB (fun i : Fin n => y ⟨i.1, Nat.lt_of_lt_of_le i.2 (hs21 ▸ h21)⟩) b * (aIn cu rt b - bIn hx b)
    else if hs22 : s = 22 then
      ∑ b : Fin n → Bool,
        eqB (fun i : Fin n => y ⟨i.1, Nat.lt_of_lt_of_le i.2 (hs22 ▸ h22)⟩) b * (aOut cu rt b - bOut hx b)
    else 0
  Gd cu rt hx s _ :=
    (s = 21 → ∀ b, aIn cu rt b = bIn hx b) ∧ (s = 22 → ∀ b, aOut cu rt b = bOut hx b)

/-- **`RdBlkR13B.hIOΦ` for `ioDefSchedB`**: vanishing of slot 21/22's draw polynomial forces plane equality. -/
theorem ioDefSchedB_hIOΦ (P : BlockParams) (n : ℕ) (h21 : n ≤ P.draws 21) (h22 : n ≤ P.draws 22)
    (aIn aOut : Cuts3 Lq → RootsO → (Fin n → Bool) → K)
    (bIn bOut : HdrX Lq → (Fin n → Bool) → K) :
    ∀ cu rt hx s h, s ∈ (ioDefSchedB P n h21 h22 aIn aOut bIn bOut).ks →
      (∀ y, (ioDefSchedB P n h21 h22 aIn aOut bIn bOut).Φ cu rt hx s h y = 0) →
      (ioDefSchedB P n h21 h22 aIn aOut bIn bOut).Gd cu rt hx s h := by
  intro cu rt hx s h hs hy
  simp only [ioDefSchedB, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl
  · refine ⟨fun _ b => ?_, fun h22 => by omega⟩
    have hvan : ∀ τ : Fin n → K, (∑ b' : Fin n → Bool, eqB τ b' * (aIn cu rt b' - bIn hx b')) = 0 := by
      intro τ
      have h1 := hy (fun j => if hj : j.1 < n then τ ⟨j.1, hj⟩ else 0)
      simp only [ioDefSchedB, ↓reduceDIte] at h1
      have heq : (fun i : Fin n => if hj : i.1 < n then τ ⟨i.1, hj⟩ else 0) = τ := by
        funext i
        simp [i.2]
      simpa only [heq] using h1
    exact sub_eq_zero.mp (eqB_vanish_zero (fun b' => aIn cu rt b' - bIn hx b') hvan b)
  · refine ⟨fun h21 => by omega, fun _ b => ?_⟩
    have hvan : ∀ τ : Fin n → K, (∑ b' : Fin n → Bool, eqB τ b' * (aOut cu rt b' - bOut hx b')) = 0 := by
      intro τ
      have h1 := hy (fun j => if hj : j.1 < n then τ ⟨j.1, hj⟩ else 0)
      have hne : ¬ (22 = 21) := by decide
      simp only [ioDefSchedB, hne, ↓reduceDIte] at h1
      have heq : (fun i : Fin n => if hj : i.1 < n then τ ⟨i.1, hj⟩ else 0) = τ := by
        funext i
        simp [i.2]
      simpa only [heq] using h1
    exact sub_eq_zero.mp (eqB_vanish_zero (fun b' => aOut cu rt b' - bOut hx b') hvan b)

/-- **`RdBlkR13B.hIO` at R13**: once `ioDefSchedB`'s `Gd` holds on `[21, 22]`, any `Xin`, `Xout` projected from `bIn`,
`bOut` equal `(xtR ...).X ∘ Lay.dPos` and `(xtR ...).X2 ∘ Lay.dPos`. -/
theorem ioDefSchedB_r13_hIO (U : K) (c : W16Cfg) (P : BlockParams) (ls : ℕ)
    (Dof : Cuts3 Lq → RootsO → ZK60.Exec.Block.CmData K P)
    (h21 : nD c ≤ P.draws 21) (h22 : nD c ≤ P.draws 22)
    (bIn bOut : HdrX Lq → (Fin (nD c) → Bool) → K)
    {S : BlockShape} (Lay : W16Layout S (CtR c) (CwR c) (CgR c) (CjR c) (CdR c) (CfR c))
    (cu : Cuts3 Lq) (rt : RootsO) (hx : HdrX Lq) (h21_hist h22_hist : Hist)
    (Xin Xout : S.Pos → GF)
    (hXin : ∀ p, Xin p = piB K (bIn hx (Fin.append (Lay.dPos p).1 (Lay.dPos p).2)))
    (hXout : ∀ p, Xout p = piB K (bOut hx (Fin.append (Lay.dPos p).1 (Lay.dPos p).2)))
    (hg21 : (ioDefSchedB P (nD c) h21 h22
      (fun cu' rt' b => aPl U P (Dof cu' rt') (offR c 8) (nD c) b)
      (fun cu' rt' b => aPl U P (Dof cu' rt') (offR c 44) (nD c) b) bIn bOut).Gd cu rt hx 21 h21_hist)
    (hg22 : (ioDefSchedB P (nD c) h21 h22
      (fun cu' rt' b => aPl U P (Dof cu' rt') (offR c 8) (nD c) b)
      (fun cu' rt' b => aPl U P (Dof cu' rt') (offR c 44) (nD c) b) bIn bOut).Gd cu rt hx 22 h22_hist) :
    Xin = (fun p => (xtR U c P (Dof cu rt) ls).X (Lay.dPos p))
      ∧ Xout = (fun p => (xtR U c P (Dof cu rt) ls).X2 (Lay.dPos p)) := by
  refine ⟨funext fun p => ?_, funext fun p => ?_⟩
  · rw [hXin p, ← hg21.1 rfl (Fin.append (Lay.dPos p).1 (Lay.dPos p).2)]
    rfl
  · rw [hXout p, ← hg22.2 rfl (Fin.append (Lay.dPos p).1 (Lay.dPos p).2)]
    rfl

end IoSched

