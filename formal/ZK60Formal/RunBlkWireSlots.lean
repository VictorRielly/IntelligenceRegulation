variable {K : Type} [Field K] [Algebra GF K]

def rowsOfArgs {Lq : ℕ} (oA oH oI oO : RtOpen K Lq) : Block.Cm → ℕ
  | .a => oA.rows
  | .h => oH.rows
  | .inp => oI.rows
  | .out => oO.rows

def qOfArgs {Lq : ℕ} (oA oH oI oO : RtOpen K Lq) : Block.Cm → ℕ
  | .a => oA.Q
  | .h => oH.Q
  | .inp => oI.Q
  | .out => oO.Q

theorem claimSem_cast_lc (U : K) (R Q l1 l2 : ℕ) (hl : l1 = l2) (X : Fin R → Fin (2 ^ l1 + Q) → K)
    (z : Block.ZClaim) :
    claimSem U R l2 Q (fun i t => X i (Fin.cast (congrArg (fun m => 2 ^ m + Q) hl.symm) t)) z
      = claimSem U R l1 Q X z := by
  subst hl
  rfl

/-- **Committed matrices `CmData K P` assembled solely from `Fsl k`'s arguments `(c3, rt, hx)` via `bndTab`.** -/
noncomputable def dArgs (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (P : Block.BlockParams)
    (oA oH oI oO : RtOpen K Lq)
    (hoA : oA.lc = Block.rowLog P .a) (hoH : oH.lc = Block.rowLog P .h)
    (hoI : oI.lc = Block.rowLog P .inp) (hoO : oO.lc = Block.rowLog P .out)
    (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) (pi po : ℕ) : Block.CmData K P where
  rows := rowsOfArgs oA oH oI oO
  Q := qOfArgs oA oH oI oO
  X
    | .a => fun i t => bndTab tag Lq h64 oA (rt.1, c3.1) i (Fin.cast (congrArg (fun m => 2 ^ m + oA.Q) hoA.symm) t)
    | .h => fun i t => bndTab tag Lq h64 oH (rt.2.2, c3.2.2) i (Fin.cast (congrArg (fun m => 2 ^ m + oH.Q) hoH.symm) t)
    | .inp => fun i t => bndTab tag Lq h64 oI (hx pi) i (Fin.cast (congrArg (fun m => 2 ^ m + oI.Q) hoI.symm) t)
    | .out => fun i t => bndTab tag Lq h64 oO (hx po) i (Fin.cast (congrArg (fun m => 2 ^ m + oO.Q) hoO.symm) t)

/-- **`csArgs` IS `claimSem` on `dArgs` (`polyS_slotEvalN`'s `hcs`).** -/
theorem csArgs_dArgs (U : K) (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (P : Block.BlockParams)
    (oA oH oI oO : RtOpen K Lq)
    (hoA : oA.lc = Block.rowLog P .a) (hoH : oH.lc = Block.rowLog P .h)
    (hoI : oI.lc = Block.rowLog P .inp) (hoO : oO.lc = Block.rowLog P .out)
    (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) (pi po : ℕ) :
    ∀ cm z, csArgs U tag Lq h64 oA oH oI oO c3 rt hx pi po cm z
      = claimSem U ((dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po).rows cm)
          (Block.rowLog P cm)
          ((dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po).Q cm)
          ((dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po).X cm) z
  | .a, z => (claimSem_cast_lc U oA.rows oA.Q oA.lc (Block.rowLog P .a) hoA (bndTab tag Lq h64 oA (rt.1, c3.1)) z).symm
  | .h, z => (claimSem_cast_lc U oH.rows oH.Q oH.lc (Block.rowLog P .h) hoH (bndTab tag Lq h64 oH (rt.2.2, c3.2.2)) z).symm
  | .inp, z => (claimSem_cast_lc U oI.rows oI.Q oI.lc (Block.rowLog P .inp) hoI (bndTab tag Lq h64 oI (hx pi)) z).symm
  | .out, z => (claimSem_cast_lc U oO.rows oO.Q oO.lc (Block.rowLog P .out) hoO (bndTab tag Lq h64 oO (hx po)) z).symm

/-- **Concrete masked block slot polynomial `bwFsl` over `dArgs` and `mRowX`.** -/
noncomputable def bwFsl (U : K) (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (Sf : ℕ) (P : Block.BlockParams)
    (oA oH oI oO : RtOpen K Lq)
    (hoA : oA.lc = Block.rowLog P .a) (hoH : oH.lc = Block.rowLog P .h)
    (hoI : oI.lc = Block.rowLog P .inp) (hoO : oO.lc = Block.rowLog P .out)
    (pi po : ℕ) (prog : List Block.SlotS) (pubs : Block.PubTabs)
    (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) :
    (j : ℕ) → Block.Seen → (Fin ((Block.slotShape P j).1 + (Block.slotShape P j).2.1) → K) → K :=
  Block.maskedF U (Link.mRowX U Sf (Link.colsC tag Lq h64 c3.2.1 rt.2.1)) P
    (Block.polyS U P (dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po) prog pubs)

/-- **`bwFsl` satisfies `SlotEvalN` over `csArgs` and `msArgs`.** -/
theorem bwFsl_slotEvalN (U : K) (hU : U ^ 2 = algebraMap GF K 7)
    (hbij : Function.Bijective (ZK60.Hiding.fp2 (F := GF) U))
    (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (Sf : ℕ) (P : Block.BlockParams)
    (oA oH oI oO : RtOpen K Lq)
    (hoA : oA.lc = Block.rowLog P .a) (hoH : oH.lc = Block.rowLog P .h)
    (hoI : oI.lc = Block.rowLog P .inp) (hoO : oO.lc = Block.rowLog P .out)
    (pi po : ℕ) (prog : List Block.SlotS) (pubs : Block.PubTabs)
    (hN : ∀ j, j < P.geom.slots.length →
      0 < (Block.slotShape P j).1 + (Block.slotShape P j).2.1
        ∧ ((Block.slotShape P j).1 + (Block.slotShape P j).2.1) * (Block.slotShape P j).2.2 + 2 ≤ 512)
    (hdef : P.define = Block.defineS prog pubs)
    (hprog : Block.progOKb (Block.rowLog P) prog P.geom.slots = true)
    (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) :
    Block.SlotEvalN U P
      (csArgs U tag Lq h64 oA oH oI oO c3 rt hx pi po)
      (msArgs U tag Lq h64 Sf c3 rt)
      (bwFsl U tag Lq h64 Sf P oA oH oI oO hoA hoH hoI hoO pi po prog pubs c3 rt hx) :=
  Block.maskedF_slotEvalN U hU hbij P
    (csArgs U tag Lq h64 oA oH oI oO c3 rt hx pi po)
    (msArgs U tag Lq h64 Sf c3 rt)
    (Link.mRowX U Sf (Link.colsC tag Lq h64 c3.2.1 rt.2.1)) 512
    (Link.msOfTab_mlin U Sf (Link.colsC tag Lq h64 c3.2.1 rt.2.1))
    hN
    (Block.polyS U P (dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po) prog pubs)
    (Block.polyS_slotEvalN U hU P (dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po) prog pubs
      (csArgs U tag Lq h64 oA oH oI oO c3 rt hx pi po)
      (csArgs_dArgs U tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po)
      hdef hprog)

/-- **`bwFsl` satisfies `IndDegLE` at every slot index.** -/
theorem bwFsl_indDeg (U : K) (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (Sf : ℕ) (P : Block.BlockParams)
    (oA oH oI oO : RtOpen K Lq)
    (hoA : oA.lc = Block.rowLog P .a) (hoH : oH.lc = Block.rowLog P .h)
    (hoI : oI.lc = Block.rowLog P .inp) (hoO : oO.lc = Block.rowLog P .out)
    (pi po : ℕ) (prog : List Block.SlotS) (pubs : Block.PubTabs)
    (hd : ∀ j, j < P.geom.slots.length → 1 ≤ (Block.slotShape P j).2.2)
    (hprog : Block.progOKb (Block.rowLog P) prog P.geom.slots = true)
    (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) (j : ℕ) (sn : Block.Seen) :
    IndDegLE (Block.slotShape P j).2.2
      (bwFsl U tag Lq h64 Sf P oA oH oI oO hoA hoH hoI hoO pi po prog pubs c3 rt hx j sn) :=
  Block.maskedF_indDeg_all U _ P _ hd
    (Block.polyS_indDeg U P (dArgs tag Lq h64 P oA oH oI oO hoA hoH hoI hoO c3 rt hx pi po) prog pubs hprog) j sn

/-- **Run-indexed family `bwFslRun` for all blocks `k < Lb`.** -/
noncomputable def bwFslRun (U : K) (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (Lb : ℕ)
    (Pk : ℕ → Block.BlockParams) (Sf : ℕ → ℕ) (D : RtKData K Lq) (pf : RtProf)
    (hoAK : ∀ k, k < Lb → (D.opA (k + 1)).lc = Block.rowLog (Pk k) .a)
    (hoHK : ∀ k, k < Lb → (D.opH (k + 1)).lc = Block.rowLog (Pk k) .h)
    (hoIK : ∀ k, k < Lb → (D.opX (k + 1)).lc = Block.rowLog (Pk k) .inp)
    (hoOK : ∀ k, k < Lb → (D.opX (k + 1 + 1)).lc = Block.rowLog (Pk k) .out)
    (progK : ℕ → List Block.SlotS) (pubsK : ℕ → Block.PubTabs)
    (k : ℕ) (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq) (j : ℕ) (sn : Block.Seen)
    (pt : Fin ((Block.slotShape (Pk k) j).1 + (Block.slotShape (Pk k) j).2.1) → K) : K :=
  if hk : k < Lb then
    bwFsl U tag Lq h64 (Sf k) (Pk k) (D.opA (k + 1)) (D.opH (k + 1)) (D.opX (k + 1)) (D.opX (k + 1 + 1))
      (hoAK k hk) (hoHK k hk) (hoIK k hk) (hoOK k hk) (pf.off k + 2) (pf.off (k + 1) + 2)
      (progK k) (pubsK k) c3 rt hx j sn pt
  else 0

/-- **`hsl_argsN` of `RunStgJoinTop` proved for `bwFslRun`.** -/
theorem bwFslRun_slotEvalN (U : K) (hU : U ^ 2 = algebraMap GF K 7)
    (hbij : Function.Bijective (ZK60.Hiding.fp2 (F := GF) U))
    (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (Lb : ℕ)
    (Pk : ℕ → Block.BlockParams) (Sf : ℕ → ℕ) (D : RtKData K Lq) (pf : RtProf)
    (hoAK : ∀ k, k < Lb → (D.opA (k + 1)).lc = Block.rowLog (Pk k) .a)
    (hoHK : ∀ k, k < Lb → (D.opH (k + 1)).lc = Block.rowLog (Pk k) .h)
    (hoIK : ∀ k, k < Lb → (D.opX (k + 1)).lc = Block.rowLog (Pk k) .inp)
    (hoOK : ∀ k, k < Lb → (D.opX (k + 1 + 1)).lc = Block.rowLog (Pk k) .out)
    (progK : ℕ → List Block.SlotS) (pubsK : ℕ → Block.PubTabs)
    (hNK : ∀ k, k < Lb → ∀ j, j < (Pk k).geom.slots.length →
      0 < (Block.slotShape (Pk k) j).1 + (Block.slotShape (Pk k) j).2.1
        ∧ ((Block.slotShape (Pk k) j).1 + (Block.slotShape (Pk k) j).2.1) * (Block.slotShape (Pk k) j).2.2 + 2 ≤ 512)
    (hdefK : ∀ k, k < Lb → (Pk k).define = Block.defineS (progK k) (pubsK k))
    (hprogK : ∀ k, k < Lb → Block.progOKb (Block.rowLog (Pk k)) (progK k) (Pk k).geom.slots = true) :
    ∀ k, k < Lb → ∀ (c3 : Block.Cuts3 Lq) (rt : Block.RootsO) (hx : Block.HdrX Lq),
      Block.SlotEvalN U (Pk k)
        (csArgs U tag Lq h64 (D.opA (k + 1)) (D.opH (k + 1)) (D.opX (k + 1)) (D.opX (k + 1 + 1))
          c3 rt hx (pf.off k + 2) (pf.off (k + 1) + 2))
        (msArgs U tag Lq h64 (Sf k) c3 rt)
        (fun j sn pt => bwFslRun U tag Lq h64 Lb Pk Sf D pf hoAK hoHK hoIK hoOK progK pubsK k c3 rt hx j sn pt) := by
  intro k hk c3 rt hx
  have heq : (fun j sn pt => bwFslRun U tag Lq h64 Lb Pk Sf D pf hoAK hoHK hoIK hoOK progK pubsK k c3 rt hx j sn pt)
      = bwFsl U tag Lq h64 (Sf k) (Pk k) (D.opA (k + 1)) (D.opH (k + 1)) (D.opX (k + 1)) (D.opX (k + 1 + 1))
          (hoAK k hk) (hoHK k hk) (hoIK k hk) (hoOK k hk) (pf.off k + 2) (pf.off (k + 1) + 2)
          (progK k) (pubsK k) c3 rt hx := by
    funext j sn pt
    simp only [bwFslRun, dif_pos hk]
  rw [heq]
  exact bwFsl_slotEvalN U hU hbij tag Lq h64 (Sf k) (Pk k)
    (D.opA (k + 1)) (D.opH (k + 1)) (D.opX (k + 1)) (D.opX (k + 1 + 1))
    (hoAK k hk) (hoHK k hk) (hoIK k hk) (hoOK k hk)
    (pf.off k + 2) (pf.off (k + 1) + 2) (progK k) (pubsK k) (hNK k hk) (hdefK k hk) (hprogK k hk) c3 rt hx

end BwSlots

section ShieldSynth

/-- **Every `ShieldBlkAt` layer in `shieldExport` has a `progOKb`-verified slot program and fits `512`-wide masks.** -/
theorem shieldBlkAt_prog_facts {P : Block.BlockParams} {Ly : ZK60.RunShape.Shield.ShieldLayer}
    (hLy : Ly ∈ ZK60.RunShape.Shield.shieldExport)
    {Pb : ZK60.Block.BlockPublic (ZK60.RunShape.Shield.shieldShape Ly)}
    (h : Block.Join.R13H.ShieldBlkAt P Ly Pb) :
    (∃ (prog : List Block.SlotS) (pubs : Block.PubTabs),
      P.define = Block.defineS prog pubs ∧ Block.progOKb (Block.rowLog P) prog P.geom.slots = true)
      ∧ (∀ j, j < P.geom.slots.length →
          0 < (Block.slotShape P j).1 + (Block.slotShape P j).2.1
            ∧ ((Block.slotShape P j).1 + (Block.slotShape P j).2.1) * (Block.slotShape P j).2.2 + 2 ≤ 512) := by
  obtain ⟨tag', rowsOf', Lay', B', ioIn', ioOut', hP, hdef, hlc, hep, -⟩ := h
  refine ⟨⟨Block.DefR13.progR13 (Block.DefR13.cfgShieldR13 Ly) ioIn' ioOut',
    Block.Join.R13H.Pub.pubsR13L (Block.DefR13.cfgShieldR13 Ly) Pb Lay' B' (ZK60.RunShape.Shield.shieldShape Ly).nG,
    hdef, ?_⟩, ?_⟩
  · rw [hP.hsl, Block.progOKb_congr (Block.rowLog P) (fun _ => 1)
      (fun cm => by cases cm <;> simp [Block.rowLog, hlc, hep])]
    exact Block.DefR13.progR13_shield_ok ioIn' ioOut' Ly hLy
  · intro j hj
    have hlen : P.geom.slots.length = 23 := by rw [hP.hsl]; rfl
    rw [hlen] at hj
    have hf := Block.r13_shield_mask_facts j hj
    simp only [Block.slotShape, hP.hsl]
    exact hf.2

theorem shieldRunAt_prog_ex {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) (k : ℕ) (hk : k < Lb) :
    ∃ (prog : List Block.SlotS) (pubs : Block.PubTabs),
      (Pk k).define = Block.defineS prog pubs ∧ Block.progOKb (Block.rowLog (Pk k)) prog (Pk k).geom.slots = true := by
  obtain ⟨Ly, _, Pb, hLyOpt, -, -, -, hb⟩ := hPk k hk
  exact (shieldBlkAt_prog_facts (List.mem_of_getElem? hLyOpt) hb).1

theorem shieldRun_hN {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) :
    ∀ k, k < Lb → ∀ j, j < (Pk k).geom.slots.length →
      0 < (Block.slotShape (Pk k) j).1 + (Block.slotShape (Pk k) j).2.1
        ∧ ((Block.slotShape (Pk k) j).1 + (Block.slotShape (Pk k) j).2.1) * (Block.slotShape (Pk k) j).2.2 + 2 ≤ 512 := by
  intro k hk
  obtain ⟨Ly, _, Pb, hLyOpt, -, -, -, hb⟩ := hPk k hk
  exact (shieldBlkAt_prog_facts (List.mem_of_getElem? hLyOpt) hb).2

noncomputable def shieldRunProg {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) (k : ℕ) : List Block.SlotS :=
  if hk : k < Lb then Classical.choose (shieldRunAt_prog_ex hPk k hk) else []

noncomputable def shieldRunPubs {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) (k : ℕ) : Block.PubTabs :=
  if hk : k < Lb then Classical.choose (Classical.choose_spec (shieldRunAt_prog_ex hPk k hk))
  else fun _ _ _ _ => []

theorem shieldRun_hdef {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) :
    ∀ k, k < Lb → (Pk k).define = Block.defineS (shieldRunProg hPk k) (shieldRunPubs hPk k) := by
  intro k hk
  simp only [shieldRunProg, shieldRunPubs, dif_pos hk]
  exact (Classical.choose_spec (Classical.choose_spec (shieldRunAt_prog_ex hPk k hk))).1

theorem shieldRun_hprog {S0 : ZK60.Block.BlockShape} {Pk : ℕ → Block.BlockParams}
    {blks : List (ZK60.RunShape.RunBlock S0)} {Lb : ℕ}
    (hPk : Block.Join.R13H.ShieldRunAt Pk blks Lb) :
    ∀ k, k < Lb → Block.progOKb (Block.rowLog (Pk k)) (shieldRunProg hPk k) (Pk k).geom.slots = true := by
  intro k hk
  simp only [shieldRunProg, dif_pos hk]
  exact (Classical.choose_spec (Classical.choose_spec (shieldRunAt_prog_ex hPk k hk))).2

end ShieldSynth

