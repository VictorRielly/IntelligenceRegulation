section Cover

variable {Lq : ℕ} {Coins' : Type}

/-- **The joint cover from the parts' covers**: if accepted while stage IN-C's, the blocks' or stage OUT-C's
conclusion fails lies in `Z`, and accepted with stage IN-C's conclusion while the endpoint's fails lies in `Z`, then
accepted while the joint conclusion fails lies in `Z`. -/
theorem jointCover_of_partsP (R : ClassifyRunPublicP S) (P : Protocol (QB Lq) Dig Coins' (classifyModelP R))
    (E : List (QB Lq × Dig) → P.Stmt → P.Receipt → RunExt S P.Salt)
    (Z : OC (QB Lq) Dig (P.Stmt × P.Receipt) → (QB Lq → Dig) → Prop)
    (h3 : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ (InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ BlocksOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ OutOkP R (P.ypub (A.runLog G).1.1) (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)) → Z A G)
    (hep : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) →
      ¬ EpOkP P G (A.runLog G).1.1 (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) → Z A G) :
    ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ JointOkP R P G (A.runLog G).1.1 (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) → Z A G := by
  intro A G hv hj
  by_cases h : InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
      ∧ BlocksOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
      ∧ OutOkP R (P.ypub (A.runLog G).1.1) (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
  · exact hep A G hv h.1 (fun he => hj ⟨h.1, h.2.1, h.2.2, he⟩)
  · exact h3 A G hv h

end Cover

section CoverOrd

variable {Lq : ℕ} {Coins : Type}

/-- **The cover of stage IN-C, the blocks and stage OUT-C from per-part covers, the kinds alive IN ORDER** (D63 lane
L30; L27's `cover3_of_runParts` with its flat `halive` replaced). On an accepted receipt outside the extraction
failure `Ex`: (`halive`) the kinds of the list `Ks` are alive in order (`AliveOrd`); (`hdin`, `hdblk`, `hdout`) if
stage IN-C's conclusion, block `k`'s `BlockOn` on the extracted planes `B_k` and `B_{k+1}`, or stage OUT-C's
conclusion for the statement's verdict fails, some kind's sub-protocol of that part entered its window doomed on the
run's transcript. Then an accepted receipt on which one of the three conclusions fails lies in `Ex` or in the event
of one of the kinds, read in any list `Ls` that holds them: the premise `h3` of L26's
`classifyUP_productionReady_ep_target`. The protocol is any `Protocol` on the classify model. -/
theorem cover3_of_runParts_ordP (R : ClassifyRunPublicP S) (P : Protocol (QB Lq) Dig Coins (classifyModelP R))
    (E : List (QB Lq × Dig) → P.Stmt → P.Receipt → RunExt S P.Salt)
    (tr : (QB Lq → Dig) → P.Stmt × P.Receipt → List (TItem × Dig))
    (Ks : List (KindRun tr)) (hnp : ∀ K ∈ Ks, K.np = R.blks.length + 2)
    (Ls : List (FirstKind Lq (P.Stmt × P.Receipt))) (hsub : ∀ K ∈ Ks, K.toFirstKind ∈ Ls)
    (Ex : OC (QB Lq) Dig (P.Stmt × P.Receipt) → (QB Lq → Dig) → Prop)
    (halive : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true → ¬ Ex A G →
      AliveOrd Ks (R.blks.length + 2) (A.runLog G).2 (tr G (A.run G)))
    (hdin : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true → ¬ Ex A G →
      ¬ InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) →
      ∃ K ∈ Ks, ∃ c ∈ K.cs 0 (A.runLog G).2, EntD K.RC.W c (tr G (A.run G)))
    (hdblk : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig) (k : ℕ) (hk : k < R.blks.length),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true → ¬ Ex A G →
      ¬ BlockOn R.blks[k].pub ((E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2).planes k)
        ((E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2).planes (k + 1)) →
      ∃ K ∈ Ks, ∃ c ∈ K.cs (k + 1) (A.runLog G).2, EntD K.RC.W c (tr G (A.run G)))
    (hdout : ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true → ¬ Ex A G →
      ¬ OutOkP R (P.ypub (A.runLog G).1.1) (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) →
      ∃ K ∈ Ks, ∃ c ∈ K.cs (R.blks.length + 1) (A.runLog G).2, EntD K.RC.W c (tr G (A.run G))) :
    ∀ (A : OC (QB Lq) Dig (P.Stmt × P.Receipt)) (G : QB Lq → Dig),
      P.verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ (InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ BlocksOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ OutOkP R (P.ypub (A.runLog G).1.1) (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)) →
        Ex A G ∨ ∃ K ∈ Ls, K.Ev A G := by
  intro A G hv hbad
  by_cases hx : Ex A G
  · exact Or.inl hx
  · right
    have hev : ∀ K ∈ Ks, ∀ i, i < R.blks.length + 2 → (∃ c ∈ K.cs i (A.runLog G).2, EntD K.RC.W c (tr G (A.run G)))
        → ∃ K' ∈ Ls, K'.Ev A G := by
      intro K hK i hi hc
      exact kindEv_of_dm_ord Ks (R.blks.length + 2) hnp Ls hsub A G (halive A G hv hx) ⟨K, hK, i, hi, hc⟩
    by_cases hin : InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
    · by_cases hblk : BlocksOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
      · have hout : ¬ OutOkP R (P.ypub (A.runLog G).1.1) (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) :=
          fun h => hbad ⟨hin, hblk, h⟩
        obtain ⟨K, hK, hc⟩ := hdout A G hv hx hout
        exact hev K hK _ (by omega) hc
      · unfold BlocksOkP at hblk
        simp only [not_forall] at hblk
        obtain ⟨k, hk, hk'⟩ := hblk
        obtain ⟨K, hK, hc⟩ := hdblk A G k hk hv hx hk'
        exact hev K hK _ (by omega) hc
    · obtain ⟨K, hK, hc⟩ := hdin A G hv hx hin
      exact hev K hK 0 (by omega) hc

end CoverOrd

section Endpoint

/-- **The endpoint's cover at `classifyProtocolUP`** (D63 lane L26; O11d's deterministic core). Let the input
commitment be a token-words plane (`plane = posPlane pos`, canonical words admissible), let the run's extractor read
the endpoint off the extractor's openings `ops` (its words: the decoded data rows at the token positions, read
canonically; its opening data: built from the decoded rows and the extracted salts and paths, `SaltMk`), and let the
extracted openings verify with canonical columns. Then, accepted while the endpoint's conclusion fails (the commitment
does not open at radius `e` to the extracted words), either the extra event `Ex` holds, or the extracted matrix is not
close inside the columns that open (`hX`'s event: the column test's), or the decoded endpoint plane does not vanish
off the token positions (`hzero`'s event: SIC_IO's identity on the decoded data). -/
theorem epCoverUP (R : ClassifyRunPublicP S) (Lq : ℕ) (V : RunV Hdr) (P : RunP Hdr (S.Tok → ℕ) Coins)
    (Cin : PlaneCommit (S.Tok → ℕ) (ClsStmt Hdr) Salt) (h64 : 64 ≤ Lq) (hr : 8 * Cin.R ≤ Lq) (base : Coins → Salt)
    (e : ℕ) (hokC : ∀ x, (∀ t, x t < gP) → Cin.ok x) (pos : S.Tok → Fin Cin.dR × Fin Cin.n)
    (hplane : ∀ x, Cin.plane x = posPlane pos x) (mk : Cin.SaltMk)
    (ops : List (QB Lq × Dig) → ClsStmt Hdr → Fin Cin.N → Option (MerkleOpening Dig Dig (ColR Cin.R)))
    (E : List (QB Lq × Dig) → ClsStmt Hdr → ClsReceipt → RunExt S Salt)
    (hE : ∀ lg s pf, (E lg s pf).epW = (fun t => (Cin.decodeIn (ops lg s) e).1 (Cin.place (pos t).1) (pos t).2)
      ∧ (E lg s pf).r = mk.bld (Cin.decodeIn (ops lg s) e).1 (Cin.decodeIn (ops lg s) e).2 (Cin.exSalt (ops lg s))
          (Cin.exPath (ops lg s)))
    (Ex Z : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt) → (QB Lq → Dig) → Prop)
    (hops : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig) j o,
      ops (A.runLog G).2 (A.runLog G).1.1 j = some o →
        (merkleEncB Cin.tag Lq Cin.R h64 hr).Opens G Cin.depth (Cin.root (A.runLog G).1.1) j.val o)
    (hcan : ∀ lg s j o, ops lg s j = some o → ∀ a ∈ o.col.1, a.Canon)
    (hX : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ Ex A G →
      ¬ CloseIn (LinearMap.range (encLin (Q := Cin.Q) Cin.pts Cin.form)) e (exX (ops (A.runLog G).2 (A.runLog G).1.1))
          (exU (ops (A.runLog G).2 (A.runLog G).1.1)) → Z A G)
    (hzero : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ Ex A G →
      ¬ (∀ k i, (¬ ∃ t, pos t = (k, i)) → (Cin.decodeIn (ops (A.runLog G).2 (A.runLog G).1.1) e).1 (Cin.place k) i = 0)
        → Z A G) :
    ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ EpOkP (classifyProtocolUP R Lq V P Cin h64 hr base e) G (A.runLog G).1.1
        (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2) → Ex A G ∨ Z A G := by
  intro A G hv hep
  by_cases hx : Ex A G
  · exact Or.inl hx
  right
  by_cases hcl : CloseIn (LinearMap.range (encLin (Q := Cin.Q) Cin.pts Cin.form)) e
      (exX (ops (A.runLog G).2 (A.runLog G).1.1)) (exU (ops (A.runLog G).2 (A.runLog G).1.1))
  · by_cases hz : ∀ k i, (¬ ∃ t, pos t = (k, i)) →
        (Cin.decodeIn (ops (A.runLog G).2 (A.runLog G).1.1) e).1 (Cin.place k) i = 0
    · exfalso
      apply hep
      obtain ⟨hw, hrr⟩ := hE (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2
      show Cin.OpensU Lq h64 hr e G (A.runLog G).1.1
        (fun t => canonWord ((E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2).epW t))
        (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2).r
      rw [hw, hrr]
      refine Cin.opensU_of_closeIn mk Lq h64 hr e G (A.runLog G).1.1 (ops (A.runLog G).2 (A.runLog G).1.1)
        (hops A G) (hcan _ _) _ (exX_spec _) _ (exU_spec _) hcl _ (hokC _ (fun t => canonWord_lt _)) ?_
      intro k
      rw [hplane]
      exact congrFun (posPlane_eq_of_zero
        (fun k i => (Cin.decodeIn (ops (A.runLog G).2 (A.runLog G).1.1) e).1 (Cin.place k) i) hz) k
    · exact hzero A G hv hx hz
  · exact hX A G hv hx hcl

variable [Fintype Coins] [Nonempty Coins] [Inhabited Coins]
variable {K : Type} [Field K] [DecidableEq K] [Algebra GF K]

/-- **THE GATE at `classifyProtocolUP` at the approved targets, with O11d DISCHARGED from the endpoint's column test**
(D63 lane L26; L24's joint gate). Every `ClassifyOpenP` field but O11, the radius, ONE list of kinds `L` (its constants
`≤ 2^26`), the cover of stage IN-C, the blocks and stage OUT-C (`h3`), and for the endpoint only `epCoverUP`'s premises
with their events among `L`'s kinds: `ProductionReady … (classifyProtocolU …) εcTarget εsTarget εsTarget εzkTarget`. -/
theorem classifyUP_productionReady_ep_target (R : ClassifyRunPublicP S) (Lq : ℕ) (V : RunV Hdr)
    (P : RunP Hdr (S.Tok → ℕ) Coins) (Cin : PlaneCommit (S.Tok → ℕ) (ClsStmt Hdr) Salt) (h64 : 64 ≤ Lq)
    (hr : 8 * Cin.R ≤ Lq) (hon : HonestIn Coins Cin) (U : K) (hbij : Function.Bijective (ZK60.Hiding.fp2 (F := GF) U))
    {ι : Type} [Fintype ι] (site : (S.Tok → ℕ) → ι → Site (QB Lq) Coins K) (kOf : ι → ℕ) (δOf : ι → ℝ≥0∞)
    (E : List (QB Lq × Dig) → ClsStmt Hdr → ClsReceipt → RunExt S Salt)
    {εzk : ℕ → ℕ → ℝ≥0∞}
    (O : ClassifyOpenP R Lq V P Cin h64 hr hon U site kOf δOf εzk) (e : ℕ)
    (he : 2 * e + (Cin.n + Cin.Q) ≤ Cin.N) (hN20 : Cin.N ≤ 2 ^ 20)
    (L : List (FirstKind Lq (ClsStmt Hdr × ClsReceipt) × ℕ))
    (Ex : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt) → (QB Lq → Dig) → Prop) (εx : ℕ → ℝ≥0∞)
    (hEx : ∀ (q : ℕ) (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)), A.Bounded q → prH (Ex A) ≤ εx q)
    (h3 : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr hon.base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ (InOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ BlocksOkP R (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)
          ∧ OutOkP R ((classifyProtocolUP R Lq V P Cin h64 hr hon.base e).ypub (A.runLog G).1.1)
            (E (A.runLog G).2 (A.runLog G).1.1 (A.runLog G).1.2)) →
        Ex A G ∨ ∃ K ∈ L.map Prod.fst, K.Ev A G)
    (pos : S.Tok → Fin Cin.dR × Fin Cin.n) (hplane : ∀ x, Cin.plane x = posPlane pos x) (mk : Cin.SaltMk)
    (ops : List (QB Lq × Dig) → ClsStmt Hdr → Fin Cin.N → Option (MerkleOpening Dig Dig (ColR Cin.R)))
    (hE : ∀ lg s pf, (E lg s pf).epW = (fun t => (Cin.decodeIn (ops lg s) e).1 (Cin.place (pos t).1) (pos t).2)
      ∧ (E lg s pf).r = mk.bld (Cin.decodeIn (ops lg s) e).1 (Cin.decodeIn (ops lg s) e).2 (Cin.exSalt (ops lg s))
          (Cin.exPath (ops lg s)))
    (hops : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig) j o,
      ops (A.runLog G).2 (A.runLog G).1.1 j = some o →
        (merkleEncB Cin.tag Lq Cin.R h64 hr).Opens G Cin.depth (Cin.root (A.runLog G).1.1) j.val o)
    (hcan : ∀ lg s j o, ops lg s j = some o → ∀ a ∈ o.col.1, a.Canon)
    (hX : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr hon.base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ Ex A G →
      ¬ CloseIn (LinearMap.range (encLin (Q := Cin.Q) Cin.pts Cin.form)) e (exX (ops (A.runLog G).2 (A.runLog G).1.1))
          (exU (ops (A.runLog G).2 (A.runLog G).1.1)) → ∃ K ∈ L.map Prod.fst, K.Ev A G)
    (hzero : ∀ (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB Lq → Dig),
      (classifyProtocolUP R Lq V P Cin h64 hr hon.base e).verify G () (A.runLog G).1.1 (A.runLog G).1.2 = true →
      ¬ Ex A G →
      ¬ (∀ k i, (¬ ∃ t, pos t = (k, i)) → (Cin.decodeIn (ops (A.runLog G).2 (A.runLog G).1.1) e).1 (Cin.place k) i = 0)
        → ∃ K ∈ L.map Prod.fst, K.Ev A G)
    (cx : ℕ) (hℓ : ∀ p ∈ L, p.1.ℓ ≤ 2 ^ 21) (hlin : ∀ q : ℕ, ∀ p ∈ L, (q : ℝ≥0∞) * p.1.εmax + p.1.B ≤ u126 q p.2)
    (hx : ∀ q : ℕ, q + 1 ≤ 2 ^ 102 → εx q ≤ u126 q cx) (hbud : partConst L cx ≤ 2 ^ 26)
    (hzk : ∀ q R', εzk q R' ≤ εzkTarget q R') :
    ProductionReady (classifyModelP R) (classifyArithP R) (classifyProtocolUP R Lq V P Cin h64 hr hon.base e)
      εcTarget εsTarget εsTarget εzkTarget :=
  classifyUP_productionReady_joint_target R Lq V P Cin h64 hr hon U hbij site kOf δOf E O e he hN20 L Ex εx hEx
    (jointCover_of_partsP R (classifyProtocolUP R Lq V P Cin h64 hr hon.base e) E
      (fun A G => Ex A G ∨ ∃ K ∈ L.map Prod.fst, K.Ev A G) h3
      (fun A G hv _ hep => epCoverUP R Lq V P Cin h64 hr hon.base e O.commit.1 pos hplane mk ops E hE Ex
