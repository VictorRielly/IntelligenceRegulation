    HGd spH hdgH
    (fun G bga rs acc hT => alg_hvH U hU hbij key domain hs hL hdrLen _ 512 Poly _ _ hlin hNs A spH G bga rs acc hT
      (hformH G bga rs acc hT))
    hgdH Alk T mlk hN he hbr hhr

