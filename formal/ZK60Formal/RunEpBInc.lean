/-! ## The extraction under a reader -/

section XOk

variable (tag : MTag) (Lq : ℕ) (h64 : 64 ≤ Lq) (key : Option Dig) (domain : List UInt8)
  (hs : decodeLink (startMsg domain) = none) (hL : (startMsg domain).length ≤ Lq)

/-- **An opening's extraction under a reader** (L43's `RhXOk` with `colX` replaced by L51's `colXM rdx`): every sampled
column of `zo` that verifies against `root` at depth `g.h`, with `g.rows` values, is the column extracted for the root
the header's message at `g.ipos` reads as under `rdx`. -/
def RhXOkM (rdx : List UInt8 → Option Dig) (g : RkGeo) (P : List (QB Lq × Dig)) (G : QB Lq → Dig)
    (hdr : List (TItem × Dig)) (zo : Block.OpeningZk) (root : Dig) : Prop :=
  ∀ (k : ℕ), k < g.Q → k < zo.columns.length →
    ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.2.2.length = g.h →
    verifyPath (liftH G) tag root ((toOZ zo).columns.getD k (0, [], zeroDig, [])).1
      (saltLeaf (liftH G) tag (colDigest (liftH G) tag ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.1)
        ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.2.1) ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.2.2
      = true →
    ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.1.length = g.rows →
    (colXM tag Lq h64 key domain hs hL rdx g.h g.ipos P hdr ((toOZ zo).columns.getD k (0, [], zeroDig, [])).1).map
      Subtype.val = some ((toOZ zo).columns.getD k (0, [], zeroDig, [])).2.1

end XOk

/-- **Repair B's root list**: the statement's input root alone. -/
def ebInRoots {Hdr : Type} (o : ClsStmt Hdr × ClsReceipt) : List Dig := [o.1.inRoot]

theorem ebInRoots_length {Hdr : Type} (o : ClsStmt Hdr × ClsReceipt) : (ebInRoots o).length ≤ 1 := le_rfl

section IncX

variable {K : Type} [Field K] [Algebra GF K] (U : K) (tag : MTag)
  {Hdr : Type} {V : RunV Hdr} {key : Option Dig} {domain : List UInt8} {Lq : ℕ}
  (h64 : 64 ≤ Lq) (hs : decodeLink (startMsg domain) = none) (hL : (startMsg domain).length ≤ Lq)

/-- **Stage IN-C's closing opening under a reader** (L48's `rs_inc_opXG`, copied by `l52_mk_inc.py` with the extraction
read under `rdx`): at part `i` of an accepted run (stage IN-C with the contract `I`), at any code geometry `g` whose
numbers the endpoint verifier has, the closing opening of the segment read off the bytes meets `RhOpWM rdx` as soon as
it meets its extraction under `rdx` at the statement's input root. -/
theorem eb_inc_opXG (R : RtRun V key domain Lq) (hv : R.pf.Valid) (G : QB Lq → Dig) (s : ClsStmt Hdr)
    (segs : ClsReceipt) (hE : classifyVerifyE V (liftH G) s segs = .ok ()) (i : ℕ) (p : RtPart)
    (inc : Hdr → IncV) (incG : Hdr → StageGeom) (cx0 : IncCtx) (I : RtInc Lq inc incG p)
    (hσi : R.σs[i]? = some (rtIncSeg inc incG cx0 p))
    (W : List (TItem × Dig) → IncV) (hW : W ((R.tr G (s, segs)).take (R.pf.off i + p.pre)) = inc s.hdr)
    (g : OGeo) (hg : g.Ok) (hX : RkPcsAt U tag g I.pX) (xPos : ℕ) (lg : List (QB Lq × Dig))
    (rdx : List UInt8 → Option Dig) :
    ∃ seg : StageSeg, rtStageOf (incG s.hdr) (segs.getD i []) = some seg
      ∧ (RhXOkM tag Lq h64 key domain hs hL rdx (rkAt g I.pX.rows xPos) lg G
          ((R.tr G (s, segs)).take (R.pf.off i + (R.pf.part i).oX)) (seg.closes.headD IncV.ozk0) s.inRoot →
        Nonempty (RhOpWM U tag Lq h64 key domain hs hL rdx (rtW R.pf.sqs) (rkAt g I.pX.rows xPos) I.nIn
          (fun hdr => [] ++ (rkAccInc W (R.pf.off i + 5) (R.pf.off i + p.pre) hdr).claims.inp)
          (R.pf.off i + (R.pf.part i).oX) (R.pf.off i + (R.pf.part i).oBX)
          (R.pf.off i + (R.pf.part i).oX + (I.nIn + I.pX.rows)) lg G (R.tr G (s, segs)))) := by
  obtain ⟨seg, root, recs, acc, t4, t5, t6, t7, t', hof, hcanC, hshape, hcanX, hrdi, hpi, hbr, hsl, -, h5, h6, h7, h8,
    hread⟩ := rs_inc_run R hv G s segs hE i p inc incG cx0 hσi (I.hgeo s.hdr) (I.hgt s.hdr)
      (fun cx k hk => (I.hgeomL s.hdr cx k hk).1) W hW
  obtain ⟨hgood, -⟩ := R.accept (liftH G) s segs hE
  have hpart : R.pf.part i = p := rh_part_eq R.pf i p hpi
  have hpd : RtPartOk Lq p (rtIncData (inc s.hdr) cx0 seg) := rk_forall₂_getElem? hgood.2.2.2 i p _ hpi hrdi
  have hgA : seg.core.aOpen.groupVecs.length = p.gA := hpd.2.2.1
  have hgH : seg.core.hOpen.groupVecs.length = p.gH := hpd.2.2.2.1
  have hgX : (seg.closes.headD IncV.ozk0).groupVecs.length = p.gX := hpd.2.2.2.2.1
  have hgd : seg.bRoot.getD zeroDig = root := by rw [hbr]; rfl
  have hpre_eq := rs_incPre_eq (inc s.hdr) cx0 seg root hgd
  have hd1 : ∀ cx j, j < seg.core.slots.length → 1 ≤ (Block.slotShape ((inc s.hdr).bp cx) j).2.2 :=
    fun cx j hj => (I.hgeomL s.hdr cx j (by rw [← hshape.1]; exact hj)).1
  have ht4 := rt_incSlots_tr (liftH G) (inc s.hdr) seg.core _ recs acc t4 hsl hd1 cx0
  rw [I.hPm s.hdr] at h5
  have ht5 := (rt_mask_tr I.tag p.S (liftH G) _ _ _ t4 t5 h5).1
  obtain ⟨hcA, hcH, hcI, -⟩ := I.hcnt s.hdr (liftH G) seg.core _ recs acc t4 hsl hshape.1
  have ht6 := (I.pA.tr s.hdr (liftH G) seg.core.aRoot acc.claims.a seg.core.aOpen t5 t6 h6 I.nA hcA).1
  have ht7 := (I.pH.tr s.hdr (liftH G) seg.core.hRoot (acc.claims.h ++ [(inc s.hdr).lay.logupSumClaim])
    seg.core.hOpen t6 t7 h7 I.nH hcH).1
  have hmX : p.mX = g.mI := by rw [← I.hmX]; exact hX.hm U tag hg.hm
  have hwA : p.wA = I.nA + I.pA.rows := I.hwA.symm
  have hmA : p.mA = I.pA.m := I.hmA.symm
  have hwH : p.wH = I.nH + I.pH.rows := I.hwH.symm
  have hmH : p.mH = I.pH.m := I.hmH.symm
  have hwX : p.wX = I.nIn + I.pX.rows := I.hwX.symm
  set u := opsStps (rtIncData (inc s.hdr) cx0 seg).pre ++ mStps p.S seg.core.maskOpen
      ++ pcsStps p.wA p.mA seg.core.aOpen ++ pcsStps p.wH p.mH seg.core.hOpen with huDef
  obtain ⟨tk, td, trem, tctr, tst⟩ := rtTr_part key domain Lq R.pf R.rd hv G (s, segs) hgood i p
    (rtIncData (inc s.hdr) cx0 seg) hpi hrdi u (pcsStps p.wX p.mX (seg.closes.headD IncV.ozk0))
    (by rw [huDef]; simp only [rtPartStps, rtIncData, List.append_assoc])
  have hul : (stpsOps u).length = p.oX := by
    rw [huDef, stpsOps_append, stpsOps_append, stpsOps_append, List.length_append, List.length_append,
      List.length_append, stpsOps_opsStps, stpsOps_mStps_length, stpsOps_pcsStps_length, stpsOps_pcsStps_length,
      hpd.1, hgA, hgH]
    simp only [RtPart.oX, RtPart.oBH, RtPart.oH, RtPart.oBA, RtPart.oA]
    omega
  have hle : R.pf.off i + p.pre ≤ R.pf.off i + p.oX := by
    simp only [RtPart.oX, RtPart.oBH, RtPart.oH, RtPart.oBA, RtPart.oA]
    omega
  have ht7' : runOps (liftH G) (Tr.newKeyed (liftH G) domain key) (stpsOps (rtPre R.pf (R.rd (s, segs)) i ++ u))
      = t7 := by
    rw [ht7, ht6, ht5, ht4, huDef, hpre_eq, hwA, hmA, hwH, hmH]
    simp only [stpsOps_append, stpsOps_opsStps, runOps_append, List.append_assoc]
  have hlen := rh_take_len key domain Lq R.pf R.rd G (s, segs) hgood i u tk
  rw [hul] at td trem hlen
  rw [ht7'] at td tctr
  rw [hmX, hwX] at td tst
  refine ⟨seg, hof, fun hx => ⟨?_⟩⟩
  rw [hpart] at hx ⊢
  have hok := I.pX.hok s.hdr (liftH G) s.inRoot acc.claims.inp (seg.closes.headD IncV.ozk0) t7 t' h8
  rw [hX.htag, hX.hpt, hX.hlc'] at hok
  have hr : (rkAt g I.pX.rows xPos).rows = I.pX.rows := rfl
  exact
    { tA := t7
      tH := t'
      zo := seg.closes.headD IncV.ozk0
      c := R.pf.sqAt i + stpsSq u
      rs := rtPartsStps (R.pf.parts.drop (i + 1)) ((R.rd (s, segs)).2.drop (i + 1))
      prm := I.pX.prm
      ev := I.pX.ev
      cl := acc.claims.inp
      root := s.inRoot
      hpl := hlen
      hdrop := td
      hpre := trem
      hctr := tctr
      hst := tst
      hvpos := rfl
      haB := by
        rw [hgX, hr]
        have := I.hwX
        simp only [RtPart.oBX]
        omega
      hlc := hX.hlc
      hqp := by rw [I.pX.hqp, hX.hQ]; rfl
      hnQ := by rw [I.pX.hnQ, hX.hQ]; rfl
      hnn := by rw [I.pX.hnn, hX.hN]; rfl
      hpow := by rw [I.pX.hnn]; exact I.pX.hpow
      hQ0 := hg.hQ0
      hm := hg.hm
      hspec := hX.hspec
      hok := hok
      hcnt := hcI
      hrd := by
        show [] ++ (rkAccInc W (R.pf.off i + 5) (R.pf.off i + p.pre)
          ((R.tr G (s, segs)).take (R.pf.off i + p.oX))).claims.inp = acc.claims.inp
        rw [hread ((R.tr G (s, segs)).take (R.pf.off i + p.oX)) (rk_take_take_le _ _ _ hle), List.nil_append]
      hcan := og_closes_canon seg hcanX
      hcolX := hx }

/-- **THE INPUT TOKEN ENDPOINT'S OPENING MEETS `RhOpWM` OUTRIGHT AT PART `0`** (L48's `rx_inc_opX` under repair B), at
any code geometry `g` with at most `256` queries, on an accepted run outside repair B's event `EvXM rdx` with the run's
own Merkle work, given that the header's message at `xPos` reads (under `rdx`) as the statement's input root. -/
theorem rx_inc_opXM (R : RtRun V key domain Lq) (hv : R.pf.Valid) (G : QB Lq → Dig) (s : ClsStmt Hdr)
    (segs : ClsReceipt) (hE : classifyVerifyE V (liftH G) s segs = .ok ()) (p : RtPart)
    (inc : Hdr → IncV) (incG : Hdr → StageGeom) (cx0 : IncCtx) (I : RtInc Lq inc incG p)
    (hσ : R.σs[0]? = some (rtIncSeg inc incG cx0 p))
    (W : List (TItem × Dig) → IncV) (hW : W ((R.tr G (s, segs)).take (R.pf.off 0 + p.pre)) = inc s.hdr)
    (g : OGeo) (hg : g.Ok) (hgQ : g.Q ≤ 256) (hX : RkPcsAt U tag g I.pX) (xPos : ℕ)
    (outcG : Hdr → StageGeom) (sgeom : ClsStmt Hdr → ℕ → Block.SegGeom) (Lb : ℕ)
    (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (hrun : A.run G = (s, segs)) (rdx : List UInt8 → Option Dig)
    (hXev : ¬ EvXM tag Lq h64 key domain hs hL rdx 256 256 256 16 16 12 26 (rxCoreOf sgeom)
      (rxVx tag Lq h64 incG outcG sgeom Lb) ebInRoots A G)
    (hfit : 8 * I.pX.rows ≤ Lq)
    (hRd : (Block.absAt ((R.tr G (s, segs)).take (R.pf.off 0 + (R.pf.part 0).oX)) xPos).bind rdx = some s.inRoot) :
    Nonempty (RhOpWM U tag Lq h64 key domain hs hL rdx (rtW R.pf.sqs) (rkAt g I.pX.rows xPos) I.nIn
      (fun hdr => [] ++ (rkAccInc W (R.pf.off 0 + 5) (R.pf.off 0 + p.pre) hdr).claims.inp)
      (R.pf.off 0 + (R.pf.part 0).oX) (R.pf.off 0 + (R.pf.part 0).oBX)
      (R.pf.off 0 + (R.pf.part 0).oX + (I.nIn + I.pX.rows)) (A.runLog G).2 G (R.tr G (s, segs))) := by
  obtain ⟨seg, hof, himp⟩ :=
    eb_inc_opXG U tag h64 hs hL R hv G s segs hE 0 p inc incG cx0 I hσ W hW g hg hX xPos (A.runLog G).2 rdx
  have hseg : rxInSeg incG (A.run G) = some seg := by rw [hrun]; exact hof
  have hroot : s.inRoot ∈ ebInRoots (A.run G) := by
    rw [hrun]
    exact List.mem_singleton_self _
  apply himp
  exact ab_xok_in tag Lq h64 key domain hs hL rdx (rxCoreOf sgeom) (rxVx tag Lq h64 incG outcG sgeom Lb) ebInRoots
    A G hXev g.h xPos I.pX.rows g.Q _ (seg.closes.headD IncV.ozk0) s.inRoot hroot hRd hfit
    (fun k hk => rx_q_work tag Lq h64 incG outcG sgeom Lb (rxCoreOf sgeom) A G (seg.closes.headD IncV.ozk0).columns
      (rx_inCols_mem incG outcG sgeom Lb _ seg hseg).2.2.2 g.h (by have := hg.hh; omega) k (lt_of_lt_of_le hk hgQ))

/-- **THE RESTATED TOP THEOREM'S `hopX` AT PART `0`, AT THE CODE'S HEADER** (repair B): on an accepted run whose header
is the code's (`clsHdrOf`, L51: the input root inside `expected-IO` at position `1`), outside repair B's event
`EvXM abRdIn`, when part `0`'s closing geometry is the input endpoint's read at position `1` (`hgX`) with `I.nIn` claims
(`hnX`), part `0`'s closing opening meets `EbXW … 0` (that is, `RhOpWM abRdIn`) at the kinds data `rxPs` and the
readers `rxAcc`. No premise about where the root is absorbed is left: the header gives it (`ab_rdIn_at1`). -/
theorem eb_hopX0 (hw : Hdr → ClsHdrW) (R : RtRun V key domain Lq) (hR : ∀ s, R.hdr s = clsHdrOf hw s)
    (hv : R.pf.Valid) (G : QB Lq → Dig) (s : ClsStmt Hdr)
    (segs : ClsReceipt) (hE : classifyVerifyE V (liftH G) s segs = .ok ()) (pin : RtPart)
    (inc : Hdr → IncV) (incG : Hdr → StageGeom) (cx0 : IncCtx) (I : RtInc Lq inc incG pin)
    (hσ0 : R.σs[0]? = some (rtIncSeg inc incG cx0 pin))
    (Win : List (TItem × Dig) → IncV) (Wout : List (TItem × Dig) → OutcV) (Pk : ℕ → Block.BlockParams) (Lb : ℕ)
    (base : ℕ → RkPart K Lq) (din : RxMAH) (dblk : ℕ → RxMAH) (dout : RxMAH)
    (hWin : Win ((R.tr G (s, segs)).take (R.pf.off 0 + pin.pre)) = inc s.hdr)
    (g : OGeo) (hg : g.Ok) (hgQ : g.Q ≤ 256) (hX : RkPcsAt U tag g I.pX)
    (hgX : (base 0).gX = rkAt g I.pX.rows 1) (hnX : (base 0).nX = I.nIn)
    (outcG : Hdr → StageGeom) (sgeom : ClsStmt Hdr → ℕ → Block.SegGeom)
    (A : OC (QB Lq) Dig (ClsStmt Hdr × ClsReceipt)) (hrun : A.run G = (s, segs))
    (hXev : ¬ EvXM tag Lq h64 key domain hs hL abRdIn 256 256 256 16 16 12 26 (rxCoreOf sgeom)
      (rxVx tag Lq h64 incG outcG sgeom Lb) ebInRoots A G)
    (hfit : 8 * I.pX.rows ≤ Lq) :
    EbXW U tag Lq h64 key domain hs hL abRdIn 0 (rtW R.pf.sqs) ((rxPs base Lb din dblk dout) 0).gX
      ((rxPs base Lb din dblk dout) 0).nX
      (fun hdr => rkPend (rxAcc Win Wout Pk R.pf Lb) 0 hdr ++ ((rxAcc Win Wout Pk R.pf Lb) 0 hdr).claims.inp)
      (R.pf.off 0 + (R.pf.part 0).oX) (R.pf.off 0 + (R.pf.part 0).oBX)
      (R.pf.off 0 + (R.pf.part 0).oX + (((rxPs base Lb din dblk dout) 0).nX
        + ((rxPs base Lb din dblk dout) 0).gX.rows)) (A.runLog G).2 G (R.tr G (s, segs)) := by
  have hpart : R.pf.part 0 = pin := rx_part_of R 0 _ hσ0
  have hRd : (Block.absAt ((R.tr G (s, segs)).take (R.pf.off 0 + (R.pf.part 0).oX)) 1).bind abRdIn = some s.inRoot :=
    ab_rdIn_at1 hw R hR G s segs hE _ (by rw [ab_off0 hw R hR G s segs hE]; omega)
  have h := rx_inc_opXM U tag h64 hs hL R hv G s segs hE pin inc incG cx0 I hσ0 Win hWin g hg hgQ hX 1 outcG sgeom
    Lb A hrun abRdIn hXev hfit hRd
  show Nonempty (RhOpWM U tag Lq h64 key domain hs hL abRdIn (rtW R.pf.sqs) (base 0).gX (base 0).nX
    (fun hdr => [] ++ (rkAccInc Win (R.pf.off 0 + 5) (R.pf.off 0 + (R.pf.part 0).pre) hdr).claims.inp)
    (R.pf.off 0 + (R.pf.part 0).oX) (R.pf.off 0 + (R.pf.part 0).oBX)
    (R.pf.off 0 + (R.pf.part 0).oX + ((base 0).nX + (base 0).gX.rows)) (A.runLog G).2 G (R.tr G (s, segs)))
  rw [hgX, hnX, hpart]
  rw [hpart] at h
  exact h

end IncX

/-! ## Repair B's event at the run, its bound, and the count -/

section Ev

variable (tag : MTag) (L : ℕ) (h64 : 64 ≤ L) (key : Option Dig) (domain : List UInt8)
  (hs : decodeLink (startMsg domain) = none) (hL : (startMsg domain).length ≤ L) {Hdr : Type}

/-- **Repair B's event at the run**: L51's `EvXM` with the input root's reader `abRdIn`, the input root as the one root,
and the run's own Merkle work (`rxCoreOf`, `rxVx`: the same as the run's event `EvXR`'s). -/
def ebEvIn (incG outcG : Hdr → StageGeom) (sgeom : ClsStmt Hdr → ℕ → Block.SegGeom) (Lb : ℕ)
    (A : OC (QB L) Dig (ClsStmt Hdr × ClsReceipt)) (G : QB L → Dig) : Prop :=
  EvXM tag L h64 key domain hs hL abRdIn 256 256 256 16 16 12 26 (rxCoreOf sgeom) (rxVx tag L h64 incG outcG sgeom Lb)
    ebInRoots A G

/-- **ITS BOUND**: within `εxRun q` for every `q` (`(q + 1)·(2^16 + 2^18)/2^126` for `q + 1 ≤ 2^102`): L51's
`extract_fail_xm_u126` at the run's Merkle work (`26·(256·18 + 256·18 + 256·14) + 574,464 = 907,264 ≤ 2^22` queries)
and one root. -/
theorem ebEvIn_le (incG outcG : Hdr → StageGeom) (sgeom : ClsStmt Hdr → ℕ → Block.SegGeom) (Lb : ℕ) (q : ℕ)
    (A : OC (QB L) Dig (ClsStmt Hdr × ClsReceipt)) (hA : A.Bounded q) :
    prH (ebEvIn tag L h64 key domain hs hL incG outcG sgeom Lb A) ≤ εxRun q := by
  unfold εxRun
  by_cases hq : q + 1 ≤ 2 ^ 102
  · rw [ite_eq_left hq]
    exact extract_fail_xm_u126 tag L h64 key domain hs hL abRdIn 256 256 256 16 16 12 26 (rxCoreOf sgeom)
      (rxVx tag L h64 incG outcG sgeom Lb) 574464 (rxVx_bounded tag L h64 incG outcG sgeom Lb) ebInRoots 1
      ebInRoots_length (by norm_num) (by norm_num) q hq A hA
  · rw [ite_eq_right hq]
    exact prH_le_one _

end Ev

section Count

variable {Lq : ℕ} {α : Type} {tr : (QB Lq → Dig) → α → List (TItem × Dig)}

/-- **THE COUNT UNDER REPAIR B** (PROVED): R13's total with the run's extraction event, `55,525,211` (L30's
`eleven_totals`), plus repair B's event, `2^16 + 2^18 = 327,680`, is `55,852,891`, within `2^26 = 67,108,864`. -/
theorem eb_total : 55525211 + (2 ^ 16 + 2 ^ 18) = 55852891 ∧ 55852891 ≤ 2 ^ 26 ∧ (2 : ℕ) ^ 26 = 67108864 := by
  norm_num

/-- **R13's eleven constants with the run's extraction event and one more event of constant `cy`**: within `2^26`
whenever `55,525,211 + cy ≤ 2^26` (at repair B, `cy = 2^16 + 2^18`: `55,852,891`). -/
theorem eb_bud_r13 (Ksl KM KA KB KR₀ KR₁ KH₀ KH₁ KLU : KindRun tr) (KxA KxB : FirstKind Lq α) (cy : ℕ)
    (hcy : 55525211 + cy ≤ 2 ^ 26) :
    partConst (kindsFK [(Ksl, 7 + 7 * 370), (KM, 3 * 2 ^ 20), (KA, 2 ^ 16), (KB, 1), (KR₀, 80 + 80 * 451),
        (KR₁, 80 + 80 * 451), (KH₀, 80 + 80 * 451), (KH₁, 80 + 80 * 451), (KLU, 50331700)]
      ++ [(KxA, 2 ^ 16), (KxB, 1)]) ((2 ^ 16 + 2 ^ 18) + cy) ≤ 2 ^ 26 := by
  simp only [kindsFK, List.map_cons, List.map_nil, List.cons_append, List.nil_append]
  rw [partConst_eleven]
  norm_num at hcy ⊢
  omega

end Count

end ZK60.ProtocolClassify
