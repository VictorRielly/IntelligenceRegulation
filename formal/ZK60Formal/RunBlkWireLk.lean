variable {K : Type} [Field K] [Algebra GF K] {L : ℕ}

/-- **The committed data read directly off the `(cut, rtA)` pair `lkSqB` provides** (no adversary `A` needed). -/
noncomputable def dofARB (tag : MTag) (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (h Q e rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (cr : List (QB L × Dig) × Option (List UInt8)) : CmData K P :=
  dXof tag hL20 P hlc h Q e rA rH rE QE XE (cr.1, [], []) (cr.2, none, none)

/-- **The `A` planes of `dofARB (cu.1, rt.1)` are definitionally `dXof cu rt`'s `A` planes (`rfl`).** -/
theorem dofARB_aPl (U : K) (tag : MTag) (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (h Q e rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (cu : Cuts3 L) (rt : RootsO) (off log : ℕ) (b : Fin log → Bool) :
    aPl U P (dofARB tag hL20 P hlc h Q e rA rH rE QE XE (cu.1, rt.1)) off log b
      = aPl U P (dXof tag hL20 P hlc h Q e rA rH rE QE XE cu rt) off log b := rfl

/-- **Adversary-free R13 lookup list** over `(cut, rtA)` (`lkSqB`'s `Alk`). -/
noncomputable def AlkR13B (U : K) (c : W16Cfg) (P : BlockParams) {S : ZK60.Block.BlockShape}
    (Pb : ZK60.Block.BlockPublic S) (Lay : W16Layout S (CtR c) (CwR c) (CgR c) (CjR c) (CdR c) (CfR c))
    (B : W16Pub S Pb Lay) {ls : ℕ} (G : GeoR c ls)
    (DofB : List (QB L × Dig) × Option (List UInt8) → CmData K P)
    (cr : List (QB L × Dig) × Option (List UInt8)) :
    SgIx c ⊕ (PrIx c ls ⊕ PrIx c ls) → Tup K :=
  AlkR13 U c P Pb Lay B G (fun _ => DofB cr) cr.1

/-- **Adversary-free R13 multiplicity vector** over `(cut, rtA)` (`lkSqB`'s `mlk`). -/
noncomputable def mlkR13B (U : K) (c : W16Cfg) (P : BlockParams)
    (DofB : List (QB L × Dig) × Option (List UInt8) → CmData K P)
    (cr : List (QB L × Dig) × Option (List UInt8)) : TbIx → K :=
  mlkR13 U c P (fun _ => DofB cr) cr.1

/-- **Adversary-free R13 lookup coverage (`RdBlkR13B.hcov`), generic in the configuration.** -/
theorem hcov_r13B (U : K) (tag : MTag) (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    {c : W16Cfg} {ls : ℕ} (G : GeoR c ls) (hc : LookCfg c ls) {S : ZK60.Block.BlockShape}
    (Pb : ZK60.Block.BlockPublic S) (Lay : W16Layout S (CtR c) (CwR c) (CgR c) (CjR c) (CdR c) (CfR c))
    (B : W16Pub S Pb Lay) (hS : PrecR c S) (cu : Cuts3 L) (rt : RootsO) :
    ∀ q, R13Query Pb Lay B (xtR U c P (dXof tag hL20 P hlc 16 256 24448 rA rH rE QE XE cu rt) ls) q →
      ∃ l, AlkR13B U c P Pb Lay B G (dofARB tag hL20 P hlc 16 256 24448 rA rH rE QE XE) (cu.1, rt.1) l = tupK q := by
  intro q hq
  have hcov := cover_xtR U P Pb Lay B G hc
    (fun _ => dofARB tag hL20 P hlc 16 256 24448 rA rH rE QE XE (cu.1, rt.1))
    cu.1
    (dXof tag hL20 P hlc 16 256 24448 rA rH rE QE XE cu rt)
    (fun off log b => dofARB_aPl U tag hL20 P hlc 16 256 24448 rA rH rE QE XE cu rt off log b)
    (dXof_base_r13 tag hL20 P hlc rA rH rE QE XE cu rt) hS hlc
  exact r13Query_of hcov hq

/-- **Adversary-free R13 lookup coverage at every Shieldstral layer (`RdBlkR13B.hcov`), with no shape premise.** -/
theorem hcov_shieldB (Ly : ZK60.RunShape.Shield.ShieldLayer) (U : K) (tag : MTag) (hL20 : 2 ^ 20 ≤ L)
    (P : BlockParams) (hlc : P.logCols = 14) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (Pb : ZK60.Block.BlockPublic (ZK60.RunShape.Shield.shieldShape Ly))
    (Lay : W16Layout (ZK60.RunShape.Shield.shieldShape Ly) (CtR (DefR13.cfgShieldR13 Ly))
      (CwR (DefR13.cfgShieldR13 Ly)) (CgR (DefR13.cfgShieldR13 Ly)) (CjR (DefR13.cfgShieldR13 Ly))
      (CdR (DefR13.cfgShieldR13 Ly)) (CfR (DefR13.cfgShieldR13 Ly)))
    (B : W16Pub (ZK60.RunShape.Shield.shieldShape Ly) Pb Lay) (cu : Cuts3 L) (rt : RootsO) :
    ∀ q, R13Query Pb Lay B (xtR U (DefR13.cfgShieldR13 Ly) P
        (dXof tag hL20 P hlc 16 256 24448 4577 4390 rE QE XE cu rt) 1) q →
      ∃ l, AlkR13B U (DefR13.cfgShieldR13 Ly) P Pb Lay B (geoShield Ly)
        (dofARB tag hL20 P hlc 16 256 24448 4577 4390 rE QE XE) (cu.1, rt.1) l = tupK q :=
  hcov_r13B U tag hL20 P hlc 4577 4390 rE QE XE (geoShield Ly) (lookCfg_shield Ly) Pb Lay B (precR_shield Ly) cu rt

