/-! ## The committed matrices of a block -/

section Data

variable {K : Type} [Field K] [Algebra GF K]

/-- The rows of each commitment's matrix. -/
def rowsOfX (rA rH : ℕ) (rE : Cm → ℕ) : Cm → ℕ
  | .a => rA
  | .h => rH
  | .inp => rE .inp
  | .out => rE .out

/-- The pad columns of each commitment's matrix. -/
def qOfX (Q : ℕ) (QE : Cm → ℕ) : Cm → ℕ
  | .a => Q
  | .h => Q
  | .inp => QE .inp
  | .out => QE .out

/-- A column index at the verifier's row log, read at row log 14. -/
def colCast (P : BlockParams) (hlc : P.logCols = 14) (Q : ℕ) : Fin (2 ^ P.logCols + Q) → Fin (2 ^ 14 + Q) :=
  Fin.cast (congrArg (fun m => 2 ^ m + Q) hlc)

/-- The matrices: `A`'s and `H`'s at row log 14, the endpoints' as given. -/
def xOfX (P : BlockParams) (hlc : P.logCols = 14) (rA rH Q : ℕ) (XA : Fin rA → Fin (2 ^ 14 + Q) → K)
    (XH : Fin rH → Fin (2 ^ 14 + Q) → K) (rE QE : Cm → ℕ)
    (XE : (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K) :
    (cm : Cm) → Fin (rowsOfX rA rH rE cm) → Fin (2 ^ rowLog P cm + qOfX Q QE cm) → K
  | .a => fun i t => XA i (colCast P hlc Q t)
  | .h => fun i t => XH i (colCast P hlc Q t)
  | .inp => XE .inp
  | .out => XE .out

/-- **The committed matrices of a block** at an opening geometry `(h, Q, e)` with rows `rA`, `rH`: `A`'s and `H`'s as
L31's `csXof` reads them, the endpoints' `XE`. -/
noncomputable def dXof (tag : MTag) {L : ℕ} (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (h Q e rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (cu : Cuts3 L) (rt : RootsO) : CmData K P :=
  ⟨rowsOfX rA rH rE, qOfX Q QE,
    xOfX P hlc rA rH Q (Link.xAof tag L (Link.le64_of_le20 hL20) h Q e rA cu rt)
      (Link.xHof tag L (Link.le64_of_le20 hL20) h Q e rH cu rt) rE QE (XE cu rt)⟩

variable (U : K)

theorem claimSem_cast14 (R Q l : ℕ) (hl : l = 14) (X : Fin R → Fin (2 ^ 14 + Q) → K) (z : ZClaim) :
    Link.claimSem U R l Q (fun i t => X i (Fin.cast (congrArg (fun m => 2 ^ m + Q) hl) t)) z
      = Link.claimSem U R 14 Q X z := by
  subst hl
  rfl

/-- **`csXof` is the claim functional on `dXof`'s matrices**: L22's semantics on `A` and `H` by definition, the
endpoints' by `hcsE`. This is the `hcs` of `polyS_slotEvalN`. -/
theorem csXof_dXof (tag : MTag) {L : ℕ} (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (h Q e rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (csE : Cuts3 L → RootsO → Cm → ZClaim → K)
    (hcsE : ∀ (cu : Cuts3 L) (rt : RootsO) (cm : Cm) (z : ZClaim), (cm = .inp ∨ cm = .out) →
      csE cu rt cm z = Link.claimSem U (rE cm) (rowLog P cm) (QE cm) (XE cu rt cm) z)
    (cu : Cuts3 L) (rt : RootsO) : ∀ cm z,
    Link.csXof U tag L (Link.le64_of_le20 hL20) h Q e rA rH csE cu rt cm z
      = Link.claimSem U ((dXof tag hL20 P hlc h Q e rA rH rE QE XE cu rt).rows cm) (rowLog P cm)
        ((dXof tag hL20 P hlc h Q e rA rH rE QE XE cu rt).Q cm) ((dXof tag hL20 P hlc h Q e rA rH rE QE XE cu rt).X cm) z
  | .a, z => (claimSem_cast14 U rA Q P.logCols hlc (Link.xAof tag L (Link.le64_of_le20 hL20) h Q e rA cu rt) z).symm
  | .h, z => (claimSem_cast14 U rH Q P.logCols hlc (Link.xHof tag L (Link.le64_of_le20 hL20) h Q e rH cu rt) z).symm
  | .inp, z => hcsE cu rt .inp z (Or.inl rfl)
  | .out, z => hcsE cu rt .out z (Or.inr rfl)

/-- **A program's private tables per slot in commitment `cm`** (the `aC`, `hC` of L31's statements). -/
def cntS (cm : Cm) (prog : List SlotS) : List ℕ := prog.map fun s => cmCountS cm s.tabs

/-- **The tables part of the slot polynomials** of a block whose `define` runs `prog`, over `dXof`'s matrices. -/
noncomputable abbrev polyXof (tag : MTag) {L : ℕ} (hL20 : 2 ^ 20 ≤ L) (P : BlockParams) (hlc : P.logCols = 14)
    (h Q e rA rH : ℕ) (rE QE : Cm → ℕ)
    (XE : Cuts3 L → RootsO → (cm : Cm) → Fin (rE cm) → Fin (2 ^ rowLog P cm + QE cm) → K)
    (prog : List SlotS) (pubs : PubTabs) :
    Cuts3 L → RootsO → (k : ℕ) → Seen → (Fin ((slotShape P k).1 + (slotShape P k).2.1) → K) → K :=
  fun cu rt => polyS U P (dXof tag hL20 P hlc h Q e rA rH rE QE XE cu rt) prog pubs

end Data

