/-- **The matrix `csXof` reads a claim on `A` on**: the rows decoded from the matrix extracted for the `A` root. -/
noncomputable def xAof (h Q e rA : ℕ) (cu : Block.Cuts3 L) (rt : Block.RootsO) : Fin rA → Fin (2 ^ 14 + Q) → K :=
  decodeRows (encG (K := K) h Q) e (UxC tag L h64 h rA (N := 2 ^ h) cu.1 rt.1)

/-- The same for `H`. -/
noncomputable def xHof (h Q e rH : ℕ) (cu : Block.Cuts3 L) (rt : Block.RootsO) : Fin rH → Fin (2 ^ 14 + Q) → K :=
  decodeRows (encG (K := K) h Q) e (UxC tag L h64 h rH (N := 2 ^ h) cu.2.2 rt.2.2)

end Data

