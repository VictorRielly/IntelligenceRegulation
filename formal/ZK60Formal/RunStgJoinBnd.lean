        (wrCsB U tag Lq h64 (ebData U tag Lq h64 key domain hs hL rdx R.pf
            (rxPs base Lb din (fun k => rxDblk R.pf k (Sf k) (kMf k) (rAf k) (rHf k) (nAf k) (nHf k)) dout)
